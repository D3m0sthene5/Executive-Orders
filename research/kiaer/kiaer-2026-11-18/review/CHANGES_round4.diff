+class UsageValidationTest(unittest.TestCase):
+    """Third review: empty or partial usage is not measured usage, and a reconciliation figure must be finite."""
+
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = Path(self.tmp.name)
+        self.addCleanup(self.tmp.cleanup)
+
+    def test_codex_empty_or_incomplete_usage_events_are_not_usage(self):
+        ok = '{"type":"turn.completed","usage":{"input_tokens":100,"cached_input_tokens":40,"output_tokens":7}}'
+        self.assertEqual(codex_adapter.parse_events(ok)[1]["input_tokens"], 100)
+        for bad in ('{"type":"turn.completed","usage":{}}',
+                    '{"type":"turn.completed","usage":{"input_tokens":100,"output_tokens":7}}',
+                    '{"type":"turn.completed","usage":{"input_tokens":100,"cached_input_tokens":40}}',
+                    '{"type":"turn.completed","usage":{"input_tokens":10,"cached_input_tokens":40,"output_tokens":7}}',
+                    '{"type":"turn.completed","usage":{"input_tokens":-1,"cached_input_tokens":0,"output_tokens":7}}'):
+            self.assertEqual(codex_adapter.parse_events(bad)[1], {}, bad)
+            self.assertEqual(codex_adapter.parse_events(ok + "\n" + bad)[1], {}, bad)
+
+    def test_partial_or_empty_usage_is_charged_an_estimate_and_stops_admission(self):
+        for usage in ({"input_tokens": 500, "output_tokens": 9},
+                      {"input_tokens": 500, "cache_read_tokens": 0, "cache_write_tokens": 0},
+                      {"input_tokens": 0, "cache_read_tokens": 0, "cache_write_tokens": 0, "output_tokens": 0},
+                      {"input_tokens": float("nan"), "cache_read_tokens": 0, "cache_write_tokens": 0,
+                       "output_tokens": 5},
+                      {"total_tokens": 900}):
+            with self.subTest(usage=usage), tempfile.TemporaryDirectory() as tmp:
+                provider = lambda *_: reply([("a.json", "{}")], usage=usage)
+                e = Engine(Path(tmp) / "db.sqlite3", tmp, {"claude": provider, "codex": provider},
+                           token_cap=5_000_000, halt_unmeasured=True)
+                try:
+                    first = e.create_pipeline("a", [{"actor": "claude", "prompt": "A", "inputs": []}])["id"]
+                    wait_for(e, first, "completed")
+                    turn = e.get(first)["turn_records"][0]
+                    self.assertEqual((turn["estimated"], turn["units"], turn["total_tokens"]), (1, 150000.0, None))
+                    second = e.create_pipeline("b", [{"actor": "claude", "prompt": "B", "inputs": []}])["id"]
+                    time.sleep(0.3)
+                    self.assertEqual(e.get(second)["status"], "queued")
+                    self.assertEqual(len(e.unmeasured()), 1)
