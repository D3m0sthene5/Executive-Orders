+# Which step may deliver each scored artifact: (actor, pipeline step). A seed artifact belongs to "user".
+ARTIFACT_OWNER = {"genuine": {"result.json": ("claude", 1), "review.json": ("codex", 2), "final.json": ("claude", 3)},
+                  "plant": {"result.json": ("user", None), "review.json": ("codex", 1)}}
+
+
+def owned(artifacts, turns, name, kind):
+    """The artifact of this name from the one step entitled to deliver it: never a later or foreign copy."""
+    actor, step = ARTIFACT_OWNER[kind].get(name, (None, None))
+    step_of = {t["event_id"]: t["step"] for t in turns if t["ok"] and t["event_id"] is not None}
+    for a in artifacts:
+        if a["name"] == name and a["actor"] == actor and (step is None or step_of.get(a["event_id"]) == step):
+            return a["content"]
+    return None
 
 
