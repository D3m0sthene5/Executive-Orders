+def wait_for(engine, job, status, seconds=5):
+    end = time.time() + seconds
+    while time.time() < end:
+        if engine.get(job)["status"] == status:
+            return
+        time.sleep(0.02)
+    raise AssertionError(f"expected {status}; found {engine.get(job)['status']}")
+
