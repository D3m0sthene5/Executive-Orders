+class CodexAccountingEventsTest(unittest.TestCase):
+    """Fourth review: one accounting event without valid usage makes the whole Codex turn unmeasured."""
+    GOOD = '{"type":"turn.completed","usage":{"input_tokens":100,"cached_input_tokens":40,"output_tokens":7}}'
+    BAD = ('{"type":"turn.completed","usage":null}', '{"type":"turn.completed","usage":[]}',
+           '{"type":"turn.completed","usage":"100"}', '{"type":"turn.completed"}',
+           '{"type":"token_count","info":{"last_token_usage":{}}}',
+           '{"type":"token_count","info":{"last_token_usage":null,"total_token_usage":{"input_tokens":5,'
+           '"cached_input_tokens":0,"output_tokens":1}}}',
+           '{"type":"token_count","info":"none"}', '{"type":"token_count","usage":null}',
+           '{"usage":{}}')
+    IGNORED = ('{"type":"token_count","info":null}', '{"type":"token_count"}', '{"type":"token_count","info":{}}',
+               '{"type":"turn.started"}', '{"type":"item.completed","item":{"type":"reasoning","text":"x"}}')
+
+    def test_a_malformed_accounting_event_voids_the_stream_even_after_valid_ones(self):
+        for bad in self.BAD:
+            for stream in (bad, self.GOOD + "\n" + bad, bad + "\n" + self.GOOD):
+                self.assertEqual(codex_adapter.parse_events(stream)[1], {}, stream)
+
+    def test_events_that_carry_no_accounting_field_do_not_void_valid_usage(self):
+        for other in self.IGNORED:
+            usage = codex_adapter.parse_events(self.GOOD + "\n" + other)[1]
+            self.assertEqual((usage["input_tokens"], usage["cached_input_tokens"], usage["output_tokens"]),
+                             (100, 40, 7), other)
+            self.assertEqual(codex_adapter.parse_events(other)[1], {}, other)
+        both = codex_adapter.parse_events(self.GOOD + "\n" + self.GOOD)[1]
+        self.assertEqual(both["input_tokens"], 200)
+
