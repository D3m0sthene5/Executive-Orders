+class Reply(str):
+    telemetry: dict = {}
+
+
+def reply(artifacts, tokens=1000, usage=True):
+    out = Reply(json.dumps({"action": "finish", "message": "done", "reply_to": None,
+                            "artifacts": [{"name": n, "content": c} for n, c in artifacts]}))
+    out.telemetry = {"input_tokens": tokens, "cache_read_tokens": 0, "cache_write_tokens": 0,
+                     "output_tokens": 0} if usage is True else (usage or {})
+    return out
+
