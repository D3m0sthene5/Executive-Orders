+"""The launch check that binds a Kiaer run to its reviewed plan (kiaer/wave.py verify)."""
+import hashlib
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+from kiaer import common, wave
+
+
+def _draw(out, repo):
+    cells = {"C01": {"label": "a", "pool": 9, "cap": 5, "blind": False, "fixed": False, "order": ["EO:1", "EO:2", "EO:3", "EO:4", "EO:5"]},
+             "C06": {"label": "b", "pool": 9, "cap": 2, "blind": True, "fixed": True, "order": ["EO:6", "EO:7"]}}
+    frame = {cid: c["order"] for cid, c in cells.items()}
+    plan = {"seed": 1, "cells": cells, "inputs_sha256": common.input_hashes(repo),
+            "frame_sha256": hashlib.sha256(json.dumps(frame, sort_keys=True).encode()).hexdigest()}
+    common.write_json(Path(out) / "DRAW.json", plan)
+    return plan
+
+
+def _approve(path):
+    w = json.loads(path.read_text(encoding="utf-8"))
+    w["review"] = {"reviewer": "gpt-test", "verdict": "approve", "plan_sha256": wave.plan_sha(w)}
+    common.write_json(path, w)
+    return w
+
+
+class VerifyTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.repo, self.out = Path(self.tmp.name) / "repo", Path(self.tmp.name) / "data"
+        self.repo.mkdir()
+        self.out.mkdir()
+        _draw(self.out, self.repo)
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def test_unreviewed_plan_is_refused(self):
+        wave.write(self.repo, self.out, 10_000_000, 3, stage=0)
+        problems = wave.verify(self.repo, self.out, 0, 1, 6_000_000)
+        self.assertTrue(any("no approving review" in p for p in problems))
