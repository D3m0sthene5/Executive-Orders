        "page_images_inspected": false,
        "text_review_basis": "Full readable official text extract with matching GPO fixity; no page-image reading claimed",
        "quoted_text": "Section 8. Executive O rder Nos. 12276 through 12285 of January 19, 1981, are \nratified.\nThis O rder shall be effective immediately and copies shall be transm itted to \nthe Congress."
      },
      "full_held_text_read": true,
