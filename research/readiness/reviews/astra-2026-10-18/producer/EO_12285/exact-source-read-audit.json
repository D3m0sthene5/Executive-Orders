    {
      "instrument_id": "EO:12307",
      "source": {
        "url": "https://www.govinfo.gov/content/pkg/FR-1981-06-09/pdf/FR-1981-06-09.pdf",
        "sha256": "3522c390cf4e8fd88872db167a9e75ff9643629726535b3190b06a8468df9d9a",
        "page_or_item": "46 FR30483, PDF page11",
        "text_path": "jobs/fr-originals/output/texts/EO_12307.txt",
        "text_sha256": "90b6b309f1c025484998bf641a84a94af6aa731ca18c6a6b4d20bf434034389a",
        "page_images_inspected": false,
        "text_review_basis": "Full readable official text extract with matching GPO fixity; no page-image reading claimed",
        "quoted_text": "By the authority vested in me as President by the Constitution and statutes of \nthe United States of America, in accordance with the Federal Advisory \nCommittee Act, as amended (5 U.S.C. App. I), and to give the President’s \nCommission on Hostage Compensation time to complete its work, it is hereby \nordered that Executive Order No. 12285 (January 19, 1981) is amended as \nfollows:\nThe first sentence of Section 1-202 of the Order is amended to read: “The \nCommission shall submit a report to the President no later than August 20, \n1981.” .\nThe second sentence of Section 1-301 of the Order is amended to read: “In \naddition to conducting open meetings in accordance with the Federal Adviso­\nry Committee Act, the Commission may conduct public hearings to identify \ncritical issues and possible solutions related to compensation.”"
      },
      "full_held_text_read": true,
      "page_images_read": false,
      "scope": "Complete held extract, with exact operative source boundary identified; EO12317 adjacent blank/regulatory pages excluded from EO source scope"
    },
    {
      "instrument_id": "EO:12317",
      "source": {
        "url": "https://www.govinfo.gov/content/pkg/FR-1981-08-20/pdf/FR-1981-08-20.pdf",
        "sha256": "75995becbbb99c1fa1f5464853e2a527ad1dd188813c6b3e54ac53c70d5c6c89",
        "page_or_item": "46 FR42241, PDF page15; adjacent blank page16 and unrelated regulations page17 read/excluded",
        "text_path": "jobs/fr-originals/output/texts/EO_12317.txt",
        "text_sha256": "c4e5f9d63c97a5a8bb90edb39b14e5bf5339300858b33be9c145be077ae1aa74",
        "page_images_inspected": false,
        "text_review_basis": "Full readable official text extract with matching GPO fixity; no page-image reading claimed",
        "quoted_text": "By the authority vested in me as President by the Constitution and statutes of \nthe United States of America, in accordance with the Federal Advisory \nCommittee Act, as amended (5 U.S.C. App. I), and to give the President’s \nCommission on Hostage Compensation additional time to prepare its report, it \nis hereby ordered that the first sentence of Section 1-202 of Executive Order \nNo. 12285, as amended, is further amended to read: “The Commission shall \nsubmit a final report to the President no later than September 21, 1981.“."
      },
      "full_held_text_read": true,
      "page_images_read": false,
      "scope": "Complete held extract, with exact operative source boundary identified; EO12317 adjacent blank/regulatory pages excluded from EO source scope"
    },
