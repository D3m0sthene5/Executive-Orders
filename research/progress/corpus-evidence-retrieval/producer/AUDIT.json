  "source_count": 19,
  "key_context_spans": [
    {
      "file": "jobs/app-executive-orders/output/texts/executive-order-10931-amendment-section-1-executive-order-no-10673-establishing-the.txt",
      "raw_sha256": "40566e42ca13eb791f8e586a888eb3daea2f1a74801b96c965a0e28e88087f21",
      "char_start": 680,
      "char_end": 931,
      "text": "SEC. 2. The following-described orders, amending section 1 of Executive Order No. 10673, are hereby revoked:\n\nExecutive Order No. 10704 of March 25, 1957.\n\nExecutive Order No. 10740 of November 21, 1957.\n\nExecutive Order No. 10785 of October 17, 1958."
    },
    {
      "file": "jobs/app-executive-orders/output/texts/executive-order-11074-establishing-the-presidents-council-physical-fitness.txt",
      "raw_sha256": "4245c6ab0b536562797659d9b8026522177b62de9a8de34d09bd332079d64f85",
      "char_start": 2132,
      "char_end": 2692,
      "text": "SEC. 3. Federal Agencies. (a) Nothing in this order shall be construed to abrogate, modify, or restrict any function vested by law in, or assigned pursuant to law to, any executive department or other agency of the Government or any officer thereof.\n\n(b) Each executive department the head of which is referred to in section 1 of this order shall, as may be necessary for the purpose of effectuating the provisions of this order, furnish assistance to the Council in accordance with section 214 of the act of May 3, 1945, 59 Stat. 134 (31 U.S.C. 691).\n\nSEC. 4."
    },
    {
      "file": "jobs/app-executive-orders/output/texts/executive-order-11074-establishing-the-presidents-council-physical-fitness.txt",
      "raw_sha256": "4245c6ab0b536562797659d9b8026522177b62de9a8de34d09bd332079d64f85",
      "char_start": 2685,
      "char_end": 2833,
      "text": "SEC. 4. Continuity. The Council established by this order shall be deemed to be a continuation of the President's Council on Youth Fitness.\n\nSEC. 5."
    },
    {
      "file": "jobs/app-executive-orders/output/texts/executive-order-11074-establishing-the-presidents-council-physical-fitness.txt",
      "raw_sha256": "4245c6ab0b536562797659d9b8026522177b62de9a8de34d09bd332079d64f85",
      "char_start": 3049,
      "char_end": 3214,
      "text": "SEC. 6. Revocations. Executive Order 10673 of July 16, 1956, Executive Order 10772 of June 30, 1958, and Executive Order 10931 of March 29, 1961, are hereby revoked."
    },
    {
      "file": "jobs/app-executive-orders/output/texts/executive-order-11398-establishing-the-presidents-council-physical-fitness-and-sports.txt",
      "raw_sha256": "2c1b8ce79d611378ad513c97c3aee0d1efb4de26247d706decd67650b03763dd",
      "char_start": 5846,
      "char_end": 6358,
      "text": "SEC. 7. Continuity. The Council established by this order shall be deemed to be a continuation of the President's Council on Physical Fitness.\n\nSEC. 8. Seal. Executive Order 10830 of July 24, 1959, prescribing a seal for the President's Council on Youth Fitness, as amended by Executive Order 11074 of January 8, 1963, is further amended by adding the words \"and Sports\" after the word \"Fitness\" wherever it appears in said order.\n\nSEC. 9. Revocation. Executive Order 11074 of January 8, 1963, is hereby revoked."
    },
    {
      "file": "jobs/app-executive-orders/output/texts/executive-order-14327-presidents-council-sports-fitness-and-nutrition-and-the.txt",
      "raw_sha256": "4dbf85bb099aa6f57556f8d0402982192ffae35631e0620efd6a3428900191ed",
      "char_start": 1599,
      "char_end": 1768,
      "text": "President Eisenhower recognized this issue when he created the President's Council on Youth Fitness in response to reports on the poor state of youth fitness in America."
    },
    {
      "file": "jobs/fr-originals/output/texts/EO_10772.txt",
      "raw_sha256": "dc89b5011eecda10fcc98b9f1fb897e1266f94f76fc34d5a79b03ee37c4273a2",
      "char_start": 1526,
      "char_end": 1554,
      "text": "TITLE 6\u2014 AGRICULTURAL CREDIT"
    },
    {
      "file": "jobs/fr-originals/output/texts/EO_10772.txt",
