      "paths": [
        "jobs/pinakes-proquest-ingest/output/texts/EO_1079.txt"
      ],
      "text": "Exrecutive ether.\nMr. Carl G. Barth may be appointed as an expert in shop management\nat the Watertown Arsenal, Watertowvn, Massachusetts, at a salary of $50\nper diem and expenses for each day his service will be given to the arsenal,\nfor such period as may enable him to make a conclusive test of his methods\nin the operation of a manufacturing arsenal.\nWm H TAFT\nTHE WHITE HOUSE,\nMay 28, 1909.\n[No. 1079.1",
      "text_sha256": "540ab1b6b7f94aa12c640b9d8699d0498d4558971eeb4068a8b23537d56f142c"
    }
