      },
      "text": "By virtue of and pursuant to the au­\nthority vested in me by section 1752 of\nthe Revised Statutes of the United States\n(22 U. S. C., sec. 132) , it is ordered that\nthe Tariff of United States Foreign Serv­\nice Fees, as prescribed by section V-15\nof the Foreign Service Regulations of the\nUnited States be, and it is hereby, amend­\ned as follows:"
    },
    {
      "char_end": 1316,
      "char_start": 1045,
      "id": "CLAUSES:EO:8078#1",
      "kind": "amendment_instruction",
      "label": "1.",
      "pdf_page": 3,
      "scope_id": "EO:8078#1",
      "source": {
        "filing_date": null,
        "location_confidence": "high",
        "location_verified": false,
        "page_or_item": "4 FR 1475, PDF pages 3-3",
        "requires_page_check": false,
        "sha256": "8139e7c859e04c77055190b20ddab8690453ce08eba46d86d328ee75cca7f09e",
        "signing_date": "1939-04-04",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_8078.recheck.txt",
