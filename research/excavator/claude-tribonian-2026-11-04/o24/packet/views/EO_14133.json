      "id": "CLAUSES:EO:14133#sec5-c",
      "kind": "subsection",
      "label": "(c)",
      "pdf_page": 2,
      "scope_id": "EO:14133#sec5-c",
      "source": {
        "filing_date": null,
        "location_confidence": "high",
        "location_verified": false,
        "page_or_item": "90 FR 187, PDF pages 1-2",
        "requires_page_check": false,
        "sha256": "bce0d1975ed4eafda1dc82a6528da5a9fbe8065583f3291d92ef05c74a9990f8",
        "signing_date": "2024-12-30",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_14133.txt",
        "text_sha256": "ab0ad635fe45deae122bb95048b55e23e744166ebec72a895283a8cd249b4f76",
        "url": "https://www.govinfo.gov/content/pkg/FR-2025-01-03/pdf/2024-31766.pdf"
      },
      "text": "(c) This order is not intended to, and does not, create any right or benefit, \nsubstantive or procedural, enforceable at law or in equity by any party \nagainst the United States, its departments, agencies, or entities, its officers, \nemployees, or agents, or any other person."
    }
