        "url": "https://www.govinfo.gov/content/pkg/FR-2025-01-03/pdf/2024-31766.pdf"
      },
      "text": "(i) the authority granted by law to an executive department or agency, \nor the head thereof; or"
    },
    {
      "char_end": 2158,
      "char_start": 2019,
      "id": "CLAUSES:EO:14133#sec5-i-ii",
      "kind": "item",
      "label": "(ii)",
      "pdf_page": 1,
      "scope_id": "EO:14133#sec5-i-ii",
      "source": {
        "filing_date": null,
        "location_confidence": "high",
        "location_verified": false,
        "page_or_item": "90 FR 187, PDF pages 1-2",
        "requires_page_check": false,
        "sha256": "bce0d1975ed4eafda1dc82a6528da5a9fbe8065583f3291d92ef05c74a9990f8",
        "signing_date": "2024-12-30",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_14133.txt",
