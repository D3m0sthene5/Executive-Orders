        "signing_date": "2022-07-15",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_14077.txt",
        "text_sha256": "5f3a90e69a85ef63bcf4feb8b38ec566993c1999075b65fd00a5440182b62b17",
        "url": "https://www.govinfo.gov/content/pkg/FR-2022-07-20/pdf/2022-15628.pdf"
      },
      "text": "Sec. 5. Expiration. The Board shall terminate upon the submission of the \nreport provided for in section 2 of this order."
    }
