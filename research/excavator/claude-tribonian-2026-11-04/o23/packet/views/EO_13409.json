        "requires_page_check": false,
        "sha256": "1f22227573e7fce9465f14399e0789933ffd49b3dcbe8a3da8c8646f43680deb",
        "signing_date": "2006-07-03",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_13409.txt",
        "text_sha256": "ad4b02b1d56dfba4067177a76909a26a28b778891388c83cd0e6023cf5fe4ecf",
        "url": "https://www.govinfo.gov/content/pkg/FR-2006-07-07/pdf/06-6101.pdf"
      },
      "text": "Sec. 3. Maintaining Conditions. As provided by section 9A(c) of the RLA, \nfrom the date of the creation of the Board and for 120 days thereafter, \nno change in the conditions out of which the dispute arose shall be made \nby the parties to the controversy, except by agreement of the parties."
    },
