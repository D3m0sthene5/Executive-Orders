        "url": "https://www.govinfo.gov/content/pkg/FR-2006-07-07/pdf/06-6101.pdf"
      },
      "text": "Section 1. Establishment of Emergency Board (Board). There is established, \neffective 12:01 a.m. eastern daylight time on July 8, 2006, a Board of three \nmembers to be appointed by the President to investigate and report on \nthis dispute. No member shall be pecuniarily or otherwise interested in \nany organization of railroad employees or any carrier. The Board shall per-\nform its functions subject to the availability of funds."
    },
    {
      "char_end": 2201,
      "char_start": 2084,
      "id": "CLAUSES:EO:13409#sec2",
      "kind": "section",
      "label": "Sec. 2.",
      "pdf_page": 1,
      "scope_id": "EO:13409#sec2",
      "source": {
        "filing_date": null,
        "location_confidence": "high",
        "location_verified": false,
        "page_or_item": "71 FR 38511, PDF pages 1-2",
        "requires_page_check": false,
        "sha256": "1f22227573e7fce9465f14399e0789933ffd49b3dcbe8a3da8c8646f43680deb",
        "signing_date": "2006-07-03",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_13409.txt",
