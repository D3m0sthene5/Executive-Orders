        "signing_date": "2007-04-04",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_13429.txt",
        "text_sha256": "5b471782c83bfccdcc856285a14663bad6f3b87580ff68f9dee734afad3b5093",
