      "source": {
        "filing_date": null,
        "location_confidence": "high",
        "location_verified": false,
        "page_or_item": "80 FR 43003, PDF pages 1-3",
        "requires_page_check": false,
        "sha256": "c051a14ec6eee02ca75cbe70674749b1f568764a4a2ba78771a0eb3f3afd1a30",
        "signing_date": "2015-07-15",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_13700.txt",
        "text_sha256": "b8ebe6e1802960beb56762957542b355d42d90d8838054a75c3b9281c6d1f8a0",
        "url": "https://www.govinfo.gov/content/pkg/FR-2015-07-20/pdf/2015-17926.pdf"
      },
      "text": "Sec. 3. Maintaining Conditions. As provided by section 9A(c) of the RLA, \nfor 120 days from the date of the creation of the Board, no change in \nthe conditions out of which the disputes arose shall be made by the parties \nto the controversy, except by agreement of the parties."
    },
