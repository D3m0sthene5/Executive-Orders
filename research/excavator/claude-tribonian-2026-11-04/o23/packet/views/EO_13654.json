      "scope_id": "EO:13654#sec3",
      "source": {
        "filing_date": null,
        "location_confidence": "high",
        "location_verified": false,
        "page_or_item": "78 FR 70843, PDF pages 1-3",
        "requires_page_check": false,
        "sha256": "35e7d15aa65691322a1ff7405228c3c3f21c2ef790186d42042a773599ecabab",
        "signing_date": "2013-11-21",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_13654.txt",
        "text_sha256": "277e1072608fd9111c6ad487b7c1bea43ff1bf74cea9b0293361329483c84673",
        "url": "https://www.govinfo.gov/content/pkg/FR-2013-11-26/pdf/2013-28581.pdf"
      },
      "text": "Sec. 3. Maintaining Conditions. As provided by section 9A(c) of the RLA, \nfor 120 days from the date of the creation of the Board, no change in \nthe conditions out of which the disputes arose shall be made by the parties \nto the controversy, except by agreement of the parties."
    },
