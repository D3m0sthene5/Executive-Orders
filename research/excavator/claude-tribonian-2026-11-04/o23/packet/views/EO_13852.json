      "kind": "subsection",
      "label": "(c)",
      "pdf_page": 2,
      "scope_id": "EO:13852#sec5-c",
      "source": {
        "filing_date": null,
        "location_confidence": "high",
        "location_verified": false,
        "page_or_item": "83 FR 62687, PDF pages 1-2",
