      "scope_id": "EO:13523#sec3",
      "source": {
        "filing_date": null,
        "location_confidence": "medium",
        "location_verified": false,
        "page_or_item": "74 FR 66563, PDF pages 1-1",
        "requires_page_check": true,
        "sha256": "747d55074f1861028e46c734d9a05529f59648ce3e09e70758f5e47307f2663d",
        "signing_date": "2009-12-11",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_13523.txt",
        "text_sha256": "7c9a322462cee0d8872b16b98281716343ead9fe183c1fedf2da208416f4933b",
        "url": "https://www.govinfo.gov/content/pkg/FR-2009-12-16/pdf/E9-30020.pdf"
      },
      "text": "Sec. 3. Thursday, December 24, 2009, shall be considered as falling within \nthe scope of Executive Order 11582 of February 11, 1971, and of 5 U.S.C. \n5546 and 6103(b) and other similar statutes insofar as they relate to the \npay and leave of employees of the United States."
    },
