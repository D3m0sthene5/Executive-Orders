        "filing_date": null,
        "location_confidence": "high",
        "location_verified": false,
        "page_or_item": "53 FR 13239, PDF pages 13-16",
        "requires_page_check": false,
        "sha256": "184b3da0e3aa1b188145dba96768881c1252a563d06a020a2ef7205e1f422128",
        "signing_date": "1988-04-20",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_12636.txt",
        "text_sha256": "44578cef13f817f79e28c80bb5ca5fc0a48dd2880d11b8da08064a3c661171b7",
        "url": "https://www.govinfo.gov/content/pkg/FR-1988-04-22/pdf/FR-1988-04-22.pdf"
      },
      "text": "Sec. 2. Report. The board shall report its finding to the President with respect  \nto the dispute within 30 days from the date of its creation."
    },
    {
      "char_end": 2414,
      "char_start": 2067,
      "id": "CLAUSES:EO:12636#sec3",
      "kind": "section",
      "label": "Sec. 3.",
