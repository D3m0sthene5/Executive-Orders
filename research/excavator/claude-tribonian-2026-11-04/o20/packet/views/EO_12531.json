        "filing_date": null,
        "location_confidence": "high",
        "location_verified": false,
        "page_or_item": "50 FR 36033, PDF pages 11-13",
        "requires_page_check": false,
        "sha256": "62c19e109b67d484b3e30ab808cd53fe4ab97fd9bdd439e2f21616d0528534b4",
        "signing_date": "1985-08-30",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_12531.txt",
        "text_sha256": "a7ba4c386af21c33cfe945904274375b5ef52ab9dfcb24d76e75dd1e75338869",
        "url": "https://www.govinfo.gov/content/pkg/FR-1985-09-05/pdf/FR-1985-09-05.pdf"
      },
      "text": "Sec. 2. R ep o rt. The board shall report its findings to the President with respect \nto the dispute within 30 days from the date of its creation."
    },
    {
      "char_end": 2489,
