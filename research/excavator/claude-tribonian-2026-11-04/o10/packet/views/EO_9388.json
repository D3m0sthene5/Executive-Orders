      "scope_id": "EO:9388#2",
      "source": {
        "filing_date": null,
        "location_confidence": "high",
        "location_verified": false,
        "page_or_item": "8 FR 14105, PDF pages 3-3",
        "requires_page_check": false,
        "sha256": "91f835b326ae7a11bf7a7c76f5a542ada65eb725334ed51e0a059feacd2019e0",
        "signing_date": "1943-10-16",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_9388.txt",
        "text_sha256": "f762cccb6850c3af19887329fccdc557050ee29f0c4a307f6651f1be69742ee0",
        "url": "https://www.govinfo.gov/content/pkg/FR-1943-10-19/pdf/FR-1943-10-19.pdf"
      },
      "text": "(2) The parties before the Special \nEmergency Board shall be the same as  \nthose included within the recommenda­\ntion of the Emergency Board which re­\nported to me on May 24 and May 29 in  \nthis dispute."
    },
    {
      "char_end": 7860,
      "char_start": 7297,
