        "text_path": "jobs/fr-originals/data/full_run/texts/EO_13351.txt",
        "text_sha256": "675641e1f43f170b717f58e23a1e27287a89b497371187a1d9a483810be049fb",
        "url": "https://www.govinfo.gov/content/pkg/FR-2004-08-12/pdf/04-18575.pdf"
      },
      "text": "Sec. 4. Records Maintenance. The records and files of the Board are records \nof the Office of the President and upon the Board’s termination shall be \nmaintained in the physical custody of the National Mediation Board. \nVerDate jul<14>2003 16:29 Aug 11, 2004 Jkt 203001 PO 00000 Frm 00003 Fmt 4705 Sfmt 4790 E:\\FR\\FM\\12AUE0.SGM 12AUE0\n=== PDF page 2 of 2 ===\n50048 Federal Register / Vol. 69, No. 155 / Thursday, August 12, 2004 / Presidential Documents"
    },
