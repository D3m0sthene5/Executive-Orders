        "sha256": "bc1904905adb4235e2982247bafd792eefc03dbd2b6addea292de9b2ab1c4021",
        "signing_date": "1946-12-23",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_9814.txt",
        "text_sha256": "fdcf72d09780c8b2f139408fcea7142b4b35b2986fa5c6eeead6a07ea2749217",
        "url": "https://www.govinfo.gov/content/pkg/FR-1946-12-25/pdf/FR-1946-12-25.pdf"
      },
      "text": "4. All executive departments and \nagencies of the Federal Government are \nauthorized and directed to cooperate \nwith the Board in its work, and to furnish \nthe Board all appropriate information \nand assistance."
    },
