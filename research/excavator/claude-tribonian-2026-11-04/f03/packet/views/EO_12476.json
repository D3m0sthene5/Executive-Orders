        "requires_page_check": false,
        "sha256": "6bd540c75bec42bece1eabfd60b60327b81e9442eafc2cf0443aa337699337cc",
        "signing_date": "1984-05-11",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_12476.txt",
        "text_sha256": "8c2f4d410fb928fa2eeb214135cd28fb8e7ac0bdf818e265d7f22380fa2ed2a1",
        "url": "https://www.govinfo.gov/content/pkg/FR-1984-05-15/pdf/FR-1984-05-15.pdf"
      },
      "text": "Sec. 2. Section 2(c) shall read: “To pursue its goals in connection with  \nparticipation in the United States-Japan Advisory Commission, the Commis­\nsion may conduct studies, hearings, and meetings as it deems necessary;  \nassemble and disseminate information; and issue reports and other publica­\ntions.”"
    },
