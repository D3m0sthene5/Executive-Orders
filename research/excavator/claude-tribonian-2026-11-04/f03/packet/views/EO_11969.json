        "text_path": "jobs/fr-originals/data/full_run/texts/EO_11969.txt",
        "text_sha256": "23851224eec9b45ac4135cdb4d8c7d27531dc50ac6314c4ecb78f7fe8c72f7be",
        "url": "https://www.govinfo.gov/content/pkg/FR-1977-02-04/pdf/FR-1977-02-04.pdf"
      },
      "text": "Sec. 4. The heads of all Executive agencies shall cooperate with and assist the \nChairman in carrying out the authority delegated to him by this Order."
    },
