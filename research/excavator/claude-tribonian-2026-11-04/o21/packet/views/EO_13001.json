        "sha256": "2d7e68ff42761818562c408895db9e9918b46b8e9a29fc0626e801f735bb9e27",
        "signing_date": "1996-05-08",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_13001.txt",
