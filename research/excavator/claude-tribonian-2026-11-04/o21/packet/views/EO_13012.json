      "scope_id": "EO:13012#sec2",
      "source": {
        "filing_date": null,
        "location_confidence": "high",
        "location_verified": false,
        "page_or_item": "61 FR 38051, PDF pages 1-1",
        "requires_page_check": false,
        "sha256": "d784bab73d2415355daaf0e407d9696efde9e8767ca3bba0e42f8daf3b32cc4b",
        "signing_date": "1996-07-18",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_13012.txt",
        "text_sha256": "c4b0954df7dd2cab1104877fd8b6c5ea1ee01aa5e6676b12a6c9b2c509476079",
        "url": "https://www.govinfo.gov/content/pkg/FR-1996-07-23/pdf/96-18846.pdf"
      },
      "text": "Sec. 2. Report. The Board shall report to the President with respect to\nthe dispute within 30 days of its creation."
    },
    {
      "char_end": 2375,
      "char_start": 2088,
      "id": "CLAUSES:EO:13012#sec3",
      "kind": "section",
