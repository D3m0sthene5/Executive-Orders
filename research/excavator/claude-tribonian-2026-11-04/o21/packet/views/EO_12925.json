        "requires_page_check": false,
        "sha256": "edd74cb28a2122ba6e5cb718c04343ff44e93ab55aff3d5c7d74c8d86d6b7958",
        "signing_date": "1994-08-29",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_12925.txt",
        "text_sha256": "7aed5401ea04060a0268739bedfaaf7c65424111659c0c9903cb26b80c8b41a9",
        "url": "https://www.govinfo.gov/content/pkg/FR-1994-08-31/pdf/FR-1994-08-31.pdf"
      },
      "text": "Sec. 5. Expiration.  The Board shall terminate upon the submission of the \nreport provided for in sections 2 and 3 of this order.\n[F R  Doc 94-21738 \nFiled 8-30-94; 11:16 am] \nBilling code 3195-01-M"
    }
