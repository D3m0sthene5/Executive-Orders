<!-- documentid:32_110  usckey:320000000011000000000000000000000 currentthrough:20250106 documentPDFPage:11 -->
<!-- itempath:/320/CHAPTER 1/Sec. 110 -->
<!-- itemsortkey:320AAAL -->
<!-- expcite:TITLE 32-NATIONAL GUARD!@!CHAPTER 1-ORGANIZATION!@!Sec. 110 -->
<!-- field-start:head -->
<h3 class="section-head">&sect;110. Regulations</h3>
<!-- field-end:head -->
<!-- field-start:statute -->
<p class="statutory-body">The President shall prescribe regulations, and issue orders, necessary to organize, discipline, and govern the National Guard.</p>
<!-- field-end:statute -->
<!-- field-start:sourcecredit -->
<p class="source-credit">(Aug. 10, 1956, ch. 1041, 70A Stat. 600.)</p>
<!-- field-end:sourcecredit -->
<!-- field-start:notes -->
<!-- field-start:historicalandrevision-note -->
<table class="uschistrev" cellspacing="0" width="700"><caption><cap-smallcap>Historical and Revision Notes</cap-smallcap></caption>
<tr><th id="row0col0"><i>Revised section</i></th><th id="row0col1"><i>Source (U.S. Code)</i></th><th id="row0col2"><i>Source (Statutes at Large)</i></th></tr>
<tr>
<td class="left">110</td>
<td class="middle">32:17.</td>
<td class="right">June 3, 1916, ch. 134, &sect;118, 39 Stat. 213.</td>
</tr>

</table>

<p class="note-body">The word &quot;rules&quot; is omitted as covered by the word &quot;regulations&quot;. The words &quot;National Guard&quot; are substituted for the words &quot;the militia provided for in this title&quot;. The words &quot;for the thorough&quot; are omitted as surplusage.</p>
<!-- field-end:historicalandrevision-note -->
<!-- field-end:notes -->


</body></html>