      "source": {
        "filing_date": null,
        "location_confidence": "high",
        "location_verified": false,
        "page_or_item": "70 FR 3137, PDF pages 1-2",
        "requires_page_check": false,
        "sha256": "f8a7bc905ec783521ad95f158087eff95ff08d17f0276ed94e4850618741af04",
        "signing_date": "2005-01-13",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_13370.txt",
        "text_sha256": "a75e9e261987a9b6e2d60c06fe2cea2ae88fe103b82edfab76de44d62018c631",
        "url": "https://www.govinfo.gov/content/pkg/FR-2005-01-19/pdf/05-1170.pdf"
      },
      "text": "(b) Notwithstanding the provisions of this order, the President retains \ndiscretion, to the extent permitted by law, to depart from this order in \ndesignating an acting Director.\nW"
    }
