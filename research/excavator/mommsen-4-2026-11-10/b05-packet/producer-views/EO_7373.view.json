":"supersede"},{"actor_id":"EO:7520","char_end":839,"char_start":0,"confidence":"medium","how_named":"parent_as_amended","id":"CHAIN:EO:7373#36","notes":"Change wording lead; chronology does not decide legal effect.","provision_text":"By virtue of and pursuant to the authority vested in me by the act of June 25, 1910, ch. 421, 36 Stat. 847, as amended by the act of August 24, 1912, ch. 369, 37 Stat. 497, it is ordered that the following-described land in the State of Arizona be, and it is hereby, temporarily withdrawn from settlement, location, sale, or entry and reserved for use of the War Department as a target range for the Arizona National Guard:\n\nGILA AND SALT RIVER MERIDIAN\n\nT. 14 S., R. 12 E., W 1/2 SW 1/4,\n\nSec. 13, W 1/2, SE 1/4, W 1/2 NE 1/4;\n\nSec. 14, NW 1/4, W 1/2 NE 1/4 sec. 23.\n\nExecutive Order No. 6910 of November 26, 1934, as amended, is hereby modified to the extent necessary to make this order effective.\n\nThis order shall continue in full force and effect unless and until revoked by the President or by act of Congress.\n\nFRANKLIN D ROOSEVELT","sections_touched":["partial"],"signing_date":null,"source":{"acceptable_as_original":false,"archival_id":"app:node/210147","filing_date":null,"grade":"mirror_transcription","instrument_id":"EO:7520","location_confidence":"medium","location_verified":false,"page_or_item":"Executive Order 7520—Withdrawal of Public Land for Use of the War Department as a Target Range for the Arizona National Guard; December 18, 1936; APP node 210147; common-crawl capture 2026-01-14T09:47:42Z","requires_page_check":true,"sha256":"e8a5094c32345271d295ca29aabf5ded7066a8d832ca654b7b3e09231f5f6e68","signing_date":null,"text_path":"jobs/app-executive-orders/output/texts/executive-order-7520-withdrawal-public-land-for-use-the-war-department-target-range-for.txt","text_sha256":"3e16a10fd550130329db907de59d8d3ed350969d341af1d37d674016cd4d15ec","url":"https://www.presidency.ucsb.edu/documents/executive-order-7520-withdrawal-p