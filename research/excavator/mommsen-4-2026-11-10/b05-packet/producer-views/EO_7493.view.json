],"signing_date":"1953-07-07","source":{"filing_date":null,"location_confidence":"high","location_verified":false,"page_or_item":"18 FR 3979, PDF pages 1-1","requires_page_check":false,"sha256":"32e28e552d92156d606e7ec8cd8dbfe7fb98653e4cef6b59eb9b6d1e7673819b","signing_date":"1953-07-07","text_path":"jobs/fr-originals/data/full_run/texts/EO_10468.txt","text_sha256":"f48cc2dffcef9c2cb9f2f3f609f6a5cdb290c923c1232574b3bdcbb7134b5161","url":"https://www.govinfo.gov/content/pkg/FR-1953-07-09/pdf/FR-1953-07-09.pdf"},"verb":"amend"}],"generic_refs_excluded":235,"id":"CHAIN:EO:7493","notes":"Named, located change provisions only; missing provisions and unheld texts remain dossier gaps. Undated events sort last.","target_id":"EO:7493"}
