nals/output/texts/EO_7689.txt","text_sha256":"195ff17a80894b8f05844a14467baded76c0cb6adde81b43555c5665885a1895","url":"https://www.govinfo.gov/content/pkg/FR-1937-08-17/pdf/FR-1937-08-17.pdf"},"verb":"amend"},{"actor_id":"EO:8294","char_end":1771,"char_start":1351,"confidence":"medium","how_named":"parent_as_amended","id":"CHAIN:EO:7493#5","notes":"Change wording lead; chronology does not decide legal effect.","provision_text":"Ickes, resigned, to\nserve without additional compensation,\nand to exercise and discharge the func­\ntions, duties, and authority conferred\nupon the Puerto Rico Reconstruction Ad­\nministration and the Administrator by\nExecutive Orders No. 7057 of May 28,\n1935; No. 7180 of September 6, 1935, as\namended by No. 7554 of February 17,\n1937; and No. 7689 of August 12,1937.*\nThe said Executive Orders are amend­\ned accordingly.","sections_touched":["partial"],"signing_date":"1939-11-30","source":{"filing_date":null,"location_confidence":"high","location_verified":false,"page_or_item":"4 FR 4763, PDF pages 3-3","requires_page_check":false,"sha256":"88db380459f9b4ebf3d38e9eb67cfccebeda431794e04bdc2facd9920d28735b","signing_date":"1939-11-30","text_path":"jobs/fr-originals/data/full_run/texts/EO_8294.recheck.txt","text_sha256":"66947202b304cd845cb4404653e3dd21d0efa29ebd64e69cf48e6300d65ce83d","url":"https://www.govinfo.gov/content/pkg/FR-1939-12-05/pdf/FR-1939-12-05.pdf"},"verb":"amend"},{"actor_id":"EO:8888","char_end":1865,"char_start":843,"confidence":"medium","how_named":"parent_as_amended","id":"CHAIN:EO:7493#6","notes":"Change wording lead; chronology does not decide legal effect.","provision_text":"By virtue of the authority vested in \nme under the Emergency Relief Appro­\npriation Act of 1935 (49 Stat. 115, 118) \nand the act entitled “An Act to provide \nthat funds allocated to Puerto Rico un­\nder the Emergency Relief Appropriation \nAct of 1935 may be expended for perma­\nnent rehabilitation, and for other pur­\nposes”, approved February 11, 1936 (49 \nStat. 1133), I hereby appoint Guy J. \nSwope, Director, Division of Territories \nand Island Possessions, Department of \nthe Interior, as Administrator of the \nPuerto Rico Reconstruction Administra­\ntion, vice Admiral William D. Leahy, re­\nsigned, to serve without additional com­\npensation, and to exercise and discharge \nthe functions, duties, and authority con­\nferred upon the Puerto Rico Reconstruc­\ntion Administration and the Administra­\ntor by Executive Orders No. 7057 of May \n28, 1935, No. 7180 of September 6, 1935, \nas amended by No. 7554 of February 17, \n1937, and No. 76891  of August 12, 1937.\nThe said Executive orders are hereby \namended accordingly.","sections_touched":["partial"],"signing_date":"1941-09-03","source":{"filing_date":null,"location_confidence":"high","location_verified":false,"page_or_item":"6 FR 4601, PDF pages 1-1","requires_page_check":false,"sha256":"7507364fc64cd0b3862cbc05a3677e271e1b0e2b9c3af40a2e35ed06621cf485","signing_date":"1941-09-03","text_path":"jobs/fr-originals/data/full_run/texts/EO_8888.txt","text_sha256":"aa75d151177596489e35deb845e88ac4bf61f271afc845d10b7179f4ef7cda59","url":"https://www.govinfo.gov/content/pkg/FR-1941-09-06/pdf/FR-1941-09-06.pdf"},"verb":"amend"},{"actor_id":"EO:9278","char_end":4269,"char_start":3260,"confidence":"medium","how_named":"parent_as_amended","id":"CHAIN:EO:7493#7","notes":"Change wording lead; chronology does not decide legal effect.","provision_text":"By virtue of the authority vested in me \nunder the Emergency Relief Appropria­\ntion Act of 1935 (49 Stat. 115, 118) and \nthe act entitled “An Act to provide that \nfunds allocated to Puerto Rico under \nthé Emergency Relief Appropriation Act \nof 1935 may be expended for permanent \nrehabilitation, and for other purposes”, \napproved February 11, 1936 (49 Stat. \n1135); I  hereby appoint Benjamin W. \nThoron, Director, Division of Territories \nand Island Possessions, Department of \nthe Interior, as Administrator of the \nPuerto Rico Reconstruction Administra­\ntion, vice Guy J . Swope, resigned, to \nserve without additional compensation, \nand to exercise and discharge the func­\ntions, duties, and authority conferred \nupon the Puerto Rico Reconstruction \nAdministration and the Administrator \nby Executive Orders No. 7057 of May 28, \n1935, No. 7180 of September 6, 1935, as \namended by No. 7554 of February 17, \n1937, and No. 7689 of August 12, 1937.\nThe said Executive orders are hereby \namended accordingly.","sections_touched":["partial"],"signing_date":"1942-12-04","source":{"filing_date":null,"location_confidence":"high","location_verified":false,"page_or_item":"7 FR 10181, PDF pages 5-5","requires_page_check":false,"sha256":"ad32835ba61fea3499997a231bb7954ac0b253fbb574c4c2bb2d19c3cd5e79d0","signing_date":"1942-12-04","text_path":"jobs/fr-originals/data/full_run/texts/EO_9278.txt","text_sha256":"b5f5af4feea15a9b0e59b252961b6314d722e3b4ceaeb53db90ee9bf1d6b0f68","url":"https://www.govinfo.gov/content/pkg/FR-1942-12-08/pdf/FR-1942-12-08.pdf"},"verb":"amend"},{"actor_id":"EO:9288","char_end":2425,"char_start":1417,"confidence":"medium","how_named":"parent_as_amended","id":"CHAIN:EO:7493#8","notes":"Change wording lead; chronology does not decide legal effect.","provision_text":"EXECUTIVE ORDER 9 288\nT ransferring the Control and Jurisdic­\ntion  O ver C ertain T racts* of L and \nFrom the Secretary of the Interior to \nthe Secretary of A griculture for Ad­\nministrative  Purposes\nPUERTO RICO\nBy virtue of the authority vested in \nme by the Emergency Relief Appropria­\ntion Act of 1935, approved April 8, 1935 \n(49 Stat. 115), and as President of the \nUnited States, it is hereby ordered that \nthe following-described tracts of land \nin Puerto Rico, acquired under authority \nof that act and Executive Order No. 7057 \nof May 28, 1935, as amended, which \ntracts are not primarily suitable for cul­\ntivation, be, and they are hereby, sub­\nject to valid existing rights, transferred \nfrom the control and jurisdiction of the \nSecretary of the Interior to the control \nand jurisdiction of the Secretary of Ag­\nriculture to be administered for forest \npurposes in accordance with the pro­\nvisions of Title H I of the Bankhead- \nJones Farm Tenant Act approved July \n22, 1937 (50 stat. 522):\n1.","sections_touched":["whole_via_parent"],"signing_date":"1942-12-24","source":{"filing_date":null,"location_confidence":"high","location_verified":false,"page_or_item":"7 FR 10900, PDF pages 4-6","requires_page_check":false,"sha256":"556b4a0f6fdd4dc0b157f00e99e5d2dad8fc5a5d86b6b6bac23f7ac525ed05ed","signing_date":"1942-12-24","text_path":"jobs/fr-originals/data/full_run/texts/EO_9288.txt","text_sha256":"bb9d42756962b3d187e6b06a8d7cae0df1adf83fdac8600376f788d7e13681d9","url":"https://www.govinfo.gov/content/pkg/FR-1942-12-29/pdf/FR-1942-12-29.pdf"},"verb":"transfer"},{"actor_id":"EO:9618","char_end":4851,"char_start":3829,"confidence":"medium","how_named":"parent_as_amended","id":"CHAIN:EO:7493#9","notes":"Change wording lead; chronology does not decide legal effect.","provision_text":"By virtue of the authority vested in me \nunder the Ehiergency Relief Appropria­\ntion Act of 1935 (49 Stat. 115, 118) and \nthe act entitled “An Act to provide that \nfunds allocated to Puerto Rico under the \nEmergency Relief Appropriation Act of \n1935 may be expended for permanent re­\nhabilitation, and for other purposes”, \napproved February 11, 1936 (49 Stat. \n1135), I  hereby appoint Edwin G. Ar­\nnold, Director, Division of Territories \nand Island Possessions, Department of \nthe Interior, as Administrator of the \nPuerto Rico Reconstruction Administra­\ntion, vice Benjamin W. Thoron, resigned, \nto serve without additional compensa­\ntion, and to exercise and discharge the \nfunctions, duties, and authority con­\nferred upon the Puerto Rico Reconstruc­\ntion Administration and the Administra­\ntor by Executive Orders No. 7057 of May \n28, 1935, No. 7180 of September 6, 1935, \nas amended by No. *7 5 5 4  of February 17, \n1937, and No. 7689 of August 12, 1937.\nThe said Executive orders are hereby \namended accordingly.","sections_touched":["partial"],"signing_date":"1945-09-19","source":{"filing_date":null,"location_confidence":"high","location_verified":false,"page_or_item":"10 FR 11931, PDF pages 3-3","requires_page_check":false,"sha256":"a8285d80cbcf9800c0e50bf767140936a3c998b6d10c83fa99502e0d5f78cf94","signing_date":"1945-09-19","text_path":"jobs/fr-originals/data/full_run/texts/EO_9618.txt","text_sha256":"5e97c141fd628ccfa61218ef2664a1d1ee8591996b92b693a532402fdc956ff3","url":"https://www.govinfo.gov/content/pkg/FR-1945-09-20/pdf/FR-1945-09-20.pdf"},"verb":"amend"},{"actor_id":"EO:9901","char_end":1874,"char_start":863,"confidence":"medium","how_named":"parent_as_amended","id":"CHAIN:EO:7493#10","notes":"Change wording lead; chronology does not decide legal effect.","provision_text":"By virtue of the authority vested in me \nunder the Emergency Relief Appropria­\ntion Act of 1935 (49 Stat. 115, 118), and \nthe act entitled “An Act to provide that \nfunds allocated to Puerto Rico under the \nEmergency Relief Appropriation Act of \n1935 may be expended for permanent re­\nhabilitation, and for other purposes”, \napproved February 11, 1936 (49 Stat. \n1135), I  hereby appoint James P. Davis, \nDirector, Division of Territories and Is­\nland Possessions, Department of the In­\nterior, as Administrator of the Puerto \nRico Reconstruction Administration, \nvice Edwin G. Arnold, resigned, to serve \nwithout additional compensation, and to \nexercise and discharge the functions, \nduties, and authority conferred upon the \nPuerto Rico Reconstruction jAdministra- \ntion and the Administrator by Executive \nOrders No. 7057 of May 28, 1935, No. \n7180 of September 6,1935, as amended by \nNo. 7554 of February 17, 1937, and No. \n7689 of August 12, 1937.\nThe said Executive orders are hereby \namended accordingly.","sections_touched":["partial"],"signing_date":"1947-10-25","source":{"filing_date":null,"location_confidence":"high","location_verified":false,"page_or_item":"12 FR 6965, PDF pages 1-1","requires_page_check":false,"sha256":"f5d872a4109145ae33f443be0733a61f822d01a81718c9b67e96fa7d3efa508d","signing_date":"1947-10-25","text_path":"jobs/fr-originals/data/full_run/texts/EO_9901.txt","text_sha256":"6e0498ce2761773311ce24d378d418ce35028243b58c4c556b0efc88bb7fdaff","url":"https://www.govinfo.gov/content/pkg/FR-1947-10-28/pdf/FR-1947-10-28.pdf"},"verb":"amend"},{"actor_id":"EO:10018","char_end":861,"char_start":0,"confidence":"medium","how_named":"parent_as_amended","id":"CHAIN:EO:7493#11","notes":"Change wording lead; chronology does not decide legal effect.","provision_text":"By virtue of the authority vested in me by the Emergency Relief Appropriation Act of 1935, approved April 8, 1935 (49 Stat. 115), and section 32 of the Bankhead-Jones Farm Tenant Act, approved July 22, 1937 (50 Stat. 525), and as President of the United States, it is ordered that the following-described tracts of land in Puerto Rico, acquired under authority of the said Emergency Relief Appropriation Act of 1935 and Executive Order No. 7057 of May 28, 1935, as amended, which tracts are not primarily suitable for cultivation, be, and they are hereby, subject to valid existing rights transferred from the control and jurisdiction of the Secretary of the Interior to the control and jurisdiction of the Secretary of Agriculture to be administered for forest purposes in accordance with the provisions of Title III of the said Bankhead-Jones Farm Tenant Act:","sections_touched":["section 32"],"signing_date":"1948-11-15","source":{"acceptable_as_original":false,"archival_id":"app:node/278267","filing_date":null,"grade":"mirror_transcription","instrument_id":"EO:10018","location_confidence":"medium","location_verified":false,"page_or_item":"Executive Order 10018—Transferring the Control and Jurisdiction 