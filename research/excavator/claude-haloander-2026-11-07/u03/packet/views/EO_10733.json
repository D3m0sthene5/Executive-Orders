      "source": {
        "filing_date": null,
        "location_confidence": "high",
        "location_verified": false,
        "page_or_item": "22 FR 8135, PDF pages 3-3",
        "requires_page_check": false,
        "sha256": "a8128fa2dba99d70bec11d50a0bc3c2320769d40e1356b998026d99ff68cdadc",
        "signing_date": "1957-10-10",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_10733.txt",
        "text_sha256": "68be9b52203b8e4c8175444918e7de5dcd39403272655c9ccf2be0b7d3a5da4a",
        "url": "https://www.govinfo.gov/content/pkg/FR-1957-10-15/pdf/FR-1957-10-15.pdf"
      },
      "text": "(2) by amending paragraph (b) of the \nsaid section to read as follows: “ (b) Ten \nother members to be appointed by the \nPresident. The Chairman and Vice \nChairman, and an Executive Vice Chair­\nman who shall assist the Chairman and \nVice Chairman in the carrying out of the \nfunctions of the Committee, shall be des­\nignated by the President.”"
    }
