    publisher:
      name: Harvard Dataverse
  - type: article
    authors:
      - family-names: Thrower
        given-names: Sharece
    title: "To Revoke or Not Revoke? The Political Determinants of Executive Order Longevity"
    journal: "American Journal of Political Science"
    volume: 61
