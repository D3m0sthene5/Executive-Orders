                            <div class="hsg-list-group"><a href="terms#t_GOI_1" tabindex="0" class="list-group-item" data-toggle="tooltip" title="Government of India; Government of Iran">GOI</a><a href="terms#t_MEA_1" tabindex="0" class="list-group-item" data-toggle="tooltip" title="Ministry of External Affairs">MEA</a><a href="terms#t_NRC_1" tabindex="0" class="list-group-item" data-toggle="tooltip" title="Nuclear Regulatory Commission">NRC</a><a href="terms#t_PM_1" tabindex="0" class="list-group-item" data-toggle="tooltip" title="Prime Minister">PM</a><a href="terms#t_RG_1" tabindex="0" class="list-group-item" data-toggle="tooltip" title="Record Group">RG</a><a href="terms#t_USG_1" tabindex="0" class="list-group-item" data-toggle="tooltip" title="United States Government">USG</a></div>
