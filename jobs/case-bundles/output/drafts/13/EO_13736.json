a798e7306d95a0b0a689c815fa24f96","url":"https://www.govinfo.gov/content/pkg/FR-2016-08-17/pdf/2016-19724.pdf"},"scope_id":"EO:13736#sec2(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) No individual who is serving in an office listed in section 1(a)– \n(j) of this order shall act as Secretary unless that individual is otherwise \neligible to so serve under the Act.","original_source":{"page_or_item":"81 FR 54711, PDF pages 1-2; Sec. 2(b)","sha256":"1596d7ac476cb07722706d7db8ae0b838a798e7306d95a0b0a689c815fa24f96","url":"https://www.govinfo.gov/content/pkg/FR-2016-08-17/pdf/2016-19724.pdf"},"scope_id":"EO:13736#sec2(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) Notwithstanding the provisions of this order, the President retains \ndiscretion, to the extent permitted by law, to depart from this order in \ndesignating an acting Secretary.","original_source":{"page_or_item":"81 FR 54711, PDF pages 1-2; Sec. 2(c)","sha256":"1596d7ac476cb07722706d7db8ae0b838a798e7306d95a0b0a689c815fa24f96","url":"https://www.govinfo.gov/content/pkg/FR-2016-08-17/pdf/2016-19724.pdf"},"scope_id":"EO:13736#sec2(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) Executive Order 13247 of December 18, 2001, is \nhereby revoked;","original_source":{"page_or_item":"81 FR 54711, PDF pages 1-2; Sec. 3(a)","sha256":"1596d7ac476cb07722706d7db8ae0b838a798e7306d95a0b0a689c815fa24f96","url":"https://www.govinfo.gov/content/pkg/FR-2016-08-17/pdf/2016-19724.pdf"},"scope_id":"EO:13736#sec3(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) Section 4(g) of Executive Order 13261 of March 19, 2002, is hereby \nrevoked;","original_source":{"page_or_item":"81 FR 54711, PDF pages 1-2; Sec. 3(b)","sha256":"1596d7ac476cb07722706d7db8ae0