=6&per_page=1000&search_after_cursor=WzEyNDk3LjAsIjEyNDk3Il0"}},"suggested":true}],"whole_order_end_total":1},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"confirm","counterevidence":"confirm","ending_or_current_basis":"confirm","opus_media":"n/a","original_text":"done_now_by_custody","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":[],"would_satisfy_once_confirmed":["clause_inventory","ending_or_current_basis","counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"2002-12-11","later-events_catalog":"2002-12-11","research/stage21/original_sources/CASE_ORIGINAL_SOURCE_CUSTODY.csv":"2002-12-11","stage19_causal_queue":"2002-12-11","stage21_crosswalk":"2002-12-11"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:13278","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Section 1. Establishment. There is established the President’s Commission\non the United States Postal Service (Commission).","original_source":{"page_or_item":"67 FR 76671 (PDF p. 1); Sec. 1","sha256":"c91bcb395ea57e5e93d992a8226fe974839cf1951250e12c1432f947e721f307","url":"https://www.govinfo.gov/content/pkg/FR-2002-12-13/pdf/02-31624.pdf"},"scope_id":"EO:13278#sec1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 2. Membership. Commission shall be composed of nine members ap-\npointed by the President. The President shall designate two members of\nthe Commission to serve as Co-Chairs.","original_source":{"page_or_item":"67 FR 76671 (PDF p. 1); Sec. 2","sha256":"c91bcb395ea57e5e93d992a8226fe974839cf1951250e12c1432f947e721f307","url":"https://www.govinfo.gov/content/pkg/FR-2002-12-13/pdf/02-31624.pdf"},"scope_id":"EO:13278#sec2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The mission of the Commission shall be to examine\nthe state of the United States Postal Service, and to prepare and submit\nto the President a report articulating a proposed vision for the future of\nthe United States Postal Service and recommending the legislative and admin-\nistrative reforms needed to ensure the viability of postal services.","original_source":{"page_or_item":"67 FR 76671 (PDF p. 1); Sec. 3(a)","sha256":"c91bcb395ea57e5e93d992a8226fe974839cf1951250e12c1432f947e721f307","url":"https://www.govinfo.gov/content/pkg/FR-2002-12-13/pdf/02-31624.pdf"},"scope_id":"EO:13278#sec3(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) In fulfilling its mission, the Commission shall consider the following\nissues and such other issues relating to the Postal Service as the Commission\ndetermines appropriate:\n(i) the role of the Postal Service in the 21st century and beyond;\n(ii) the flexibility that the Postal Service should have to change prices,\ncontrol costs, and adjust service in response to financial, competitive,\nor market pressures;\n(iii) the rigidities in cost or service that limit the efficiency of the\npostal system;\n(iv) the ability of the Postal Service, over the long term, to maintain\nuniversal mail delivery at affordable rates and cover its unfunded liabilities\nwith minimum exposure to the American taxpayers;\n(v) the extent to which postal monopoly restrictions continue to advance\nthe public interest under evolving market conditions, and the extent to\nwhich the Postal Service competes with private sector services; and\n(vi) the most appropriate governance and oversight structure for the\nPostal Service.","original_source":{"page_or_item":"67 FR 76671 (PDF p. 1); Sec. 3(b)","sha256":"c91bcb395ea57e5e93d992a8226fe974839cf1951250e12c1432f947e721f307","url":"https://www.govinfo.gov/content/pkg/FR-2002-12-13/pdf/02-31624.pdf"},"scope_id":"EO:13278#sec3(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The Department of the Treasury or any organiza-\ntional entity subject to the direction of the Secretary of the Treasury shall,\nto the extent permitted by law, provide administrative support and funding\nfor the Commission. The Commission is established within the Department\nof the Treasury for administrative purposes only.","original_source":{"page_or_item":"67 FR 76671 (PDF p. 1); Sec. 4(a)","sha256":"c91bcb395ea57e5e93d992a8226fe974839cf1951250e12c1432f947e721f307","url":"https://www.govinfo.gov/content/pkg/FR-2002-12-13/pdf/02-31624.pdf"},"scope_id":"EO:13278#sec4(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) Members of the Commission shall serve without any compensation\nfor their work on the Commission. Members appointed from among private\ncitizens of the United States, however, while engaged in the work of the\nCommission, may be allowed travel expenses, including per diem in lieu\nof subsistence, as authorized by law for persons serving intermittently in\nGovernment service (5 U.S.C. 5701–5707), to the extent funds are available.","original_source":{"page_or_item":"67 FR 76671 (PDF p. 1); Sec. 4(b)","sha256":"c91bcb395ea57e5e93d992a8226fe974839cf1951250e12c1432f947e721f307","url":"https://www.govinfo.gov/content/pkg/FR-2002-12-13/pdf/02-31624.pdf"},"scope_id":"EO:13278#sec4(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) The Commission shall have a staff headed by an Executive Director.","original_source":{"page_or_item":"67 FR 76671 (PDF p. 1); Sec. 4(c)","sha256":"c91bcb395ea57e5e93d992a8226fe974839cf1951250e12c1432f947e721f307","url":"https://www.govinfo.gov/content/pkg/FR-2002-12-13/pdf/02-31624.pdf"},"scope_id":"EO:13278#sec4(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) The Commission, with the concurrence of the Secretary of the Treasury,\nmay establish subcommittees, consisting of Commission members, as appro-\npriate, to aid in its work.","original_source":{"page_or_item":"67 FR 76671 (PDF p. 1); Sec. 4(d)","sha256":"c91bcb395ea57e5e93d992a8226fe974839cf1951250e12c1432f947e721f307","url":"https://www.govinfo.gov/content/pkg/FR-2002-12-13/pdf/02-31624.pdf"},"scope_id":"EO:13278#sec4(d)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(e) Consistent with such guidance as the President or, on the President ’s\nbehalf, the Secretary of the Treasury, may provide, the Commission shall\nexchange information with and obtain advice from Members of Congress;\nFederal, State, local, and tribal officials; commercial, nonprofit, and residen-\ntial users of the United States Postal Service; and others, as appropriate,\nincluding through public hearings.","original_source":{"page_or_item":"67 FR 76672 (PDF p. 2); Sec. 4(e)","sha256":"c91bcb395ea57e5e93d992a8226fe974839cf1951250e12c1432f947e721f307","url":"https://www.govinfo.gov/content/pkg/FR-2002-12-13/pdf/02-31624.pdf"},"scope_id":"EO:13278#sec4(e)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(f) Insofar as the Federal Advisory Committee Act, as amended, may\napply to the Commission, any functions of the President under that Act,\nexcept for those in section 6 of that Act, shall be performed by the Secretary\nof the Treasury, in accordance with the guidelines that have been issued\nby the Administrator of General Services.","original_source":{"page_or_item":"67 FR 76672 (PDF p. 2); Sec. 4(f)","sha256":"c91bcb395ea57e5e93d992a8226fe974839cf1951250e12c1432f947e721f307","url":"https://www.govinfo.gov/content/pkg/FR-2002-12-13/pdf/02-31624.pdf"},"scope_id":"EO:13278#sec4(f)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(g) Nothing in this order shall be construed to impair or otherwise affect\nthe functions of the Director of the Office of Management and Budget relating\nto budget, administrative, or legislative proposals.","original_source":{"page_or_item":"67 FR 76672 (PDF p. 2); Sec. 4(g)","sha256":"c91bcb395ea57e5e93d992a8226fe974839cf1951250e12c1432f947e721f307","url":"https://www.govinfo.gov/content/pkg/FR-2002-12-13/pdf/02-31624.pdf"},"scope_id":"EO:13278#sec4(g)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 5. Report. The Commission shall submit its report, consistent with\nits mission set forth in section 3 of this order, to the President, through\nthe Secretary of the Treasury, not later than July 31, 2003.","original_source":{"page_or_item":"67 FR 76672 (PDF p. 2); Sec. 5","sha256":"c91bcb395ea57e5e93d992a8226fe974839cf1951250e12c1432f947e721f307","url":"https://www.govinfo.gov/content/pkg/FR-2002-12-13/pdf/02-31624.pdf"},"scope_id":"EO:13278#sec5","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) This order is intended only to improve the\ninternal management of the Federal Government and it is not intended\nto, and does not create, any right or benefit, substantive or procedural,\nenforceable at law or in equity by a party against the United States, its\ndepartments, agencies, instrumentalities or entities, its officers or employees,\nor any other person.","original_source":{"page_or_item":"67 FR 76672 (PDF p. 2); Sec. 6(a)","sha256":"c91bcb395ea57e5e93d992a8226fe974839cf1951250e12c1432f947e721f307","url":"https://www.govinfo.gov/content/pkg/FR-2002-12-13/pdf/02-31624.pdf"},"scope_id":"EO:13278#sec6(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The Commission shall terminate 30 days after submitting its report\nand in no event later than August 30, 2003.\nW","original_source":{"page_or_item":"67 FR 76672 (PDF p. 2); Sec. 6(b)","sha256":"c91bcb395ea57e5e93d992a8226fe974839cf1951250e12c1432f947e721f307","url":"https://www.govinfo.gov/content/pkg/FR-2002-12-13/pdf/02-31624.pdf"},"scope_id":"EO:13278#sec6(b)","state_at_cutoff":null}],"original_representation":{"page_or_item":"whole per-document Federal Register PDF (67 FR 76671)","sha256":"c91bcb395ea57e5e93d992a8226fe974839cf1951250e12c1432f947e721f307","url":"https://www.govinfo.gov/content/pkg/FR-2002-12-13/pdf/02-31624.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 14 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:13278"}
