status":"no","readiness":{"by_step":{"clause_inventory":"confirm","counterevidence":"confirm","ending_or_current_basis":"confirm","opus_media":"n/a","original_text":"done_now_by_custody","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":[],"would_satisfy_once_confirmed":["clause_inventory","ending_or_current_basis","counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"2002-04-29","later-events_catalog":"2002-04-29","research/stage21/original_sources/CASE_ORIGINAL_SOURCE_CUSTODY.csv":"2002-04-29","stage19_causal_queue":"2002-04-29","stage21_crosswalk":"2002-04-29"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:13263","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Section 1. Establishment. There is hereby established the President’s New\nFreedom Commission on Mental Health (Commission).","original_source":{"page_or_item":"67 FR 22337 (PDF p. 1); Sec. 1","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The Commission’s membership shall be composed\nof:\n(i) Not more than fifteen members appointed by the President, including\nproviders, payers, administrators, and consumers of mental health services\nand family members of consumers; and\n(ii) Not more than seven ex officio members, four of whom shall be\ndesignated by the Secretary of Health and Human Services, and the remain-\ning three of whom shall be designated—one each—by the Secretaries\nof the Departments of Labor, Education, and Veterans Affairs.","original_source":{"page_or_item":"67 FR 22337 (PDF p. 1); Sec. 2(a)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec2(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The President shall designate a Chair from among the fifteen members\nof the Commission appointed by the President.","original_source":{"page_or_item":"67 FR 22337 (PDF p. 1); Sec. 2(b)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec2(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 3. Mission. The mission of the Commission shall be to conduct a\ncomprehensive study of the United States mental health service delivery\nsystem, including public and private sector providers, and to advise the\nPresident on methods of improving the system. The Commission’s goal\nshall be to recommend improvements to enable adults with serious mental\nillness and children with serious emotional disturbances to live, work, learn,\nand participate fully in their communities. In carrying out its mission,\nthe Commission shall, at a minimum:","original_source":{"page_or_item":"67 FR 22337 (PDF p. 1); Sec. 3 (lead-in)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec3","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) Review the current quality and effectiveness of public and private\nproviders and Federal, State, and local government involvement in the deliv-\nery of services to individuals with serious mental illnesses and children\nwith serious emotional disturbances, and identify unmet needs and barriers\nto services.","original_source":{"page_or_item":"67 FR 22337 (PDF p. 1); Sec. 3(a)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec3(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) Identify innovative mental health treatments, services, and technologies\nthat are demonstrably effective and can be widely replicated in different\nsettings.","original_source":{"page_or_item":"67 FR 22337 (PDF p. 1); Sec. 3(b)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec3(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) Formulate policy options that could be implemented by public and\nprivate providers, and Federal, State, and local governments to integrate\nthe use of effective treatments and services, improve coordination among\nservice providers, and improve community integration for adults with serious\nmental illnesses and children with serious emotional disturbances.","original_source":{"page_or_item":"67 FR 22337 (PDF p. 1); Sec. 3(c)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec3(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 4. Principles. In conducting its mission, the Commission shall adhere\nto the following principles:","original_source":{"page_or_item":"67 FR 22337 (PDF p. 1); Sec. 4 (lead-in)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec4","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The Commission shall focus on the desired outcomes of mental health\ncare, which are to attain each individual’s maximum level of employment,\nself-care, interpersonal relationships, and community participation;","original_source":{"page_or_item":"67 FR 22337 (PDF p. 1); Sec. 4(a)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec4(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The Commission shall focus on community-level models of care that\nefficiently coordinate the multiple health and human service providers and\npublic and private payers involved in mental health treatment and delivery\nof services;","original_source":{"page_or_item":"67 FR 22337 (PDF p. 1); Sec. 4(b)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec4(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) The Commission shall focus on those policies that maximize the utility\nof existing resources by increasing cost effectiveness and reducing unneces-\nsary and burdensome regulatory barriers;","original_source":{"page_or_item":"67 FR 22338 (PDF p. 2); Sec. 4(c)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec4(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) The Commission shall consider how mental health research findings\ncan be used most effectively to influence the delivery of services; and","original_source":{"page_or_item":"67 FR 22338 (PDF p. 2); Sec. 4(d)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec4(d)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(e) The Commission shall follow the principles of Federalism, and ensure\nthat its recommendations promote innovation, flexibility, and accountability\nat all levels of government and respect the constitutional role of the States\nand Indian tribes.","original_source":{"page_or_item":"67 FR 22338 (PDF p. 2); Sec. 4(e)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec4(e)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The Department of Health and Human Services,\nto the extent permitted by law, shall provide funding and administrative\nsupport for the Commission.","original_source":{"page_or_item":"67 FR 22338 (PDF p. 2); Sec. 5(a)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec5(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) To the extent funds are available and as authorized by law for persons\nserving intermittently in Government service (5 U.S.C. 5701 –5707), members\nof the Commission appointed from among private citizens of the United\nStates may be allowed travel expenses while engaged in the work of the\nCommission, including per diem in lieu of subsistence. All members of\nthe Commission who are officers or employees of the United States shall\nserve without compensation in addition to that received for their services\nas officers or employees of the United States.","original_source":{"page_or_item":"67 FR 22338 (PDF p. 2); Sec. 5(b)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec5(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) The Commission shall have a staff headed by an Executive Director,\nwho shall be selected by the President. To the extent permitted by law,\noffice space, analytical support, and additional staff support for the Commis-\nsion shall be provided by executive branch departments and agencies.","original_source":{"page_or_item":"67 FR 22338 (PDF p. 2); Sec. 5(c)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec5(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) Insofar as the Federal Advisory Committee Act, as amended, may\napply to the Commission, any functions of the President under that Act,\nexcept for those in section 6 of that Act, shall be performed by the Department\nof Health and Human Services, in accordance with the guidelines that have\nbeen issued by the Administrator of General Services.","original_source":{"page_or_item":"67 FR 22338 (PDF p. 2); Sec. 5(d)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec5(d)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 6. Reports. The Commission shall submit reports to the President as\nfollows:","original_source":{"page_or_item":"67 FR 22338 (PDF p. 2); Sec. 6 (lead-in)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec6","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) Interim Report. Within 6 months from the date of this order, an\ninterim report shall describe the extent of unmet needs and barriers to\ncare within the mental health system and provide examples of community-\nbased care models with success in coordination of services and providing\ndesired outcomes.","original_source":{"page_or_item":"67 FR 22338 (PDF p. 2); Sec. 6(a)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec6(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) Final Report. The final report will set forth the Commission ’s rec-\nommendations, in accordance with its mission as stated in section 3 of\nthis order. The submission date shall be determined by the Chair in consulta-\ntion with the President.","original_source":{"page_or_item":"67 FR 22338 (PDF p. 2); Sec. 6(b)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec6(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 7. Termination. The Commission shall terminate 1 year from the date\nof this order, unless extended by the President prior to that date.\nW","original_source":{"page_or_item":"67 FR 22338 (PDF p. 2); Sec. 7","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"scope_id":"EO:13263#sec7","state_at_cutoff":null}],"original_representation":{"page_or_item":"whole per-document Federal Register PDF (67 FR 22337)","sha256":"50f6496f6b3e4206cb8d28ea919288d05fe15bf927385cb9136af9f40c8a93c5","url":"https://www.govinfo.gov/content/pkg/FR-2002-05-03/pdf/02-11166.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 21 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:13263"}
