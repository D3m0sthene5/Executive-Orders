"LE-23edd3642773","LE-f503db24e978"],"quote":"Revoked by: EO 13304, May 28, 2003","quote_kind":"verbatim_note_item","quote_truncated":false,"status":"CANDIDATE_UNVERIFIED"},"proposal":{"actor":"EO:13304","date":"2003-05-28","mechanism":"revocation","source":{"page_or_item":"OFR API record executive_order_number=13088; citation 63 FR 32109; document_number 98-15888; field disposition_notes","sha256":"8ba9e1cce593bb06b6be625b585b15bb04a1555ed34ad8c5b6f8c9bd81f83f77","url":"https://www.federalregister.gov/api/v1/documents?conditions%5Bcorrection%5D=0&conditions%5Bpresidential_document_type%5D=executive_order&conditions%5Btype%5D%5B%5D=PRESDOCU&fields%5B%5D=citation&fields%5B%5D=disposition_notes&fields%5B%5D=document_number&fields%5B%5D=executive_order_number&fields%5B%5D=html_url&fields%5B%5D=pdf_url&fields%5B%5D=president&fields%5B%5D=publication_date&fields%5B%5D=raw_text_url&fields%5B%5D=signing_date&fields%5B%5D=title&format=json&include_pre_1994_docs=true&order=executive_order_number&page=6&per_page=1000&search_after_cursor=WzEyNDk3LjAsIjEyNDk3Il0"}},"suggested":true}],"whole_order_end_total":1},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"confirm","counterevidence":"confirm","ending_or_current_basis":"confirm","opus_media":"n/a","original_text":"done_now_by_custody","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":[],"would_satisfy_once_confirmed":["clause_inventory","ending_or_current_basis","counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"1998-06-09","later-events_catalog":"1998-06-09","research/stage21/original_sources/CASE_ORIGINAL_SOURCE_CUSTODY.csv":"1998-06-09","stage19_causal_queue":"1998-06-09","stage21_crosswalk":"1998-06-09"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:13088","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"I, WILLIAM J. CLINTON, President of the United States of America, find\nthat the actions and policies of the Governments of the Federal Republic\nof Yugoslavia (Serbia and Montenegro) and the Republic of Serbia with\nrespect to Kosovo, by promoting ethnic conflict and human suffering, threaten\nto destabilize countries of the region and to disrupt progress in Bosnia\nand Herzegovina in implementing the Dayton peace agreement, and therefore\nconstitute an unusual and extraordinary threat to the national security and\nforeign policy of the United States, and hereby declare a national emergency\nto deal with that threat.\nI hereby order:","original_source":{"page_or_item":"63 FR 32109 (PDF p. 1); operative words before the numbered sections","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"scope_id":"EO:13088#preamble-op","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) Except to the extent provided in section 2 of this order,\nsection 203(b) of IEEPA (50 U.S.C. 1702(b)), and in regulations, orders,\ndirectives, or licenses that may hereafter be issued pursuant to this order,\nall property and interests in property of the Governments of the Federal\nRepublic of Yugoslavia (Serbia and Montenegro), the Republic of Serbia,\nand the Republic of Montenegro that are in the United States, that hereafter\ncome within the United States, or that are or hereafter come within the\npossession or control of United States persons, including their overseas\nbranches, are hereby blocked.","original_source":{"page_or_item":"63 FR 32109 (PDF p. 1); Sec. 1(a)","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"scope_id":"EO:13088#sec1(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The blocking of property and property interests in paragraph (a) of\nthis section includes the prohibition of financial transactions with, including\ntrade financing for, the Governments of the Federal Republic of Yugoslavia\n(Serbia and Montenegro), the Republic of Serbia, and the Republic of Mon-\ntenegro by United States persons.","original_source":{"page_or_item":"63 FR 32109 (PDF p. 1); Sec. 1(b)","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"scope_id":"EO:13088#sec1(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 2. Nothing in section 1 of this order shall prohibit financial trans-\nactions, including trade financing, by United States persons within the terri-\ntory of the Federal Republic of Yugoslavia (Serbia and Montenegro) if (a)\nconducted exclusively through the domestic banking system within the Fed-\neral Republic of Yugoslavia (Serbia and Montenegro) in local currency (di-\nnars), or (b) conducted using bank notes or barter.","original_source":{"page_or_item":"63 FR 32109 (PDF p. 1); Sec. 2","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"scope_id":"EO:13088#sec2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 3. Except as otherwise provided in regulations, orders, directives,\nor licenses that may hereafter be issued pursuant to this order, all new\ninvestment by United States persons in the territory of the Republic of\nSerbia, and the approval or other facilitation by United States persons of\nother persons’ new investment in the territory of the Republic of Serbia,\nare prohibited.","original_source":{"page_or_item":"63 FR 32109 (PDF p. 1); Sec. 3","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"scope_id":"EO:13088#sec3","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 4. Any transaction by a United States person that evades or avoids,\nor has the purpose of evading or avoiding, or attempts to violate, any\nof the prohibitions set forth in this order is prohibited.","original_source":{"page_or_item":"63 FR 32110 (PDF p. 2); Sec. 4","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"scope_id":"EO:13088#sec4","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 5. For the purposes of this order:","original_source":{"page_or_item":"63 FR 32110 (PDF p. 2); Sec. 5 (lead-in)","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"scope_id":"EO:13088#sec5","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The term ‘‘person’’ means an individual or entity;","original_source":{"page_or_item":"63 FR 32110 (PDF p. 2); Sec. 5(a)","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"scope_id":"EO:13088#sec5(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The term ‘‘entity’’ means a partnership, association, trust, joint venture,\ncorporation, or other organization;","original_source":{"page_or_item":"63 FR 32110 (PDF p. 2); Sec. 5(b)","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"scope_id":"EO:13088#sec5(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) The term ‘‘new investment’’ means (i) the acquisition of debt or equity\ninterests in, (ii) a commitment or contribution of funds or other assets\nto, or (iii) a loan or other extensionof credit to, a public or private undertak-\ning, entity, or project, including the Government of the Republic of Serbia,\nother than donations of funds for purely humanitarian purposes to charitable\norganizations;","original_source":{"page_or_item":"63 FR 32110 (PDF p. 2); Sec. 5(c)","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"scope_id":"EO:13088#sec5(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) The term ‘‘United States person’’ means any United States citizen,\npermanent resident alien, juridical person organized under the laws of the\nUnited States (including foreign branches), or any person in the United\nStates;","original_source":{"page_or_item":"63 FR 32110 (PDF p. 2); Sec. 5(d)","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"scope_id":"EO:13088#sec5(d)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(e) The term ‘‘Government of the Federal Republic of Yugoslavia (Serbia\nand Montenegro)’’ means the government of the Federal Republic of Yugo-\nslavia (Serbia and Montenegro), its agencies, instrumentalities, and controlled\nentities, including all financial institutions and state-owned and socially\nowned entities organized or located in the Federal Republic of Yugoslavia\n(Serbia and Montenegro) as of June 9, 1998, any successors to such entities,\nand their respective subsidiaries and branches, wherever located, and any\npersons acting or purporting to act for or on behalf of any of the foregoing;","original_source":{"page_or_item":"63 FR 32110 (PDF p. 2); Sec. 5(e)","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"scope_id":"EO:13088#sec5(e)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(f) The term ‘‘Government of the Republic of Serbia’’ means the government\nof the Republic of Serbia, including any subdivisions thereof or local govern-\nments therein, its agencies, instrumentalities, and controlled entities, includ-\ning all financial institutions and state-owned and socially owned entities\norganized or located in the Republic of Serbia as of June 9, 1998, any\nsuccessors to such entities, and their respective subsidiaries and branches,\nwherever located, and any persons acting or purporting to act for or on\nbehalf of any of the foregoing;","original_source":{"page_or_item":"63 FR 32110 (PDF p. 2); Sec. 5(f)","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"scope_id":"EO:13088#sec5(f)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(g) The term ‘‘Government of the Republic of Montenegro’’ means the\ngovernment of the Republic of Montenegro, including any subdivisions there-\nof or local governments therein, its agencies, instrumentalities, and controlled\nentities, including all financial institutions and state-owned and socially\nowned entities organized or located in the Republic of Montenegro as of\nJune 9, 1998, any successors to such entities, and their respective subsidiaries\nand branches, wherever located, and any persons acting or purporting to\nact for or on behalf of any of the foregoing.","original_source":{"page_or_item":"63 FR 32110 (PDF p. 2); Sec. 5(g)","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"scope_id":"EO:13088#sec5(g)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 6. The Secretary of the Treasury, in consultation with the Secretary\nof State, is hereby authorized to take such actions, including the promulgation\nof rules and regulations, and to employ all powers granted to me by the\nInternational Emergency Economic Powers Act, as may be necessary to carry\nout the purposes of this order. The Secretary of the Treasury may redelegate\nany of these functions to other officers and agencies of the United States\nGovernment, all agencies of which are hereby directed to take all appropriate\nmeasures within their authority to carry out the provisions of this order,\nincluding suspension or termination of licenses or other authorizations in\neffect as of the effective date of this order.","original_source":{"page_or_item":"63 FR 32110 (PDF p. 2); Sec. 6","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"scope_id":"EO:13088#sec6","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 7. The Secretary of the Treasury, in consultation with the Secretary\nof State, shall give special consideration to the circumstances of the Govern-\nment of the Republic of Montenegro and persons located in and organized\nunder the laws of the Republic of Montenegro in the implementation of\nthis order.","original_source":{"page_or_item":"63 FR 32110 (PDF p. 2); Sec. 7","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"scope_id":"EO:13088#sec7","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 8. Nothing contained in this order shall confer any substantive or\nprocedural right or privilege on any person or organization, enforceable\nagainst the United States, its agencies or its officers.","original_source":{"page_or_item":"63 FR 32111 (PDF p. 3); Sec. 8","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"scope_id":"EO:13088#sec8","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) This order is effective at 12:01 a.m. eastern daylight time\non June 10, 1998.","original_source":{"page_or_item":"63 FR 32111 (PDF p. 3); Sec. 9(a)","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"scope_id":"EO:13088#sec9(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) This order shall be transmitted to the Congress and published in\nthe Federal Register.","original_source":{"page_or_item":"63 FR 32111 (PDF p. 3); Sec. 9(b)","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"scope_id":"EO:13088#sec9(b)","state_at_cutoff":null}],"original_representation":{"page_or_item":"whole per-document Federal Register PDF (63 FR 32109)","sha256":"779e66e081dc848751db1ead137414e067eebb95f07265de66cf301cf4a4396a","url":"https://www.govinfo.gov/content/pkg/FR-1998-06-12/pdf/98-15888.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 19 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:13088"}
