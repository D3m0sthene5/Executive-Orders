kind":"verbatim_text_sentence","quote_truncated":false,"status":"CANDIDATE_UNVERIFIED"},"proposal":{"actor":"EO:13192","date_candidate":"2001-01-17","mechanism":"revocation","source":{"page_or_item":"66 FR 7379, PDF pages 1-7","sha256":"ee193455ff3e99b1e71ad31db73f92c600270500442510d6ec8ab2e8260935d8","url":"https://www.govinfo.gov/content/pkg/FR-2001-01-23/pdf/01-2138.pdf"}}},{"clause_hint_scope_ids":[],"custody_records_in":["later-events"],"meta":{"acting_instrument_id":"EO:13304","date_basis":["acting order signing_date from OFR catalog","date stated next to the acting instrument in the OFR note"],"evidence_types":["ofr_note_on_acting","ofr_note_on_target"],"from":"later-events@jobs/later-events/output","from_job":"later-events","ids":["LE-23edd3642773","LE-f503db24e978"],"quote":"Revoked by: EO 13304, May 28, 2003","quote_kind":"verbatim_note_item","quote_truncated":false,"status":"CANDIDATE_UNVERIFIED"},"proposal":{"actor":"EO:13304","date_candidate":"2003-05-28","mechanism":"revocation","source":{"page_or_item":"OFR API record executive_order_number=13088; citation 63 FR 32109; document_number 98-15888; field disposition_notes","sha256":"8ba9e1cce593bb06b6be625b585b15bb04a1555ed34ad8c5b6f8c9bd81f83f77","url":"https://www.federalregister.gov/api/v1/documents?conditions%5Bcorrection%5D=0&conditions%5Bpresidential_document_type%5D=executive_order&conditions%5Btype%5D%5B%5D=PRESDOCU&fields%5B%5D=citation&fields%5B%5D=disposition_notes&fields%5B%5D=document_number&fields%5B%5D=executive_order_number&fields%5B%5D=html_url&fields%5B%5D=pdf_url&fields%5B%5D=president&fields%5B%5D=publication_date&fields%5B%5D=raw_text_url&fields%5B%5D=signing_date&fields%5B%5D=title&format=json&include_pre_1994_docs=true&order=executive_order_number&page=6&per_page=1000&search_after_cursor=WzEyNDk3LjAsIjEyNDk3Il0"}}}],"later_events_total":7,"later_source_search_machine":[{"machine_hits_for_this_order":0,"search_id":"current-law:usc"},{"machine_hits_for_this_order":0,"search_id":"curre