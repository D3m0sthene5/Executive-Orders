l_text":"done_now_by_custody","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":["clause_inventory","ending_or_current_basis"],"would_satisfy_once_confirmed":["counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"2002-06-20","later-events_catalog":"2002-06-20","research/stage21/original_sources/CASE_ORIGINAL_SOURCE_CUSTODY.csv":"2002-06-20","stage19_causal_queue":"2002-06-20","stage21_crosswalk":"2002-06-20"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:13267","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Section 1. Establishment. I hereby establish within the Office of Management\nand Budget (OMB) a Transition Planning Office for the Department of Home-\nland Security (the ‘‘Transition Planning Office’’), to be headed by the Director\nof the Transition Planning Office for the Department of Homeland Security\n(the ‘‘Director for Transition Planning’’).","original_source":{"page_or_item":"67 FR 42469 (PDF p. 1); Sec. 1","sha256":"45b1d3acd40d700fe5bddfa402ba0e1fbde22d6bfa4aca5d1cd35594cdcac5a9","url":"https://www.govinfo.gov/content/pkg/FR-2002-06-24/pdf/02-16041.pdf"},"scope_id":"EO:13267#sec1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 2. Missions. The missions of the Transition Planning Office shall be\nto:","original_source":{"page_or_item":"67 FR 42469 (PDF p. 1); Sec. 2 (lead-in)","sha256":"45b1d3acd40d700fe5bddfa402ba0e1fbde22d6bfa4aca5d1cd35594cdcac5a9","url":"https://www.govinfo.gov/content/pkg/FR-2002-06-24/pdf/02-16041.pdf"},"scope_id":"EO:13267#sec2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) coordinate, guide, and conduct transition and related planning through-\nout the executive branch of the United States Government in preparation\nfor establishment of the proposed Department of Homeland Security; and","original_source":{"page_or_item":"67 FR 42469 (PDF p. 1); Sec. 2(a)","sha256":"45b1d3acd40d700fe5bddfa402ba0e1fbde22d6bfa4aca5d1cd35594cdcac5a9","url":"https://www.govinfo.gov/content/pkg/FR-2002-06-24/pdf/02-16041.pdf"},"scope_id":"EO:13267#sec2(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) consistent with Presidential guidance, work with the Congress as it\nconsiders legislation to establish that Department.","original_source":{"page_or_item":"67 FR 42469 (PDF p. 1); Sec. 2(b)","sha256":"45b1d3acd40d700fe5bddfa402ba0e1fbde22d6bfa4aca5d1cd35594cdcac5a9","url":"https://www.govinfo.gov/content/pkg/FR-2002-06-24/pdf/02-16041.pdf"},"scope_id":"EO:13267#sec2(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The Director of OMB shall ensure that the Transi-\ntion Planning Office receives appropriate personnel (including detailees and\nassignees, as appropriate), funding, and administrative support for the Office,\nsubject to the availability of appropriations. The Director of OMB is author-\nized to make expenditures under section 522 of title 31, United States\nCode, as may be appropriate to carry out this order.","original_source":{"page_or_item":"67 FR 42469 (PDF p. 1); Sec. 3(a)","sha256":"45b1d3acd40d700fe5bddfa402ba0e1fbde22d6bfa4aca5d1cd35594cdcac5a9","url":"https://www.govinfo.gov/content/pkg/FR-2002-06-24/pdf/02-16041.pdf"},"scope_id":"EO:13267#sec3(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) If an individual who is an Assistant to the President is appointed\nto serve simultaneously as Director for Transition Planning, the functioning,\npersonnel, funds, records, and property of the office of the Assistant to\nthe President and the office of the Director for Transition Planning shall\nbe kept separate in the same manner as if the two offices were headed\nby two different individuals.","original_source":{"page_or_item":"67 FR 42469 (PDF p. 1); Sec. 3(b)","sha256":"45b1d3acd40d700fe5bddfa402ba0e1fbde22d6bfa4aca5d1cd35594cdcac5a9","url":"https://www.govinfo.gov/content/pkg/FR-2002-06-24/pdf/02-16041.pdf"},"scope_id":"EO:13267#sec3(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 4. Other Departments and Agencies. This order does not alter the\nexisting authorities of United States Government departments and agencies.\nIn carrying out the missions set forth in section 2 of this order, all executive\ndepartments and agencies are directed to assist the Director for Transition\nPlanning and the Transition Planning Office to the extent permitted by\nlaw.","original_source":{"page_or_item":"67 FR 42469 (PDF p. 1); Sec. 4","sha256":"45b1d3acd40d700fe5bddfa402ba0e1fbde22d6bfa4aca5d1cd35594cdcac5a9","url":"https://www.govinfo.gov/content/pkg/FR-2002-06-24/pdf/02-16041.pdf"},"scope_id":"EO:13267#sec4","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 5. Termination. The Transition Planning Office, and all the authorities\nof this order, shall terminate within 90 days after the date on which legisla-\ntion creating the Department of Homeland Security is enacted, or within\n1 year of the date of this order, whichever occurs first.\nW","original_source":{"page_or_item":"67 FR 42470 (PDF p. 2); Sec. 5","sha256":"45b1d3acd40d700fe5bddfa402ba0e1fbde22d6bfa4aca5d1cd35594cdcac5a9","url":"https://www.govinfo.gov/content/pkg/FR-2002-06-24/pdf/02-16041.pdf"},"scope_id":"EO:13267#sec5","state_at_cutoff":null}],"original_representation":{"page_or_item":"whole per-document Federal Register PDF (67 FR 42469)","sha256":"45b1d3acd40d700fe5bddfa402ba0e1fbde22d6bfa4aca5d1cd35594cdcac5a9","url":"https://www.govinfo.gov/content/pkg/FR-2002-06-24/pdf/02-16041.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 8 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:13267"}
