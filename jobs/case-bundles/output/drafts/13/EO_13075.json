eadiness":{"by_step":{"clause_inventory":"confirm","counterevidence":"confirm","ending_or_current_basis":"confirm","opus_media":"n/a","original_text":"done_now_by_custody","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":[],"would_satisfy_once_confirmed":["clause_inventory","ending_or_current_basis","counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"1998-02-19","later-events_catalog":"1998-02-19","research/stage21/original_sources/CASE_ORIGINAL_SOURCE_CUSTODY.csv":"1998-02-19","stage19_causal_queue":"1998-02-19","stage21_crosswalk":"1998-02-19"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:13075","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) There is hereby established the Special Oversight\nBoard for Department of Defense Investigations of Gulf War Chemical and\nBiological Incidents (‘‘Special Oversight Board’’). The Special Oversight\nBoard shall be composed of not more than seven members appointed by\nthe President. The members of the Special Oversight Board shall have exper-\ntise relevant to the functions of the Special Oversight Board and shall\nnot be full-time officials or employees of the executive branch of the Federal\nGovernment.","original_source":{"page_or_item":"63 FR 9085 (PDF p. 1); Sec. 1(a)","sha256":"5137548d95240205c8af2b8cd59c8887c17798949a46b108366a849255f08874","url":"https://www.govinfo.gov/content/pkg/FR-1998-02-24/pdf/98-4816.pdf"},"scope_id":"EO:13075#sec1(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The President shall designate a Chairperson and a Vice Chairperson\nfrom among the members of the Special Oversight Board.","original_source":{"page_or_item":"63 FR 9085 (PDF p. 1); Sec. 1(b)","sha256":"5137548d95240205c8af2b8cd59c8887c17798949a46b108366a849255f08874","url":"https://www.govinfo.gov/content/pkg/FR-1998-02-24/pdf/98-4816.pdf"},"scope_id":"EO:13075#sec1(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The Special Oversight Board shall report to the Presi-\ndent through the Secretary of Defense.","original_source":{"page_or_item":"63 FR 9085 (PDF p. 1); Sec. 2(a)","sha256":"5137548d95240205c8af2b8cd59c8887c17798949a46b108366a849255f08874","url":"https://www.govinfo.gov/content/pkg/FR-1998-02-24/pdf/98-4816.pdf"},"scope_id":"EO:13075#sec2(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The Special Oversight Board shall provide advice and recommendations\nbased on its review of Department of Defense investigations into possible\ndetections of, and exposures to, chemical or biological weapons agents and\nenvironmental and other factors that may have contributed to Gulf War\nillnesses.","original_source":{"page_or_item":"63 FR 9085 (PDF p. 1); Sec. 2(b)","sha256":"5137548d95240205c8af2b8cd59c8887c17798949a46b108366a849255f08874","url":"https://www.govinfo.gov/content/pkg/FR-1998-02-24/pdf/98-4816.pdf"},"scope_id":"EO:13075#sec2(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) It shall not be a function of the Special Oversight Board to conduct\nscientific research.","original_source":{"page_or_item":"63 FR 9085 (PDF p. 1); Sec. 2(c)","sha256":"5137548d95240205c8af2b8cd59c8887c17798949a46b108366a849255f08874","url":"https://www.govinfo.gov/content/pkg/FR-1998-02-24/pdf/98-4816.pdf"},"scope_id":"EO:13075#sec2(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) It shall not be a function of the Special Oversight Board to provide\nadvice or recommendations on any legal liability of the Federal Government\nfor any claims or potential claims against the Federal Government.","original_source":{"page_or_item":"63 FR 9085 (PDF p. 1); Sec. 2(d)","sha256":"5137548d95240205c8af2b8cd59c8887c17798949a46b108366a849255f08874","url":"https://www.govinfo.gov/content/pkg/FR-1998-02-24/pdf/98-4816.pdf"},"scope_id":"EO:13075#sec2(d)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(e) The Special Oversight Board shall submit an interim report within\n9 months of its first meeting and a final report within 18 months of its\nfirst meeting, unless otherwise directed by the President.","original_source":{"page_or_item":"63 FR 9085 (PDF p. 1); Sec. 2(e)","sha256":"5137548d95240205c8af2b8cd59c8887c17798949a46b108366a849255f08874","url":"https://www.govinfo.gov/content/pkg/FR-1998-02-24/pdf/98-4816.pdf"},"scope_id":"EO:13075#sec2(e)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The heads of executive departments and agencies\nshall, to the extent permitted by law, provide the Special Oversight Board\nwith such information as it may require for purposes of carrying out its\nfunctions.","original_source":{"page_or_item":"63 FR 9085 (PDF p. 1); Sec. 3(a)","sha256":"5137548d95240205c8af2b8cd59c8887c17798949a46b108366a849255f08874","url":"https://www.govinfo.gov/content/pkg/FR-1998-02-24/pdf/98-4816.pdf"},"scope_id":"EO:13075#sec3(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) Special Oversight Board members may be allowed travel expenses,\nincluding per diem in lieu of subsistence, to the extent permitted by law\nfor persons serving intermittently in the Government service (5 U.S.C. 5701–\n5707). The administrative staff for the Special Oversight Board shall be\ncompensated in accordance with Federal law.","original_source":{"page_or_item":"63 FR 9085 (PDF p. 1); Sec. 3(b)","sha256":"5137548d95240205c8af2b8cd59c8887c17798949a46b108366a849255f08874","url":"https://www.govinfo.gov/content/pkg/FR-1998-02-24/pdf/98-4816.pdf"},"scope_id":"EO:13075#sec3(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) To the extent permitted by law, and subject to the availability of\nappropriations, the Department of Defense shall provide the Special Oversight\nBoard with such funds as may be necessary for the performance of its\nfunctions.","original_source":{"page_or_item":"63 FR 9085 (PDF p. 1); Sec. 3(c)","sha256":"5137548d95240205c8af2b8cd59c8887c17798949a46b108366a849255f08874","url":"https://www.govinfo.gov/content/pkg/FR-1998-02-24/pdf/98-4816.pdf"},"scope_id":"EO:13075#sec3(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) Notwithstanding the provisions of any other\nExecutive order, the functions of the President under the Federal Advisory\nCommittee Act, as amended, that are applicable to the Special Oversight\nBoard, except that of reporting annually to the Congress, shall be performed\nby the Secretary of Defense, in accordance with the guidelines and procedures\nestablished by the Administrator of General Services.","original_source":{"page_or_item":"63 FR 9085 (PDF p. 1); Sec. 4(a)","sha256":"5137548d95240205c8af2b8cd59c8887c17798949a46b108366a849255f08874","url":"https://www.govinfo.gov/content/pkg/FR-1998-02-24/pdf/98-4816.pdf"},"scope_id":"EO:13075#sec4(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The Special Oversight Board shall terminate 30 days after submitting\nits final report.","original_source":{"page_or_item":"63 FR 9086 (PDF p. 2); Sec. 4(b)","sha256":"5137548d95240205c8af2b8cd59c8887c17798949a46b108366a849255f08874","url":"https://www.govinfo.gov/content/pkg/FR-1998-02-24/pdf/98-4816.pdf"},"scope_id":"EO:13075#sec4(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) This order is intended only to improve the internal management of\nthe executive branch and it is not intended, and shall not be construed,\nto create any right, benefit, or trust responsibility, substantive or procedural,\nenforceable at law or equity by a party against the United States, its agencies,\nits officers, or any person.","original_source":{"page_or_item":"63 FR 9086 (PDF p. 2); Sec. 4(c)","sha256":"5137548d95240205c8af2b8cd59c8887c17798949a46b108366a849255f08874","url":"https://www.govinfo.gov/content/pkg/FR-1998-02-24/pdf/98-4816.pdf"},"scope_id":"EO:13075#sec4(c)","state_at_cutoff":null}],"original_representation":{"page_or_item":"whole per-document Federal Register PDF (63 FR 9085)","sha256":"5137548d95240205c8af2b8cd59c8887c17798949a46b108366a849255f08874","url":"https://www.govinfo.gov/content/pkg/FR-1998-02-24/pdf/98-4816.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 13 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:13075"}
