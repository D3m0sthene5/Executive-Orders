&order=executive_order_number&page=6&per_page=1000&search_after_cursor=WzEyNDk3LjAsIjEyNDk3Il0"}},"suggested":true}],"whole_order_end_total":1},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"confirm","counterevidence":"confirm","ending_or_current_basis":"confirm","opus_media":"n/a","original_text":"done_now_by_custody","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":[],"would_satisfy_once_confirmed":["clause_inventory","ending_or_current_basis","counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"2001-05-02","later-events_catalog":"2001-05-02","research/stage21/original_sources/CASE_ORIGINAL_SOURCE_CUSTODY.csv":"2001-05-02","stage19_causal_queue":"2001-05-02","stage21_crosswalk":"2001-05-02"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:13210","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Section 1. Establishment. There is established the President’s Commission\nto Strengthen Social Security (Commission).","original_source":{"page_or_item":"66 FR 22895, PDF pages 1-2; Sec. 1","sha256":"c150e955fa9c892b1879eb1f57381a7602ad6aa099b0e84e67a2756d12dbe441","url":"https://www.govinfo.gov/content/pkg/FR-2001-05-04/pdf/01-11505.pdf"},"scope_id":"EO:13210#sec1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 2. Membership. The Commission shall be composed of sixteen members\nappointed by the President, of which no more than eight shall be members\nof the same political party. The President shall also designate two members\nof the Commission to act as co-chairs. The two co-chairs shall not be\nmembers of the same political party.","original_source":{"page_or_item":"66 FR 22895, PDF pages 1-2; Sec. 2","sha256":"c150e955fa9c892b1879eb1f57381a7602ad6aa099b0e84e67a2756d12dbe441","url":"https://www.govinfo.gov/content/pkg/FR-2001-05-04/pdf/01-11505.pdf"},"scope_id":"EO:13210#sec2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 3. Mission. The mission of the Commission shall be to submit to\nthe President bipartisan recommendations to modernize and restore fiscal\nsoundness to the Social Security system according to the following principles:","original_source":{"page_or_item":"66 FR 22895, PDF pages 1-2; Sec. 3 (lead-in)","sha256":"c150e955fa9c892b1879eb1f57381a7602ad6aa099b0e84e67a2756d12dbe441","url":"https://www.govinfo.gov/content/pkg/FR-2001-05-04/pdf/01-11505.pdf"},"scope_id":"EO:13210#sec3","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) Modernization must not change Social Security benefits for retirees or\nnear-retirees;","original_source":{"page_or_item":"66 FR 22895, PDF pages 1-2; Sec. 3(a)","sha256":"c150e955fa9c892b1879eb1f57381a7602ad6aa099b0e84e67a2756d12dbe441","url":"https://www.govinfo.gov/content/pkg/FR-2001-05-04/pdf/01-11505.pdf"},"scope_id":"EO:13210#sec3(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The entire Social Security surplus must be dedicated to Social Security\nonly;","original_source":{"page_or_item":"66 FR 22895, PDF pages 1-2; Sec. 3(b)","sha256":"c150e955fa9c892b1879eb1f57381a7602ad6aa099b0e84e67a2756d12dbe441","url":"https://www.govinfo.gov/content/pkg/FR-2001-05-04/pdf/01-11505.pdf"},"scope_id":"EO:13210#sec3(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) Social Security payroll taxes must not be increased;","original_source":{"page_or_item":"66 FR 22895, PDF pages 1-2; Sec. 3(c)","sha256":"c150e955fa9c892b1879eb1f57381a7602ad6aa099b0e84e67a2756d12dbe441","url":"https://www.govinfo.gov/content/pkg/FR-2001-05-04/pdf/01-11505.pdf"},"scope_id":"EO:13210#sec3(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) Government must not invest Social Security funds in the stock market;","original_source":{"page_or_item":"66 FR 22895, PDF pages 1-2; Sec. 3(d)","sha256":"c150e955fa9c892b1879eb1f57381a7602ad6aa099b0e84e67a2756d12dbe441","url":"https://www.govinfo.gov/content/pkg/FR-2001-05-04/pdf/01-11505.pdf"},"scope_id":"EO:13210#sec3(d)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(e) Modernization must preserve Social Security’s disability and survivors\ncomponents; and","original_source":{"page_or_item":"66 FR 22895, PDF pages 1-2; Sec. 3(e)","sha256":"c150e955fa9c892b1879eb1f57381a7602ad6aa099b0e84e67a2756d12dbe441","url":"https://www.govinfo.gov/content/pkg/FR-2001-05-04/pdf/01-11505.pdf"},"scope_id":"EO:13210#sec3(e)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(f) Modernization must include individually controlled, voluntary personal\nretirement accounts, which will augment the Social Security safety net.","original_source":{"page_or_item":"66 FR 22895, PDF pages 1-2; Sec. 3(f)","sha256":"c150e955fa9c892b1879eb1f57381a7602ad6aa099b0e84e67a2756d12dbe441","url":"https://www.govinfo.gov/content/pkg/FR-2001-05-04/pdf/01-11505.pdf"},"scope_id":"EO:13210#sec3(f)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The Social Security Administration shall, to\nthe extent permitted by law, provide administrative support and funding\nfor the Commission.","original_source":{"page_or_item":"66 FR 22895, PDF pages 1-2; Sec. 4(a)","sha256":"c150e955fa9c892b1879eb1f57381a7602ad6aa099b0e84e67a2756d12dbe441","url":"https://www.govinfo.gov/content/pkg/FR-2001-05-04/pdf/01-11505.pdf"},"scope_id":"EO:13210#sec4(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) Members of the Commission shall serve without any compensation\nfor their work on the Commission. Members appointed from among private\ncitizens of the United States, however, while engaged in the work of the\nCommission, may be allowed travel expenses, including per diem in lieu\nof subsistence, as authorized by law for persons serving intermittently in\nGovernment service (5 U.S.C. 5701–5707), to the extent funds are available.","original_source":{"page_or_item":"66 FR 22895, PDF pages 1-2; Sec. 4(b)","sha256":"c150e955fa9c892b1879eb1f57381a7602ad6aa099b0e84e67a2756d12dbe441","url":"https://www.govinfo.gov/content/pkg/FR-2001-05-04/pdf/01-11505.pdf"},"scope_id":"EO:13210#sec4(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) The Commission shall have a staff headed by an Executive Director,\nwho shall be selected by the President. To the extent permitted by law,\noffice space, analytical support, and additional staff support for the Commis-\nsion shall be provided by executive branch departments and agencies as\ndirected by the President.","original_source":{"page_or_item":"66 FR 22895, PDF pages 1-2; Sec. 4(c)","sha256":"c150e955fa9c892b1879eb1f57381a7602ad6aa099b0e84e67a2756d12dbe441","url":"https://www.govinfo.gov/content/pkg/FR-2001-05-04/pdf/01-11505.pdf"},"scope_id":"EO:13210#sec4(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) The Commission shall receive input from and provide briefings to\nthe Congress, by procedures determined by the President in consultation\nwith the congressional leadership and the Commission. Public hearings shall\nbe held at the call of the co-chairs, in consultation with the President.","original_source":{"page_or_item":"66 FR 22895, PDF pages 1-2; Sec. 4(d)","sha256":"c150e955fa9c892b1879eb1f57381a7602ad6aa099b0e84e67a2756d12dbe441","url":"https://www.govinfo.gov/content/pkg/FR-2001-05-04/pdf/01-11505.pdf"},"scope_id":"EO:13210#sec4(d)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(e) The functions of the President under the Federal Advisory Committee\nAct, as amended, except for those in section 6 of that Act, that are applicable\nto the Commission, shall be performed by the Social Security Administration,\nVerDate 11<MAY>2000 12:47 May 03, 2001 Jkt 194001 PO 00000 Frm 00003 Fmt 4705 Sfmt 4790 E:\\FR\\FM\\04MYE0.SGM pfrm01 PsN: 04MYE0\n=== PDF page 2 of 2 ===\n22896 Federal Register / Vol. 66, No. 87 / Friday, May 4, 2001 / Presidential Documents\nin accordance with the guidelines that have been issued by the Administrator\nof General Services.","original_source":{"page_or_item":"66 FR 22895, PDF pages 1-2; Sec. 4(e)","sha256":"c150e955fa9c892b1879eb1f57381a7602ad6aa099b0e84e67a2756d12dbe441","url":"https://www.govinfo.gov/content/pkg/FR-2001-05-04/pdf/01-11505.pdf"},"scope_id":"EO:13210#sec4(e)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 5. Reports. The Commission shall submit reports to the President as\nfollows:","original_source":{"page_or_item":"66 FR 22895, PDF pages 1-2; Sec. 5 (lead-in)","sha256":"c150e955fa9c892b1879eb1f57381a7602ad6aa099b0e84e67a2756d12dbe441","url":"https://www.govinfo.gov/content/pkg/FR-2001-05-04/pdf/01-11505.pdf"},"scope_id":"EO:13210#sec5","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) Interim Report. An interim report shall describe the challenges\nfacing the Social Security system and the criteria by which the Commission\nwill evaluate reform proposals. These criteria may include but are not limited\nto: solvency, sustainability, benefit adequacy, fair treatment across genera-\ntions and demographic groups, total annual cost obligations, net impact\non the Federal budget, impact upon national savings, impact on workforce\nparticipation, impact on employer-provided pension plans, rates of return,\nand protections against poverty.","original_source":{"page_or_item":"66 FR 22895, PDF pages 1-2; Sec. 5(a)","sha256":"c150e955fa9c892b1879eb1f57381a7602ad6aa099b0e84e67a2756d12dbe441","url":"https://www.govinfo.gov/content/pkg/FR-2001-05-04/pdf/01-11505.pdf"},"scope_id":"EO:13210#sec5(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) Final Report. The final report will set forth the Commission ’s rec-\nommendations, in accordance with its stated mission in section 3 of this\norder, regarding how to strengthen Social Security with personal accounts.\nThe Commission shall submit its final report during the fall of 2001. The\nsubmission date shall be determined by the co-chairs in consultation with\nthe President.","original_source":{"page_or_item":"66 FR 22895, PDF pages 1-2; Sec. 5(b)","sha256":"c150e955fa9c892b1879eb1f57381a7602ad6aa099b0e84e67a2756d12dbe441","url":"https://www.govinfo.gov/content/pkg/FR-2001-05-04/pdf/01-11505.pdf"},"scope_id":"EO:13210#sec5(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 6. Termination. The Commission shall terminate 30 days after submitting\nits final report.\nW","original_source":{"page_or_item":"66 FR 22895, PDF pages 1-2; Sec. 6","sha256":"c150e955fa9c892b1879eb1f57381a7602ad6aa099b0e84e67a2756d12dbe441","url":"https://www.govinfo.gov/content/pkg/FR-2001-05-04/pdf/01-11505.pdf"},"scope_id":"EO:13210#sec6","state_at_cutoff":null}],"original_representation":{"page_or_item":"whole per-document Federal Register PDF (66 FR 22895)","sha256":"c150e955fa9c892b1879eb1f57381a7602ad6aa099b0e84e67a2756d12dbe441","url":"https://www.govinfo.gov/content/pkg/FR-2001-05-04/pdf/01-11505.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 18 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:13210"}
