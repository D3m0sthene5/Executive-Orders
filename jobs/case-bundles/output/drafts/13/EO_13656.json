["app-transcriptions","later-events"],"from":"app-transcriptions@jobs/app-transcriptions/output","grade":"compiled_transcription_lead","identified_by":null,"location_confidence":"medium","ref":{"page_or_item":"Executive Order 13656—Establishment of the Afghanistan and Pakistan Strategic Partnership Office and Amendment to Executive Order 12163; January 17, 2014; APP node 305218; common-crawl capture 2025-09-12T12:51:49Z","sha256":"080bdf9dedf7b2078d6905f458aedda4c2a56c7163a4d1656a986237d8289e8d","url":"https://www.presidency.ucsb.edu/documents/executive-order-13656-establishment-the-afghanistan-and-pakistan-strategic-partnership"},"signing_date":null,"source_id":"app-executive-orders:EO:13656:common-crawl:080bdf9dedf7","strong":false,"text_path":"../../app-executive-orders/output/texts/executive-order-13656-establishment-the-afghanistan-and-pakistan-strategic-partnership.txt","why":"American Presidency Project (UCSB) web transcription: an editorial transcription published on the web, read live or from a web-archive capture of the page, NOT the signed or officially printed original; a lead to the original and to the text, never the original by itself"}],"savings_leads":[],"whole_order_end":[],"whole_order_end_total":0},"provisional_status":"yes","readiness":{"by_step":{"clause_inventory":"confirm","counterevidence":"confirm","ending_or_current_basis":"research","opus_media":"n/a","original_text":"confirm","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":["ending_or_current_basis"],"would_satisfy_once_confirmed":["original_text","clause_inventory","counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"2014-01-17","later-events_catalog":"2014-01-17","stage19_causal_queue":"2014-01-17","stage21_crosswalk":"2014-01-17"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:13656","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Section 1. Establishment. There is established within the Department of \nState, in accordance with section 3161 of title 5, United States Code, a \ntemporary organization to be known as the Afghanistan and Pakistan Strategic \nPartnership Office (APSPO).","original_source":{"page_or_item":"79 FR 4263, PDF pages 1-2; Sec. 1","sha256":"b49a31f145f6840d26bf5bd9be5162aa44fbc424d2ae5590271c31e53448752c","url":"https://www.govinfo.gov/content/pkg/FR-2014-01-24/pdf/2014-01523.pdf"},"scope_id":"EO:13656#sec1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 2. Purpose of the Temporary Organization. The purposes of the APSPO \nshall be to perform the specific project of supporting executive departments \nand agencies (agencies) in facilitating a strategic partnership between the \nU.S. Government and the governments of Afghanistan and Pakistan, pro-\nmoting further security and stabilization, and transitioning to a normalized \ndiplomatic presence in both countries.","original_source":{"page_or_item":"79 FR 4263, PDF pages 1-2; Sec. 2","sha256":"b49a31f145f6840d26bf5bd9be5162aa44fbc424d2ae5590271c31e53448752c","url":"https://www.govinfo.gov/content/pkg/FR-2014-01-24/pdf/2014-01523.pdf"},"scope_id":"EO:13656#sec2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 3. Functions of the Temporary Organization. In carrying out the purposes \nset forth in section 2 of this order, the APSPO shall:","original_source":{"page_or_item":"79 FR 4263, PDF pages 1-2; Sec. 3 (lead-in)","sha256":"b49a31f145f6840d26bf5bd9be5162aa44fbc424d2ae5590271c31e53448752c","url":"https://www.govinfo.gov/content/pkg/FR-2014-01-24/pdf/2014-01523.pdf"},"scope_id":"EO:13656#sec3","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) support agencies in transitioning to a strategic partnership with the \ngovernments of Afghanistan and Pakistan in the economic, diplomatic, cul-\ntural, technology, and security fields, particularly in the areas of program \nmanagement, rule of law, and program oversight;","original_source":{"page_or_item":"79 FR 4263, PDF pages 1-2; Sec. 3(a)","sha256":"b49a31f145f6840d26bf5bd9be5162aa44fbc424d2ae5590271c31e53448752c","url":"https://www.govinfo.gov/content/pkg/FR-2014-01-24/pdf/2014-01523.pdf"},"scope_id":"EO:13656#sec3(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) coordinate the final drawdown of the Department of State’s civilian \nfield operations and staff in Afghanistan;","original_source":{"page_or_item":"79 FR 4263, PDF pages 1-2; Sec. 3(b)","sha256":"b49a31f145f6840d26bf5bd9be5162aa44fbc424d2ae5590271c31e53448752c","url":"https://www.govinfo.gov/content/pkg/FR-2014-01-24/pdf/2014-01523.pdf"},"scope_id":"EO:13656#sec3(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) coordinate and oversee the administration of certain State Department \nassistance funds; and","original_source":{"page_or_item":"79 FR 4263, PDF pages 1-2; Sec. 3(c)","sha256":"b49a31f145f6840d26bf5bd9be5162aa44fbc424d2ae5590271c31e53448752c","url":"https://www.govinfo.gov/content/pkg/FR-2014-01-24/pdf/2014-01523.pdf"},"scope_id":"EO:13656#sec3(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) perform such other functions related to the specific project set forth \nin section 2 of this order as the Secretary of State (Secretary) may assign.","original_source":{"page_or_item":"79 FR 4263, PDF pages 1-2; Sec. 3(d)","sha256":"b49a31f145f6840d26bf5bd9be5162aa44fbc424d2ae5590271c31e53448752c","url":"https://www.govinfo.gov/content/pkg/FR-2014-01-24/pdf/2014-01523.pdf"},"scope_id":"EO:13656#sec3(d)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 4. Personnel and Administration. The APSPO shall be headed by a \nDirector appointed by the Secretary. The APSPO shall be based in Wash-\nington, DC, Pakistan, and Afghanistan.","original_source":{"page_or_item":"79 FR 4263, PDF pages 1-2; Sec. 4","sha256":"b49a31f145f6840d26bf5bd9be5162aa44fbc424d2ae5590271c31e53448752c","url":"https://www.govinfo.gov/content/pkg/FR-2014-01-24/pdf/2014-01523.pdf"},"scope_id":"EO:13656#sec4","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 5. Termination of the Temporary Organization. The APSPO shall termi-\nnate at the end of the maximum period permitted by section 3161(a)(1) \nof title 5, United States Code, unless terminated sooner by the Secretary.","original_source":{"page_or_item":"79 FR 4263, PDF pages 1-2; Sec. 5","sha256":"b49a31f145f6840d26bf5bd9be5162aa44fbc424d2ae5590271c31e53448752c","url":"https://www.govinfo.gov/content/pkg/FR-2014-01-24/pdf/2014-01523.pdf"},"scope_id":"EO:13656#sec5","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 6. Delegation of Certain Determination Functions. Executive Order 12163 \nof September 29, 1979, as amended, is further amended, in section 1– \n701(c), by striking the semicolon and all subsequent text before the period.","original_source":{"page_or_item":"79 FR 4263, PDF pages 1-2; Sec. 6","sha256":"b49a31f145f6840d26bf5bd9be5162aa44fbc424d2ae5590271c31e53448752c","url":"https://www.govinfo.gov/content/pkg/FR-2014-01-24/pdf/2014-01523.pdf"},"scope_id":"EO:13656#sec6","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) This order shall be implemented in accordance \nwith applicable law and subject to the availability of appropriations.","original_source":{"page_or_item":"79 FR 4263, PDF pages 1-2; Sec. 7(a)","sha256":"b49a31f145f6840d26bf5bd9be5162aa44fbc424d2ae5590271c31e53448752c","url":"https://www.govinfo.gov/content/pkg/FR-2014-01-24/pdf/2014-01523.pdf"},"scope_id":"EO:13656#sec7(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) Nothing in this order shall be construed to impair or otherwise affect: \n(i) the authority granted by law to a department or agency, or the head \nthereof; or \nVerDate Mar<15>2010 18:08 Jan 23, 2014 Jkt 229001 PO 00000 Frm 00003 Fmt 4705 Sfmt 4790 E:\\FR\\FM\\24JAE0.SGM 24JAE0TKELLEY on DSK3SPTVN1PROD with E0\n=== PDF page 2 of 2 ===\n4264 Federal Register / Vol. 79, No. 16 / Friday, January 24, 2014 / Presidential Documents \n(ii) the functions of the Director of the Office of Management and Budget \nrelating to budgetary, administrative, or legislative proposals.","original_source":{"page_or_item":"79 FR 4263, PDF pages 1-2; Sec. 7(b)","sha256":"b49a31f145f6840d26bf5bd9be5162aa44fbc424d2ae5590271c31e53448752c","url":"https://www.govinfo.gov/content/pkg/FR-2014-01-24/pdf/2014-01523.pdf"},"scope_id":"EO:13656#sec7(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) This order is not intended to, and does not, create any right or benefit, \nsubstantive or procedural, enforceable at law or in equity by any party \nagainst the United States, its departments, agencies, or entities, its officers, \nemployees, or agents, or any other person.","original_source":{"page_or_item":"79 FR 4263, PDF pages 1-2; Sec. 7(c)","sha256":"b49a31f145f6840d26bf5bd9be5162aa44fbc424d2ae5590271c31e53448752c","url":"https://www.govinfo.gov/content/pkg/FR-2014-01-24/pdf/2014-01523.pdf"},"scope_id":"EO:13656#sec7(c)","state_at_cutoff":null}],"original_representation":{"page_or_item":"79 FR 4263, PDF pages 1-2","sha256":"b49a31f145f6840d26bf5bd9be5162aa