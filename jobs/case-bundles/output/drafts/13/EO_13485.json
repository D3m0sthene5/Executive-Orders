4/pdf/E9-814.pdf"},"scope_id":"EO:13485#sec2(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) Notwithstanding the provisions of this order, the President retains\ndiscretion, to the extent permitted by law, to depart from this order in\ndesignating an acting Secretary.","original_source":{"page_or_item":"74 FR 2287 (PDF p. 1); Sec. 2(c)","sha256":"cb36286d727d3ea2b30a5fa6884dd0cf352f8afee07e544f49f95235b5db3fd1","url":"https://www.govinfo.gov/content/pkg/FR-2009-01-14/pdf/E9-814.pdf"},"scope_id":"EO:13485#sec2(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 3. This order supersedes the President’s Memorandum of March 19,\n2002 (Designation of Officers of the Department of Transportation).","original_source":{"page_or_item":"74 FR 2287 (PDF p. 1); Sec. 3","sha256":"cb36286d727d3ea2b30a5fa6884dd0cf352f8afee07e544f49f95235b5db3fd1","url":"https://www.govinfo.gov/content/pkg/FR-2009-01-14/pdf/E9-814.pdf"},"scope_id":"EO:13485#sec3","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 4. This order is intended to improve the internal management of the\nexecutive branch and is not intended to, and does not, create any right\nor benefit, substantive or procedural, enforceable at law or in equity, by\nany party against the United States, its agencies, instrumentalities, or entities,\nits officers, employees, or agents, or any other person.","original_source":{"page_or_item":"74 FR 2288 (PDF p. 2); Sec. 4","sha256":"cb36286d727d3ea2b30a5fa6884dd0cf352f8afee07e544f49f95235b5db3fd1","url":"https://www.govinfo.gov/content/pkg/FR-2009-01-14/pdf/E9-814.pdf"},"scope_id":"EO:13485#sec4","state_at_cutoff":null}],"original_representation":{"page_or_item":"whole per-document Federal Register PDF (74 FR 2287)","sha256":"cb36286d727d3ea2b30a5fa6884dd0cf352f8afee07e544f49f95235b5db3f