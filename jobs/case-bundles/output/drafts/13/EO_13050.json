ent-law","later-events"]},"meta":{"acting_instrument_id":"EO:13138","actor_text":"President, by Ex. Ord. No. 13138","date_basis":"printed_next_to_acting_instrument","from":"current-law@jobs/current-law/output","from_job":"current-law","ids":["usc:ev:c624d9e9e509"],"mechanism_text":"revocation (as stated in an OLRC note at 42 U.S.C. 1981 note)","quote":"Ex. Ord. No. 13050, June 13, 1997, 62 F.R. 32987, which established the President’s Advisory Board on Race, was revoked by Ex. Ord. No. 13138, § 3(e), Sept. 30, 1999, 64 F.R. 53880, formerly set out as a note under section 14 of the Appendix to Title 5, Government Organization and Employees.","quote_truncated":false,"system":"usc","where":"USC 42 U.S.C. 1981 note"},"proposal":{"actor":"EO:13138","date":"1999-09-30","mechanism":"revocation","source":{"page_or_item":"42 U.S.C. 1981 note; note 'Executive Order No. 13050' [USLM note id id3a28458d-c3e9-11f1-bd73-d95596aaa024]; usc42.xml (sha256 9a2ce8ea01dfa97423fcd8749e7534a64c0ec75df9bf56584b210c0725a66692) in xml_uscAll@119-121.zip","sha256":"c6122974e951003437ece5a998aa7c0b2cdc0f5703dfc78d6135e1fc9e729142","url":"https://uscode.house.gov/download/releasepoints/us/pl/119/121/xml_uscAll@119-121.zip"}},"suggested":false}],"whole_order_end_total":2},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"confirm","counterevidence":"confirm","ending_or_current_basis":"confirm","opus_media":"n/a","original_text":"done_now_by_custody","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":[],"would_satisfy_once_confirmed":["clause_inventory","ending_or_current_basis","counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"1997-06-13","later-events_catalog":"1997-06-13","research/stage21/original_sources/CASE_ORIGINAL_SOURCE_CUSTODY.csv":"1997-06-13","stage19_causal_queue":"1997-06-13","stage21_crosswalk":"1997-06-13"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:13050","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) There is established the President’s Advisory\nBoard on Race. The Advisory Board shall comprise 7 members from outside\nthe Federal Government to be appointed by the President. Members shall\neach have substantial experience and expertise in the areas to be considered\nby the Advisory Board. Members shall be representative of the diverse\nperspectives in the areas to be considered by the Advisory Board.","original_source":{"page_or_item":"62 FR 32987, PDF pages 1-2; Sec. 1(a)","sha256":"abbb324d2c3c5e2149ff6b5825dc929e6ecd7a9c03c2a46b842b2013eeb54db7","url":"https://www.govinfo.gov/content/pkg/FR-1997-06-17/pdf/97-16080.pdf"},"scope_id":"EO:13050#sec1(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The President shall designate a Chairperson from among the members\nof the Advisory Board.","original_source":{"page_or_item":"62 FR 32987, PDF pages 1-2; Sec. 1(b)","sha256":"abbb324d2c3c5e2149ff6b5825dc929e6ecd7a9c03c2a46b842b2013eeb54db7","url":"https://www.govinfo.gov/content/pkg/FR-1997-06-17/pdf/97-16080.pdf"},"scope_id":"EO:13050#sec1(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The Advisory Board shall advise the President on\nmatters involving race and racial reconciliation, including ways in which\nthe President can:\n(1) Promote a constructive national dialogue to confront and work through\nchallenging issues that surround race;\n(2) Increase the Nation’s understanding of our recent history of race rela-\ntions and the course our Nation is charting on issues of race relations\nand racial diversity;\n(3) Bridge racial divides by encouraging leaders in communities throughout\nthe Nation to develop and implement innovative approaches to calming\nracial tensions;\n(4) Identify, develop, and implement solutions to problems in areas in\nwhich race has a substantial impact, such as education, economic oppor-\ntunity, housing, health care, and the administration of justice.","original_source":{"page_or_item":"62 FR 32987, PDF pages 1-2; Sec. 2(a)","sha256":"abbb324d2c3c5e2149ff6b5825dc929e6ecd7a9c03c2a46b842b2013eeb54db7","url":"https://www.govinfo.gov/content/pkg/FR-1997-06-17/pdf/97-16080.pdf"},"scope_id":"EO:13050#sec2(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The Advisory Board also shall advise on such other matters as from\ntime to time the President may refer to the Board.","original_source":{"page_or_item":"62 FR 32987, PDF pages 1-2; Sec. 2(b)","sha256":"abbb324d2c3c5e2149ff6b5825dc929e6ecd7a9c03c2a46b842b2013eeb54db7","url":"https://www.govinfo.gov/content/pkg/FR-1997-06-17/pdf/97-16080.pdf"},"scope_id":"EO:13050#sec2(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) In carrying out its functions, the Advisory Board shall coordinate\nwith the staff of the President’s Initiative on Race.","original_source":{"page_or_item":"62 FR 32987, PDF pages 1-2; Sec. 2(c)","sha256":"abbb324d2c3c5e2149ff6b5825dc929e6ecd7a9c03c2a46b842b2013eeb54db7","url":"https://www.govinfo.gov/content/pkg/FR-1997-06-17/pdf/97-16080.pdf"},"scope_id":"EO:13050#sec2(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) To the extent permitted by law and subject\nto the availability of appropriations, the Department of Justice shall provide\nthe financial and administrative support for the Advisory Board.","original_source":{"page_or_item":"62 FR 32987, PDF pages 1-2; Sec. 3(a)","sha256":"abbb324d2c3c5e2149ff6b5825dc929e6ecd7a9c03c2a46b842b2013eeb54db7","url":"https://www.govinfo.gov/content/pkg/FR-1997-06-17/pdf/97-16080.pdf"},"scope_id":"EO:13050#sec3(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The heads of executive agencies shall, to the extent permitted by\nlaw, provide to the Advisory Board such information as it may require\nfor the purpose of carrying out its functions.","original_source":{"page_or_item":"62 FR 32987, PDF pages 1-2; Sec. 3(b)","sha256":"abbb324d2c3c5e2149ff6b5825dc929e6ecd7a9c03c2a46b842b2013eeb54db7","url":"https://www.govinfo.gov/content/pkg/FR-1997-06-17/pdf/97-16080.pdf"},"scope_id":"EO:13050#sec3(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) The Chairperson may, from time to time, invite experts to submit\ninformation to the Advisory Board and may form subcommittees or working\ngroups within the Advisory Board to review specific matters.","original_source":{"page_or_item":"62 FR 32987, PDF pages 1-2; Sec. 3(c)","sha256":"abbb324d2c3c5e2149ff6b5825dc929e6ecd7a9c03c2a46b842b2013eeb54db7","url":"https://www.govinfo.gov/content/pkg/FR-1997-06-17/pdf/97-16080.pdf"},"scope_id":"EO:13050#sec3(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) Members of the Advisory Board shall serve without compensation\nbut shall be allowed travel expenses, including per diem in lieu of subsist-\nence, as authorized by law for persons serving intermittently in the Govern-\nment service (5 U.S.C. 5701-5707).","original_source":{"page_or_item":"62 FR 32987, PDF pages 1-2; Sec. 3(d)","sha256":"abbb324d2c3c5e2149ff6b5825dc929e6ecd7a9c03c2a46b842b2013eeb54db7","url":"https://www.govinfo.gov/content/pkg/FR-1997-06-17/pdf/97-16080.pdf"},"scope_id":"EO:13050#sec3(d)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) Notwithstanding any other Executive order, the functions\nof the President under the Federal Advisory Committee Act, as amended,\nexcept that of reporting to the Congress, that are applicable to the Advisory\nBoard shall be performed by the Attorney General, or his or her designee,\n=== PDF page 2 of 2 ===\n32988 Federal Register / Vol. 62, No. 116 / Tuesday, June 17, 1997 / Presidential Documents\nin accordance with guidelines that have been issued by the Administrator\nof General Services.","original_source":{"page_or_item":"62 FR 32987, PDF pages 1-2; Sec. 4(a)","sha256":"abbb324d2c3c5e2149ff6b5825dc929e6ecd7a9c03c2a46b842b2013eeb54db7","url":"https://www.govinfo.gov/content/pkg/FR-1997-06-17/pdf/97-16080.pdf"},"scope_id":"EO:13050#sec4(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The Advisory Board shall terminate on September 30, 1998, unless\nextended by the President prior to such date.","original_source":{"page_or_item":"62 FR 32987, PDF pages 1-2; Sec. 4(b)","sha256":"abbb324d2c3c5e2149ff6b5825dc929e6ecd7a9c03c2a46b842b2013eeb54db7","url":"https://www.govinfo.gov/content/pkg/FR-1997-06-17/pdf/97-16080.pdf"},"scope_id":"EO:13050#sec4(b)","state_at_cutoff":null}],"original_representation":{"page_or_item":"whole per-document Federal Register PDF (62 FR 32987)","sha256":"abbb324d2c3c5e2149ff6b5825dc929e6ecd7a9c03c2a46b842b2013eeb54db7","url":"https://www.govinfo.gov/content/pkg/FR-1997-06-17/pdf/97-16080.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 11 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-cl