source_id":"fr-originals:EO:13090:030b83d958b7","strong":true,"text_path":"texts/EO_13090.txt","why":"page location high; location_verified is false - open the PDF pages"}],"savings_leads":[],"whole_order_end":[{"custody_records_in":["later-events"],"group":{"actor":"EO:13225","corroborated_by_two_jobs":false,"date":"2001-09-28","jobs":["later-events"]},"meta":{"acting_instrument_id":"EO:13225","date_basis":["acting order signing_date from OFR catalog","date stated next to the acting instrument in the OFR note"],"evidence_types":["ofr_note_on_acting","ofr_note_on_target"],"from":"later-events@jobs/later-events/output","from_job":"later-events","ids":["LE-33b55c5b93a5","LE-5926dace4ab3"],"quote":"Revoked by: EO 13225, September 28, 2001","quote_kind":"verbatim_note_item","quote_truncated":false,"status":"CANDIDATE_UNVERIFIED"},"proposal":{"actor":"EO:13225","date":"2001-09-28","mechanism":"revocation","source":{"page_or_item":"OFR API record executive_order_number=13090; citation 63 FR 36151; document_number 98-17828; field disposition_notes","sha256":"8ba9e1cce593bb06b6be625b585b15bb04a1555ed34ad8c5b6f8c9bd81f83f77","url":"https://www.federalregister.gov/api/v1/documents?conditions%5Bcorrection%5D=0&conditions%5Bpresidential_document_type%5D=executive_order&conditions%5Btype%5D%5B%5D=PRESDOCU&fields%5B%5D=citation&fields%5B%5D=disposition_notes&fields%5B%5D=document_number&fields%5B%5D=executive_order_number&fields%5B%5D=html_url&fields%5B%5D=pdf_url&fields%5B%5D=president&fields%5B%5D=publication_date&fields%5B%5D=raw_text_url&fields%5B%5D=signing_date&fields%5B%5D=title&format=json&include_pre_1994_docs=true&order=executive_order_number&page=6&per_page=1000&search_after_cursor=WzEyNDk3LjAsIjEyNDk3Il0"}},"suggested":true}],"whole_order_end_total":1},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"confirm","counterevidence":"confirm","ending_or_current_basis":"confirm","opus_media":"n/a","original_text":"done_now_by_custody","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":[],"would_satisfy_once_confirmed":["clause_inventory","ending_or_current_basis","counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"1998-06-29","later-events_catalog":"1998-06-29","research/stage21/original_sources/CASE_ORIGINAL_SOURCE_CUSTODY.csv":"1998-06-29","stage19_causal_queue":"1998-06-29","stage21_crosswalk":"1998-06-29"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:13090","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Section 1. Establishment. There is established the President’s Commission\non the Celebration of Women in American History (‘‘Commission’’). The\nCommission shall be composed of not more than 11 members appointed\nby the President from the public and private sectors. The public sector\nmembers shall include such persons as the President deems appropriate,\nincluding (a) the Assistant to the President and Director of Communications\nand (b) a person recommended by and who shall be the representative\nof the Administrator of General Services. The President may designate two\nmembers as Co-Chairs of the Commission. The private sector members shall\nrepresent entities interested in the Commission’s work on American history,\nparticularly the history of women in America. These entities may include,\nbut need not be limited to, academic institutions, business entities, labor\norganizations, public interest organizations, arts and humanities institutions,\nState and local governments, athletic groups, and organizations devoted\nto civil rights and opportunities for minorities and women. The private\nsector members shall not be considered special Government employees.","original_source":{"page_or_item":"63 FR 36151 (PDF p. 1); Sec. 1","sha256":"030b83d958b75c03a61a80a35aeedabc8e3cc001c54ee653163729ea048c7830","url":"https://www.govinfo.gov/content/pkg/FR-1998-07-02/pdf/98-17828.pdf"},"scope_id":"EO:13090#sec1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The Commission shall make recommendations to the\nPresident, through the Co-Chairs of the Commission, on ways to best acknowl-\nedge and celebrate the roles and accomplishments of women in American\nhistory. Recommendations may include, among other things, the feasibility\nof a focal point for women’s history located in Washington, D.C., and the\nuse of the latest technology to connect existing and planned women’s history\nsites, museums, and libraries.","original_source":{"page_or_item":"63 FR 36151 (PDF p. 1); Sec. 2(a)","sha256":"030b83d958b75c03a61a80a35aeedabc8e3cc001c54ee653163729ea048c7830","url":"https://www.govinfo.gov/content/pkg/FR-1998-07-02/pdf/98-17828.pdf"},"scope_id":"EO:13090#sec2(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The Commission shall meet to carry out its work concerning the\ncelebration of women in American history.","original_source":{"page_or_item":"63 FR 36151 (PDF p. 1); Sec. 2(b)","sha256":"030b83d958b75c03a61a80a35aeedabc8e3cc001c54ee653163729ea048c7830","url":"https://www.govinfo.gov/content/pkg/FR-1998-07-02/pdf/98-17828.pdf"},"scope_id":"EO:13090#sec2(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) The Commission shall report its recommendations, through the Co-\nChairs of the Commission, in a final report to the President by March\n1, 1999.","original_source":{"page_or_item":"63 FR 36151 (PDF p. 1); Sec. 2(c)","sha256":"030b83d958b75c03a61a80a35aeedabc8e3cc001c54ee653163729ea048c7830","url":"https://www.govinfo.gov/content/pkg/FR-1998-07-02/pdf/98-17828.pdf"},"scope_id":"EO:13090#sec2(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The heads of executive departments and agencies\nshall, to the extent permitted by law and where practicable, provide the\nCo-Chairs of the Commission with such information with respect to women’s\nhistory in America as the Co-Chairs may request.","original_source":{"page_or_item":"63 FR 36151 (PDF p. 1); Sec. 3(a)","sha256":"030b83d958b75c03a61a80a35aeedabc8e3cc001c54ee653163729ea048c7830","url":"https://www.govinfo.gov/content/pkg/FR-1998-07-02/pdf/98-17828.pdf"},"scope_id":"EO:13090#sec3(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) Members of the Commission shall serve without compensation for\ntheir work on the Commission. While engaged in the work of the Commission,\nmembers appointed from the private sector may be allowed travel expenses,\nincluding per diem in lieu of subsistence, as authorized by law for persons\nserving intermittently in Government service (5 U.S.C. 5701–5707).","original_source":{"page_or_item":"63 FR 36151 (PDF p. 1); Sec. 3(b)","sha256":"030b83d958b75c03a61a80a35aeedabc8e3cc001c54ee653163729ea048c7830","url":"https://www.govinfo.gov/content/pkg/FR-1998-07-02/pdf/98-17828.pdf"},"scope_id":"EO:13090#sec3(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) To the extent permitted by law and subject to the availability of\nappropriations, the General Services Administration shall provide the Com-\nmission with funding, administrative services, facilities, staff, and other\nsupport services necessary for the performance of the functions of the Com-\nmission. With respect to the Commission, the Administrator of General\nServices shall perform the administrative functions of the President under\nthe Federal Advisory Committee Act, as amended, except that of reporting\nto the Congress.","original_source":{"page_or_item":"63 FR 36152 (PDF p. 2); Sec. 3(c)","sha256":"030b83d958b75c03a61a80a35aeedabc8e3cc001c54ee653163729ea048c7830","url":"https://www.govinfo.gov/content/pkg/FR-1998-07-02/pdf/98-17828.pdf"},"scope_id":"EO:13090#sec3(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) The Commission shall terminate 60 days after the submission of its\nfinal report.","original_source":{"page_or_item":"63 FR 36152 (PDF p. 2); Sec. 3(d)","sha256":"030b83d958b75c03a61a80a35aeedabc8e3cc001c54ee653163729ea048c7830","url":"https://www.govinfo.gov/content/pkg/FR-1998-07-02/pdf/98-17828.pdf"},"scope_id":"EO:13090#sec3(d)","state_at_cutoff":null}],"original_representation":{"page_or_item":"whole per-document Federal Register PDF (63 FR 36151)","sha256":"030b83d958b75c03a61a80a35aeedabc8e3cc001c54ee653163729ea048c7830","url":"https://www.govinfo.gov/content/pkg/FR-1998-07-02/pdf/98-17828.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 8 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:13090"}
