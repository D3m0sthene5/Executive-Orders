iginals:EO:13682:25656fab9cd6","strong":true,"text_path":"texts/EO_13682.txt","why":"page location high; location_verified is false - open the PDF pages"}],"savings_leads":[],"whole_order_end":[],"whole_order_end_total":0},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"research","counterevidence":"confirm","ending_or_current_basis":"research","opus_media":"n/a","original_text":"confirm","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":["clause_inventory","ending_or_current_basis"],"would_satisfy_once_confirmed":["original_text","counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"2014-12-05","later-events_catalog":"2014-12-05","stage19_causal_queue":"2014-12-05","stage21_crosswalk":"2014-12-05"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:13682","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Section 1. All executive branch departments and agencies of the Federal \nGovernment shall be closed and their employees excused from duty on \nFriday, December 26, 2014, the day after Christmas Day, except as provided \nin section 2 of this order.","original_source":{"page_or_item":"79 FR 73459, PDF pages 1-2; Sec. 1","sha256":"25656fab9cd601430e9fe4af3885cce88c2392da0405b36d10d0afe2e26e7af0","url":"https://www.govinfo.gov/content/pkg/FR-2014-12-10/pdf/2014-29121.pdf"},"scope_id":"EO:13682#sec1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 2. The heads of executive branch departments and agencies may deter-\nmine that certain offices and installations of their organizations, or parts \nthereof, must remain open and that certain employees must report for duty \non December 26, 2014, for reasons of national security, defense, or other \npublic need.","original_source":{"page_or_item":"79 FR 73459, PDF pages 1-2; Sec. 2","sha256":"25656fab9cd601430e9fe4af3885cce88c2392da0405b36d10d0afe2e26e7af0","url":"https://www.govinfo.gov/content/pkg/FR-2014-12-10/pdf/2014-29121.pdf"},"scope_id":"EO:13682#sec2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 3. Friday, December 26, 2014, shall be considered as falling within \nthe scope of Executive Order 11582 of February 11, 1971, and of 5 U.S.C. \n5546 and 6103(b) and other similar statutes insofar as they relate to the \npay and leave of employees of the United States.","original_source":{"page_or_item":"79 FR 73459, PDF pages 1-2; Sec. 3","sha256":"25656fab9cd601430e9fe4af3885cce88c2392da0405b36d10d0afe2e26e7af0","url":"https://www.govinfo.gov/content/pkg/FR-2014-12-10/pdf/2014-29121.pdf"},"scope_id":"EO:13682#sec3","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 4. The Director of the Office of Personnel Management shall take \nsuch actions as may be necessary to implement this order.","original_source":{"page_or_item":"79 FR 73459, PDF pages 1-2; Sec. 4","sha256":"25656fab9cd601430e9fe4af3885cce88c2392da0405b36d10d0afe2e26e7af0","url":"https://www.govinfo.gov/content/pkg/FR-2014-12-10/pdf/2014-29121.pdf"},"scope_id":"EO:13682#sec4","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) Nothing in this order shall be construed \nto impair or otherwise affect: \n(i) the authority granted by law to an executive department or agency, \nor the head thereof; or \n(ii) the functions of the Director of the Office of Management and Budget \nrelating to budgetary, administrative, or legislative proposals.","original_source":{"page_or_item":"79 FR 73459, PDF pages 1-2; Sec. 5(a)","sha256":"25656fab9cd601430e9fe4af3885cce88c2392da0405b36d10d0afe2e26e7af0","url":"https://www.govinfo.gov/content/pkg/FR-2014-12-10/pdf/2014-29121.pdf"},"scope_id":"EO:13682#sec5(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) This order shall be implemented consistent with applicable law and \nsubject to the availability of appropriations. \nVerDate Sep<11>2014 19:34 Dec 09, 2014 Jkt 235001 PO 00000 Frm 00003 Fmt 4705 Sfmt 4790 E:\\FR\\FM\\10DEE0.SGM 10DEE0mstockstill on DSK4VPTVN1PROD with E0\n=== PDF page 2 of 2 ===\n73460 Federal Register / Vol. 79, No. 237 / Wednesday, December 10, 2014 / Presidential Documents \n(c) This order is not intended to, and does not, create any right or benefit, \nsubstantive or procedural, enforceable at law or in equity by any party \nagainst the United States, its departments, agencies, or entities, its officers, \nemployees, or agents, or any other person.","original_source":{"page_or_item":"79 FR 73459, PDF pages 1-2; Sec. 5(b)","sha256":"25656fab9cd601430e9fe4af3885cce88c2392da0405b36d10d0afe2e26e7af0","url":"https://www.govinfo.gov/content/pkg/FR-2014-12-10/pdf/2014-29121.pdf"},"scope_id":"EO:13682#sec5(b)","state_at_cutoff":null}],"original_representation":{"page_or_item":"79 FR 73459, PDF pages 1-2","sha256":"25656fab9cd601430e9fe4af3885cce88c2392da0405b36d10d0afe2e26e7af0","url":"https://www.govinfo.gov/content/pkg/FR-2014-12-10/pdf/2014-29121.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 6 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:13682"}
