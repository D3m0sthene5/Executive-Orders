s_residuals":"agent_judgment","shared_sources":"confirm"},"needs_research":["clause_inventory","ending_or_current_basis","opus_media"],"would_satisfy_once_confirmed":["original_text","counterevidence","shared_sources"]},"shared_sources":[{"authority":"USC::26 U.S.C. 7851(a)(1)(A)","route":"official/govinfo_link_uscode","source":{"page_or_item":"USC::26 U.S.C. 7851(a)(1)(A); USCODE-2024-title26-subtitleF-chap80-subchapB-sec7851.pdf PDF pages 1-4 of 4","sha256":"860e68e8fdc7e1242021b600ffa11cca29b882aae6bb166729e1c2d148e4dd99","url":"https://www.govinfo.gov/content/pkg/USCODE-2024-title26/pdf/USCODE-2024-title26-subtitleF-chap80-subchapB-sec7851.pdf"},"source_id":"source-ladder:USC_26_U.S.C._7851_a_1_A:860e68e8fdc7","status":"found_by_source_ladder"}],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"1944-09-30","later-events_catalog":"1944-09-30","stage19_causal_queue":"1944-09-30"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:9487","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"I hereby prescribe the following regulations governing the issuance of Non-Necessity Certificates under section 124(d) of the Internal Revenue Code:","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); operative words before the numbered sections","sha256":"002a352525b590a73759e31b801f022cac8dae4fdbfa4274e30d80c17d2659e9","url":"https://www.presidency.ucsb.edu/documents/executive-order-9487-regulations-governing-the-issuance-non-necessity-certificates-under"},"scope_id":"EO:9487#preamble-op","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1. \nDefinitions\n. As used throughout these regulations:","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); para. 1 (lead-in)","sha256":"002a352525b590a73759e31b801f022cac8dae4fdbfa4274e30d80c17d2659e9","url":"https://www.presidency.ucsb.edu/documents/executive-order-9487-regulations-governing-the-issuance-non-necessity-certificates-under"},"scope_id":"EO:9487#para1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) \"Emergency facility\" means any facility, land, building, machinery, or equipment, or part thereof, the construction, reconstruction, erection, installation, or acquisition of which was completed after December 31, 1939, and with respect to which a Necessity Certificate has been made.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); para. 1(a)","sha256":"002a352525b590a73759e31b801f022cac8dae4fdbfa4274e30d80c17d2659e9","url":"https://www.presidency.ucsb.edu/documents/executive-order-9487-regulations-governing-the-issuance-non-necessity-certificates-under"},"scope_id":"EO:9487#para1(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) \"Necessity Certificate\" means a certificate made pursuant to section 124(f) of the Internal Revenue Code, as amended, certifying that the construction, reconstruction, erection, installation, or acquisition of the facility, referred to in the certificate, is necessary in the interest of national defense during the emergency period.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); para. 1(b)","sha256":"002a352525b590a73759e31b801f022cac8dae4fdbfa4274e30d80c17d2659e9","url":"https://www.presidency.ucsb.edu/documents/executive-order-9487-regulations-governing-the-issuance-non-necessity-certificates-under"},"scope_id":"EO:9487#para1(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) \"Emergency period\" means the period beginning January 1, 1940, and ending on the date on which the President proclaims that the utilization of a substantial portion of the emergency facilities with respect to which certifications under section 124(f) of the Internal Revenue Code have been made is no longer required in the interest of national defense.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); para. 1(c)","sha256":"002a352525b590a73759e31b801f022cac8dae4fdbfa4274e30d80c17d2659e9","url":"https://www.presidency.ucsb.edu/documents/executive-order-9487-regulations-governing-the-issuance-non-necessity-certificates-under"},"scope_id":"EO:9487#para1(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) \"Non-Necessity Certificate\" means a certificate made pursuant to section 124(d) of the Internal Revenue Code, certifying that an emergency facility ceased, on the date specified in the certificate, to be necessary in the interest of national defense during the emergency period.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); para. 1(d)","sha256":"002a352525b590a73759e31b801f022cac8dae4fdbfa4274e30d80c17d2659e9","url":"https://www.presidency.ucsb.edu/documents/executive-order-9487-regulations-governing-the-issuance-non-necessity-certificates-under"},"scope_id":"EO:9487#para1(d)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(e) \"Certifying authority\" means the Chairman of the War Production Board or his duly authorized representative.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); para. 1(e)","sha256":"002a352525b590a73759e31b801f022cac8dae4fdbfa4274e30d80c17d2659e9","url":"https://www.presidency.ucsb.edu/documents/executive-order-9487-regulations-governing-the-issuance-non-necessity-certificates-under"},"scope_id":"EO:9487#para1(e)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"2. \nDetermination of non-necessity\n. An emergency facility shall be considered as having ceased to be necessary in the interest of national defense during the emergency period and a Non-Necessity Certificate with respect thereto shall be promptly issued by the certifying authority upon proper application therefor where, in view of the condition, location and ownership of such emergency facility, the certifying authority has determined that no presently foreseeable substantial need for such emergency facility exists in the interests of national defense.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); para. 2","sha256":"002a352525b590a73759e31b801f022cac8dae4fdbfa4274e30d80c17d2659e9","url":"https://www.presidency.ucsb.edu/documents/executive-order-9487-regulations-governing-the-issuance-non-necessity-certificates-under"},"scope_id":"EO:9487#para2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"3. \nProcedure\n. The certifying authority is empowered to obtain reports and recommendations from such government agencies as it may designate.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); para. 3","sha256":"002a352525b590a73759e31b801f022cac8dae4fdbfa4274e30d80c17d2659e9","url":"https://www.presidency.ucsb.edu/documents/executive-order-9487-regulations-governing-the-issuance-non-necessity-certificates-under"},"scope_id":"EO:9487#para3","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"4. \nDate to be specified in certificate\n. The certificate will specify the date on which the emergency facility ceased to be necessary in the interest of national defense.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); para. 4","sha256":"002a352525b590a73759e31b801f022cac8dae4fdbfa4274e30d80c17d2659e9","url":"https://www.presidency.ucsb.edu/documents/executive-order-9487-regulations-governing-the-issuance-non-necessity-certificates-under"},"scope_id":"EO:9487#para4","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"5. \nForm of application\n. An application for a Non-Necessity Certificate shall be in the form prescribed by the certifying authority.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); para. 5","sha256":"002a352525b590a73759e31b801f022cac8dae4fdbfa4274e30d80c17d2659e9","url":"https://www.presidency.ucsb.edu/documents/executive-order-9487-regulations-governing-the-issuance-non-necessity-certificates-under"},"scope_id":"EO:9487#para5","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"6. \nPlace of filing application\n. An application for a Non-Necessity Certificate shall be filed with the War Production Board in Washington, D.C., or at any other office designated by the certifying authority.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); para. 6","sha256":"002a352525b590a73759e31b801f022cac8dae4fdbfa4274e30d80c17d2659e9","url":"https://www.presidency.ucsb.edu/documents/executive-order-9487-regulations-governing-the-issuance-non-necessity-certificates-under"},"scope_id":"EO:9487#para6","state_at_cutoff":null}],"original_representation":{"page_or_item":"9 FR 11987, PDF pages 1-3","sha256":"6221f4e5e6bd9f14282e656872291a44d972af8fa9845e5a5e92ea6fcb974ee0","url":"https://www.govinfo.gov/content/pkg/FR-1944-10-03/pdf/FR-1944-10-03.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 12 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:9487"}
