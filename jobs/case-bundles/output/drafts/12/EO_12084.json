C89-32e1fa99c4b3"],"quote":"Revokedby EO 12305","quote_kind":"ocr_table_cell","quote_truncated":false,"status":"CANDIDATE_UNVERIFIED"},"proposal":{"actor":"EO:12305","date":"1981-05-05","mechanism":"revocation","source":{"page_or_item":"OFR Codification 1945-1989 (1989), Executive Orders disposition table, printed page 1082, PDF page 1093","sha256":"6c760d36b1d22350dc22890bbf31afb0a67911c3bc295abd567cc0e706fe2ccd","url":"https://hdl.handle.net/2027/uiug.30112026470077"}},"suggested":false}],"whole_order_end_total":3},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"confirm","counterevidence":"confirm","ending_or_current_basis":"confirm","opus_media":"n/a","original_text":"confirm","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":[],"would_satisfy_once_confirmed":["original_text","clause_inventory","ending_or_current_basis","counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"1978-09-27","later-events_catalog":"1978-09-27","stage19_causal_queue":"1978-09-27"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:12084","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-101. There is established the Judicial Nominating Commission for the District of Puerto Rico.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); APP node 243423; common-crawl capture 2026-01-17T22:01:48Z; Sec. 1-101","sha256":"80605f511d61184bd4c94ccda394118b268c732670e38eaad33d767673960d5d","url":"https://www.presidency.ucsb.edu/documents/executive-order-12084-judicial-nominating-commission-for-the-district-puerto-rico"},"scope_id":"EO:12084#sec1-101","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-102. The Commission shall have seven members appointed by the President. The President shall designate a Chairman from among the members.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); APP node 243423; common-crawl capture 2026-01-17T22:01:48Z; Sec. 1-102","sha256":"80605f511d61184bd4c94ccda394118b268c732670e38eaad33d767673960d5d","url":"https://www.presidency.ucsb.edu/documents/executive-order-12084-judicial-nominating-commission-for-the-district-puerto-rico"},"scope_id":"EO:12084#sec1-102","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-201. The Commission shall begin functioning when the President or his designee notifies the Chairman that the President desires the Commission's assistance in identifying persons qualified to fill a vacancy on the United States District Court for the District of Puerto Rico.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); APP node 243423; common-crawl capture 2026-01-17T22:01:48Z; Sec. 1-201","sha256":"80605f511d61184bd4c94ccda394118b268c732670e38eaad33d767673960d5d","url":"https://www.presidency.ucsb.edu/documents/executive-order-12084-judicial-nominating-commission-for-the-district-puerto-rico"},"scope_id":"EO:12084#sec1-201","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-202. Upon receiving such notification, the Commission shall:","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); APP node 243423; common-crawl capture 2026-01-17T22:01:48Z; Sec. 1-202 (lead-in)","sha256":"80605f511d61184bd4c94ccda394118b268c732670e38eaad33d767673960d5d","url":"https://www.presidency.ucsb.edu/documents/executive-order-12084-judicial-nominating-commission-for-the-district-puerto-rico"},"scope_id":"EO:12084#sec1-202","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) give public notice of the vacancy, inviting suggestions as to potential nominees;","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); APP node 243423; common-crawl capture 2026-01-17T22:01:48Z; Sec. 1-202(a)","sha256":"80605f511d61184bd4c94ccda394118b268c732670e38eaad33d767673960d5d","url":"https://www.presidency.ucsb.edu/documents/executive-order-12084-judicial-nominating-commission-for-the-district-puerto-rico"},"scope_id":"EO:12084#sec1-202(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) conduct inquiries to identify potential nominees;","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); APP node 243423; common-crawl capture 2026-01-17T22:01:48Z; Sec. 1-202(b)","sha256":"80605f511d61184bd4c94ccda394118b268c732670e38eaad33d767673960d5d","url":"https://www.presidency.ucsb.edu/documents/executive-order-12084-judicial-nominating-commission-for-the-district-puerto-rico"},"scope_id":"EO:12084#sec1-202(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) conduct inquiries to identify, among the potential nominees, persons who are well qualified to serve as a United States District Judge; and","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); APP node 243423; common-crawl capture 2026-01-17T22:01:48Z; Sec. 1-202(c)","sha256":"80605f511d61184bd4c94ccda394118b268c732670e38eaad33d767673960d5d","url":"https://www.presidency.ucsb.edu/documents/executive-order-12084-judicial-nominating-commission-for-the-district-puerto-rico"},"scope_id":"EO:12084#sec1-202(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) report to the President, within the time specified in the notification, the results of its activities, including a list of the persons whom the Commission considers to be best qualified to fill the vacancy.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); APP node 243423; common-crawl capture 2026-01-17T22:01:48Z; Sec. 1-202(d)","sha256":"80605f511d61184bd4c94ccda394118b268c732670e38eaad33d767673960d5d","url":"https://www.presidency.ucsb.edu/documents/executive-order-12084-judicial-nominating-commission-for-the-district-puerto-rico"},"scope_id":"EO:12084#sec1-202(d)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-203. In evaluating potential nominees, the Commission shall use standards provided by the Attorney General.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); APP node 243423; common-crawl capture 2026-01-17T22:01:48Z; Sec. 1-203","sha256":"80605f511d61184bd4c94ccda394118b268c732670e38eaad33d767673960d5d","url":"https://www.presidency.ucsb.edu/documents/executive-order-12084-judicial-nominating-commission-for-the-district-puerto-rico"},"scope_id":"EO:12084#sec1-203","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-301. Members of the Commission shall serve without compensation. While engaged in the work of the Commission, members may receive travel expenses, including per diem in lieu of subsistence, as authorized by law (5 U.S.C. 5702 and 5703).","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); APP node 243423; common-crawl capture 2026-01-17T22:01:48Z; Sec. 1-301","sha256":"80605f511d61184bd4c94ccda394118b268c732670e38eaad33d767673960d5d","url":"https://www.presidency.ucsb.edu/documents/executive-order-12084-judicial-nominating-commission-for-the-district-puerto-rico"},"scope_id":"EO:12084#sec1-301","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-302. The Attorney General shall furnish to the Commission necessary administrative support.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); APP node 243423; common-crawl capture 2026-01-17T22:01:48Z; Sec. 1-302","sha256":"80605f511d61184bd4c94ccda394118b268c732670e38eaad33d767673960d5d","url":"https://www.presidency.ucsb.edu/documents/executive-order-12084-judicial-nominating-commission-for-the-district-puerto-rico"},"scope_id":"EO:12084#sec1-302","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-303. All necessary expenses incurred in connection with the work of the Commission, to the extent permitted by law, shall be paid from funds available to the Attorney General.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); APP node 243423; common-crawl capture 2026-01-17T22:01:48Z; Sec. 1-303","sha256":"80605f511d61184bd4c94ccda394118b268c732670e38eaad33d767673960d5d","url":"https://www.presidency.ucsb.edu/documents/executive-order-12084-judicial-nominating-commission-for-the-district-puerto-rico"},"scope_id":"EO:12084#sec1-303","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-401. A person who is a member of the Commission shall not, during the period of membership and for one year after that period, be ,considered by the Commission as a potential nominee.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); APP node 243423; common-crawl capture 2026-01-17T22:01:48Z; Sec. 1-401","sha256":"80605f511d61184bd4c94ccda394118b268c732670e38eaad33d767673960d5d","url":"https://www.presidency.ucsb.edu/documents/executive-order-12084-judicial-nominating-commission-for-the-district-puerto-rico"},"scope_id":"EO:12084#sec1-401","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-402. Notwithstanding the provisions of any other Executive order, the functions of the President under the Federal Advisory Committee Act (5 U.S.C. App. I), except that of reporting annually to the Congress, which are applicable to the Commission, shall be performed by the Attorney General in accordance with the guidelines and procedures established by the Administrator of General Services.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); APP node 243423; common-crawl capture 2026-01-17T22:01:48Z; Sec. 1-402","sha256":"80605f511d61184bd4c94ccda394118b268c732670e38eaad33d767673960d5d","url":"https://www.presidency.ucsb.edu/documents/executive-order-12084-judicial-nominating-commission-for-the-district-puerto-rico"},"scope_id":"EO:12084#sec1-402","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-403. The Commission shall terminate on December 31, 1978, unless sooner extended by the President.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); APP node 243423; common-crawl capture 2026-01-17T22:01:48Z; Sec. 1-403","sha256":"80605f511d61184bd4c94ccda394118b268c732670e38eaad33d767673960d5d","url":"https://www.presidency.ucsb.edu/documents/executive-order-12084-judicial-nominating-commission-for-the-district-puerto-rico"},"scope_id":"EO:12084#sec1-403","state_at_cutoff":null}],"original_representation":{"page_or_item":"43 FR 44815, PDF pages 17-18","sha256":"21fd4d467cdf794064e6f4dde942762ae621d6c704b0c7fff2acd0a67d19e2ae","url":"https://www.govinfo.gov/content/pkg/FR-1978-09-29/pdf/FR-1978-09-29.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 15 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:12084"}
