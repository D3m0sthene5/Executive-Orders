],"fr_citation":"48 FR 381","from":"fr-originals@jobs/fr-originals/output","grade":"fr_originals_high","location_confidence":"high","publication_date":"1983-01-05","ref":{"page_or_item":"48 FR 381, PDF pages 11-12","sha256":"4330a1aa743f228ed915aa5a8b604a42291e75b8dfd394d74d60d66c22e39408","url":"https://www.govinfo.gov/content/pkg/FR-1983-01-05/pdf/FR-1983-01-05.pdf"},"signing_date":"1983-01-03","source_id":"fr-originals:EO:12400:4330a1aa743f","strong":true,"text_path":"texts/EO_12400.txt","why":"page location high; location_verified is false - open the PDF pages"}],"savings_leads":[],"whole_order_end":[],"whole_order_end_total":0},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"research","counterevidence":"resolve_conflicts","ending_or_current_basis":"research","opus_media":"n/a","original_text":"confirm","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":["clause_inventory","ending_or_current_basis"],"would_satisfy_once_confirmed":["original_text"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"1983-01-03","later-events_catalog":"1983-01-03","stage19_causal_queue":"1983-01-03"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:12400","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"it is hereby ordered as follows:\nSection 1, Establishm ent, (a) There is established the President’s Commission  \non Strategic Forces. The Commission shall be composed of no more than 15  \nmembers appointed or designated by the President. These members shall have  \nparticular knowledge and expertise concerning the national security, strategic  \nforces, or foreign relations of the United States.\n(b) The President shall designate a Chairman from among the members of the  \nCommission.","original_source":{"page_or_item":"48 FR 381, PDF pages 11-12; operative words before the numbered sections","sha256":"4330a1aa743f228ed915aa5a8b604a42291e75b8dfd394d74d60d66c22e39408","url":"https://www.govinfo.gov/content/pkg/FR-1983-01-05/pdf/FR-1983-01-05.pdf"},"scope_id":"EO:12400#preamble-op","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The Commission shall review the strategic moderniza­\ntion program for United States forces, with particular reference to the inter­\ncontinental ballistic missile system and basing alternatives for that system,  \nand provide appropriate advice to the President, the National Security Coun­\ncil, and the Department of Defense.","original_source":{"page_or_item":"48 FR 381, PDF pages 11-12; Sec. 2(a)","sha256":"4330a1aa743f228ed915aa5a8b604a42291e75b8dfd394d74d60d66c22e39408","url":"https://www.govinfo.gov/content/pkg/FR-1983-01-05/pdf/FR-1983-01-05.pdf"},"scope_id":"EO:12400#sec2(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The Commission shall report to the President by February 18, 1983.","original_source":{"page_or_item":"48 FR 381, PDF pages 11-12; Sec. 2(b)","sha256":"4330a1aa743f228ed915aa5a8b604a42291e75b8dfd394d74d60d66c22e39408","url":"https://www.govinfo.gov/content/pkg/FR-1983-01-05/pdf/FR-1983-01-05.pdf"},"scope_id":"EO:12400#sec2(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The heads of Executive agencies shall, to the extent  \npermitted by law, provide the Commission such information as it may require  \nfor purposes of carrying out its functions. Information supplied to or developed \nby the Commission shall not, to the extent permitted by law, be available for  \npublic inspection.","original_source":{"page_or_item":"48 FR 381, PDF pages 11-12; Sec. 3(a)","sha256":"4330a1aa743f228ed915aa5a8b604a42291e75b8dfd394d74d60d66c22e39408","url":"https://www.govinfo.gov/content/pkg/FR-1983-01-05/pdf/FR-1983-01-05.pdf"},"scope_id":"EO:12400#sec3(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) Mêmbers of the Commission shall serve without compensation for their  \nwork on the Commission. However, members appointed from among private  \ncitizens of the United States may be allowed travel expenses, including per  \ndiem in lieu of subsistence, as authorized by law for persons serving intermit­\ntently in the government service (5 U.S.C. 5701-5707), to the extent funds are  \navailable therefor.","original_source":{"page_or_item":"48 FR 381, PDF pages 11-12; Sec. 3(b)","sha256":"4330a1aa743f228ed915aa5a8b604a42291e75b8dfd394d74d60d66c22e39408","url":"https://www.govinfo.gov/content/pkg/FR-1983-01-05/pdf/FR-1983-01-05.pdf"},"scope_id":"EO:12400#sec3(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) The Secretary of Defense shall provide the Commission with such adminis­\ntrative services, facilities, staff and other support services as may be neces­\nsary. Any expenses of the Commission shall be paid from such funds as may  \nbe available to the Secretary of Defense.","original_source":{"page_or_item":"48 FR 381, PDF pages 11-12; Sec. 3(c)","sha256":"4330a1aa743f228ed915aa5a8b604a42291e75b8dfd394d74d60d66c22e39408","url":"https://www.govinfo.gov/content/pkg/FR-1983-01-05/pdf/FR-1983-01-05.pdf"},"scope_id":"EO:12400#sec3(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) Notwithstanding any other Executive Order, the functions  \nof the President under the Federal Advisory Committee Act, as amended,  \nexcept that of reporting to the Congress, which are applicable to the Commis­\nsion, shall be performed by the Secretary of Defense, in accordance with  \nguidelines and procedures established by the Administrator of General Serv­\nices.\n\n=== PDF page 12 of 248 ===\n382 Federal Register /  Vol. 48, No. 3 / Wednesday, January 5,1983 / Presidential Documents\n(b) The Commission shall terminate 30 days after its report, unless sooner \nextended.","original_source":{"page_or_item":"48 FR 381, PDF pages 11-12; Sec. 4(a)","sha256":"4330a1aa743f228ed915aa5a8b604a42291e75b8dfd394d74d60d66c22e39408","url":"https://www.govinfo.gov/content/pkg/FR-1983-01-05/pdf/FR-1983-01-05.pdf"},"scope_id":"EO:12400#sec4(a)","state_at_cutoff":null}],"original_representation":{"page_or_item":"48 FR 381, PDF pages 11-12","sha256":"4330a1aa743f228ed915aa5a8b604a42291e75b8dfd394d74d60d66c22e39408","url":"https://www.govinfo.gov/content/pkg/FR-1983-01-05/pdf/FR-1983-01-05.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 7 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)","CONFLICT FULL_AND_PARTIAL_EVIDENCE_CONFLICT: EO:12534: the sources read as both a whole and a partial ending"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:12400"}
