ion%5D=0&conditions%5Bpresidential_document_type%5D=executive_order&conditions%5Btype%5D%5B%5D=PRESDOCU&fields%5B%5D=citation&fields%5B%5D=disposition_notes&fields%5B%5D=document_number&fields%5B%5D=executive_order_number&fields%5B%5D=html_url&fields%5B%5D=pdf_url&fields%5B%5D=president&fields%5B%5D=publication_date&fields%5B%5D=raw_text_url&fields%5B%5D=signing_date&fields%5B%5D=title&format=json&include_pre_1994_docs=true&order=executive_order_number&page=6&per_page=1000&search_after_cursor=WzEyNDk3LjAsIjEyNDk3Il0"}}}],"later_events_total":12,"later_source_search_machine":[{"machine_hits_for_this_order":0,"search_id":"current-law:usc"},{"machine_hits_for_this_order":0,"search_id":"current-law:ecfr"},{"machine_hits_for_this_order":12,"search_id":"later-events:ofr_catalog"}],"later_source_search_partial":[],"original_representation":[{"custody_records_in":["fr-originals","later-events"],"fr_citation":"45 FR 7773","from":"fr-originals@jobs/fr-originals/output","grade":"fr_originals_high","location_confidence":"high","publication_date":"1980-02-05","ref":{"page_or_item":"45 FR 7773, PDF pages 11-12","sha256":"6134d1e4a0b67cc0ec7a6c2ccf71ee42728253cea4bff5f34684a73da8d44aad","url":"https://www.govinfo.gov/content/pkg/FR-1980-02-05/pdf/FR-1980-02-05.pdf"},"signing_date":"1980-02-01","source_id":"fr-originals:EO:12190:6134d1e4a0b6","strong":true,"text_path":"texts/EO_12190.txt","why":"page location high; location_verified is false - open the PDF pages"}],"savings_leads":[],"whole_order_end":[],"whole_order_end_total":0},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"research","counterevidence":"confirm","ending_or_current_basis":"research","opus_media":"research","original_text":"confirm","savings_residuals":"agent_judgment","shared_sources":"confirm"},"needs_research":["clause_inventory","ending_or_current_basis","opus_media"],"would_satisfy_once_confirmed":["original_text","counterevidence","shared_sources"]},"shared_sources":[{"authority":"EO::12692","route":"official/govinfo_fr_issue_pdf","source":{"page_or_item":"54 FR 40627, PDF pages 11-12","sha256":"4fed43c8ec3525e806ca8c16834089265bf3c95a0e8987b506444d45fcafe80c","url":"https://www.govinfo.gov/content/pkg/FR-1989-10-03/pdf/FR-1989-10-03.pdf"},"source_id":"source-ladder:EO_12692:4fed43c8ec35","status":"found_by_source_ladder"}],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"1980-02-01","later-events_catalog":"1980-02-01","stage19_causal_queue":"1980-02-01"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:12190","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-101. There is established an Advisory Committee on Small and Minority Business Ownership composed of five high-level officers from five United States businesses and five representatives of minority small businesses.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); Sec. 1-101","sha256":"882019af7ed89a429720700ae30220f2a97af3bba54001fefe5c59dcb796e077","url":"https://www.presidency.ucsb.edu/documents/executive-order-12190-advisory-committee-small-and-minority-business-ownership"},"scope_id":"EO:12190#sec1-101","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-102. The President shall appoint the members of the Committee and designate a Chairman from among its members.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); Sec. 1-102","sha256":"882019af7ed89a429720700ae30220f2a97af3bba54001fefe5c59dcb796e077","url":"https://www.presidency.ucsb.edu/documents/executive-order-12190-advisory-committee-small-and-minority-business-ownership"},"scope_id":"EO:12190#sec1-102","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-103. In selecting the members, the President shall give due consideration to the particular skills desirable to accomplish the purpose .and functions of the Committee.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); Sec. 1-103","sha256":"882019af7ed89a429720700ae30220f2a97af3bba54001fefe5c59dcb796e077","url":"https://www.presidency.ucsb.edu/documents/executive-order-12190-advisory-committee-small-and-minority-business-ownership"},"scope_id":"EO:12190#sec1-103","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The Committee shall assist in monitoring and encouraging the placement of subcontracts by the private sector with eligible small businesses, particularly with small minority businesses, and shall study and propose the incentives and assistance needed by the private sector to help in the training, development, and upgrading of such businesses.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); Sec. 1-201(a)","sha256":"882019af7ed89a429720700ae30220f2a97af3bba54001fefe5c59dcb796e077","url":"https://www.presidency.ucsb.edu/documents/executive-order-12190-advisory-committee-small-and-minority-business-ownership"},"scope_id":"EO:12190#sec1-201(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) Eligible small businesses are those located in areas of high concentration of unemployed or low-income individuals, businesses owned by low-income individuals, and those businesses eligible for assistance under Section 8(a) of the Small Business Act (15 U.S.C. 637(a), 92 Stat. 1761).","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); Sec. 1-201(b)","sha256":"882019af7ed89a429720700ae30220f2a97af3bba54001fefe5c59dcb796e077","url":"https://www.presidency.ucsb.edu/documents/executive-order-12190-advisory-committee-small-and-minority-business-ownership"},"scope_id":"EO:12190#sec1-201(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-202. The Committee shall make periodic reports and recommendations to the President through the Administrator of the Small Business Administration and shall offer such other advice and at such times as the President through the Administrator may request.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); Sec. 1-202","sha256":"882019af7ed89a429720700ae30220f2a97af3bba54001fefe5c59dcb796e077","url":"https://www.presidency.ucsb.edu/documents/executive-order-12190-advisory-committee-small-and-minority-business-ownership"},"scope_id":"EO:12190#sec1-202","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-203. The Committee, through its Chairman, shall report annually to the President and to the Congress on the activities of the Committee during the preceding calendar year.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); Sec. 1-203","sha256":"882019af7ed89a429720700ae30220f2a97af3bba54001fefe5c59dcb796e077","url":"https://www.presidency.ucsb.edu/documents/executive-order-12190-advisory-committee-small-and-minority-business-ownership"},"scope_id":"EO:12190#sec1-203","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-301. The Committee may request any Executive agency to furnish such information as may be useful in fulfilling the Committee's functions. Each such agency is authorized, to the extent permitted by law, to furnish such information to the Committee.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); Sec. 1-301","sha256":"882019af7ed89a429720700ae30220f2a97af3bba54001fefe5c59dcb796e077","url":"https://www.presidency.ucsb.edu/documents/executive-order-12190-advisory-committee-small-and-minority-business-ownership"},"scope_id":"EO:12190#sec1-301","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-302. Each member of the Committee who is not otherwise employed by the Federal Government shall receive no compensation from the United States by virtue of their service on the Committee, but all members may receive transportation and travel expenses, including per diem in lieu of subsistence, as authorized by 5 U.S.C. 5702 and 5703.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); Sec. 1-302","sha256":"882019af7ed89a429720700ae30220f2a97af3bba54001fefe5c59dcb796e077","url":"https://www.presidency.ucsb.edu/documents/executive-order-12190-advisory-committee-small-and-minority-business-ownership"},"scope_id":"EO:12190#sec1-302","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-303. All necessary administrative staff services, support, facilities, and expenses of the Committee shall, to the extent permitted by law, be furnished by the Small Business Administration.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); Sec. 1-303","sha256":"882019af7ed89a429720700ae30220f2a97af3bba54001fefe5c59dcb796e077","url":"https://www.presidency.ucsb.edu/documents/executive-order-12190-advisory-committee-small-and-minority-business-ownership"},"scope_id":"EO:12190#sec1-303","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-401. The functions of the President under the Federal Advisory Committee Act, as amended (5 U.S.C. App. I), except that of reporting annually to the Congress, which are applicable to the Committee, shall be performed by the Administrator of the Small Business Administration in accordance with guidelines and procedures established by the Administrator of General Services.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); Sec. 1-401","sha256":"882019af7ed89a429720700ae30220f2a97af3bba54001fefe5c59dcb796e077","url":"https://www.presidency.ucsb.edu/documents/executive-order-12190-advisory-committee-small-and-minority-business-ownership"},"scope_id":"EO:12190#sec1-401","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-402. The Committee shall terminate on December 31, 1980.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); Sec. 1-402","sha256":"882019af7ed89a429720700ae30220f2a97af3bba54001fefe5c59dcb796e077","url":"https://www.presidency.ucsb.edu/documents/executive-order-12190-advisory-committee-small-and-minority-business-ownership"},"scope_id":"EO:12190#sec1-402","state_at_cutoff":null}],"original_representation":{"page_or_item":"45 FR 7773, PDF pages 11-12","sha256":"6134d1e4a0b67cc0ec7a6c2ccf71ee42728253cea4bff5f34684a73da8d44aad","url":"https://www.govinfo.gov/content/pkg/FR-1980-02-05/pdf/FR-1980-02-05.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 12 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:12190"}
