R-1978-11-03/pdf/FR-1978-11-03.pdf"},"scope_id":"EO:12093#sec1-102(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The Speaker o f the House o f Representatives and the President of the  \nSenate are each invited to designate five members o f their respective Houses  \nto serve as members o f the Commission.","original_source":{"page_or_item":"43 FR 51377, PDF pages 15-16; Sec. 1-102(b)","sha256":"2d490dbf22ef208d9381dc667ded7f0b1976eadf4c007746106d0cdf4bb3f757","url":"https://www.govinfo.gov/content/pkg/FR-1978-11-03/pdf/FR-1978-11-03.pdf"},"scope_id":"EO:12093#sec1-102(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-201. The Commission shall submit a report to the President and the  \nSecretary o f the Interior containing its recommendations with respect to the  \nestablishment and maintenance of an appropriate memorial to those who  \nperished in the Holocaust.","original_source":{"page_or_item":"43 FR 51377, PDF pages 15-16; Sec. 1-201","sha256":"2d490dbf22ef208d9381dc667ded7f0b1976eadf4c007746106d0cdf4bb3f757","url":"https://www.govinfo.gov/content/pkg/FR-1978-11-03/pdf/FR-1978-11-03.pdf"},"scope_id":"EO:12093#sec1-201","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-202. The Commission’s report shall examine the feasibility of obtaining  \nfunds for creation and maintenance o f the Memorial through contributions by  \nthe American people.","original_source":{"page_or_item":"43 FR 51377, PDF pages 15-16; Sec. 1-202","sha256":"2d490dbf22ef208d9381dc667ded7f0b1976eadf4c007746106d0cdf4bb3f757","url":"https://www.govinfo.gov/content/pkg/FR-1978-11-03/pdf/FR-1978-11-03.pdf"},"scope_id":"EO:12093#sec1-202","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-203. The Commission shall recommend appropriate ways for the nation  \nto commemorate April 28 and 29, 1979, which the Congress has resolved shall  \nbe “ Days o f Remembrance o f Victims o f the Holocaust.”","original_source":{"page_or_item":"43 FR 51377, PDF pages 15-16; Sec. 1-203","sha256":"2d490dbf22ef208d9381dc667ded7f0b1976eadf4c007746106d0cdf4bb3f757","url":"https://www.govinfo.gov/content/pkg/FR-1978-11-03/pdf/FR-1978-11-03.pdf"},"scope_id":"EO:12093#sec1-203","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-301. T o the extent permitted by law, the Secretary o f the Interior shall  \nprovide all necessary administrative services, facilities, support, and funds  \nnecessary for the performance o f the Commission’s functions.","original_source":{"page_or_item":"43 FR 51377, PDF pages 15-16; Sec. 1-301","sha256":"2d490dbf22ef208d9381dc667ded7f0b1976eadf4c007746106d0cdf4bb3f757","url":"https://www.govinfo.gov/content/pkg/FR-1978-11-03/pdf/FR-1978-11-03.pdf"},"scope_id":"EO:12093#sec1-301","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-302. Each member of the Commission who is not otherwise employed  \nin the Government may receive compensation for each day such member is  \nengaged in the work of the Commission at a daily rate to be determined by  \nthe Secretary o f the Interior. Such rate shall not exceed that payable pursuant  \nto the Federal Advisory Committee Act.","original_source":{"page_or_item":"43 FR 51377, PDF pages 15-16; Sec. 1-302","sha256":"2d490dbf22ef208d9381dc667ded7f0b1976eadf4c007746106d0cdf4bb3f757","url":"https://www.govinfo.gov/content/pkg/FR-1978-11-03/pdf/FR-1978-11-03.pdf"},"scope_id":"EO:12093#sec1-302","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-303. Members of the Commission shall be entitled to travel expenses,  \nincluding per diem in lieu o f subsistence, as authorized by law (5 U.S.C. 5702  \nand 5703) for persons in the Government service employed intermittently.","original_source":{"page_or_item":"43 FR 51377, PDF pages 15-16; Sec. 1-303","sha256":"2d490dbf22ef208d9381dc667ded7f0b1976eadf4c007746106d0cdf4bb3f757","url":"https://www.govinfo.gov/content/pkg/FR-1978-11-03/pdf/FR-1978-11-03.pdf"},"scope_id":"EO:12093#sec1-303","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-304. The functions o f the President under thé Federal Advisory Com­\nmittee Act which are applicable to the Commission, except that o f reporting to  \nthe Congress, shall be performed by the Secretary o f the Interior in accord­\nance with guidelines and procedures prescribed by the Administrator o f Gen­\neral Services.\nFEDERAL REGISTER, V O L  43, NO. 214— FRIDAY, NOVEMBER 3, 1978\n\n=== PDF page 16 of 208 ===\n51378 THE PRESIDENT\n1-4. F inal R eport and Termination.","original_source":{"page_or_item":"43 FR 51377, PDF pages 15-16; Sec. 1-304","sha256":"2d490dbf22ef208d9381dc667ded7f0b1976eadf4c007746106d0cdf4bb3f757","url":"https://www.govinfo.gov/content/pkg/FR-1978-11-03/pdf/FR-1978-11-03.pdf"},"scope_id":"EO:12093#sec1-304","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-401. The Commission shall submit its final report to the President and  \nthe Secretary of the Interior not later than six months from the date of its first  \nmeeting.","original_source":{"page_or_item":"43 FR 51377, PDF pages 15-16; Sec. 1-401","sha256":"2d490dbf22ef208d9381dc667ded7f0b1976eadf4c007746106d0cdf4bb3f757","url":"https://www.govinfo.gov/content/pkg/FR-1978-11-03/pdf/FR-1978-11-03.pdf"},"scope_id":"EO:12093#sec1-401","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-402. The Commission shall terminate not later than thirty days after  \nsubmitting its final report.","original_source":{"page_or_item":"43 FR 51377, PDF pages 15-16; Sec. 1-402","sha256":"2d490dbf22ef208d9381dc667ded7f0b1976eadf4c007746106d0cdf4bb3f757","url":"https://www.govinfo.gov/content/pkg/FR-1978-11-03/pdf/FR-1978-11-03.pdf"},"scope_id":"EO:12093#sec1-402","state_at_cutoff":null}],"original_representation":{"page_or_item":"43 FR 51377, PDF pages 15-16","sha256":"2d490dbf22ef208d9381dc667ded7f0b1976eadf4c007746106d0cdf4bb3f757","url":"https://www.govinfo.gov/content/pkg/FR-1978-11-03/pdf/FR-1978-11-03.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 14 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:12093"}
