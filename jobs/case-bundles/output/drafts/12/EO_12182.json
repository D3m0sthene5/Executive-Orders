end":null,"later_events":[],"original_operative_text":"1-101. Establishm ent o f Board. There is established a board of three members \nto be appointed by the President to investigate this dispute. No member of the \nboard shall be pecuniarily or otherwise interested in any organization of \nrailroad employees or any carrier.","original_source":{"page_or_item":"44 FR 74785, PDF pages 13-13; Sec. 1-101","sha256":"2f08f0f447a6dfd55c012829237c873ddbf96950c0c1102e99972419bdd9df86","url":"https://www.govinfo.gov/content/pkg/FR-1979-12-18/pdf/FR-1979-12-18.pdf"},"scope_id":"EO:12182#sec1-101","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-102. Report. The board shall report its finding to the President with respect \nto the dispute within 30 days from the date of this Order.","original_source":{"page_or_item":"44 FR 74785, PDF pages 13-13; Sec. 1-102","sha256":"2f08f0f447a6dfd55c012829237c873ddbf96950c0c1102e99972419bdd9df86","url":"https://www.govinfo.gov/content/pkg/FR-1979-12-18/pdf/FR-1979-12-18.pdf"},"scope_id":"EO:12182#sec1-102","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-103. M aintaining Conditions. As provided by Section 10 of the Railway \nLabor Act, as amended, from this date and for 30 days after the board has \nmade its report to the President, no change, except by agreement, shall be \nmade by The Long Island Rail Road, or by its employees, in the conditions out \nof which the dispute arose.","original_source":{"page_or_item":"44 FR 74785, PDF pages 13-13; Sec. 1-103","sha256":"2f08f0f447a6dfd55c012829237c873ddbf96950c0c1102e99972419bdd9df86","url":"https://www.govinfo.gov/content/pkg/FR-1979-12-18/pdf/FR-1979-12-18.pdf"},"scope_id":"EO:12182#sec1-103","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"D ecem ber 14, 1979.\nParticipating Labor Organizations\nInternational Brotherhood of Teamsters (IBT)\nUnited Transportation Union (UTU)\nBrotherhood of Locomotive Engineers (BLE)\nBrotherhood of Railroad Carmen (BRC)\nBrotherhood of Railroad Signalmen (BRS)\nRailroad Yardmasters of America (RYA)\nPolice Benevolent Association (PBA)\nEditorial Note: The President’s announcement of Dec. 14,1979, on establishing the Board and the  \nappointment of the membership to the Board, are printed in the Weekly Compilation of Presiden­\ntial Documents (Vol. 15, No. 50).","original_source":{"page_or_item":"44 FR 74785, PDF pages 13-13; text printed after the signature (annex/schedule)","sha256":"2f08f0f447a6dfd55c012829237c873ddbf96950c0c1102e99972419bdd9df86","url":"https://www.govinfo.gov/content/pkg/FR-1979-12-18/pdf/FR-1979-12-18.pdf"},"scope_id":"EO:12182#annex","state_at_cutoff":null}],"original_representation":{"page_or_item":"44 FR 74785, PDF pages 13-13","sha256":"2f08f0f447a6dfd55c012829237c873ddbf96950c0c1102e99972419bdd9df86","url":"https://www.govinfo.gov/content/pkg/FR-1979-12-18/pdf/FR-1979-12-18.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 5 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:12182"}
