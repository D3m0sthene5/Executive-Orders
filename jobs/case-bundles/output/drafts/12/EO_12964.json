m":"OFR API record executive_order_number=12964; citation 60 FR 33095; document_number 95-15760; field disposition_notes","sha256":"8ba9e1cce593bb06b6be625b585b15bb04a1555ed34ad8c5b6f8c9bd81f83f77","url":"https://www.federalregister.gov/api/v1/documents?conditions%5Bcorrection%5D=0&conditions%5Bpresidential_document_type%5D=executive_order&conditions%5Btype%5D%5B%5D=PRESDOCU&fields%5B%5D=citation&fields%5B%5D=disposition_notes&fields%5B%5D=document_number&fields%5B%5D=executive_order_number&fields%5B%5D=html_url&fields%5B%5D=pdf_url&fields%5B%5D=president&fields%5B%5D=publication_date&fields%5B%5D=raw_text_url&fields%5B%5D=signing_date&fields%5B%5D=title&format=json&include_pre_1994_docs=true&order=executive_order_number&page=6&per_page=1000&search_after_cursor=WzEyNDk3LjAsIjEyNDk3Il0"}},"suggested":true}],"whole_order_end_total":1},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"confirm","counterevidence":"confirm","ending_or_current_basis":"confirm","opus_media":"n/a","original_text":"done_now_by_custody","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":[],"would_satisfy_once_confirmed":["clause_inventory","ending_or_current_basis","counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"1995-06-21","later-events_catalog":"1995-06-21","research/stage21/original_sources/CASE_ORIGINAL_SOURCE_CUSTODY.csv":"1995-06-21","stage19_causal_queue":"1995-06-21","stage21_crosswalk":"1995-06-21"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:12964","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) There is established the Commission on United\nStates-Pacific Trade and Investment Policy (‘‘Commission’’). The Commission\nshall be composed of 15 members to be appointed by the President. Members\nshall (1) be chosen from the private sector (businesses, unions, academic\ninstitutions, and nonprofit corporations); and (2) have substantial experience\nwith selling agricultural products, manufactured goods, or high-value-added\nservices to Asian and Pacific markets or be knowledgeable from their personal\nor professional experience about the trade barriers or their industry and\ngovernment policies and practices, formal and informal, that have restricted\naccess by U.S. business to Asian and Pacific markets.","original_source":{"page_or_item":"60 FR 33095, PDF pages 1-2; Sec. 1(a)","sha256":"0c095bc02f329291c923fe9daa3475d84951ae3344d27105e4c201e8baad9d21","url":"https://www.govinfo.gov/content/pkg/FR-1995-06-26/pdf/95-15760.pdf"},"scope_id":"EO:12964#sec1(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The President shall designate a Chairperson and Vice Chairperson\nfrom among the members of the Commission.","original_source":{"page_or_item":"60 FR 33095, PDF pages 1-2; Sec. 1(b)","sha256":"0c095bc02f329291c923fe9daa3475d84951ae3344d27105e4c201e8baad9d21","url":"https://www.govinfo.gov/content/pkg/FR-1995-06-26/pdf/95-15760.pdf"},"scope_id":"EO:12964#sec1(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) On or before February 1, 1996, the Commission shall\nreport to the President on the steps the United States should take to achieve\na significant opening of Japan, China, and other Asian and Pacific markets\nto U.S. business. The report also shall identify trade and investment impedi-\nments to U.S. business in Asian and Pacific markets and provide rec-\nommendations for reducing the impediments. The report’s recommendations\nshall reflect the goal of securing increased access for U.S. business to Asian\nand Pacific markets, by the turn of the century, in such a way that a\nmaximum number of high-wage jobs are created and maintained in the\nUnited States. The Commission also shall recommend to the President (1)\nmeasures to strengthen, if necessary, ongoing programs for regular monitoring\nof progress toward this goal, including the periodic assessment of the nature\nand scope of trade and investment impediments; and (2) realistic measure-\nments of trade and investment activity in Asia and the Pacific, which consider\nall relevant factors, including the composition of trade and intracompany\ntrade and investment patterns.","original_source":{"page_or_item":"60 FR 33095, PDF pages 1-2; Sec. 2(a)","sha256":"0c095bc02f329291c923fe9daa3475d84951ae3344d27105e4c201e8baad9d21","url":"https://www.govinfo.gov/content/pkg/FR-1995-06-26/pdf/95-15760.pdf"},"scope_id":"EO:12964#sec2(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The Commission shall decide by a three-fifths vote which recommenda-\ntions to include in the report. At the request of any Commission member,\nthe report will include that Commission member’s dissenting views or opin-\nions.","original_source":{"page_or_item":"60 FR 33095, PDF pages 1-2; Sec. 2(b)","sha256":"0c095bc02f329291c923fe9daa3475d84951ae3344d27105e4c201e8baad9d21","url":"https://www.govinfo.gov/content/pkg/FR-1995-06-26/pdf/95-15760.pdf"},"scope_id":"EO:12964#sec2(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) The Commission may, for the purpose of carrying out its functions,\nhold meetings at such times and places as the Commission may find advis-\nable.","original_source":{"page_or_item":"60 FR 33095, PDF pages 1-2; Sec. 2(c)","sha256":"0c095bc02f329291c923fe9daa3475d84951ae3344d27105e4c201e8baad9d21","url":"https://www.govinfo.gov/content/pkg/FR-1995-06-26/pdf/95-15760.pdf"},"scope_id":"EO:12964#sec2(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) To the extent permitted by law, the heads of\nexecutive departments, agencies, and independent instrumentalities shall\nprovide the Commission, upon request, with such information as it may\nrequire for the purposes of carrying out its functions.","original_source":{"page_or_item":"60 FR 33095, PDF pages 1-2; Sec. 3(a)","sha256":"0c095bc02f329291c923fe9daa3475d84951ae3344d27105e4c201e8baad9d21","url":"https://www.govinfo.gov/content/pkg/FR-1995-06-26/pdf/95-15760.pdf"},"scope_id":"EO:12964#sec3(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) Upon request of the Chairperson of the Commission, the head of\nany Federal agency or instrumentality shall, to the extent permitted by\nlaw and subject to the discretion of such head, (1) make any of the facilities\nand services of such agency or instrumentality available to the Commission;\n=== PDF page 2 of 2 ===\n33096 Federal Register / Vol. 60, No. 122 / Monday, June 26, 1995 / Presidential Documents\nand (2) detail any of the personnel of such agency or instrumentality to\nthe Commission to assist the Commission in carrying out its duties.","original_source":{"page_or_item":"60 FR 33095, PDF pages 1-2; Sec. 3(b)","sha256":"0c095bc02f329291c923fe9daa3475d84951ae3344d27105e4c201e8baad9d21","url":"https://www.govinfo.gov/content/pkg/FR-1995-06-26/pdf/95-15760.pdf"},"scope_id":"EO:12964#sec3(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) Members of the Commission shall serve without compensation for\ntheir work on the Commission. While engaged in the work of the Commission,\nmembers appointed from the private sector may be allowed travel expenses,\nincluding per diem in lieu of subsistence, as authorized by law for persons\nserving intermittently in the Government service (5 U.S.C. 5701–5707) to\nthe extent funds are available for such purposes.","original_source":{"page_or_item":"60 FR 33095, PDF pages 1-2; Sec. 3(c)","sha256":"0c095bc02f329291c923fe9daa3475d84951ae3344d27105e4c201e8baad9d21","url":"https://www.govinfo.gov/content/pkg/FR-1995-06-26/pdf/95-15760.pdf"},"scope_id":"EO:12964#sec3(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) To the extent permitted by law and subject to the availability of\nappropriations, the Department of Commerce shall provide the Commission\nwith administrative services, facilities, staff, and other support services nec-\nessary for performance of the Commission’s functions.","original_source":{"page_or_item":"60 FR 33095, PDF pages 1-2; Sec. 3(d)","sha256":"0c095bc02f329291c923fe9daa3475d84951ae3344d27105e4c201e8baad9d21","url":"https://www.govinfo.gov/content/pkg/FR-1995-06-26/pdf/95-15760.pdf"},"scope_id":"EO:12964#sec3(d)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(e) The United States Trade Representative shall perform the functions\nof the President under the Act, except that of reporting to the Congress,\nin accordance with the guidelines and procedures established by the Admin-\nistrator of General Services.","original_source":{"page_or_item":"60 FR 33095, PDF pages 1-2; Sec. 3(e)","sha256":"0c095bc02f329291c923fe9daa3475d84951ae3344d27105e4c201e8baad9d21","url":"https://www.govinfo.gov/content/pkg/FR-1995-06-26/pdf/95-15760.pdf"},"scope_id":"EO:12964#sec3(e)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(f) The Commission shall adhere to the requirements set forth in the\nAct. All executive branch officials assigned duties by the Act shall comply\nwith its requirements with respect to the Commission.","original_source":{"page_or_item":"60 FR 33095, PDF pages 1-2; Sec. 3(f)","sha256":"0c095bc02f329291c923fe9daa3475d84951ae3344d27105e4c201e8baad9d21","url":"https://www.govinfo.gov/content/pkg/FR-1995-06-26/pdf/95-15760.pdf"},"scope_id":"EO:12964#sec3(f)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 4. General Provision. The Commission shall terminate 30 days after\nsubmitting its final report.","original_source":{"page_or_item":"60 FR 33095, PDF pages 1-2; Sec. 4","sha256":"0c095bc02f329291c923fe9daa3475d84951ae3344d27105e4c201e8baad9d21","url":"https://www.govinfo.gov/content/pkg/FR-1995-06-26/pdf/95-15760.pdf"},"scope_id":"EO:12964#sec4","state_at_cutoff":null}],"original_representation":{"page_or_item":"whole per-document Federal Register PDF (60 FR 33095)","sha256":"0c095bc02f329291c923fe9daa3475d84951ae3344d27105e4c201e8baad9d21","url":"https://www.govinfo.gov/content/pkg/FR-1995-06-26/pdf/95-15760.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 12 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:12964"}
