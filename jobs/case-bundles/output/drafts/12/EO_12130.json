","url":"https://uscode.house.gov/download/releasepoints/us/pl/119/121/xml_uscAll@119-121.zip"}},"suggested":false}],"whole_order_end_total":2},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"confirm","counterevidence":"resolve_conflicts","ending_or_current_basis":"confirm","opus_media":"n/a","original_text":"confirm","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":[],"would_satisfy_once_confirmed":["original_text","clause_inventory","ending_or_current_basis"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"1979-04-11","later-events_catalog":"1979-04-11","stage19_causal_queue":"1979-04-11"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:12130","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-1. E s ta b lis h m e n t\n1-101. There is established the President’s Commission on the A ccident at \nThree Mile Island.","original_source":{"page_or_item":"44 FR 22027, PDF pages 11-12; Sec. 1-1","sha256":"33c3c496004cd4bca1e0bc331741e74716d62439ba17cee1c5fe34ebcc94c9d8","url":"https://www.govinfo.gov/content/pkg/FR-1979-04-13/pdf/FR-1979-04-13.pdf"},"scope_id":"EO:12130#sec1-1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-102. The membership of the Commission shall be com posed of not more \nthan tw elve persons appointed by the President from among citizens who are \nnot full time officers or employees w ithin the Executive Branch. The President \nshall designate a Chairm an from among the mem bers of the Commission.","original_source":{"page_or_item":"44 FR 22027, PDF pages 11-12; Sec. 1-102","sha256":"33c3c496004cd4bca1e0bc331741e74716d62439ba17cee1c5fe34ebcc94c9d8","url":"https://www.govinfo.gov/content/pkg/FR-1979-04-13/pdf/FR-1979-04-13.pdf"},"scope_id":"EO:12130#sec1-102","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-201. The Commission shall conduct a com prehensive study and investiga­\ntion of the recent accident involving the nuclear pow er facility on Three Mile \nIsland in Pennsylvania. The study and investigation shall include:","original_source":{"page_or_item":"44 FR 22027, PDF pages 11-12; Sec. 1-201 (lead-in)","sha256":"33c3c496004cd4bca1e0bc331741e74716d62439ba17cee1c5fe34ebcc94c9d8","url":"https://www.govinfo.gov/content/pkg/FR-1979-04-13/pdf/FR-1979-04-13.pdf"},"scope_id":"EO:12130#sec1-201","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) a technical assessm ent of the events and their causes;","original_source":{"page_or_item":"44 FR 22027, PDF pages 11-12; Sec. 1-201(a)","sha256":"33c3c496004cd4bca1e0bc331741e74716d62439ba17cee1c5fe34ebcc94c9d8","url":"https://www.govinfo.gov/content/pkg/FR-1979-04-13/pdf/FR-1979-04-13.pdf"},"scope_id":"EO:12130#sec1-201(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) an analysis of the role of the managing utility;","original_source":{"page_or_item":"44 FR 22027, PDF pages 11-12; Sec. 1-201(b)","sha256":"33c3c496004cd4bca1e0bc331741e74716d62439ba17cee1c5fe34ebcc94c9d8","url":"https://www.govinfo.gov/content/pkg/FR-1979-04-13/pdf/FR-1979-04-13.pdf"},"scope_id":"EO:12130#sec1-201(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) an assessm ent of the emergency preparedness and response of the Nuclear \nRegulatory Commission and other Federal, state and local authorities;","original_source":{"page_or_item":"44 FR 22027, PDF pages 11-12; Sec. 1-201(c)","sha256":"33c3c496004cd4bca1e0bc331741e74716d62439ba17cee1c5fe34ebcc94c9d8","url":"https://www.govinfo.gov/content/pkg/FR-1979-04-13/pdf/FR-1979-04-13.pdf"},"scope_id":"EO:12130#sec1-201(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) an evaluation of the N uclear Regulatory Commission’s licensing, inspec­\ntion, operation and enforcement procedures as applied to this facility;","original_source":{"page_or_item":"44 FR 22027, PDF pages 11-12; Sec. 1-201(d)","sha256":"33c3c496004cd4bca1e0bc331741e74716d62439ba17cee1c5fe34ebcc94c9d8","url":"https://www.govinfo.gov/content/pkg/FR-1979-04-13/pdf/FR-1979-04-13.pdf"},"scope_id":"EO:12130#sec1-201(d)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(e) an assessm ent of how  the public’s right to information concerning the \nevents at Three Mile Island w as served and of the steps which should be \ntaken during sim ilar emergencies to provide the public w ith accurate, compre­\nhensible and timely information; and","original_source":{"page_or_item":"44 FR 22027, PDF pages 11-12; Sec. 1-201(e)","sha256":"33c3c496004cd4bca1e0bc331741e74716d62439ba17cee1c5fe34ebcc94c9d8","url":"https://www.govinfo.gov/content/pkg/FR-1979-04-13/pdf/FR-1979-04-13.pdf"},"scope_id":"EO:12130#sec1-201(e)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(f) appropriate recom m endations based upon the Commission’s findings..","original_source":{"page_or_item":"44 FR 22027, PDF pages 11-12; Sec. 1-201(f)","sha256":"33c3c496004cd4bca1e0bc331741e74716d62439ba17cee1c5fe34ebcc94c9d8","url":"https://www.govinfo.gov/content/pkg/FR-1979-04-13/pdf/FR-1979-04-13.pdf"},"scope_id":"EO:12130#sec1-201(f)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-202. The Commission shall prepare and transm it to the President and to the \nSecretaries of Energy and Health, Education and W elfare a final report of its \nfindings and recom m endations.","original_source":{"page_or_item":"44 FR 22027, PDF pages 11-12; Sec. 1-202","sha256":"33c3c496004cd4bca1e0bc331741e74716d62439ba17cee1c5fe34ebcc94c9d8","url":"https://www.govinfo.gov/content/pkg/FR-1979-04-13/pdf/FR-1979-04-13.pdf"},"scope_id":"EO:12130#sec1-202","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-301. The Chairm an of the Commission is authorized to appoint and fix the \ncom pensation of a staff of such persons as m ay be necessary to discharge the \nCommission’s responsibilities, subject to the applicable provisions of the \nFederal A dvisory Committee Act and Title 5 of the United States Code.","original_source":{"page_or_item":"44 FR 22027, PDF pages 11-12; Sec. 1-301","sha256":"33c3c496004cd4bca1e0bc331741e74716d62439ba17cee1c5fe34ebcc94c9d8","url":"https://www.govinfo.gov/content/pkg/FR-1979-04-13/pdf/FR-1979-04-13.pdf"},"scope_id":"EO:12130#sec1-301","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-302. To the extent authorized by law  and requested by the Chairm an of the \nCommission, the General Services A dm inistration shall provide the Commis­\nsion with necessary adm inistrative services, facilities, and support on a \nreim bursable basis.","original_source":{"page_or_item":"44 FR 22027, PDF pages 11-12; Sec. 1-302","sha256":"33c3c496004cd4bca1e0bc331741e74716d62439ba17cee1c5fe34ebcc94c9d8","url":"https://www.govinfo.gov/content/pkg/FR-1979-04-13/pdf/FR-1979-04-13.pdf"},"scope_id":"EO:12130#sec1-302","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-303. The Departm ent of Energy and the Departm ent of Health, Education \nand W elfare shall, to the extent perm itted by law  and subject to the availabil­\nity of funds, provide the Commission w ith such facilities, support, funds and\n\n=== PDF page 12 of 376 ===\n22028 The President\nservices, including staff, as m ay be necessary for the effective perform ance of \nthe Commission’s functions.\nWÊÊÈÊÉÊÈ / ■\n1-304. The Commission m ay request any Executive agency to furnish such \ninformation, advice or assistance as it deems necessary to carry out its \nfunctions. Each such agency is directed, to the extent perm itted by law, to \nfurnish such information, advice or assistance upon request by the Chairman \nof the Commission.","original_source":{"page_or_item":"44 FR 22027, PDF pages 11-12; Sec. 1-303","sha256":"33c3c496004cd4bca1e0bc331741e74716d62439ba17cee1c5fe34ebcc94c9d8","url":"https://www.govinfo.gov/content/pkg/FR-1979-04-13/pdf/FR-1979-04-13.pdf"},"scope_id":"EO:12130#sec1-303","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-305. Each m em ber of the Commission m ay receive com pensation at the \nmaximum rate now  or hereafter prescribed by law  for each day such mem ber \nis engaged in the w ork of the Commission. Each member m ay also receive \ntravel expenses, including per diem in lieu of subsistence (5 U.S.C. 5702 and \n5703).","original_source":{"page_or_item":"44 FR 22027, PDF pages 11-12; Sec. 1-305","sha256":"33c3c496004cd4bca1e0bc331741e74716d62439ba17cee1c5fe34ebcc94c9d8","url":"https://www.govinfo.gov/content/pkg/FR-1979-04-13/pdf/FR-1979-04-13.pdf"},"scope_id":"EO:12130#sec1-305","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-306. The functions of the President under the Federal Advisory Committee \nAct which are applicable to the Commission, except that of reporting annually \nto the Congress, shall be perform ed by the A dm inistrator of G eneral Services.","original_source":{"page_or_item":"44 FR 22027, PDF pages 11-12; Sec. 1-306","sha256":"33c3c496004cd4bca1e0bc331741e74716d62439ba17cee1c5fe34ebcc94c9d8","url":"https://www.govinfo.gov/content/pkg/FR-1979-04-13/pdf/FR-1979-04-13.pdf"},"scope_id":"EO:12130#sec1-306","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-4. F in a l R e p o rt a n d  T erm in a tio n .","original_source":{"page_or_item":"44 FR 22027, PDF pages 11-12; Sec. 1-4","sha256":"33c3c496004cd4bca1e0bc331741e74716d62439ba17cee1c5fe34ebcc94c9d8","url":"https://www.govinfo.gov/content/pkg/FR-1979-04-13/pdf/FR-1979-04-13.pdf"},"scope_id":"EO:12130#sec1-4","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-401. The final report required by Section 1-202 of this O rder shall be \ntransm itted not later than six m onths from the date of the Commission’s first \nmeeting.","original_source":{"page_or_item":"44 FR 22027, PDF pages 11-12; Sec. 1-401","sha256":"33c3c496004cd4bca1e0bc331741e74716d62439ba17cee1c5fe34ebcc94c9d8","url":"https://www.govinfo.gov/content/pkg/FR-1979-04-13/pdf/FR-1979-04-13.pdf"},"scope_id":"EO:12130#sec1-401","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-402. The Commission shall term inate two m onths after the transm ittal of its \nfinal report.","original_source":{"page_or_item":"44 FR 22027, PDF pages 11-12; Sec. 1-402","sha256":"33c3c496004cd4bca1e0bc331741e74716d62439ba17cee1c5fe34ebcc94c9d8","url":"https://www.govinfo.gov/content/pkg/FR-1979-04-13/pdf/FR-1979-04-13.pdf"},"scope_id":"EO:12130#sec1-402","state_at_cutoff":null}],"original_representation":{"page_or_item":"44 FR 22027, PDF pages 11-12","sha256":"33c3c496004cd4bca1e0bc331741e74716d62439ba17cee1c5fe34ebcc94c9d8","url":"https://www.govinfo.gov/content/pkg/FR-1979-04-13/pdf/FR-1979-04-13.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 18 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","D