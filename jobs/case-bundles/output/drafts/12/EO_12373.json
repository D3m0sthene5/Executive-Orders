l_queue":"1982-07-21"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:12373","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"A dispute exists between the United Transportation Union and certain rail­\nroads represented by the National Carriers’  Conference Committee of the  \nNational Railway Labor Conference designated on the list attached hereto and  \nmade a part hereof.\nThis dispute has not heretofore been adjusted under the provisions of the  \nRailway Labor Act, as amended; and\nThis dispute, in the judgment of the National Mediation Board, threatens  \nsubstantially to interrupt interstate commerce to a degree such as to deprive a  \nsection of the country of essential transportation service:","original_source":{"page_or_item":"47 FR 31843, PDF pages 11-13; operative words before the numbered sections","sha256":"37cdbbdda1f6d809f3da9e82cbfdc455ed15ba68ff9c6bf21b02493f79f1521c","url":"https://www.govinfo.gov/content/pkg/FR-1982-07-23/pdf/FR-1982-07-23.pdf"},"scope_id":"EO:12373#preamble-op","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-101. E stablish m en t o f Board. There is established, effective immediately, a  \nboard of three members to be appointed by the President to investigate this  \ndispute. No member of the board shall be pecuniarily or otherwise interested  \nin any organization of railroad employees or any carrier.","original_source":{"page_or_item":"47 FR 31843, PDF pages 11-13; Sec. 1-101","sha256":"37cdbbdda1f6d809f3da9e82cbfdc455ed15ba68ff9c6bf21b02493f79f1521c","url":"https://www.govinfo.gov/content/pkg/FR-1982-07-23/pdf/FR-1982-07-23.pdf"},"scope_id":"EO:12373#sec1-101","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-102. R eport. The board' shall report its finding to the President with respect  \nto the dispute within 30 days from the date of its establishment.","original_source":{"page_or_item":"47 FR 31843, PDF pages 11-13; Sec. 1-102","sha256":"37cdbbdda1f6d809f3da9e82cbfdc455ed15ba68ff9c6bf21b02493f79f1521c","url":"https://www.govinfo.gov/content/pkg/FR-1982-07-23/pdf/FR-1982-07-23.pdf"},"scope_id":"EO:12373#sec1-102","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1-103. M aintaining Conditions.  As provided by Section 10 of the Railway  \nLabor Act, as amended, from the date of the creation of the Emergency Board  \nand for 30 days after the board has made its report to the President, no  \nchange, except by agreement, shall be made by the carriers or by their  \nemployees, in the conditions out of which the dispute arose.","original_source":{"page_or_item":"47 FR 31843, PDF pages 11-13; Sec. 1-103","sha256":"37cdbbdda1f6d809f3da9e82cbfdc455ed15ba68ff9c6bf21b02493f79f1521c","url":"https://www.govinfo.gov/content/pkg/FR-1982-07-23/pdf/FR-1982-07-23.pdf"},"scope_id":"EO:12373#sec1-103","state_at_cutoff":null}],"original_representation":{"page_or_item":"47 FR 31843, PDF pages 11-13","sha256":"37cdbbdda1f6d809f3da9e82cbfdc455ed15ba68ff9c6bf21b02493f79f1521c","url":"https://www.govinfo.gov/content/pkg/FR-1982-07-23/pdf/FR-1982-07-23.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 4 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:12373"}
