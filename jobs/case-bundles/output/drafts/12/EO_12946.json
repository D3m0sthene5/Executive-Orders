ds%5B%5D=raw_text_url&fields%5B%5D=signing_date&fields%5B%5D=title&format=json&include_pre_1994_docs=true&order=executive_order_number&page=6&per_page=1000&search_after_cursor=WzEyNDk3LjAsIjEyNDk3Il0"}},"suggested":true},{"custody_records_in":["current-law"],"group":{"actor":"EO:13062","corroborated_by_two_jobs":true,"date":"1997-09-29","jobs":["current-law","later-events"]},"meta":{"acting_instrument_id":"EO:13062","actor_text":"President, by Ex. Ord. No. 13062","date_basis":"printed_next_to_acting_instrument","from":"current-law@jobs/current-law/output","from_job":"current-law","ids":["usc:ev:8832afb96938"],"mechanism_text":"revocation (as stated in an OLRC note at 22 U.S.C. 2551 note)","quote":"Ex. Ord. No. 12946, Jan. 20, 1995, 60 F.R. 4829, which established within Department of Defense the President’s Advisory Board on Arms Proliferation Policy, was revoked by Ex. Ord. No. 13062, § 3(c), Sept. 29, 1997, 62 F.R. 51756, formerly set out as a note under section 1013 of Title 5, Government  ...","quote_truncated":true,"system":"usc","where":"USC 22 U.S.C. 2551 note"},"proposal":{"actor":"EO:13062","date":"1997-09-29","mechanism":"revocation","source":{"page_or_item":"22 U.S.C. 2551 note; note 'Executive Order No. 12946' [USLM note id idde86c07b-b816-11f1-963c-e4c4db8c41be]; usc22.xml (sha256 349b496b46eee69bc535a4c8bd32a6d5dbbcb7b99e1f83964d81fe7804f4e923) in xml_uscAll@119-121.zip","sha256":"c6122974e951003437ece5a998aa7c0b2cdc0f5703dfc78d6135e1fc9e729142","url":"https://uscode.house.gov/download/releasepoints/us/pl/119/121/xml_uscAll@119-121.zip"}},"suggested":false}],"whole_order_end_total":2},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"confirm","counterevidence":"confirm","ending_or_current_basis":"confirm","opus_media":"n/a","original_text":"done_now_by_custody","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":[],"would_satisfy_once_confirmed":["clause_inventory","ending_or_current_basis","counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"1995-01-20","later-events_catalog":"1995-01-20","research/stage21/original_sources/CASE_ORIGINAL_SOURCE_CUSTODY.csv":"1995-01-20","stage19_causal_queue":"1995-01-20","stage21_crosswalk":"1995-01-20"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:12946","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Section 1. Establishment. There is established within the Department of\nDefense the ‘‘President’s Advisory Board on Arms Proliferation Policy’’\n(‘‘Board’’). The Board shall consist of five members who shall be appointed\nby the President from among persons in private life who are noted for\ntheir stature and expertise regarding the proliferation of strategic and ad-\nvanced conventional weapons and are from diverse backgrounds. The Presi-\ndent shall designate one of the members as Chairperson of the Board.","original_source":{"page_or_item":"60 FR 4829, PDF pages 1-2; Sec. 1","sha256":"d82be5dd15a73b146f77cebc9ffe77b778256d8c4a9fd84b73cc3eff22c1bba7","url":"https://www.govinfo.gov/content/pkg/FR-1995-01-24/pdf/95-1925.pdf"},"scope_id":"EO:12946#sec1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 2. Functions. The Board shall advise the President on implementation\nof United States conventional arms transfer policy, other issues related to\narms proliferation policy, and on other matters deemed appropriate by the\nPresident. The Board shall report to the President through the Assistant\nto the President for National Security Affairs.","original_source":{"page_or_item":"60 FR 4829, PDF pages 1-2; Sec. 2","sha256":"d82be5dd15a73b146f77cebc9ffe77b778256d8c4a9fd84b73cc3eff22c1bba7","url":"https://www.govinfo.gov/content/pkg/FR-1995-01-24/pdf/95-1925.pdf"},"scope_id":"EO:12946#sec2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The heads of executive agencies shall, to the\nextent permitted by law, provide to the Board such information as it may\nrequire for the purpose of carrying out its functions.","original_source":{"page_or_item":"60 FR 4829, PDF pages 1-2; Sec. 3(a)","sha256":"d82be5dd15a73b146f77cebc9ffe77b778256d8c4a9fd84b73cc3eff22c1bba7","url":"https://www.govinfo.gov/content/pkg/FR-1995-01-24/pdf/95-1925.pdf"},"scope_id":"EO:12946#sec3(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) Members of the Board shall serve without compensation, but shall\nbe allowed travel expenses, including per diem in lieu of subsistence, as\nauthorized by law, including 5 U.S.C. 5701–5707 and section 7(d) of the\nAct, for persons serving intermittently in government service.","original_source":{"page_or_item":"60 FR 4829, PDF pages 1-2; Sec. 3(b)","sha256":"d82be5dd15a73b146f77cebc9ffe77b778256d8c4a9fd84b73cc3eff22c1bba7","url":"https://www.govinfo.gov/content/pkg/FR-1995-01-24/pdf/95-1925.pdf"},"scope_id":"EO:12946#sec3(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) The Department of Defense or the head of any other Federal department\nor agency may detail to the Board, upon request of the Chairperson of\nthe Board, any of the personnel of the department or agency to assist\nthe Board in carrying out its duties.","original_source":{"page_or_item":"60 FR 4829, PDF pages 1-2; Sec. 3(c)","sha256":"d82be5dd15a73b146f77cebc9ffe77b778256d8c4a9fd84b73cc3eff22c1bba7","url":"https://www.govinfo.gov/content/pkg/FR-1995-01-24/pdf/95-1925.pdf"},"scope_id":"EO:12946#sec3(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) The Secretary of Defense shall designate a federally funded research\nand development center with expertise in the matters covered by the Board\nto provide the Board with such support services as the Board may need\nto carry out its duties.","original_source":{"page_or_item":"60 FR 4829, PDF pages 1-2; Sec. 3(d)","sha256":"d82be5dd15a73b146f77cebc9ffe77b778256d8c4a9fd84b73cc3eff22c1bba7","url":"https://www.govinfo.gov/content/pkg/FR-1995-01-24/pdf/95-1925.pdf"},"scope_id":"EO:12946#sec3(d)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(e) The Department of Defense shall provide the Board with administrative\nservices, facilities, staff, and other support services necessary for the perform-\nance of its functions.","original_source":{"page_or_item":"60 FR 4829, PDF pages 1-2; Sec. 3(e)","sha256":"d82be5dd15a73b146f77cebc9ffe77b778256d8c4a9fd84b73cc3eff22c1bba7","url":"https://www.govinfo.gov/content/pkg/FR-1995-01-24/pdf/95-1925.pdf"},"scope_id":"EO:12946#sec3(e)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The Board shall terminate 30 days after the date on\nwhich the President submits the final report of the Board to the Congress.","original_source":{"page_or_item":"60 FR 4829, PDF pages 1-2; Sec. 4(a)","sha256":"d82be5dd15a73b146f77cebc9ffe77b778256d8c4a9fd84b73cc3eff22c1bba7","url":"https://www.govinfo.gov/content/pkg/FR-1995-01-24/pdf/95-1925.pdf"},"scope_id":"EO:12946#sec4(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) For reasons of national security or for such other reasons as specified\nin section 552(b) of title 5, United States Code, the Board shall not provide\npublic notice or access to meetings at which national security information\nwill be discussed. Authority to make such determinations shall reside with\nthe Secretary of Defense or his designee who must be an official required\nto be appointed by and with the advice and consent of the Senate.","original_source":{"page_or_item":"60 FR 4829, PDF pages 1-2; Sec. 4(b)","sha256":"d82be5dd15a73b146f77cebc9ffe77b778256d8c4a9fd84b73cc3eff22c1bba7","url":"https://www.govinfo.gov/content/pkg/FR-1995-01-24/pdf/95-1925.pdf"},"scope_id":"EO:12946#sec4(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) Information made available to the Board shall be given all necessary\nsecurity protection in accordance with applicable laws and regulations.\n=== PDF page 2 of 2 ===\n4830 Federal Register / Vol. 60, No. 15 / Tuesday, January 24, 1995 / Presidential Documents\n(d) Each member of the Board and each member of the Board’s staff\nshall execute an agreement not to reveal any classified information obtained\nby virtue of his or her service with the Board except as authorized by\napplicable law and regulations.","original_source":{"page_or_item":"60 FR 4829, PDF pages 1-2; Sec. 4(c)","sha256":"d82be5dd15a73b146f77cebc9ffe77b778256d8c4a9fd84b73cc3eff22c1bba7","url":"https://www.govinfo.gov/content/pkg/FR-1995-01-24/pdf/95-1925.pdf"},"scope_id":"EO:12946#sec4(c)","state_at_cutoff":null}],"original_representation":{"page_or_item":"whole per-document Federal Register PDF (60 FR 4829)","sha256":"d82be5dd15a73b146f77cebc9ffe77b778256d8c4a9fd84b73cc3eff22c1bba7","url":"https://www.govinfo.gov/content/pkg/FR-1995-01-24/pdf/95-1925.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 10 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:12946"}
