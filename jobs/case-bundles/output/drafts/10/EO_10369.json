2-07-02/pdf/FR-1952-07-02.pdf"},"scope_id":"EO:10369#sec1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"S ec. 2. In accordance with section 102 \nof the Act, the provisions of Title I  of the \nAct shall be applicable to all contracts \nwith the Bureau of Reclamation, and re­\nlated subcontracts, to the extent of the \namounts received or accrued on or after \nthe first day of July, 1952, whether such \ncontracts or subcontracts were made on, \nbefore, or after that date.","original_source":{"page_or_item":"17 FR 5932, PDF pages 4-4; Sec. 2","sha256":"b1c98fd55f7ab4294342477b495799636f75fcfda51002384c235b045d956370","url":"https://www.govinfo.gov/content/pkg/FR-1952-07-02/pdf/FR-1952-07-02.pdf"},"scope_id":"EO:10369#sec2","state_at_cutoff":null}],"original_representation":{"page_or_item":"17 FR 5932, PDF pages 4-4","sha256":"b1c98fd55f7ab4294342477b495799636f75fcfda51002384c235b045d956370","url":"https://www.govinfo.gov/content/pkg/FR-1952-07-02/pdf/FR-1952-07-02.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 2 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:10369"}
