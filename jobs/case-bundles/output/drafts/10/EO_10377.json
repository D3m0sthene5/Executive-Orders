te":"1953-08-14","mechanism":"revocation","source":{"page_or_item":"OFR Codification 1945-1989 (1989), Executive Orders disposition table, printed page 1054, PDF page 1065","sha256":"6c760d36b1d22350dc22890bbf31afb0a67911c3bc295abd567cc0e706fe2ccd","url":"https://hdl.handle.net/2027/uiug.30112026470077"}},"suggested":false}],"whole_order_end_total":2},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"confirm","counterevidence":"confirm","ending_or_current_basis":"confirm","opus_media":"n/a","original_text":"confirm","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":[],"would_satisfy_once_confirmed":["original_text","clause_inventory","ending_or_current_basis","counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"1952-07-25","later-events_catalog":"1952-07-25","stage19_causal_queue":"1952-07-25"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:10377","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"S ection  1. Executive Orders No. 10233 \nof April 21, 1951 (16 P. R. 3503), and No. \n10301 of November 2, 1951 (16 F. R. \n11257), are hereby revoked.","original_source":{"page_or_item":"17 FR 6891, PDF pages 1-1; Sec. 1","sha256":"3f4aff9933d06b7cda12779fa6dac0d802cb049cb04fa0d18801540bd5f05c26","url":"https://www.govinfo.gov/content/pkg/FR-1952-07-29/pdf/FR-1952-07-29.pdf"},"scope_id":"EO:10377#sec1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"S ec. 2. Part IV of Executive Order No. \n10161 of September 9, 1950 (15 P. R. \n6105), as amended, is hereby further \namended by revoking sections 403 to 410, \ninclusive, and by inserting after section \n402 thereof the following new section \n403:\n“S ec. 403 (a ). The Wage Stabilization \nBoard created by section 403 (b) of the \nDefense Production Act of 1950, as \namended, shall be composed of eighteen\n(18) members, who shall be appointed by \nthe President by and with the advice and \nconsent of the Senate. The said Board \nshall be composed in equal numbers of \nmembers representative of the general \npublic, members representative of labor, \nand members representative of business \nand industry. A Chairman and a Vice \nChairman of the Board shall be desig­\nnated by the President from among the \nmembers representative of the general \npublic.\n“ (b). In performing any of its func­\ntions, the Wage Stabilization Board shall \nbe under the supervision and direction \nof the Economic Stabilization Adminis­\ntrator.”","original_source":{"page_or_item":"17 FR 6891, PDF pages 1-1; Sec. 2","sha256":"3f4aff9933d06b7cda12779fa6dac0d802cb049cb04fa0d18801540bd5f05c26","url":"https://www.govinfo.gov/content/pkg/FR-1952-07-29/pdf/FR-1952-07-29.pdf"},"scope_id":"EO:10377#sec2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"S ec. 3. To the extent that provisions \nof prior Executive orders or proclama­\ntions, or parts thereof, are in conflict \nwith this order, the latter shall control, \nand any such prior provisions are \namended accordingly.","original_source":{"page_or_item":"17 FR 6891, PDF pages 1-1; Sec. 3","sha256":"3f4aff9933d06b7cda12779fa6dac0d802cb049cb04fa0d18801540bd5f05c26","url":"https://www.govinfo.gov/content/pkg/FR-1952-07-29/pdf/FR-1952-07-29.pdf"},"scope_id":"EO:10377#sec3","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"S ec. 4. This order shall become effec­\ntive on July 30, 1952.","original_source":{"page_or_item":"17 FR 6891, PDF pages 1-1; Sec. 4","sha256":"3f4aff9933d06b7cda12779fa6dac0d802cb049cb04fa0d18801540bd5f05c26","url":"https://www.govinfo.gov/content/pkg/FR-1952-07-29/pdf/FR-1952-07-29.pdf"},"scope_id":"EO:10377#sec4","state_at_cutoff":null}],"original_representation":{"page_or_item":"17 FR 6891, PDF pages 1-1","sha256":"3f4aff9933d06b7cda12779fa6dac0d802cb049cb04fa0d18801540bd5f05c26","url":"https://www.govinfo.gov/content/pkg/FR-1952-07-29/pdf/FR-1952-07-29.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 4 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:10377"}
