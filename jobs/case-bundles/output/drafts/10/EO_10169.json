satisfy_once_confirmed":["original_text","clause_inventory","ending_or_current_basis","counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"1950-10-11","later-events_catalog":"1950-10-11","stage19_causal_queue":"1950-10-11"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:10169","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Establishing  the  N ational A dvisory\nCommittee  on M obilization  P olicy\nWHEREAS the National Security Re­\nsources Board, created by the National  \nSecurity Act of 1947, is responsible for  \nadvising the President on the coordina­\ntion of military, industrial and civilian  \nmobilization; and","original_source":{"page_or_item":"15 FR 6901, PDF pages 1-1; operative words before the numbered sections","sha256":"8ae1fced92ad7cd0cdf596eff7f8a7a476273d26e91481e5d9f91310ec79d1fe","url":"https://www.govinfo.gov/content/pkg/FR-1950-10-14/pdf/FR-1950-10-14.pdf"},"scope_id":"EO:10169#preamble-op","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"1. There is hereby established the Na­\ntional Advisory Committee cm Mobiliza­\ntion Policy to consult with and advise  \nthe National Security Resources Board  \non national mobilization policy.","original_source":{"page_or_item":"15 FR 6901, PDF pages 1-1; para. 1","sha256":"8ae1fced92ad7cd0cdf596eff7f8a7a476273d26e91481e5d9f91310ec79d1fe","url":"https://www.govinfo.gov/content/pkg/FR-1950-10-14/pdf/FR-1950-10-14.pdf"},"scope_id":"EO:10169#para1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"2. The membership of the National  \nAdvisory Committee on Mobilization  \nPolicy shall be appointed by the Chair -  \nnian of the National Security Resources \nBoard and shall include persons whose  \nexperience and ability equip them to rep­\nresent business, labor, agriculture, and  \nthe public as a whole.","original_source":{"page_or_item":"15 FR 6901, PDF pages 1-1; para. 2","sha256":"8ae1fced92ad7cd0cdf596eff7f8a7a476273d26e91481e5d9f91310ec79d1fe","url":"https://www.govinfo.gov/content/pkg/FR-1950-10-14/pdf/FR-1950-10-14.pdf"},"scope_id":"EO:10169#para2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"3. All executive departments and agen­\ncies of the Federal Government are  \nrequested to cooperate with the Com­\nmittee and to furnish it such available  \ninformation as it may require for the per­\nformance of its duties.","original_source":{"page_or_item":"15 FR 6901, PDF pages 1-1; para. 3","sha256":"8ae1fced92ad7cd0cdf596eff7f8a7a476273d26e91481e5d9f91310ec79d1fe","url":"https://www.govinfo.gov/content/pkg/FR-1950-10-14/pdf/FR-1950-10-14.pdf"},"scope_id":"EO:10169#para3","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"4. The National Security Resources  \nBoard shall defray necessary expenses of  \nthe Committee, including the compensa­\ntion of the members thereof, within  \nlimits of applicable law.","original_source":{"page_or_item":"15 FR 6901, PDF pages 1-1; para. 4","sha256":"8ae1fced92ad7cd0cdf596eff7f8a7a476273d26e91481e5d9f91310ec79d1fe","url":"https://www.govinfo.gov/content/pkg/FR-1950-10-14/pdf/FR-1950-10-14.pdf"},"scope_id":"EO:10169#para4","state_at_cutoff":null}],"original_representation":{"page_or_item":"15 FR 6901, PDF pages 1-1","sha256":"8ae1fced92ad7cd0cdf596eff7f8a7a476273d26e91481e5d9f91310ec79d1fe","url":"https://www.govinfo.gov/content/pkg/FR-1950-10-14/pdf/FR-1950-10-14.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 5 clause(s); clause inven