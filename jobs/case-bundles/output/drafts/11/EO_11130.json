obs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:11130","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"I hereby appoint a Commission to ascertain, evaluate, and report upon the facts relating to the assassination of the late President John F. Kennedy and the subsequent violent death of the man charged with the assassination. The Commission shall consist of--","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); unnumbered paragraph 1","sha256":"8781da77caf932b4cef8110e990503ae0046a7f5c75c32e2738939460e791edc","url":"https://www.presidency.ucsb.edu/documents/executive-order-11130-appointing-commission-report-upon-the-assassination-president-john-f"},"scope_id":"EO:11130#p1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"The Chief Justice of the United States, Chairman;","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); unnumbered paragraph 2","sha256":"8781da77caf932b4cef8110e990503ae0046a7f5c75c32e2738939460e791edc","url":"https://www.presidency.ucsb.edu/documents/executive-order-11130-appointing-commission-report-upon-the-assassination-president-john-f"},"scope_id":"EO:11130#p2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Senator Richard B. Russell;","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); unnumbered paragraph 3","sha256":"8781da77caf932b4cef8110e990503ae0046a7f5c75c32e2738939460e791edc","url":"https://www.presidency.ucsb.edu/documents/executive-order-11130-appointing-commission-report-upon-the-assassination-president-john-f"},"scope_id":"EO:11130#p3","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Senator John Sherman Cooper;","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); unnumbered paragraph 4","sha256":"8781da77caf932b4cef8110e990503ae0046a7f5c75c32e2738939460e791edc","url":"https://www.presidency.ucsb.edu/documents/executive-order-11130-appointing-commission-report-upon-the-assassination-president-john-f"},"scope_id":"EO:11130#p4","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Congressman Hale Boggs;","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); unnumbered paragraph 5","sha256":"8781da77caf932b4cef8110e990503ae0046a7f5c75c32e2738939460e791edc","url":"https://www.presidency.ucsb.edu/documents/executive-order-11130-appointing-commission-report-upon-the-assassination-president-john-f"},"scope_id":"EO:11130#p5","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Congressman Gerald R. Ford;","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); unnumbered paragraph 6","sha256":"8781da77caf932b4cef8110e990503ae0046a7f5c75c32e2738939460e791edc","url":"https://www.presidency.ucsb.edu/documents/executive-order-11130-appointing-commission-report-upon-the-assassination-president-john-f"},"scope_id":"EO:11130#p6","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"The Honorable Allen W. Dulles;","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); unnumbered paragraph 7","sha256":"8781da77caf932b4cef8110e990503ae0046a7f5c75c32e2738939460e791edc","url":"https://www.presidency.ucsb.edu/documents/executive-order-11130-appointing-commission-report-upon-the-assassination-president-john-f"},"scope_id":"EO:11130#p7","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"The Honorable John J. McCloy.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); unnumbered paragraph 8","sha256":"8781da77caf932b4cef8110e990503ae0046a7f5c75c32e2738939460e791edc","url":"https://www.presidency.ucsb.edu/documents/executive-order-11130-appointing-commission-report-upon-the-assassination-president-john-f"},"scope_id":"EO:11130#p8","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"The purposes of the Commission are to examine the evidence developed by the Federal Bureau of Investigation and any additional evidence that may hereafter come to light or be uncovered by Federal or State authorities; to make such further investigation as the Commission finds desirable; to evaluate all the facts and circumstances surrounding such assassination, including the subsequent violent death of the man charged with the assassination, and to report to me its findings and conclusions.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); unnumbered paragraph 9","sha256":"8781da77caf932b4cef8110e990503ae0046a7f5c75c32e2738939460e791edc","url":"https://www.presidency.ucsb.edu/documents/executive-order-11130-appointing-commission-report-upon-the-assassination-president-john-f"},"scope_id":"EO:11130#p9","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"The Commission is empowered to prescribe its own procedures and to employ such assistants as it deems necessary.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); unnumbered paragraph 10","sha256":"8781da77caf932b4cef8110e990503ae0046a7f5c75c32e2738939460e791edc","url":"https://www.presidency.ucsb.edu/documents/executive-order-11130-appointing-commission-report-upon-the-assassination-president-john-f"},"scope_id":"EO:11130#p10","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Necessary expenses of the Commission may be paid from the \"Emergency Fund for the President.\"","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); unnumbered paragraph 11","sha256":"8781da77caf932b4cef8110e990503ae0046a7f5c75c32e2738939460e791edc","url":"https://www.presidency.ucsb.edu/documents/executive-order-11130-appointing-commission-report-upon-the-assassination-president-john-f"},"scope_id":"EO:11130#p11","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"All Executive departments and agencies are directed to furnish the Commission with such facilities, services, and cooperation as it may request from time to time.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); unnumbered paragraph 12","sha256":"8781da77caf932b4cef8110e990503ae0046a7f5c75c32e2738939460e791edc","url":"https://www.presidency.ucsb.edu/documents/executive-order-11130-appointing-commission-report-upon-the-assassination-president-john-f"},"scope_id":"EO:11130#p12","state_at_cutoff":null}],"original_representation":{"archival_id":"opus_stage11_evidence_originals:evidence/shards/S11_B_EXEC/cache/fr_1963-12-03.excerpt.pdf","local_file_sha256":"0e7305932d56664cba26eb60280dc8519ef22dac3dc8c6c0aaabaa3499392338","page_or_item":"PDF page 1 (heading on p1) of archived member evidence/shards/S11_B_EXEC/cache/fr_1963-12-03.excerpt.pdf; Federal Register issue 1963-12-03 (file name); printed FR page(s) 12789 (page heads)","sha256":"0e7305932d56664cba26eb60280dc8519ef22dac3dc8c6c0aaabaa3499392338"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_mat