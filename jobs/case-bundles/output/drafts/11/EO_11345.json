/api/v1/documents?conditions%5Bcorrection%5D=0&conditions%5Bpresidential_document_type%5D=executive_order&conditions%5Btype%5D%5B%5D=PRESDOCU&fields%5B%5D=citation&fields%5B%5D=disposition_notes&fields%5B%5D=document_number&fields%5B%5D=executive_order_number&fields%5B%5D=html_url&fields%5B%5D=pdf_url&fields%5B%5D=president&fields%5B%5D=publication_date&fields%5B%5D=raw_text_url&fields%5B%5D=signing_date&fields%5B%5D=title&format=json&include_pre_1994_docs=true&order=executive_order_number&page=5&per_page=1000&search_after_cursor=WzExNDk3LjAsIjExNDk3Il0"}},"suggested":true}],"whole_order_end_total":1},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"confirm","counterevidence":"confirm","ending_or_current_basis":"confirm","opus_media":"n/a","original_text":"confirm","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":[],"would_satisfy_once_confirmed":["original_text","clause_inventory","ending_or_current_basis","counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"1967-04-20","later-events_catalog":"1967-04-20","stage19_causal_queue":"1967-04-20"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:11345","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"S ection 1. Great Lakes Busin Commission.  I t is hereby declared \nthat the Great Lakes Basin Commission is established under the \nprovisions of Title I I  of the Act.","original_source":{"page_or_item":"32 FR 6329, PDF pages 5-6; Sec. 1","sha256":"5792312481ea1d915600e6ea2d098b2a12f6413a4d0b479d8e570072f93eb15e","url":"https://www.govinfo.gov/content/pkg/FR-1967-04-22/pdf/FR-1967-04-22.pdf"},"scope_id":"EO:11345#sec1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"S ec. 2. Jurisdiction of Commission.  I t is hereby determined that \nthe jurisdiction of the Great Lakes Basin Commission referred to in \nsection 1 of this order (hereinafter referred to as the Commission) \nshall extend to those portions of the eight Great Lakes States of \nIllinois, Indiana, Michigan, Minnesota, New York, Ohio, Pennsyl­\nvania, and Wisconsin that are drained by the St. Lawrence River \nsystem, including the Great Lakes, their tributaries, and tributaries \nto the St. Lawrence River which reach that river within the United \nStates, in accordance with the requests of the Governors of Indiana, \nMichigan, Minnesota, Ohio, and Wisconsin, concurred in by the \nGovernors of Illinois, New York, and Pennsylvania, and in accordance \nwith the resolution of the Council.\nFEDERAL REGISTER, V O L 32, NO. 78— SATURDAY, APRIL 22, 1967\n\n=== PDF page 6 of 64 ===\n6330 THE PRESIDENT\nS ec. 3. Membership of the Commission.  I t is hereby determined \nthat, in accordance with section 202 of the Act, the Commission shall \nconsist of the following :\n( 1  ) a Chairman to be appointed by the President,\n(2) one member from each of the following Federal departments \nand agencies : Department of Agriculture, Department of the Army, \nDepartment of Commerce, Department of Health, Education, and \nWelfare, Department of Housing and Urban Development, Depart­\nment of the Interior, Department of Justice, Department of Trans­\nportation, and the Federal Power Commission, such member to be \nappointed by the head of each department or independent agency he \nrepresents,\n(3)  one member from each of the following States: Illinois, Indi­\nana, ^  Michigan, Minnesota, New York, Ohio, Pennsylvania, and Wis­\nconsin, and\n(4) one member from each interstate agency created by an inter­\nstate compact to which the consent of Congress has been given and \nwhose jurisdiction extends to the waters of the area specified in \nsection 2.","original_source":{"page_or_item":"32 FR 6329, PDF pages 5-6; Sec. 2","sha256":"5792312481ea1d915600e6ea2d098b2a12f6413a4d0b479d8e570072f93eb15e","url":"https://www.govinfo.gov/content/pkg/FR-1967-04-22/pdf/FR-1967-04-22.pdf"},"scope_id":"EO:11345#sec2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"S ec. 4. Functions to be performed.  The Commission and its Chair­\nman, members, and employees are hereby authorized to perform and \nexercise, with respect to the jurisdiction specified in section 2 of this \norder, the functions, powers, and duties of such a Commission and of \nsuch Chairman, members, and employees, respectively, as set out in \nTitle I I  of the Act.","original_source":{"page_or_item":"32 FR 6329, PDF pages 5-6; Sec. 4","sha256":"5792312481ea1d915600e6ea2d098b2a12f6413a4d0b479d8e570072f93eb15e","url":"https://www.govinfo.gov/content/pkg/FR-1967-04-22/pdf/FR-1967-04-22.pdf"},"scope_id":"EO:11345#sec4","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"S ec. 5. International coordination.  The Chairman of the Com­\nmission is hereby authorized and directed to refer to the Council any \nmatters under consideration by the Commission which relate to the \nareas of interest or jurisdiction of the International Joint Commission, \nUnited States and Canada, and the Great Lakes Fishery Commission. \nThe Council shall consult on these matters as appropriate with the \nDepartment of State and with the International Joint Commission \nand the Great Lakes Fishery Commission through their United States \nSections for the purpose of enhancing international coordination.","original_source":{"page_or_item":"32 FR 6329, PDF pages 5-6; Sec. 5","sha256":"5792312481ea1d915600e6ea2d098b2a12f6413a4d0b479d8e570072f93eb15e","url":"https://www.govinfo.gov/content/pkg/FR-1967-04-22/pdf/FR-1967-04-22.pdf"},"scope_id":"EO:11345#sec5","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"S ec. 6. Reporting to the President.  The Chairman of the Commis­\nsion shall report to the President through the Council.","original_source":{"page_or_item":"32 FR 6329, PDF pages 5-6; Sec. 6","sha256":"5792312481ea1d915600e6ea2d098b2a12f6413a4d0b479d8e570072f93eb15e","url":"https://www.govinfo.gov/content/pkg/FR-1967-04-22/pdf/FR-1967-04-22.pdf"},"scope_id":"EO:11345#sec6","state_at_cutoff":null}],"original_representation":{"page_or_item":"32 FR 6329, PDF pages 5-6","sha256":"5792312481ea1d915600e6ea2d098b2a12f6413a4d0b479d8e570072f93eb15e","url":"https://www.govinfo.gov/content/pkg/FR-1967-04-22/pdf/FR-1967-04-22.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 5 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:11345"}
