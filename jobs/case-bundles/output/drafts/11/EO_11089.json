[],"group":{"actor":"EO:11490","corroborated_by_two_jobs":true,"date":"1969-10-28","jobs":["current-law","later-events","ofr-codification-1989"]},"meta":{"acting_instrument_id":"EO:11490","caution":"1989 OFR editorial codification: the Executive Orders disposition table states the order's status as of 1989-01-20 (OCR table cell, rows paired by position). The date is the acting document's signing date, not its effective date; the order (or parts of it) may have ceased earlier by its own terms. Read the acting instrument","date_basis":["acting order signing_date from OFR catalog (jobs/later-events EDGES.csv)"],"evidence_types":["ofr_codification_1989_table"],"flags":["ocr_table_cell_not_human_verified","ofr_codification_1989_editorial","status_as_of_1989-01-20","whole_end_from_1989_disposition_table"],"from":"ofr-codification-1989@jobs/ofr-codification-1989/output","from_job":"ofr-codification-1989","ids":["OC89-10a791c233a8"],"quote":"Revokedby EO 11490","quote_kind":"ocr_table_cell","quote_truncated":false,"status":"CANDIDATE_UNVERIFIED"},"proposal":{"actor":"EO:11490","date":"1969-10-28","mechanism":"revocation","source":{"page_or_item":"OFR Codification 1945-1989 (1989), Executive Orders disposition table, printed page 1066, PDF page 1077","sha256":"6c760d36b1d22350dc22890bbf31afb0a67911c3bc295abd567cc0e706fe2ccd","url":"https://hdl.handle.net/2027/uiug.30112026470077"}},"suggested":false}],"whole_order_end_total":3},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"confirm","counterevidence":"confirm","ending_or_current_basis":"confirm","opus_media":"n/a","original_text":"confirm","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":[],"would_satisfy_once_confirmed":["original_text","clause_inventory","ending_or_current_basis","counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"1963-02-26","later-events_catalog":"1963-02-26","stage19_causal_queue":"1963-02-26"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:11089","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"S ection  1. Scope. The Atomic Energy Commission (hereinafter \nreferred to as the Commission) shall prepare national emergency plans \nand develop preparedness programs for the continuing conduct of \natomic energy activities of the Federal Government. These plans and \nprograms shall be designed to develop a state of readiness in these areas \nwith respect to all conditions of national emergency, including attack \nupon the United States and, consistent with applicable provisions of \nthe Atomic Energy Act of 1954, as amended, will Ib e  closely coordinated \nwith the Department of Defense and the Office of Emergency \nPlanning.","original_source":{"page_or_item":"28 FR 1839, PDF pages 11-12; Sec. 1","sha256":"ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd","url":"https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf"},"scope_id":"EO:11089#sec1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 2. Functions. The Commission shall develop plans to:","original_source":{"page_or_item":"28 FR 1839, PDF pages 11-12; Sec. 2 (lead-in)","sha256":"ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd","url":"https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf"},"scope_id":"EO:11089#sec2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) Production. Continue or resume in an emergency essential (1) \nmanufacture, development, and control of nuclear weapons and equip­\nment, except to the extent that the control over such weapons and \nequipment has been transferred to the Department of Defense; (2) \ndevelopment and technology related to reactors; (3) process develop­\nment and production of feed material, special nuclear materials, and \nother special products; (4) related raw materials procurement, proc­\nessing, and development; and (5) repair, maintenance, and construc­\ntion related to the above.","original_source":{"page_or_item":"28 FR 1839, PDF pages 11-12; Sec. 2(a)","sha256":"ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd","url":"https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf"},"scope_id":"EO:11089#sec2(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) Regulation. Continue or resume in an emergency (1) con­\ntrolling the possession, use, transfer, import, and export of atomic \nmaterials ana facilities, and (2) ordering the operation or suspension \nof licensed facilities, and recapturing from licensees, where necessary, \nspecial nuclear materials whether related to military support or \ncivilian activities.","original_source":{"page_or_item":"28 FR 1839, PDF pages 11-12; Sec. 2(b)","sha256":"ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd","url":"https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf"},"scope_id":"EO:11089#sec2(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) Public health and safety.  Shut down in anticipation of an \nimminent enemy attack on the United States, and maintain under \nsurveillance, all Commission-owned facilities which could otherwise \nconstitute a significant hazard to public health and safety; and insure \nthe development of appropriate emergency plans for nuclear reactors \nand other nuclear activities licensed by the Commission whether \nprivately-owned or Government-owned.","original_source":{"page_or_item":"28 FR 1839, PDF pages 11-12; Sec. 2(c)","sha256":"ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd","url":"https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf"},"scope_id":"EO:11089#sec2(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) Research and development.  Adapt and utilize the Commis­\nsion’ s scientific and technological capability to meet pre-attack and \npost-attack priority needs of the Federal Government within the \nframework of Federal research objectives.","original_source":{"page_or_item":"28 FR 1839, PDF pages 11-12; Sec. 2(d)","sha256":"ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd","url":"https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf"},"scope_id":"EO:11089#sec2(d)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(e) Scientific, technical, and public atomic energy information.  \nOrganize, reproduce, and disseminate appropriate public atomic energy \ninformation and scientific and technical reports and data relating to \nnuclear science research, development, engineering, applications, and \neffects to interested Government agencies, the scientific and technical \ncommunities, and approved, friendly, and cooperating foreign \nnations.","original_source":{"page_or_item":"28 FR 1839, PDF pages 11-12; Sec. 2(e)","sha256":"ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd","url":"https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf"},"scope_id":"EO:11089#sec2(e)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(f) International atomic energy affairs.  Maintain essential liaison \nwith foreign nations with respect to activities of mutual interest \ninvolving atomic energy.","original_source":{"page_or_item":"28 FR 1839, PDF pages 11-12; Sec. 2(f)","sha256":"ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd","url":"https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf"},"scope_id":"EO:11089#sec2(f)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(g) H ealth services. Assist the Department of Health, Education, \nand Welfare, consistent with the above requirements, in integrating \ninto civilian health programs in an emergency the Commission’ s \nremaining health manpower and facilities not required for the per­\nformance of the Commission’ s essential emergency functions.","original_source":{"page_or_item":"28 FR 1839, PDF pages 11-12; Sec. 2(g)","sha256":"ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd","url":"https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf"},"scope_id":"EO:11089#sec2(g)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(h) Damage assessment. Maintain a capability to assess the effects \nof attack on the Commission’ s resources, both at national and field \nlevels, and provide data to the Department of Defense.\n\n=== PDF page 12 of 149 ===\n1840 THE PRESIDENT\n(i) Claimancy. Prepare plana to claim material, manpower, equip­\nment, supplies, and services needed to carry out assigned responsi­\nbilities and other essential functions of the Commission from the \nappropriate agencies and work with such agencies in developing \nprograms to insure availability of such resources in an emergency.","original_source":{"page_or_item":"28 FR 1839, PDF pages 11-12; Sec. 2(h)","sha256":"ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd","url":"https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf"},"scope_id":"EO:11089#sec2(h)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 3.! Resources Evaluation.  The Commission shall provide for \nappropriate participation in the national resource evaluation program \nadministered by the Office of Emergency Planning.","original_source":{"page_or_item":"28 FR 1839, PDF pages 11-12; Sec. 3","sha256":"ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd","url":"https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf"},"scope_id":"EO:11089#sec3","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 4. Functional Guidance , The Commission, in carrying out \nthe functions assigned in this order, shall be guided by the following:","original_source":{"page_or_item":"28 FR 1839, PDF pages 11-12; Sec. 4 (lead-in)","sha256":"ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd","url":"https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf"},"scope_id":"EO:11089#sec4","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) Interagency cooperation.  The Commission shall assume the \ninitiative in developing joint plans for the coordination of emergency \natomic energy programs of those departments and agencies which have \nresponsibilities for any segment of such activities. It shall utilize \nto the maximum those capabilities of other agencies qualified to per­\nform or assis^in the performance of assigned functions by contractual \nor other agreements.","original_source":{"page_or_item":"28 FR 1839, PDF pages 11-12; Sec. 4(a)","sha256":"ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd","url":"https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf"},"scope_id":"EO:11089#sec4(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) Presidential coordination. The Director of the Office of Emer­\ngency Planning^ shall advise and assist the President in determining \npolicy for the performance of functions under this order and in \ncoordinating the performance of such functions with the total national \npreparedness program.","original_source":{"page_or_item":"28 FR 1839, PDF pages 11-12; Sec. 4(b)","sha256":"ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd","url":"https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf"},"scope_id":"EO:11089#sec4(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) Emergency planning.  Emergency plans and programs, and \nemergency organization structure required thereby, shall be developed \nas an integral part of the continuing activities of the Commission on \nthe basis that it will have the responsibility for carrying out such \nprograms during an emergency. The Commission shall be prepared \nto implement all appropriate plans developed under this order. \nModifications and temporary organizational changes, based on emer­\ngency conditions, will be in accordance with policy determinations by \nthe President.","original_source":{"page_or_item":"28 FR 1839, PDF pages 11-12; Sec. 4(c)","sha256":"ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd","url":"https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf"},"scope_id":"EO:11089#sec4(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 5. Emergency Action.  Nothing in this order shall be construed \nas conferring authority under Title II I of the Federal Civil Defense \nAct of 1950, as amended, or otherwise, to put into effect any emergency \nplan, procedure, policy, program, or course of action prepared or \ndeveloped pursuant to this order. Such authority is reserved to the \nPresident.","original_source":{"page_or_item":"28 FR 1839, PDF pages 11-12; Sec. 5","sha256":"ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd","url":"https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf"},"scope_id":"EO:11089#sec5","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 6. Redelegation. The Commission is hereby authorized to \nredelegate within the Commission the functions hereinabove assigned \nto it.","original_source":{"page_or_item":"28 FR 1839, PDF pages 11-12; Sec. 6","sha256":"ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd","url":"https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf"},"scope_id":"EO:11089#sec6","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 7. Prior Actions.  To the extent of any inconsistency between \nthe provisions of any prior, order and the provisions of this order, the \nlatter shall control.","original_source":{"page_or_item":"28 FR 1839, PDF pages 11-12; Sec. 7","sha256":"ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd","url":"https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf"},"scope_id":"EO:11089#sec7","state_at_cutoff":null}],"original_representation":{"page_or_item":"28 FR 1839, PDF pages 11-12","sha256":"ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd","url":"https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 18 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:11089"}
