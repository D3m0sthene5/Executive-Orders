from_job":"ofr-codification-1989","ids":["OC89-3bdb8de3c682"],"quote":"Revokedby EO 12553","quote_kind":"ocr_table_cell","quote_truncated":false,"status":"CANDIDATE_UNVERIFIED"},"proposal":{"actor":"EO:12553","date":"1986-02-25","mechanism":"revocation","source":{"page_or_item":"OFR Codification 1945-1989 (1989), Executive Orders disposition table, printed page 1072, PDF page 1083","sha256":"6c760d36b1d22350dc22890bbf31afb0a67911c3bc295abd567cc0e706fe2ccd","url":"https://hdl.handle.net/2027/uiug.30112026470077"}},"suggested":false}],"whole_order_end_total":3},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"confirm","counterevidence":"confirm","ending_or_current_basis":"confirm","opus_media":"n/a","original_text":"confirm","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":[],"would_satisfy_once_confirmed":["original_text","clause_inventory","ending_or_current_basis","counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"1969-01-23","later-events_catalog":"1969-01-23","stage19_causal_queue":"1969-01-23"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:11452","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"it is ordered as follows :\n' S e c t i o n 1. Establishment of the Council,  (a) There is hereby estab­\nlished the Council for Urban Affairs (hereinafter referred to as “the  \nCouncil”) .\n(b)  The President of the United States shall preside over meetings  \nof the Council. The Vice President shall preside in the absence of the  \nPresident.\n(c) The Council shall be composed of the following:\nThe Vice President of the United States\nThe Attorney General  \nSecretary of Agriculture  \nSecretary of Commerce  \nSecretary of Labor\nSecretary of Health, Education, and Welfare  \nSecretary of Housing and Urban Development  \nSecretary of Transportation\nand such other heads of departments and agencies as the President  \nmay from time to time direct.","original_source":{"page_or_item":"34 FR 1223, PDF pages 5-6; operative words before the numbered sections","sha256":"881ab77f6b5111076b1f11764078ba331e387b40d99826ec60767a4ea23773a5","url":"https://www.govinfo.gov/content/pkg/FR-1969-01-25/pdf/FR-1969-01-25.pdf"},"scope_id":"EO:11452#preamble-op","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 2. Functions of the Council.  The Council shall advise and assist  \nthe President with respect to urban affairs and shall perform such  \nother duties as the President may from time to time prescribe. In  \naddition to such duties, the Council is directed to :","original_source":{"page_or_item":"34 FR 1223, PDF pages 5-6; Sec. 2 (lead-in)","sha256":"881ab77f6b5111076b1f11764078ba331e387b40d99826ec60767a4ea23773a5","url":"https://www.govinfo.gov/content/pkg/FR-1969-01-25/pdf/FR-1969-01-25.pdf"},"scope_id":"EO:11452#sec2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(1) Assist the President in the development of a national urban  \npolicy, having regard both to immediate and to long-range concerns,  \nand to priorities among them.","original_source":{"page_or_item":"34 FR 1223, PDF pages 5-6; Sec. 2(1)","sha256":"881ab77f6b5111076b1f11764078ba331e387b40d99826ec60767a4ea23773a5","url":"https://www.govinfo.gov/content/pkg/FR-1969-01-25/pdf/FR-1969-01-25.pdf"},"scope_id":"EO:11452#sec2(1)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(2) Promote the coordination of Federal programs in urban areas.","original_source":{"page_or_item":"34 FR 1223, PDF pages 5-6; Sec. 2(2)","sha256":"881ab77f6b5111076b1f11764078ba331e387b40d99826ec60767a4ea23773a5","url":"https://www.govinfo.gov/content/pkg/FR-1969-01-25/pdf/FR-1969-01-25.pdf"},"scope_id":"EO:11452#sec2(2)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(3) Encourage the fullest cooperation between Federal, State, and  \ncity governments, with special concern for the maintenance of local  \ninitiative and local decision making.","original_source":{"page_or_item":"34 FR 1223, PDF pages 5-6; Sec. 2(3)","sha256":"881ab77f6b5111076b1f11764078ba331e387b40d99826ec60767a4ea23773a5","url":"https://www.govinfo.gov/content/pkg/FR-1969-01-25/pdf/FR-1969-01-25.pdf"},"scope_id":"EO:11452#sec2(3)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(4) Ensure that policies concerning urban affairs shall extend to  \nthe relations of urban, suburban, and rural areas, to programs affect­\ning them, and to the movement of population between them ..","original_source":{"page_or_item":"34 FR 1223, PDF pages 5-6; Sec. 2(4)","sha256":"881ab77f6b5111076b1f11764078ba331e387b40d99826ec60767a4ea23773a5","url":"https://www.govinfo.gov/content/pkg/FR-1969-01-25/pdf/FR-1969-01-25.pdf"},"scope_id":"EO:11452#sec2(4)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(5) Seek constant improvement in the actual delivery of public  \nservices to citizens.","original_source":{"page_or_item":"34 FR 1223, PDF pages 5-6; Sec. 2(5)","sha256":"881ab77f6b5111076b1f11764078ba331e387b40d99826ec60767a4ea23773a5","url":"https://www.govinfo.gov/content/pkg/FR-1969-01-25/pdf/FR-1969-01-25.pdf"},"scope_id":"EO:11452#sec2(5)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(6) Foster the decentralization of government with the object that  \nprogram responsibilities will be vested to the greatest possible extent  \nm state and local government.\nFEDERAL REGISTER, VOL. 34, NO. 17— SATURDAY, JANUARY 25, 1969\n\n=== PDF page 6 of 80 ===\n1224 THE PRESIDENT\n(7) Encourage the most effective role possible for voluntary or­\nganizations in dealing with urban concerns.\n( 8 ) Meet with and advise the President on the occasion of emergency  \nsituations, or conditions threatening the maintenance of civil order or  \ncivil rights. N\nSec. 3. Administrative Arrangements,  (a) A  person designated by  \nthe President shall serve as Executive Secretary of the Council. The  \nExecutive Secretary shall perform such duties as the President may  \nfrom time to time direct.\n(b) In compliance with provisions of applicable law, and as neces­\nsary to effectuate the purposes of this order, (1) the White House  \nOffice shall provide or arrange for supporting clerical administrative  \nand other staff services for the Council, and (2) each Federal depart­\nment and agency which is represented on the Council shall furnish  \nthe Council such information and other assistance as may be available.","original_source":{"page_or_item":"34 FR 1223, PDF pages 5-6; Sec. 2(6)","sha256":"881ab77f6b5111076b1f11764078ba331e387b40d99826ec60767a4ea23773a5","url":"https://www.govinfo.gov/content/pkg/FR-1969-01-25/pdf/FR-1969-01-25.pdf"},"scope_id":"EO:11452#sec2(6)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 4. Construction.  Nothing in this order shall be construed as  \nsubjecting any department, establishment, or other instrumentality of  \nthe executive branch of the Federal Government or the head thereof,  \nor any function vested by law in or assigned pursuant to law to any  \nsuch agency or head, to the authority of any other such agency or head  \nor as abrogating, modifying, or restricting any such function in any  \nmanner.","original_source":{"page_or_item":"34 FR 1223, PDF pages 5-6; Sec. 4","sha256":"881ab77f6b5111076b1f11764078ba331e387b40d99826ec60767a4ea23773a5","url":"https://www.govinfo.gov/content/pkg/FR-1969-01-25/pdf/FR-1969-01-25.pdf"},"scope_id":"EO:11452#sec4","state_at_cutoff":null}],"original_representation":{"page_or_item":"34 FR 1223, PDF pages 5-6","sha256":"881ab77f6b5111076b1f11764078ba331e387b40d99826ec60767a4ea23773a5","url":"https://www.govinfo.gov/content/pkg/FR-1969-01-25/pdf/FR-1969-01-25.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 9 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:11452"}
