cation_confidence":"medium","ref":{"page_or_item":"Executive Order 11371—Establishment of the New England River Basins Commission; September 06, 1967; APP node 306448; common-crawl capture 2025-11-09T07:52:25Z","sha256":"e4a3ff136e73fb4d788c6246550269fa865bb44e0a42fa3c330d1c1126c2974a","url":"https://www.presidency.ucsb.edu/documents/executive-order-11371-establishment-the-new-england-river-basins-commission"},"signing_date":null,"source_id":"app-executive-orders:EO:11371:common-crawl:e4a3ff136e73","strong":false,"text_path":"../../app-executive-orders/output/texts/executive-order-11371-establishment-the-new-england-river-basins-commission.txt","why":"American Presidency Project (UCSB) web transcription: an editorial transcription published on the web, read live or from a web-archive capture of the page, NOT the signed or officially printed original; a lead to the original and to the text, never the original by itself"}],"savings_leads":[],"whole_order_end":[{"custody_records_in":["later-events"],"group":{"actor":"EO:12319","corroborated_by_two_jobs":false,"date":"1981-09-09","jobs":["later-events"]},"meta":{"acting_instrument_id":"EO:12319","date_basis":["acting order signing_date from OFR catalog","date stated next to the acting instrument in the OFR note"],"evidence_types":["ofr_note_on_acting","ofr_note_on_target"],"from":"later-events@jobs/later-events/output","from_job":"later-events","ids":["LE-d00fe146488b","LE-f357cd480b71"],"quote":"EO 11371, September 6, 1967","quote_kind":"verbatim_note_item","quote_truncated":false,"status":"CANDIDATE_UNVERIFIED"},"proposal":{"actor":"EO:12319","date":"1981-09-09","mechanism":"revocation","source":{"page_or_item":"OFR API record executive_order_number=12319; citation 46 FR 45591; field disposition_notes","sha256":"79e100de57f8d997baaa1875f1937e8ee54569852f043ec283a3242cbcf3893e","url":"https://www.federalregister.gov/api/v1/documents?conditions%5Bcorrection%5D=0&conditions%5Bpresidential_document_type%5D=executive_order&conditions%5Btype%5D%5B%5D=PRESDOCU&fields%5B%5D=citation&fields%5B%5D=disposition_notes&fields%5B%5D=document_number&fields%5B%5D=executive_order_number&fields%5B%5D=html_url&fields%5B%5D=pdf_url&fields%5B%5D=president&fields%5B%5D=publication_date&fields%5B%5D=raw_text_url&fields%5B%5D=signing_date&fields%5B%5D=title&format=json&include_pre_1994_docs=true&order=executive_order_number&page=5&per_page=1000&search_after_cursor=WzExNDk3LjAsIjExNDk3Il0"}},"suggested":true}],"whole_order_end_total":1},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"confirm","counterevidence":"confirm","ending_or_current_basis":"confirm","opus_media":"n/a","original_text":"confirm","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":[],"would_satisfy_once_confirmed":["original_text","clause_inventory","ending_or_current_basis","counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"1967-09-06","later-events_catalog":"1967-09-06","stage19_causal_queue":"1967-09-06"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:11371","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"S ection  1. New E ngland R iver Basins Commission.  I t is hereby \ndeclared that the New England River Basins Commission is estab­\nlished under the provisions of Title I I  of the' Act.","original_source":{"page_or_item":"32 FR 12903, PDF pages 5-6; Sec. 1","sha256":"ec846d273e95bd2469d0de80b815a51e8f6f1545e721fcd6e4d87695100f37d1","url":"https://www.govinfo.gov/content/pkg/FR-1967-09-09/pdf/FR-1967-09-09.pdf"},"scope_id":"EO:11371#sec1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"S ec. 2. Jurisdiction o f Commission.  I t is hereby determined that the \njurisdiction of the New England River Basins Commission referred \nto in section 1 of this order (hereinafter referred to as the Commis­\nsion) shall extend to the area of the six New England States of Maine, \nNew Hampshire, Vermont, Massachusetts, Connecticut, and Rhode \nIsland, together with that portion of the State of New York within \nthe drainage area of the Housatonic River, but specifically excluding \nthose portions of the States of Vermont and Massachusetts within the \ndrainage area of the Hudson River and excluding also that portion \nof the State of Vermont within the drainage area of Lake Champlain, \nin accordance with the request of the Governor of the State of Maine, \nconcurred in by the Governors of the other New England States and \nNew York, and in accordance with the resolution of the Council.","original_source":{"page_or_item":"32 FR 12903, PDF pages 5-6; Sec. 2","sha256":"ec846d273e95bd2469d0de80b815a51e8f6f1545e721fcd6e4d87695100f37d1","url":"https://www.govinfo.gov/content/pkg/FR-1967-09-09/pdf/FR-1967-09-09.pdf"},"scope_id":"EO:11371#sec2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"S ec. 3. M embership o f Commission. I t is hereby determined that, \nin accordance with section 202 of the Act, the Commission shall consist \nof the following:\nFEDERAL REGISTER, VOL. 32, NO. 175— SATURDAY, SEPTEMBER 9, 1967\n\n=== PDF page 6 of 40 ===\n12904 THE PRESIDENT\n(1) a Chairman to be appointed by the President,\n(2) one member from each of the following Federal departments \nand agencies: Department of Agriculture, Department of the Army, \nDepartment of Commerce, Department of Health, Education, and \nWelfare, Department of Housing and Urban Development, Depart­\nment of the Interior, Department of Transportation, and Federal \nPower Commission, each such member to b$ appointed by the head of \neach department or independent agency he represents,\n(3) one member from each of the following States: Maine, New \nHampshire, Vermont, Massachusetts* Connecticut, Rhode Island, and \nNew York, and\n(4) one member from each interstate agency created by an inter­\nstate compact to which the consent of Congress has been given and \nwhose jurisdiction extends to the waters of the area specified in \nsection 2.","original_source":{"page_or_item":"32 FR 12903, PDF pages 5-6; Sec. 3","sha256":"ec846d273e95bd2469d0de80b815a51e8f6f1545e721fcd6e4d87695100f37d1","url":"https://www.govinfo.gov/content/pkg/FR-1967-09-09/pdf/FR-1967-09-09.pdf"},"scope_id":"EO:11371#sec3","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"S ec. 4. Functions to he 'performed.  The Commission and its Chair­\nman, members, and employees are hereby authorized to perform and \nexercise, with respect to the jurisdiction specified in section 2 of this \norder, the functions, powers, and duties of such a Commission and \nof such Chairman, members, and employees, respectively, as set out \nin Title I I  of the Act.","original_source":{"page_or_item":"32 FR 12903, PDF pages 5-6; Sec. 4","sha256":"ec846d273e95bd2469d0de80b815a51e8f6f1545e721fcd6e4d87695100f37d1","url":"https://www.govinfo.gov/content/pkg/FR-1967-09-09/pdf/FR-1967-09-09.pdf"},"scope_id":"EO:11371#sec4","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"S ec. 5. International coordination.  The Chairman of the Commis­\nsion is hereby authorized and directed to refer to the Council any \nmatters under consideration by the Commission which relate td the \nareas of interest or jurisdiction of the International Joint Commis­\nsion, United States and Canada. The Council shall consult on these \nmatters as appropriate with the Department of State and the Inter­\nnational Joint Commission through its United States Section for the \npurpose of enhancing international coordination.","original_source":{"page_or_item":"32 FR 12903, PDF pages 5-6; Sec. 5","sha256":"ec846d273e95bd2469d0de80b815a51e8f6f1545e721fcd6e4d87695100f37d1","url":"https://www.govinfo.gov/content/pkg/FR-1967-09-09/pdf/FR-1967-09-09.pdf"},"scope_id":"EO:11371#sec5","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"S ec. 6. Reporting to the President.  The Chairman of the Commis­\nsion shall report to the President through the Council.","original_source":{"page_or_item":"32 FR 12903, PDF pages 5-6; Sec. 6","sha256":"ec846d273e95bd2469d0de80b815a51e8f6f1545e721fcd6e4d87695100f37d1","url":"https://www.govinfo.gov/content/pkg/FR-1967-09-09/pdf/FR-1967-09-09.pdf"},"scope_id":"EO:11371#sec6","state_at_cutoff":null}],"original_representation":{"page_or_item":"32 FR 12903, PDF pages 5-6","sha256":"ec846d273e95bd2469d0de80b815a51e8f6f1545e721fcd6e4d87695100f37d1","url":"https://www.govinfo.gov/content/pkg/FR-1967-09-09/pdf/FR-1967-09-09.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 6 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:11371"}
