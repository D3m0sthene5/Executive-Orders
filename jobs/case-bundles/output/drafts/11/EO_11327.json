[],"original_operative_text":"(2) has not fulfilled his statutory reserve obligation, and","original_source":{"page_or_item":"32 FR 2995, PDF pages 5-5; Sec. 1(2)","sha256":"34ad97a7706e442109991eac4750506d05be63287550b6097f82700eeb40fdc4","url":"https://www.govinfo.gov/content/pkg/FR-1967-02-17/pdf/FR-1967-02-17.pdf"},"scope_id":"EO:11327#sec1(2)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(3) has not served on active duty or active duty for training for a  \ntotal of twenty-four months.","original_source":{"page_or_item":"32 FR 2995, PDF pages 5-5; Sec. 1(3)","sha256":"34ad97a7706e442109991eac4750506d05be63287550b6097f82700eeb40fdc4","url":"https://www.govinfo.gov/content/pkg/FR-1967-02-17/pdf/FR-1967-02-17.pdf"},"scope_id":"EO:11327#sec1(3)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"S ec. 2. In pursuance of the provisions of Title I of the Department  \nof Defense Appropriation Act, 1967, the Secretary of Defense, and,  \nwhen designated by him for this purpose, any of the Secretaries of the  \nmilitary departments of the Department of Defense, are hereby  \nauthorized to require a member ordered to active duty under this au­\nthority to serve on active duty until his total service on active duty or  \nactive duty for training equals twenty-four months. If the enlistment  \nor period of military service of a member of the Ready Reserve ordered  \nto active duty under this authority would expire before he has served  \nthe required period of active duty prescribed herein, his enlistment or  \nperiod of military service may be extended until that service on active  \nduty has been completed.","original_source":{"page_or_item":"32 FR 2995, PDF pages 5-5; Sec. 2","sha256":"34ad97a7706e442109991eac4750506d05be63287550b6097f82700eeb40fdc4","url":"https://www.govinfo.gov/content/pkg/FR-1967-02-17/pdf/FR-1967-02-17.pdf"},"scope_id":"EO:11327#sec2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 3. In pursuance of the provisions of Title I of the Department  \nof Defense Appropriation Act, 1967, and in order to achieve fair treat­\nment as between members in the Ready Reserve who are being consid­\nered for active duty under this authority, appropriate consideration  \nshall be given to—","original_source":{"page_or_item":"32 FR 2995, PDF pages 5-5; Sec. 3 (lead-in)","sha256":"34ad97a7706e442109991eac4750506d05be63287550b6097f82700eeb40fdc4","url":"https://www.govinfo.gov/content/pkg/FR-1967-02-17/pdf/FR-1967-02-17.pdf"},"scope_id":"EO:11327#sec3","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(1) family responsibilities;  and","original_source":{"page_or_item":"32 FR 2995, PDF pages 5-5; Sec. 3(1)","sha256":"34ad97a7706e442109991eac4750506d05be63287550b6097f82700eeb40fdc4","url":"https://www.govinfo.gov/content/pkg/FR-1967-02-17/pdf/FR-1967-02-17.pdf"},"scope_id":"EO:11327#sec3(1)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(2) employment necessary to maintain the national health, safety,  \nor interest. L","original_source":{"page_or_item":"32 FR 2995, PDF pages 5-5; Sec. 3(2)","sha256":"34ad97a7706e442109991eac4750506d05be63287550b6097f82700eeb40fdc4","url":"https://www.govinfo.gov/content/pkg/FR-1967-02-17/pdf/FR-1967-02-17.pdf"},"scope_id":"EO:11327#sec3(2)","state_at_cutoff":null}],"original_representation":{"page_or_item":"32 FR 2995, PDF pages 5-5","sha256":"34ad97a7706e442109991eac4750506d05be63287550b6097f82700eeb40fdc4","url":"https://www.govinfo.gov/content/pkg/FR-1967-02-17/pdf/FR-1967-02-17.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 8 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:11327"}
