e8f4d2","url":"https://www.presidency.ucsb.edu/documents/executive-order-11401-modifying-executive-order-no-6868-october-9-1934-amended-designating"},"scope_id":"EO:11401#p2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"The Assistant to the Commissioner of the District of Columbia shall, to the extent the Commissioner may direct, act for him in carrying out the functions of the Authority, and, during the absence or disability of the Commissioner or in the event of a vacancy in the office of Commissioner, the Assistant to the Commissioner shall act as the Authority.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); unnumbered paragraph 3","sha256":"718ff1a94768b35f6ac02a150a0eef9ca2621d0b3b69311d4b87b64647e8f4d2","url":"https://www.presidency.ucsb.edu/documents/executive-order-11401-modifying-executive-order-no-6868-october-9-1934-amended-designating"},"scope_id":"EO:11401#p3","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Executive Order No. 6868 of October 9, 1934, as amended by Executive Orders Nos. 7784–A of January 5, 1938, 8033 of January 11, 1939, 9344 of May 21, 1943, 9916 of December 31, 1947, and 10128 of June 2, 1950, is modified to the extent provided herein.","original_source":{"page_or_item":"American Presidency Project web page (transcription; not an official edition); unnumbered paragraph 4","sha256":"718ff1a94768b35f6ac02a150a0eef9ca2621d0b3b69311d4b87b64647e8f4d2","url":"https://www.presidency.ucsb.edu/documents/executive-order-11401-modifying-executive-order-no-6868-october-9-1934-amended-designating"},"scope_id":"EO:11401#p4","state_at_cutoff":null}],"original_representation":null,"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: original_representation not yet confirmed","DRAFT: state_a