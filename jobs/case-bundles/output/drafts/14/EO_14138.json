fae6d06e5a05f2a613302c4266cfbce2ab","url":"https://www.govinfo.gov/content/pkg/FR-2025-01-13/pdf/2025-00619.pdf"},"scope_id":"EO:14138#sec1(g)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(h) General Counsel;","original_source":{"page_or_item":"90 FR 2585, PDF pages 1-2; Sec. 1(h)","sha256":"54fc9ded52c0b665787342103a93c4fae6d06e5a05f2a613302c4266cfbce2ab","url":"https://www.govinfo.gov/content/pkg/FR-2025-01-13/pdf/2025-00619.pdf"},"scope_id":"EO:14138#sec1(h)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(i) Administrator for Federal Procurement Policy;","original_source":{"page_or_item":"90 FR 2585, PDF pages 1-2; Sec. 1(i)","sha256":"54fc9ded52c0b665787342103a93c4fae6d06e5a05f2a613302c4266cfbce2ab","url":"https://www.govinfo.gov/content/pkg/FR-2025-01-13/pdf/2025-00619.pdf"},"scope_id":"EO:14138#sec1(i)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(j) Administrator of the Office of Information and Regulatory Affairs;","original_source":{"page_or_item":"90 FR 2585, PDF pages 1-2; Sec. 1(j)","sha256":"54fc9ded52c0b665787342103a93c4fae6d06e5a05f2a613302c4266cfbce2ab","url":"https://www.govinfo.gov/content/pkg/FR-2025-01-13/pdf/2025-00619.pdf"},"scope_id":"EO:14138#sec1(j)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(k) Controller, Office of Federal Financial Management; and","original_source":{"page_or_item":"90 FR 2585, PDF pages 1-2; Sec. 1(k)","sha256":"54fc9ded52c0b665787342103a93c4fae6d06e5a05f2a613302c4266cfbce2ab","url":"https://www.govinfo.gov/content/pkg/FR-2025-01-13/pdf/2025-00619.pdf"},"scope_id":"EO:14138#sec1(k)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(l) Administrator of the Office of Electronic Government.","original_source":{"page_or_item":"90 FR 2585, PDF pages 1-2; Sec. 1(l)","sha256":"54fc9ded52c0b665787342103a93c4fae6d06e5a05f2a613302c4266cfbce2ab","url":"https://www.govinfo.gov/content/pkg/FR-2025-01-13/pdf/2025-00619.pdf"},"scope_id":"EO:14138#sec1(l)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) No individual who is serving in an office listed \nin section 1(a)–(l) of this order in an acting capacity shall, by virtue of \nso serving, act as Director pursuant to this order.","original_source":{"page_or_item":"90 FR 2585, PDF pages 1-2; Sec. 2(a)","sha256":"54fc9ded52c0b665787342103a93c4fae6d06e5a05f2a613302c4266cfbce2ab","url":"https://www.govinfo.gov/content/pkg/FR-2025-01-13/pdf/2025-00619.pdf"},"scope_id":"EO:14138#sec2(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) No individual who is serving in an office listed in section 1(a)– \n(l) of this order shall act as Director unless that individual is otherwise \neligible to so serve under the Act.","original_source":{"page_or_item":"90 FR 2585, PDF pages 1-2; Sec. 2(b)","sha256":"54fc9ded52c0b665787342103a93c4fae6d06e5a05f2a613302c4266cfbce2ab","url":"https://www.govinfo.gov/content/pkg/FR-2025-01-13/pdf/2025-00619.pdf"},"scope_id":"EO:14138#sec2(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) Notwithstanding the provisions of this order, the President retains \ndiscretion, to the extent permitted by law, to depart from this order in \ndesignating an acting Director.","original_source":{"page_or_item":"90 FR 2585, PDF pages 1-2; Sec. 2(c)","sha256":"54fc9ded52c0b665787342103a93c4fae6d06e5a05f2a613302c4266cfbce2ab","url":"https://www.govinfo.gov/content/pkg/FR-2025-01-13/pdf/2025-00619.pdf"},"scope_id":"EO:14138#sec2(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[]