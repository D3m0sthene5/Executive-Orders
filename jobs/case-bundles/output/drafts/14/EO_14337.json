s/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:14337","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Section 1. Revocation. Executive Order 14036 of July 9, 2021 (Promoting \nCompetition in the American Economy), is hereby revoked.","original_source":{"page_or_item":"90 FR 40227, PDF pages 1-1; Sec. 1","sha256":"1b9f7495d718f189627814ba51dba6484e7f13ae370f505d1eebc9dd4be8e8e0","url":"https://www.govinfo.gov/content/pkg/FR-2025-08-19/pdf/2025-15824.pdf"},"scope_id":"EO:14337#sec1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) Nothing in this order shall be construed \nto impair or otherwise affect: \n(i) the authority granted by law to an executive department or agency, \nor the head thereof; or \n(ii) the functions of the Director of the Office of Management and Budget \nrelating to budgetary, administrative, or legislative proposals.","original_source":{"page_or_item":"90 FR 40227, PDF pages 1-1; Sec. 2(a)","sha256":"1b9f7495d718f189627814ba51dba6484e7f13ae370f505d1eebc9dd4be8e8e0","url":"https://www.govinfo.gov/content/pkg/FR-2025-08-19/pdf/2025-15824.pdf"},"scope_id":"EO:14337#sec2(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) This order shall be implemented consistent with applicable law and \nsubject to the availability of appropriations.","original_source":{"page_or_item":"90 FR 40227, PDF pages 1-1; Sec. 2(b)","sha256":"1b9f7495d718f189627814ba51dba6484e7f13ae370f505d1eebc9dd4be8e8e0","url":"https://www.govinfo.gov/content/pkg/FR-2025-08-19/pdf/2025-15824.pdf"},"scope_id":"EO:14337#sec2(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) This order is not intended to, and does not, create any right or benefit, \nsubstantive or procedural, enforceable at law or in equity by any party \nagainst the United States, its departments, agencies, or entities, its officers, \nemployees, or agents, or any other person.","original_source":{"page_or_item":"90 FR 40227, PDF pages 1-1; Sec. 2(c)","sha256":"1b9f7495d718f189627814ba51dba6484e7f13ae370f505d1eebc9dd4be8e8e0","url":"https://www.govinfo.gov/content/pkg/FR-2025-08-19/pdf/2025-15824.pdf"},"scope_id":"EO:14337#sec2(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) The costs for publication of this order shall be borne by the Department \nof Justice.","original_source":{"page_or_item":"90 FR 40227, PDF pages 1-1; Sec. 2(d)","sha256":"1b9f7495d718f189627814ba51dba6484e7f13ae370f505d1eebc9dd4be8e8e0","url":"https://www.govinfo.gov/content/pkg/FR-2025-08-19/pdf/2025-15824.pdf"},"scope_id":"EO:14337#sec2(d)","state_at_cutoff":null}],"original_representation":{"page_or_item":"90 FR 40227, PDF pages 1-1","sha256":"1b9f7495d718f189627814ba51dba6484e7f13ae370f505d1eebc9dd4be8e8e0","url":"https://www.govinfo.gov/content/pkg/FR-2025-08-19/pdf/2025-15824.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 5 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:14337"}
