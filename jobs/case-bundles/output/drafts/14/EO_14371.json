nts:ofr_catalog"}],"later_source_search_partial":[],"original_representation":[{"acceptable_as_original":true,"custody_records_in":["clause-drafts","fr-originals","later-events"],"fr_citation":"90 FR 60545","from":"research/stage21/original_sources/CASE_ORIGINAL_SOURCE_CUSTODY.csv","grade":"stage21_per_document_pdf","ref":{"page_or_item":"whole per-document Federal Register PDF (90 FR 60545)","sha256":"2c61eed7713f14b0b6a7eb700242071b126a2c805af793188753fa41e17cfa6e","url":"https://www.govinfo.gov/content/pkg/FR-2025-12-23/pdf/2025-23847.pdf"},"repo_path":"research/stage21/original_sources/EO_14371.pdf","signing_date":"2025-12-18","strong":true,"why":"official per-document PDF captured by Stage 21, bytes committed in the repo; identity and pages not human-verified"},{"acceptable_as_original":true,"custody_records_in":["clause-drafts","fr-originals","later-events"],"fr_citation":"90 FR 60545","from":"fr-originals@jobs/fr-originals/output","grade":"fr_originals_high","location_confidence":"high","publication_date":"2025-12-23","ref":{"page_or_item":"90 FR 60545, PDF pages 1-2","sha256":"2c61eed7713f14b0b6a7eb700242071b126a2c805af793188753fa41e17cfa6e","url":"https://www.govinfo.gov/content/pkg/FR-2025-12-23/pdf/2025-23847.pdf"},"signing_date":"2025-12-18","source_id":"fr-originals:EO:14371:2c61eed7713f","strong":true,"text_path":"texts/EO_14371.txt","why":"page location high; location_verified is false - open the PDF pages"}],"savings_leads":[],"whole_order_end":[],"whole_order_end_total":0},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"research","counterevidence":"confirm","ending_or_current_basis":"research","opus_media":"n/a","original_text":"done_now_by_custody","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":["clause_inventory","ending_or_current_basis"],"would_satisfy_once_confirmed":["counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"2025-12-18","later-events_catalog":"2025-12-18","research/stage21/original_sources/CASE_ORIGINAL_SOURCE_CUSTODY.csv":"2025-12-18","stage19_causal_queue":"2025-12-18","stage21_crosswalk":"2025-12-18"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:14371","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Section 1. All executive departments and agencies of the Federal Government \nshall be closed and their employees excused from duty on Wednesday, \nDecember 24, 2025, and Friday, December 26, 2025, the day before and \nthe day following Christmas Day, respectively.","original_source":{"page_or_item":"90 FR 60545, PDF pages 1-2; Sec. 1","sha256":"2c61eed7713f14b0b6a7eb700242071b126a2c805af793188753fa41e17cfa6e","url":"https://www.govinfo.gov/content/pkg/FR-2025-12-23/pdf/2025-23847.pdf"},"scope_id":"EO:14371#sec1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 2. The heads of executive departments and agencies may determine \nthat certain offices and installations of their organizations, or parts thereof, \nmust remain open and that certain employees must report for duty on \nDecember 24, 2025, or December 26, 2025, or both, for reasons of national \nsecurity, defense, or other public need.","original_source":{"page_or_item":"90 FR 60545, PDF pages 1-2; Sec. 2","sha256":"2c61eed7713f14b0b6a7eb700242071b126a2c805af793188753fa41e17cfa6e","url":"https://www.govinfo.gov/content/pkg/FR-2025-12-23/pdf/2025-23847.pdf"},"scope_id":"EO:14371#sec2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 3. December 24, 2025, and December 26, 2025, shall be considered \nas falling within the scope of Executive Order 11582 of February 11, 1971, \nand of 5 U.S.C. 5546 and 6103(b) and other similar statutes insofar as \nthey relate to the pay and leave of employees of the United States.","original_source":{"page_or_item":"90 FR 60545, PDF pages 1-2; Sec. 3","sha256":"2c61eed7713f14b0b6a7eb700242071b126a2c805af793188753fa41e17cfa6e","url":"https://www.govinfo.gov/content/pkg/FR-2025-12-23/pdf/2025-23847.pdf"},"scope_id":"EO:14371#sec3","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 4. The Director of the Office of Personnel Management shall take \nsuch actions as may be necessary to implement this order.","original_source":{"page_or_item":"90 FR 60545, PDF pages 1-2; Sec. 4","sha256":"2c61eed7713f14b0b6a7eb700242071b126a2c805af793188753fa41e17cfa6e","url":"https://www.govinfo.gov/content/pkg/FR-2025-12-23/pdf/2025-23847.pdf"},"scope_id":"EO:14371#sec4","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) Nothing in this order shall be construed \nto impair or otherwise affect: \n(i) the authority granted by law to an executive department or agency, \nor the head thereof; or \n(ii) the functions of the Director of the Office of Management and Budget \nrelating to budgetary, administrative, or legislative proposals.","original_source":{"page_or_item":"90 FR 60545, PDF pages 1-2; Sec. 5(a)","sha256":"2c61eed7713f14b0b6a7eb700242071b126a2c805af793188753fa41e17cfa6e","url":"https://www.govinfo.gov/content/pkg/FR-2025-12-23/pdf/2025-23847.pdf"},"scope_id":"EO:14371#sec5(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) This order shall be implemented consistent with applicable law and \nsubject to the availability of appropriations.","original_source":{"page_or_item":"90 FR 60545, PDF pages 1-2; Sec. 5(b)","sha256":"2c61eed7713f14b0b6a7eb700242071b126a2c805af793188753fa41e17cfa6e","url":"https://www.govinfo.gov/content/pkg/FR-2025-12-23/pdf/2025-23847.pdf"},"scope_id":"EO:14371#sec5(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) This order is not intended to, and does not, create any right or benefit, \nsubstantive or procedural, enforceable at law or in equity by any party \nagainst the United States, its departments, agencies, or entities, its officers, \nemployees, or agents, or any other person. \nVerDate Sep<11>2014 19:39 Dec 22, 2025 Jkt 268001 PO 00000 Frm 00001 Fmt 4790 Sfmt 4790 E:\\FR\\FM\\23DEE3.SGM 23DEE3khammond on DSK9W7S144PROD with PRESDOC4\n=== PDF page 2 of 2 ===\n60546 Federal Register / Vol. 90, No. 244 / Tuesday, December 23, 2025 / Presidential Documents \n(d) The costs for publication of this order shall be borne by the Office \nof Personnel Management.","original_source":{"page_or_item":"90 FR 60545, PDF pages 1-2; Sec. 5(c)","sha256":"2c61eed7713f14b0b6a7eb700242071b126a2c805af793188753fa41e17cfa6e","url":"https://www.govinfo.gov/content/pkg/FR-2025-12-23/pdf/2025-23847.pdf"},"scope_id":"EO:14371#sec5(c)","state_at_cutoff":null}],"original_representation":{"page_or_item":"whole per-document Federal Register PDF (90 FR 60545)","sha256":"2c61eed7713f14b0b6a7eb700242071b126a2c805af793188753fa41e17cfa6e","url":"https://www.govinfo.gov/content/pkg/FR-2025-12-23/pdf/2025-23847.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 7 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:14371"}
