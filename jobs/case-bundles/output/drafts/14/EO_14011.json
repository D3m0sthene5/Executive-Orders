-20","jobs":["current-law","later-events"]},"meta":{"acting_instrument_id":"EO:14148","actor_text":"President, by Ex. Ord. No. 14148","date_basis":"printed_next_to_acting_instrument","from":"current-law@jobs/current-law/output","from_job":"current-law","ids":["usc:ev:805534d8d476"],"mechanism_text":"revocation (as stated in an OLRC note at 8 U.S.C. 1103 note)","quote":"Ex. Ord. No. 14011, Feb. 2, 2021, 86 F.R. 8273, which established the Interagency Task Force on the Reunification of Families, was revoked by Ex. Ord. No. 14148, § 2(v), Jan. 20, 2025, 90 F.R. 8238, and Ex. Ord. No. 14159, § 3(a), Jan. 20, 2025, 90 F.R. 8443.","quote_truncated":false,"system":"usc","where":"USC 8 U.S.C. 1103 note"},"proposal":{"actor":"EO:14148","date":"2025-01-20","mechanism":"revocation","source":{"page_or_item":"8 U.S.C. 1103 note; note 'Executive Order No. 14011' [USLM note id id9bc2c686-3a6f-11f1-ace3-bb5201d4c7c7]; usc08.xml (sha256 dacd49660b6bae3039c1083ffd54c84f4f39ba9ef8da8457104e63283bcada5f) in xml_uscAll@119-121.zip","sha256":"c6122974e951003437ece5a998aa7c0b2cdc0f5703dfc78d6135e1fc9e729142","url":"https://uscode.house.gov/download/releasepoints/us/pl/119/121/xml_uscAll@119-121.zip"}},"suggested":false},{"custody_records_in":["later-events"],"group":{"actor":"EO:14159","corroborated_by_two_jobs":false,"date":"2025-01-20","jobs":["later-events"]},"meta":{"acting_instrument_id":"EO:14159","date_basis":["acting order signing_date from OFR catalog","date stated next to the acting instrument in the OFR note"],"evidence_types":["ofr_note_on_acting","ofr_note_on_target","order_text_app_transcriptions","order_text_fr_originals"],"flags":["acting_order_heading_not_found_in_text(whole text scanned)"],"from":"later-events@jobs/later-events/output","from_job":"later-events","ids":["LE-23d83d31dec3","LE-3e53780ec84e","LE-72449099c1d2","LE-734f765fedfc"],"quote":"EO 14011, February 2, 2021","quote_kind":"verbatim_note_item","quote_truncated":false,"status":"CANDIDATE_UNVERIFIED"},"proposal":{"actor":"EO:14159","date":"2025-01-20","mechanism":"revocation","source":{"page_or_item":"OFR API record executive_order_number=14159; citation 90 FR 8443; document_number 2025-02006; field disposition_notes","sha256":"5523a353aca96f9b69e2d61bcf3528f15e9249d1a65ee2759a54fd7fe7d6d271","url":"https://www.federalregister.gov/api/v1/documents?conditions%5Bcorrection%5D=0&conditions%5Bpresidential_document_type%5D=executive_order&conditions%5Btype%5D%5B%5D=PRESDOCU&fields%5B%5D=citation&fields%5B%5D=disposition_notes&fields%5B%5D=document_number&fields%5B%5D=executive_order_number&fields%5B%5D=html_url&fields%5B%5D=pdf_url&fields%5B%5D=president&fields%5B%5D=publication_date&fields%5B%5D=raw_text_url&fields%5B%5D=signing_date&fields%5B%5D=title&format=json&include_pre_1994_docs=true&order=executive_order_number&page=7&per_page=1000&search_after_cursor=WzEzNDk3LjAsIjEzNDk3Il0"}},"suggested":false}],"whole_order_end_total":3},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"confirm","counterevidence":"resolve_conflicts","ending_or_current_basis":"confirm","opus_media":"n/a","original_text":"confirm","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":[],"would_satisfy_once_confirmed":["original_text","clause_inventory","ending_or_current_basis"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"2021-02-02","later-events_catalog":"2021-02-02","stage19_causal_queue":"2021-02-02","stage21_crosswalk":"2021-02-02"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:14011","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Section 1. Policy. It is the policy of my Administration to respect and \nvalue the integrity of families seeking to enter the United States. My Adminis-\ntration condemns the human tragedy that occurred when our immigration \nlaws were used to intentionally separate children from their parents or \nlegal guardians (families), including through the use of the Zero-Tolerance \nPolicy. My Administration will protect family unity and ensure that children \nentering the United States are not separated from their families, except \nin the most extreme circumstances where a separation is clearly necessary \nfor the safety and well-being of the child or is required by law.","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 1","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 2. Establishment. There is hereby established an Interagency Task Force \non the Reunification of Families (Task Force).","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 2","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The Task Force shall include the following members \nor their designees: \n(i) the Secretary of Homeland Security, who shall serve as Chair; \n(ii) the Secretary of State, who shall serve as a Vice Chair; \n(iii) the Secretary of Health and Human Services, who shall serve as \na Vice Chair; \n(iv) the Attorney General; \n(v) such other officers or employees of the Departments of State, Justice, \nHealth and Human Services, and Homeland Security, as the head of each \nrespective department may designate; and \n(vi) such other officers or employees of executive departments and agencies \n(agencies) as the Chair or Vice Chairs may invite to participate, with \nthe concurrence of the head of the agency concerned.","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 3(a)","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec3(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The Chair shall convene and preside at meetings of the Task Force. \nThe Chair, in consultation with the Vice Chairs, shall direct its work and, \nas appropriate, establish and direct subgroups of the Task Force.","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 3(b)","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec3(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 4. Functions. The Task Force shall, consistent with applicable law, \nperform the following functions:","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 4 (lead-in)","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec4","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) Identifying all children who were separated from their families at \nthe United States-Mexico border between January 20, 2017, and January \n20, 2021, in connection with the operation of the Zero-Tolerance Policy;","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 4(a)","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec4(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) To the greatest extent possible, facilitating and enabling the reunifica-\ntion of each of the identified children with their families by: \n(i) providing recommendations to heads of agencies concerning the exercise \nof any agency authorities necessary to reunite the children with their \nfamilies, including: \n(A) recommendations regarding the possible exercise of parole under \nsection 212(d)(5)(A) of the Immigration and Nationality Act of 1952, as \namended (8 U.S.C. 1182(d)(5)(A)), or the issuance of visas or other immigra-\ntion benefits, as appropriate and consistent with applicable law; \nVerDate Sep<11>2014 15:47 Feb 04, 2021 Jkt 253001 PO 00000 Frm 00001 Fmt 4790 Sfmt 4790 E:\\FR\\FM\\05FEE1.SGM 05FEE1jbell on DSKJLSW7X2PROD with EXECORD1\n=== PDF page 2 of 3 ===\n8274 Federal Register / Vol. 86, No. 23 / Friday, February 5, 2021 / Presidential Documents \n(B) recommendations regarding the provision of additional services and \nsupport to the children and their families, including trauma and mental \nhealth services; and \n(C) recommendations regarding reunification of any additional family \nmembers of the children who were separated, such as siblings, where \nthere is a compelling humanitarian interest in doing so; \n(ii) providing recommendations to the President concerning the exercise \nof any Presidential authorities necessary to reunite the children with their \nfamilies, as appropriate and consistent with applicable law; and \n(iii) for purposes of developing the recommendations described in this \nsubsection, and in particular with respect to recommendations regarding \nthe manner and location of reunification, consulting with the children, \ntheir families, representatives of the children and their families, and other \nstakeholders, and considering the families’ preferences and parental rights \nas well as the children’s well-being; and","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 4(b)","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec4(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) Providing regular reports to the President, including: \n(i) an initial progress report no later than 120 days after the date of \nthis order; \n(ii) interim progress reports every 60 days thereafter; \n(iii) a report containing recommendations to ensure that the Federal Gov-\nernment will not repeat the policies and practices leading to the separation \nof families at the border, no later than 1 year after the date of this \norder; and \n(iv) a final report when the Task Force has completed its mission.","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 4(c)","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec4(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) To the extent permitted by law, \nand subject to the availability of appropriations, the Department of Homeland \nSecurity shall provide the funding and administrative support the Task \nForce needs to implement this order, as determined by the Secretary of \nHomeland Security.","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 5(a)","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec5(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) To the extent permitted by law, including the Economy Act (31 U.S.C. \n1535), and subject to the availability of appropriations, additional agencies \nrepresented on the Task Force may detail staff to the Task Force, or otherwise \nprovide administrative support, as necessary to implement this order, as \ndetermined by the respective heads of agencies.","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 5(b)","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec5(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) The Task Force shall coordinate, as appropriate and consistent with \napplicable law, with relevant stakeholders, including domestic and inter-\nnational non-governmental organizations, and representatives of the children \nand their families.","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 5(c)","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec5(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) The Task Force, at the direction of the Chair, may hold public meetings \nand engagement sessions as necessary to carry out its mission.","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 5(d)","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec5(d)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(e) The Task Force shall terminate 30 days after it provides its final \nreport to the President under section 4(c)(iv) of this order.","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 5(e)","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec5(e)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 6. Revocation of Executive Order 13841. Executive Order 13841 of \nJune 20, 2018 (Affording Congress an Opportunity To Address Family Separa-\ntion), is hereby revoked.","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 6","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec6","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 7. Definitions. For purposes of this order:","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 7 (lead-in)","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec7","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) The term ‘‘children’’ includes all persons who were under the age \nof 18 at the time they were separated from their families at the border.","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 7(a)","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec7(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) The term ‘‘Zero-Tolerance Policy’’ means the policy discussed in the \nAttorney General’s memorandum of April 6, 2018, entitled, ‘‘Zero-Tolerance \nfor Offenses Under 8 U.S.C. 1325(a),’’ and any other related policy, program, \npractice, or initiative resulting in the separation of children from their fami-\nlies at the United States-Mexico border.","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 7(b)","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec7(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) Nothing in this order shall be construed \nto impair or otherwise affect: \n(i) the authority granted by law to an executive department or agency, \nor the head thereof; or \nVerDate Sep<11>2014 15:47 Feb 04, 2021 Jkt 253001 PO 00000 Frm 00002 Fmt 4790 Sfmt 4790 E:\\FR\\FM\\05FEE1.SGM 05FEE1jbell on DSKJLSW7X2PROD with EXECORD1\n=== PDF page 3 of 3 ===\n8275 Federal Register / Vol. 86, No. 23 / Friday, February 5, 2021 / Presidential Documents \n(ii) the functions of the Director of the Office of Management and Budget \nrelating to budgetary, administrative, or legislative proposals.","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 8(a)","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec8(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) This order shall be implemented consistent with applicable law and \nsubject to the availability of appropriations.","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 8(b)","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec8(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) This order is not intended to, and does not, create any right or benefit, \nsubstantive or procedural, enforceable at law or in equity by any party \nagainst the United States, its departments, agencies, or entities, its officers, \nemployees, or agents, or any other person.","original_source":{"page_or_item":"86 FR 8273, PDF pages 1-3; Sec. 8(c)","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"scope_id":"EO:14011#sec8(c)","state_at_cutoff":null}],"original_representation":{"page_or_item":"86 FR 8273, PDF pages 1-3","sha256":"db2e3df8d6ae28c074031756d80fe62d6df9a82673e05aadd24bd49ff60530d9","url":"https://www.govinfo.gov/content/pkg/FR-2021-02-05/pdf/2021-02562.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 20 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)","CONFLICT WHOLE_END_ACTOR_DISAGREEMENT: EO:14148, EO:14159"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:14011"}
