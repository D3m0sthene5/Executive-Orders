_target"],"from":"later-events@jobs/later-events/output","from_job":"later-events","ids":["LE-038885f23ee6","LE-5fc71d9ecc5d"],"quote":"Revoked by: EO 14148, January 20, 2025","quote_kind":"verbatim_note_item","quote_truncated":false,"status":"CANDIDATE_UNVERIFIED"},"proposal":{"actor":"EO:14148","date":"2025-01-20","mechanism":"revocation","source":{"page_or_item":"OFR API record executive_order_number=14070; citation 87 FR 20689; document_number 2022-07716; field disposition_notes","sha256":"5523a353aca96f9b69e2d61bcf3528f15e9249d1a65ee2759a54fd7fe7d6d271","url":"https://www.federalregister.gov/api/v1/documents?conditions%5Bcorrection%5D=0&conditions%5Bpresidential_document_type%5D=executive_order&conditions%5Btype%5D%5B%5D=PRESDOCU&fields%5B%5D=citation&fields%5B%5D=disposition_notes&fields%5B%5D=document_number&fields%5B%5D=executive_order_number&fields%5B%5D=html_url&fields%5B%5D=pdf_url&fields%5B%5D=president&fields%5B%5D=publication_date&fields%5B%5D=raw_text_url&fields%5B%5D=signing_date&fields%5B%5D=title&format=json&include_pre_1994_docs=true&order=executive_order_number&page=7&per_page=1000&search_after_cursor=WzEzNDk3LjAsIjEzNDk3Il0"}},"suggested":true},{"custody_records_in":["current-law"],"group":{"actor":"EO:14148","corroborated_by_two_jobs":true,"date":"2025-01-20","jobs":["current-law","later-events"]},"meta":{"acting_instrument_id":"EO:14148","actor_text":"President, by Ex. Ord. No. 14148","date_basis":"printed_next_to_acting_instrument","from":"current-law@jobs/current-law/output","from_job":"current-law","ids":["usc:ev:2246eb16df1e"],"mechanism_text":"revocation (as stated in an OLRC note at 42 U.S.C. 18001 note)","quote":"Ex. Ord. No. 14070, Apr. 5, 2022, 87 F.R. 20689, which related to expanding the availability of affordable health coverage, improving the quality of coverage, strengthening benefits, and helping more Americans enroll in quality health coverage, was revoked by Ex. Ord. No. 14148, § 2(uu), Jan. 20, 20 ...","quote_truncated":true,"system":"usc","where":"USC 42 U.S.C. 18001 note"},"proposal":{"actor":"EO:14148","date":"2025-01-20","mechanism":"revocation","source":{"page_or_item":"42 U.S.C. 18001 note; note 'Executive Order No. 14070' [USLM note id id3e6070c6-c3e9-11f1-bd73-d95596aaa024]; usc42.xml (sha256 9a2ce8ea01dfa97423fcd8749e7534a64c0ec75df9bf56584b210c0725a66692) in xml_uscAll@119-121.zip","sha256":"c6122974e951003437ece5a998aa7c0b2cdc0f5703dfc78d6135e1fc9e729142","url":"https://uscode.house.gov/download/releasepoints/us/pl/119/121/xml_uscAll@119-121.zip"}},"suggested":false}],"whole_order_end_total":2},"provisional_status":"no","readiness":{"by_step":{"clause_inventory":"confirm","counterevidence":"confirm","ending_or_current_basis":"confirm","opus_media":"n/a","original_text":"confirm","savings_residuals":"agent_judgment","shared_sources":"n/a"},"needs_research":[],"would_satisfy_once_confirmed":["original_text","clause_inventory","ending_or_current_basis","counterevidence"]},"shared_sources":[],"signing_dates_seen":{"fr-originals@jobs/fr-originals/output":"2022-04-05","later-events_catalog":"2022-04-05","stage19_causal_queue":"2022-04-05","stage21_crosswalk":"2022-04-05"},"source_ladder_exhausted_proposed":[],"status":"MACHINE DRAFT - UNVERIFIED; not a claim; see jobs/claim-drafts/AGENT_GUIDE.md"},"claim":{"instrument_id":"EO:14070","later_source_search":[],"operative_clauses":[{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Section 1. Policy. On January 28, 2021, I signed Executive Order 14009 \n(Strengthening Medicaid and the Affordable Care Act), establishing that it \nis the policy of my Administration to protect and strengthen Medicaid \nand the Affordable Care Act (ACA) and to make high-quality healthcare \naccessible and affordable for every American. It directs executive departments \nand agencies (agencies) with authorities and responsibilities related to Med-\nicaid and the ACA to review existing regulations, orders, guidance docu-\nments, policies, and any other similar agency actions (collectively, agency \nactions) to determine whether such agency actions are inconsistent with \nthis policy. \nConsistent with Executive Order 14009, agencies have taken numerous ac-\ntions to protect and strengthen Medicaid and the ACA, including:","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 1 (lead-in)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec1","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) facilitating the expansion of Medicaid in Missouri and Oklahoma to \nindividuals below 138 percent of the Federal poverty level, which is projected \nto cover nearly half a million people;","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 1(a)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec1(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) extending Medicaid eligibility to new populations in order to allow \npregnant individuals to retain their Medicaid coverage for up to 1 year \npostpartum, including through initiatives in Illinois, New Jersey, Virginia, \nand Louisiana;","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 1(b)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec1(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) operating a Special Enrollment Period during 2021 that allowed 2.8 \nmillion Americans to newly enroll in coverage under the ACA;","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 1(c)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec1(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) extending the length of the HealthCare.gov Open Enrollment Period \nby 1 month and operating the most successful Open Enrollment Period \never, with a historic 14.5 million Americans enrolling in coverage through \nthe ACA Marketplaces and an additional 1 million people enrolling in \nBasic Health Program coverage, resulting in a 20 percent increase over \nthe prior year across both programs combined;","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 1(d)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec1(d)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(e) increasing outreach and enrollment funding for organizations that help \nAmericans apply for ACA and Medicaid coverage, including quadrupling \nthe number of trained Navigators to more than 1,500 people in States using \nHealthCare.gov;","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 1(e)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec1(e)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(f) lowering maximum out-of-pocket costs for consumers with employer \nand ACA coverage by $400 in 2022;","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 1(f)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec1(f)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(g) reducing paperwork burdens for people enrolling in Medicaid and \nthe ACA by eliminating unnecessary documentation requirements;","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 1(g)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec1(g)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(h) allowing low-income Americans to enroll in affordable ACA coverage \nyear-round;","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 1(h)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec1(h)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(i) strengthening Medicaid and ACA section 1332 waiver policies to partner \nwith States to develop innovative coverage options, strengthen benefits, and \nlower costs;","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 1(i)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec1(i)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(j) proposing rules that would better ensure comprehensive and standard-\nized coverage and improve the adequacy of ACA provider networks; and \nVerDate Sep<11>2014 15:30 Apr 07, 2022 Jkt 256001 PO 00000 Frm 00001 Fmt 4705 Sfmt 4790 E:\\FR\\FM\\08APE0.SGM 08APE0jspears on DSK121TN23PROD with PREZ DOC 1\n=== PDF page 2 of 3 ===\n20690 Federal Register / Vol. 87, No. 68 / Friday, April 8, 2022 / Presidential Documents \n(k) making efforts to improve the affordability of ACA coverage for families \nby proposing rules to correct a regulatory gap that prevents family members \nfrom accessing ACA subsidies despite very high premiums for coverage \nthrough an employer. \nOn March 11, 2021, I signed into law the American Rescue Plan Act of \n2021 (Public Law 117–2), which will further strengthen Medicaid and the \nACA in numerous ways, including by making ACA coverage more affordable \nfor 9 million Americans through enhanced ACA subsidies, incentivizing \nStates to adopt the ACA’s Medicaid expansion, making it easier for States \nto extend postpartum Medicaid coverage, establishing new options for States \nto establish mobile crisis intervention services teams to help provide services \nto Medicaid beneficiaries experiencing a behavioral health crisis, and increas-\ning Medicaid funding for home- and community-based services to strengthen \nand expand access to services for millions of seniors and people with \ndisabilities who need care as well as to help States strengthen their programs. \nMy Administration has made significant progress in making healthcare more \naffordable and accessible to millions of Americans. From the end of 2020 \nto September 2021, one in seven uninsured Americans gained coverage, \nleaving the uninsured rate at nearly an all-time low. Despite this progress, \nnearly 4 million Americans continue to be locked out of Medicaid expansion \nbecause they reside in 1 of the 12 States that have failed to adopt the \nACA’s Medicaid expansion. In addition, millions more continue to struggle \nto obtain the care they need, to go without health coverage, or to be enrolled \nin coverage that is insufficient to meet their needs. The effects of being \nuninsured or underinsured can be devastating financially, as families without \naccess to affordable coverage may accrue high levels of medical debt. \nIt remains the policy of my Administration to protect and strengthen Med-\nicaid and the ACA and to make high-quality healthcare accessible and \naffordable for every American. Agencies with authorities and responsibilities \nrelated to Medicaid and the ACA are continuing their review of existing \nagency actions under Executive Order 14009.","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 1(j)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec1(j)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"Sec. 2. Agency Responsibilities. In addition to taking the actions directed \npursuant to Executive Order 14009, agencies (as described in section 3502(1) \nof title 44, United States Code, except for the agencies described in section \n3502(5) of title 44, United States Code) with responsibilities related to Ameri-\ncans’ access to health coverage shall review agency actions to identify ways \nto continue to expand the availability of affordable health coverage, to im-\nprove the quality of coverage, to strengthen benefits, and to help more \nAmericans enroll in quality health coverage. As part of this review, the \nheads of such agencies shall examine the following:","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 2 (lead-in)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec2","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) policies or practices that make it easier for all consumers to enroll \nin and retain coverage, understand their coverage options, and select appro-\npriate coverage;","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 2(a)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec2(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) policies or practices that strengthen benefits and improve access to \nhealthcare providers;","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 2(b)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec2(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) policies or practices that improve the comprehensiveness of coverage \nand protect consumers from low-quality coverage;","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 2(c)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec2(c)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(d) policies or practices that expand eligibility and lower costs for coverage \nin the ACA Marketplaces, Medicaid, Medicare, and other programs;","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 2(d)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec2(d)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(e) policies or practices that help improve linkages between the healthcare \nsystem and other stakeholders to address health-related needs; and","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 2(e)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec2(e)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(f) policies or practices that help reduce the burden of medical debt \non households.","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 2(f)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec2(f)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(a) Nothing in this order shall be construed \nto impair or otherwise affect: \n(i) the authority granted by law to an executive department or agency, \nor the head thereof; or \nVerDate Sep<11>2014 15:30 Apr 07, 2022 Jkt 256001 PO 00000 Frm 00002 Fmt 4705 Sfmt 4790 E:\\FR\\FM\\08APE0.SGM 08APE0jspears on DSK121TN23PROD with PREZ DOC 1\n=== PDF page 3 of 3 ===\n20691 Federal Register / Vol. 87, No. 68 / Friday, April 8, 2022 / Presidential Documents \n(ii) the functions of the Director of the Office of Management and Budget \nrelating to budgetary, administrative, or legislative proposals.","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 3(a)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec3(a)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(b) This order shall be implemented consistent with applicable law and \nsubject to the availability of appropriations.","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 3(b)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec3(b)","state_at_cutoff":null},{"current_predicate":null,"first_end":null,"later_events":[],"original_operative_text":"(c) This order is not intended to, and does not, create any right or benefit, \nsubstantive or procedural, enforceable at law or in equity by any party \nagainst the United States, its departments, agencies, or entities, its officers, \nemployees, or agents, or any other person.","original_source":{"page_or_item":"87 FR 20689, PDF pages 1-3; Sec. 3(c)","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"scope_id":"EO:14070#sec3(c)","state_at_cutoff":null}],"original_representation":{"page_or_item":"87 FR 20689, PDF pages 1-3","sha256":"8505668e7f8477349b31de5fbe0fe303e99a4fbba533f3571427a73790a606a7","url":"https://www.govinfo.gov/content/pkg/FR-2022-04-08/pdf/2022-07716.pdf"},"research_rationale":"","savings_residuals":null,"schema":"eo-lifecycle-claim/v1","unresolved_material_gaps":["DRAFT: state_at_cutoff not decided for 21 clause(s); clause inventory completeness not confirmed","DRAFT: whole-order ending not established","DRAFT: savings and residual effects not closed","DRAFT: later_source_search not recorded (machine searches are proposals only; paste them after judging them adequate and resolving every CONFLICT line)"],"whole_order_end":null,"whole_order_status":"no"},"draft_schema":"eo-claim-draft/v1","instrument_id":"EO:14070"}
