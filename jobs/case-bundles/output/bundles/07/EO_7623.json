bed in section 1 o f this order is hereby tem porarily \nwithdrawn from  settlem ent, location, sale or entry, and re­\nserved fo r use by the United States ","path":"jobs/fr-originals/output/texts/EO_7623.txt","sha256":"8869870f721e0834fcbefc1ae708538e8ff6a662765167fbc8a9824931335bd5","source":{"line":11,"path":"jobs/fr-originals/output/SOURCES.jsonl","record_sha256":"2feb78d3a8c69934d69ee544cf3a8059adbc1aca56e271e6549e22c72da52148"}}]}
