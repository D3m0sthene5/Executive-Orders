B%5D=citation&fields%5B%5D=disposition_notes&fields%5B%5D=document_number&fields%5B%5D=executive_order_number&fields%5B%5D=html_url&fields%5B%5D=pdf_url&fields%5B%5D=president&fields%5B%5D=publication_date&fields%5B%5D=raw_text_url&fields%5B%5D=signing_date&fields%5B%5D=title"},{"page_or_item":"OFR API record executive_order_number=8543; field disposition_notes","sha256":"95361ad83413ec8072599698e736ced47ecdf3830b181329ca993b8bfa8c0113","url":"https://www.federalregister.gov/api/v1/documents?conditions%5Bcorrection%5D=0&conditions%5Bpresidential_document_type%5D=executive_order&conditions%5Btype%5D%5B%5D=PRESDOCU&fields%5B%5D=citation&fields%5B%5D=disposition_notes&fields%5B%5D=document_number&fields%5B%5D=executive_order_number&fields%5B%5D=html_url&fields%5B%5D=pdf_url&fields%5B%5D=president&fields%5B%5D=publication_date&fields%5B%5D=raw_text_url&fields%5B%5D=signing_date&fields%5B%5D=title&format=json&include_pre_1994_docs=true&order=executive_order_number&page=2&per_page=1000&search_after_cursor=Wzg1MjMuMCwiODUyMyJd"}]}],"notice":"Research startup packet; statuses remain provisional. Overflow records are explicit and require their source pointers.","readiness":{"blockers":"NO_OFFICIAL_SOURCE_LOCATED|ONLY_COMPILED_TRANSCRIPTION_FOUND|NO_CLAUSE_INVENTORY|FIRST_END_UNPROVED|SAVINGS_RESIDUALS_NOT_CLOSED","claim_present":"no","claim_record_errors":"","decision_origin":"inherited_legacy_v2","exhausted_steps":"","instrument_id":"EO:7958","provisional_status":"no","ready_for_human_review":"no","ready_tier":"","step_clause_inventory":"open","step_counterevidence":"done","step_ending_or_current_basis":"open","step_opus_media":"n/a","step_original_text":"open","step_provisional_status":"done","step_savings_residuals":"open","step_shared_sources":"n/a","steps_applicable":"6","steps_done":"2"},"readiness_blockers":[{"step":"original_text","what":"no official original-text candidate from any job; fr-originals: ofr_index_not_received_for_publication (The OFR index marks this order 'not received for publication', so it was probably never printed in the Federal Register (OFR catalog statement, not verified here). Other routes: NARA, presidential lib); 1 compiled-transcription lead(s) (for example Richardson) point to the text but are not the original by themselves"},{"step":"ending_or_current_basis","what":"provisional NO, but no job found a whole-order-end candidate"}],"schema":"eo-case-bundle/v1","status":"no","text_pointers":[{"first_1500_characters":"Whereas, in my judgment, the public interest requires that Samuel J. Gompers, Chief Clerk, Department of Labor, who, during the month of September, 1938, will reach the retirement age prescribed for automatic separation from the service, applicable to him, be exempted from compulsory retirement for age for a period of one year:\n\nNow, Therefore, by virtue of and pursuant to the authority vested in me by section 204 of the Act of June 30, 1932, 47 Stat. 382, 404 (U.S.C., title 5, sec. 715a), I hereby exempt the said Samuel J. Gompers from compulsory retirement for age for a period of one year ending September 30, 1939.\n\nFRANKLIN D. ROOSEVELT\n\nThe White House,\n\nAugust 19, 1938.\n","path":"jobs/app-executive-orders/output/texts/executive-order-7958-exemption-samuel-j-gompers-from-compulsory-retirement-for-age.txt","sha256":"da5b9f4973cda7cb3abb848ae8f19548d6af7de22e7a4b56c2801d60873cfd35","source":{"line":7848,"path":"jobs/app-transcriptions/output/SOURCES.jsonl","record_sha256":"dd54425e7801dfd03c604b9f32c087d8fb7950b41bcdb63218e685cdc155b09c"}},{"first_1500_characters":"Executive Order 7958—Exemption of Samuel J. Gompers From Compulsory Retirement for Age\n\nWhereas, in my judgment, the public interest requires that Samuel J. Gompers, Chief Clerk, Department of Labor, who, during the month of September, 1938, will reach the retirement age prescribed for automatic separation from the service, applicable to him, be exempted from compulsory retirement for age for a period of one year:\n\nNow, Therefore, by virtue of and pursuant to the authority vested in me by section 204 of the Act of June 30, 1932, 47 Stat. 382, 404 (U.S.C., title 5, sec. 715a), I hereby exempt the said Samuel J. Gompers from compulsory retirement for age for a period of one year ending September 30, 1939.\n\nFRANKLIN D. ROOSEVELT\n\nThe White House,\n\nAugust 19, 1938.","path":"jobs/clause-drafts/output/texts/cd-job-app-executive-orders-7958-0f39fc050c.txt","sha256":"d6d58aa5ae2036e9a76f33d8a27e6bc852214d48bdec68e1ac68752b1799129e","source":{"line":3376,"path":"jobs/clause-drafts/output/SOURCES.jsonl","record_sha256":"063952cd336feba8e6a34b60c2751f1f035ef3be926e53608208d47360594b9a"}}]}
