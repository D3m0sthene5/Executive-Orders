ngs_residuals":"open","step_shared_sources":"n/a","steps_applicable":"6","steps_done":"2"},"readiness_blockers":[{"step":"clause_inventory","what":"no clause inventory drafted; clause-drafts could not segment the available text(s): official_fr_scan_ocr_text:segmented:unusable(no_heading_in_text_identity_from_input_job_record;ocr_text_noisy_0.05;body_cites_its_own_order_number_identity_doubtful;ocr_columns_may_be_interleaved:fr_m"}],"schema":"eo-case-bundle/v1","status":"no","text_pointers":[{"first_1500_characters":"{\"member\": \"usc02.xml\", \"note_id\": \"iddcb8117d-3a6e-11f1-a0f3-db3efcbbb4ee\", \"citation\": \"2 U.S.C. 685 note\", \"heading\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\", \"subjects\": [\"11845\"], \"status_line\": \"Ex. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\", \"text\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\\nEx. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\\nBy virtue of the authority vested in me by the Impoundment Control Act of 1974 (Public Law 93–344; 88 Stat. 332, (2 U.S.C. 681 et seq.), hereinafter referred to as the Act) [subchapters I and II of this chapter], and section 301 of title 3 of the United States Code, the Director of the Office of Management and Budget is hereby designated and empowered to exercise, as of October 1, 1974 without ratification or other action of the President (1) the functions required by sections 1014(b) and 1014(d) of the Act [subsecs. (b) and (d) of this section] of transmitting to the Comptroller General of the United States and to the Office of the Federal Register copies of special messages transmitted pursuant to section 1012 or 1013 (2 U.S.C. 683 and 684) of the Act; and (2) the function conferred upon the President by section 1014(e) of the Act (2 U.S.C. 685","path":"jobs/current-law/output/USC_EO_NOTES.jsonl","sha256":"ac1e287b6b606b8adc5c1975f662aae2d31989c1d072e32c89dbc38f6efe8016","source":{"line":3,"path":"jobs/current-law/output/SOURCES.jsonl","record_sha256":"5b6e5de61be4ea9c9c4749827c02d0c9d484107505b7e9adae3172a42351c188"}},{"first_1500_characters":"Instrument: EO:11983\nSource: https://www.govinfo.gov/content/pkg/FR-1977-05-06/pdf/FR-1977-05-06.pdf\nSHA-256 of the downloaded file: 21758b2ccbee9422be943f259d456e5adf19eaf77034e1deba667756d8b5819f\nLocation: 42 FR 23127, PDF pages 11-11 (confidence high)\nMachine-extracted text layer of the official PDF (OCR for 1936-1994 scans). May contain recognition errors and parts of neighbouring documents on the same pages. Not an authenticated transcription: check the PDF pages.\n\n=== PDF page 11 of 360 ===\np resid en tial docum ents\nTitle 3—The President\nExecutive Order 11983 • May 4, 1977\nRelating to Certain Positions in Levels IV and V of the Executive Schedule\nBy virtue of the authority vested in me by Section 5317 of Title 5 of the United  \nStates Code, and as President of the United States of America, it is hereby ordered as  \nfollows:\nS ection 1. Section 1 of Executive Order No.. 11861, as amended, placing cer­\ntain positions in level IV of the Executive Schedule, is further amended as follows:\n(a) By deleting “Administrator, Social and Rehabilitation Service, Department  \nof Health, Education, and Welfare.” in subsection (l) and inserting in lieu thereof  \n“Administrator, Health Care Financing Administration, Department of Health, Edu­\ncation, and Welfare.”.\n(b) By deleting “(11)  Special Prosecutor, Department of Justice.” and “(14)\nExecutive Vice President, Export-Import Bank.”. j.\n(c) By revising subsection (15)  to read “(15)  Director, Office of Congressional  \nand Public A","path":"jobs/fr-originals/output/texts/EO_11983.txt","sha256":"31ebaf0494273cb49e2bde8eda8ba2142d7740e54593fa215ce3034e231d3f30","source":{"line":1542,"path":"jobs/fr-originals/output/SOURCES.jsonl","record_sha256":"08fe8cf8dda15315d6eb11ed62ca12634acec0d0b0bf6584a4cabe650d78e721"}}]}
