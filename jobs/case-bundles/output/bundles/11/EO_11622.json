"instrument_id":"EO:11622","provisional_status":"no","ready_for_human_review":"no","ready_tier":"","step_clause_inventory":"open","step_counterevidence":"done","step_ending_or_current_basis":"open","step_opus_media":"n/a","step_original_text":"done","step_provisional_status":"done","step_savings_residuals":"open","step_shared_sources":"n/a","steps_applicable":"6","steps_done":"3"},"readiness_blockers":[{"step":"clause_inventory","what":"no clause inventory drafted; clause-drafts could not segment the available text(s): official_fr_scan_ocr_text:segmented:unusable(no_operative_unit_found;ocr_columns_may_be_interleaved:no_enacting_or_operative_words)"}],"schema":"eo-case-bundle/v1","status":"no","text_pointers":[{"first_1500_characters":"{\"member\": \"usc02.xml\", \"note_id\": \"iddcb8117d-3a6e-11f1-a0f3-db3efcbbb4ee\", \"citation\": \"2 U.S.C. 685 note\", \"heading\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\", \"subjects\": [\"11845\"], \"status_line\": \"Ex. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\", \"text\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\\nEx. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\\nBy virtue of the authority vested in me by the Impoundment Control Act of 1974 (Public Law 93–344; 88 Stat. 332, (2 U.S.C. 681 et seq.), hereinafter referred to as the Act) [subchapters I and II of this chapter], and section 301 of title 3 of the United States Code, the Director of the Office of Management and Budget is hereby designated and empowered to exercise, as of October 1, 1974 without ratification or other action of the President (1) the functions required by sections 1014(b) and 1014(d) of the Act [subsecs. (b) and (d) of this section] of transmitting to the Comptroller General of the United States and to the Office of the Federal Register copies of special messages transmitted pursuant to section 1012 or 1013 (2 U.S.C. 683 and 684) of the Act; and (2) the function conferred upon the President by section 1014(e) of the Act (2 U.S.C. 685","path":"jobs/current-law/output/USC_EO_NOTES.jsonl","sha256":"ac1e287b6b606b8adc5c1975f662aae2d31989c1d072e32c89dbc38f6efe8016","source":{"line":3,"path":"jobs/current-law/output/SOURCES.jsonl","record_sha256":"5b6e5de61be4ea9c9c4749827c02d0c9d484107505b7e9adae3172a42351c188"}},{"first_1500_characters":"Instrument: EO:11622\nSource: https://www.govinfo.gov/content/pkg/FR-1971-10-07/pdf/FR-1971-10-07.pdf\nSHA-256 of the downloaded file: d17d082f15cd5d42c681d8c8ea77d394a12e4eeacd6685dfaf4ff0d7b7cf71df\nLocation: 36 FR 19491, PDF pages 7-7 (confidence high)\nMachine-extracted text layer of the official PDF (OCR for 1936-1994 scans). May contain recognition errors and parts of neighbouring documents on the same pages. Not an authenticated transcription: check the PDF pages.\n\n=== PDF page 7 of 80 ===\nPresidential Documents\nTitle 3—The President\nEXECUTIVE ORDER 11622\nAmending Executive Order 11621 Creating a Board of Inquiry\nBy virtue of the authority vested in me by Section 206 of the Labor- \nManagement Relations Act, 1947 (61 Stat. 155; 29 U.S.C. 176), \nExecutive Order 116211  of October 4, 1971, is amended as follows:\n(1) In the first paragraph, immediately following “International \nLongshoremen’s Association, A FL -C IO ”, insert the International \nAssociation of Machinists and Aerospace Workers, A FL-C IO  and \nDistrict Lodge 94 and Local Lodge 1484 thereof;” and\n(2) In the third paragraph, delete the name “Morris L. Myers”.\nT h e W h ite H ouse ,\nOctober 5, 1971.\n_________ [FR Doc.71-14830 Füed 10-6-71;9:55 am]\n*  36 F.R. 19435.\nFEDERAL REGISTER, VOL. 36, NO. 195— THURSDAY, OCTOBER 7, 1971\n","path":"jobs/fr-originals/output/texts/EO_11622.txt","sha256":"6b13e57b818875e0dd68576cf877e9e28677cfcf3396f9563b6ac37f8922e936","source":{"line":1361,"path":"jobs/fr-originals/output/SOURCES.jsonl","record_sha256":"099b30d6fc6137ffe306763550adc112f93366294232672b3fcbbee9eac61f81"}}]}
