vidence","sha256":"038f531c72449196dd3bbb84ade91fc927932cbbbe8b2037458a4a2f489c3df0"}},"readiness":{"blockers":"NO_CLAUSE_INVENTORY|FIRST_END_UNPROVED|SAVINGS_RESIDUALS_NOT_CLOSED","claim_present":"no","claim_record_errors":"","decision_origin":"inherited_legacy_v2","exhausted_steps":"","instrument_id":"EO:11086","provisional_status":"no","ready_for_human_review":"no","ready_tier":"","step_clause_inventory":"open","step_counterevidence":"done","step_ending_or_current_basis":"open","step_opus_media":"n/a","step_original_text":"done","step_provisional_status":"done","step_savings_residuals":"open","step_shared_sources":"n/a","steps_applicable":"6","steps_done":"3"},"readiness_blockers":[],"schema":"eo-case-bundle/v1","status":"no","text_pointers":[{"first_1500_characters":"Executive O rd er 1 1 0 8 6\nAMENDMENT OF EXECUTIVE ORDER 105871  RELATING TO THE\nADMINISTRATION OF SECTION 32(h) OF THE TRADING WITH THE\nENEMY ACT\nBy virtue of the authority vested in me by the Trading with the \nEnemy Act, as amended (50 U.S.C. App. 1 et seq.), and by section 301 \nof title 3 of the United States Code (65 Stat. 713), and as President \nof the United States, it is ordered that sections 1, 2 and .3 of Executive \nOrder No. 10587 of January 13, 1955 (20 F.R. 361) are amended to \nread as follows:\n“S ection  1. The Jewish Restitution Successor Organization, a char­\nitable membership organization incorporated under the laws of the \nState of New York, is hereby designated as successor in interest to \ndeceased persons in accordance with and for the purposes of subsec­\ntion (h) of section 32 of the Trading with the Enemy Act, as added \nby the Act of August 23,1954 (68 Stat. 767), and amended by section \n204(a) of Public Law 87-846, approved October 22, 1962 (76 Stat. \n1114).\n“Sec. 2. Exclusive of the designation of the Jewish Restitution \nSuccessor Organization under section 1 of this Order and the exercise \nof jurisdiction over the claims referred to in section 3, the Foreign \nClaims Settlement Commission is hereby delegated and shall carry out \nthe functions provided for in subsection (n) of section 32 of the \nTrading with the Enemy Act, as amended, including the designation \nor refusal of designation of other organizations under the first sen­\ntence of that subsection","path":"jobs/clause-drafts/output/texts/cd-job-fr-originals-11086-ebb2bd8d0d.txt","sha256":"9bf1324fbead5b2e42701fcd900c3829b2acb575d531910e2229803e0df657cc","source":{"line":2112,"path":"jobs/clause-drafts/output/SOURCES.jsonl","record_sha256":"b79af5b0e147d72b74e7e283d9f5d42fb8f6891257335d95e8aa48a58f74710c"}},{"first_1500_characters":"Instrument: EO:11086\nSource: https://www.govinfo.gov/content/pkg/FR-1963-02-28/pdf/FR-1963-02-28.pdf\nSHA-256 of the downloaded file: ebb2bd8d0dacda2dd7840bb9fd1c031a649f116ac29750854a9a2f8e51277fcd\nLocation: 28 FR 1833, PDF pages 5-5 (confidence high)\nMachine-extracted text layer of the official PDF (OCR for 1936-1994 scans). May contain recognition errors and parts of neighbouring documents on the same pages. Not an authenticated transcription: check the PDF pages.\n\n=== PDF page 5 of 149 ===\nThursday , February  28, 1963 FEDERAL REGISTER 1833\nExecutive O rd er 1 1 0 8 6\nAMENDMENT OF EXECUTIVE ORDER 105871  RELATING TO THE\nADMINISTRATION OF SECTION 32(h) OF THE TRADING WITH THE\nENEMY ACT\nBy virtue of the authority vested in me by the Trading with the \nEnemy Act, as amended (50 U.S.C. App. 1 et seq.), and by section 301 \nof title 3 of the United States Code (65 Stat. 713), and as President \nof the United States, it is ordered that sections 1, 2 and .3 of Executive \nOrder No. 10587 of January 13, 1955 (20 F.R. 361) are amended to \nread as follows:\n“S ection  1. The Jewish Restitution Successor Organization, a char­\nitable membership organization incorporated under the laws of the \nState of New York, is hereby designated as successor in interest to \ndeceased persons in accordance with and for the purposes of subsec­\ntion (h) of section 32 of the Trading with the Enemy Act, as added \nby the Act of August 23,1954 (68 Stat. 767), and amended by section \n204(a) of Public Law 87-846,","path":"jobs/fr-originals/output/texts/EO_11086.txt","sha256":"2c5754a782919134f8802b11b2d6dcd3371cd67ae5f765a9c3f64f10ffa3bb75","source":{"line":1071,"path":"jobs/fr-originals/output/SOURCES.jsonl","record_sha256":"60cb3df032a69547f1f3a5a7e6dca3b2d7d04d47a46e7960a50b2c7e47020618"}}]}
