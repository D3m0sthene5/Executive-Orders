ented:unusable(no_heading_in_text_identity_from_input_job_record;ocr_text_noisy_0.05;ocr_columns_may_be_interleaved:fr_masthead_or_contents_text+order_opening_not_found)"}],"schema":"eo-case-bundle/v1","status":"no","text_pointers":[{"first_1500_characters":"{\"member\": \"usc02.xml\", \"note_id\": \"iddcb8117d-3a6e-11f1-a0f3-db3efcbbb4ee\", \"citation\": \"2 U.S.C. 685 note\", \"heading\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\", \"subjects\": [\"11845\"], \"status_line\": \"Ex. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\", \"text\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\\nEx. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\\nBy virtue of the authority vested in me by the Impoundment Control Act of 1974 (Public Law 93–344; 88 Stat. 332, (2 U.S.C. 681 et seq.), hereinafter referred to as the Act) [subchapters I and II of this chapter], and section 301 of title 3 of the United States Code, the Director of the Office of Management and Budget is hereby designated and empowered to exercise, as of October 1, 1974 without ratification or other action of the President (1) the functions required by sections 1014(b) and 1014(d) of the Act [subsecs. (b) and (d) of this section] of transmitting to the Comptroller General of the United States and to the Office of the Federal Register copies of special messages transmitted pursuant to section 1012 or 1013 (2 U.S.C. 683 and 684) of the Act; and (2) the function conferred upon the President by section 1014(e) of the Act (2 U.S.C. 685","path":"jobs/current-law/output/USC_EO_NOTES.jsonl","sha256":"ac1e287b6b606b8adc5c1975f662aae2d31989c1d072e32c89dbc38f6efe8016","source":{"line":3,"path":"jobs/current-law/output/SOURCES.jsonl","record_sha256":"5b6e5de61be4ea9c9c4749827c02d0c9d484107505b7e9adae3172a42351c188"}},{"first_1500_characters":"Instrument: EO:11376\nSource: https://www.govinfo.gov/content/pkg/FR-1967-10-19/pdf/FR-1967-10-19.pdf\nSHA-256 of the downloaded file: 982a91c8a31ea0c55a6dae51918dc8efc122a3e7c0654b6c4b5c228e8bb46996\nLocation: 32 FR 14545, PDF pages 5-5 (confidence medium)\nMachine-extracted text layer of the official PDF (OCR for 1936-1994 scans). May contain recognition errors and parts of neighbouring documents on the same pages. Not an authenticated transcription: check the PDF pages.\n\n=== PDF page 5 of 48 ===\nPresidential Documents\nTitle 3— THE PRESIDENT\nExecutive Order T1376\nAMENDING EXECUTIVE ORDER NO. 11022, RELATING TO THE  \nPRESIDENT’S COUNCIL ON AGING\nBy virtue of the authority vested in me as President of the \nUnited States, it is ordered that Executive Order No. 110221  of \nMay 14, 1962, entitled “Establishing the President’ s Council on \nAging,” be, and it is hereby, amended by substituting for subsection (b) \nof section 1 thereof the following:\n“(b)  The Council shall be composed of the Secretary of Health, \nEducation, and Welfare, who shall be Chairman, the Secretary of \nAgriculture, the Secretary of Commerce, the Secretary of Housing and \nUrban Development, the Secretary of Labor, the Secretary of Trans­\nportation, the Secretary of the Treasury, the Chairman of the Civil \nService Commission, the Administrator of Veterans’  Affairs, and the \nDirector of the Office of Economic Opportunity.”\nT h e W h ite H ouse,\nOctober 17,1967.\n[F.R. Doc. 67-12411; Filed, Oct. 17,1967; 12: 26 p.m","path":"jobs/fr-originals/output/texts/EO_11376.txt","sha256":"22446c97d74e4d1cefc7a1fb22296137f6ad65323259942eac80838d76309651","source":{"line":1233,"path":"jobs/fr-originals/output/SOURCES.jsonl","record_sha256":"44d382d9812c07ea226d85c7708d34f4dba597135d5981cf2c2e38b101a1558b"}}]}
