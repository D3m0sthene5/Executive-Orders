art A of Part \n341 in Title 6, Code of Federal Regula­\ntions (23 F.R. 10394), is revised to read \nas follows:\nSubpart A— Operating Loans to Full-  \nTime Family-Type Farm","path":"jobs/fr-originals/output/texts/EO_10848.txt","sha256":"b0d834abfd97c53ea3e868f1d91e76c4b1903814684bc42cab73a9500d502cf6","source":{"line":934,"path":"jobs/fr-originals/output/SOURCES.jsonl","record_sha256":"0f765a8d2da96b6ab666d02749f5ce1cf8320db8791ca2915604f039b298ff29"}}]}
