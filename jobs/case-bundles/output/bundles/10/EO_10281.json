ecord_errors":"","decision_origin":"inherited_legacy_v2","exhausted_steps":"","instrument_id":"EO:10281","provisional_status":"no","ready_for_human_review":"no","ready_tier":"","step_clause_inventory":"open","step_counterevidence":"open","step_ending_or_current_basis":"open","step_opus_media":"n/a","step_original_text":"open","step_provisional_status":"done","step_savings_residuals":"open","step_shared_sources":"n/a","steps_applicable":"6","steps_done":"1"},"readiness_blockers":[{"step":"clause_inventory","what":"no clause inventory drafted; clause-drafts could not segment the available text(s): official_fr_scan_ocr_text:segmented:unusable(no_heading_in_text_identity_from_input_job_record;unbalanced_quotes_retry_without_quote_tracking;text_contains_contents_listing_fragments_columns_may_be_in"}],"schema":"eo-case-bundle/v1","status":"no","text_pointers":[{"first_1500_characters":"{\"member\": \"usc02.xml\", \"note_id\": \"iddcb8117d-3a6e-11f1-a0f3-db3efcbbb4ee\", \"citation\": \"2 U.S.C. 685 note\", \"heading\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\", \"subjects\": [\"11845\"], \"status_line\": \"Ex. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\", \"text\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\\nEx. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\\nBy virtue of the authority vested in me by the Impoundment Control Act of 1974 (Public Law 93–344; 88 Stat. 332, (2 U.S.C. 681 et seq.), hereinafter referred to as the Act) [subchapters I and II of this chapter], and section 301 of title 3 of the United States Code, the Director of the Office of Management and Budget is hereby designated and empowered to exercise, as of October 1, 1974 without ratification or other action of the President (1) the functions required by sections 1014(b) and 1014(d) of the Act [subsecs. (b) and (d) of this section] of transmitting to the Comptroller General of the United States and to the Office of the Federal Register copies of special messages transmitted pursuant to section 1012 or 1013 (2 U.S.C. 683 and 684) of the Act; and (2) the function conferred upon the President by section 1014(e) of the Act (2 U.S.C. 685","path":"jobs/current-law/output/USC_EO_NOTES.jsonl","sha256":"ac1e287b6b606b8adc5c1975f662aae2d31989c1d072e32c89dbc38f6efe8016","source":{"line":3,"path":"jobs/current-law/output/SOURCES.jsonl","record_sha256":"5b6e5de61be4ea9c9c4749827c02d0c9d484107505b7e9adae3172a42351c188"}},{"first_1500_characters":"Instrument: EO:10281\nSource: https://www.govinfo.gov/content/pkg/FR-1951-08-30/pdf/FR-1951-08-30.pdf\nSHA-256 of the downloaded file: 71eb5a5f8d50eb8d8060135b66b15069901dacce15a9fb88554f23fe1436cbf5\nLocation: 16 FR 8789, PDF pages 1-3 (confidence medium)\nMachine-extracted text layer of the official PDF (OCR for 1936-1994 scans). May contain recognition errors and parts of neighbouring documents on the same pages. Not an authenticated transcription: check the PDF pages.\n\n=== PDF page 1 of 24 ===\n.  U T T ER a X  W\nVOIUME 16 NUMBER 169\nWashington, Thursday, August 30, 1951\nTITLE 3— THE PRESIDENT\nEXECUTIVE ORDERM0281 )\nD efense  M aterials  P ^ curejjjsnt \nand S upply\nBy virtue of the authority vested in  \nme by the Constitution and statutes,  \nincluding the Defense Production Act of  \n1950, as amended, and Title n  of the  \nFirst War Powers Act, 1941, as amended,  \nand as President of the United States  \nand Commander in Chief of the armed  \nforces of the United States, it is ordered  \nas follows:\nFA R T  I. DEFENSE M ATERIALS PROCUREM ENT \nA G EN CY\nSection  101. (a) There is hereby cre­\nated an agency which shall be known as  \nthe Defense Materials Procurement  \nAgency. There shall be at the head of  \nthe said agency a Defense Materials  \nProcurement Administrator, who shall  \nperform his duties subject to direction,  \ncontrol, and coordination by the Di­\nrector of Defense Mobilization.\n(b) The Defense Materials Procure­\nment Administrator shall be appointed  \nby the President","path":"jobs/fr-originals/output/texts/EO_10281.txt","sha256":"b7d8ed9f0b3d1d591df733cff39bc8a4f602baec8db3011f6239553dc31125cd","source":{"line":673,"path":"jobs/fr-originals/output/SOURCES.jsonl","record_sha256":"8c2a9bd4a8923c86b3dac05e23a1ddffabbf9a199e7bd297f94a977a0c071a24"}}]}
