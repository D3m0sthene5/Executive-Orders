":"","instrument_id":"EO:10799","provisional_status":"no","ready_for_human_review":"no","ready_tier":"","step_clause_inventory":"open","step_counterevidence":"done","step_ending_or_current_basis":"open","step_opus_media":"n/a","step_original_text":"done","step_provisional_status":"done","step_savings_residuals":"open","step_shared_sources":"n/a","steps_applicable":"6","steps_done":"3"},"readiness_blockers":[{"step":"clause_inventory","what":"no clause inventory drafted; clause-drafts could not segment the available text(s): official_fr_scan_ocr_text:segmented:unusable(no_signature_block_found;ocr_text_noisy_0.12;ocr_columns_may_be_interleaved:unbalanced_quotes)"}],"schema":"eo-case-bundle/v1","status":"no","text_pointers":[{"first_1500_characters":"{\"member\": \"usc02.xml\", \"note_id\": \"iddcb8117d-3a6e-11f1-a0f3-db3efcbbb4ee\", \"citation\": \"2 U.S.C. 685 note\", \"heading\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\", \"subjects\": [\"11845\"], \"status_line\": \"Ex. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\", \"text\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\\nEx. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\\nBy virtue of the authority vested in me by the Impoundment Control Act of 1974 (Public Law 93–344; 88 Stat. 332, (2 U.S.C. 681 et seq.), hereinafter referred to as the Act) [subchapters I and II of this chapter], and section 301 of title 3 of the United States Code, the Director of the Office of Management and Budget is hereby designated and empowered to exercise, as of October 1, 1974 without ratification or other action of the President (1) the functions required by sections 1014(b) and 1014(d) of the Act [subsecs. (b) and (d) of this section] of transmitting to the Comptroller General of the United States and to the Office of the Federal Register copies of special messages transmitted pursuant to section 1012 or 1013 (2 U.S.C. 683 and 684) of the Act; and (2) the function conferred upon the President by section 1014(e) of the Act (2 U.S.C. 685","path":"jobs/current-law/output/USC_EO_NOTES.jsonl","sha256":"ac1e287b6b606b8adc5c1975f662aae2d31989c1d072e32c89dbc38f6efe8016","source":{"line":3,"path":"jobs/current-law/output/SOURCES.jsonl","record_sha256":"5b6e5de61be4ea9c9c4749827c02d0c9d484107505b7e9adae3172a42351c188"}},{"first_1500_characters":"Instrument: EO:10799\nSource: https://www.govinfo.gov/content/pkg/FR-1959-01-20/pdf/FR-1959-01-20.pdf\nSHA-256 of the downloaded file: feabf2db22510c09f5001a4948040ca9e9b13a260f8b97c7edc8289ea9c39f77\nLocation: 24 FR 447, PDF pages 1-2 (confidence high)\nMachine-extracted text layer of the official PDF (OCR for 1936-1994 scans). May contain recognition errors and parts of neighbouring documents on the same pages. Not an authenticated transcription: check the PDF pages.\n\n=== PDF page 1 of 24 ===\n^ O N A L ^\n* a  iTTtn» V\nREGISTER\nVOLUME 24 1934 ^\nV az/t e d ^\nWashington, Tuesday, January 20, 1959\nNUMBER 13\nTitle 3— THE PRESIDENT\nExecutive Order 10799\nPROVIDING FURTHER FOR THE AD-  \nMINISTRATION OF THE AGRICUL­\nTURAL TRADE DEVELOPMENT AND \nASSISTANCE ACT OF 1954, AS  \nAMENDED\nBy virtue of the authority vested in \nm e by section 301 of title 3 of the United \nStates Code, and as President of the \nUnited States, it is hereby ordered as follow s:\nSection 1. Section 4(a) of Executive \nOrder N o. 10560 of September 9, 1954, as \namended, is hereby further amended by \ndeleting “paragraphs (a) to (j), in- \nclusive” and by inserting in lieu thereof \ntne following: “paragraphs (a) to (k), inclusive.”\nSec. 2. Section 4(d) of Execut \nOrder N o. 10560 is hereby amended \naddmg at the end thereof the followii \n.. Those under section 104(k) \nthe Act by the Director of the Natio \nScience Foundation and such ot] \nagency or agencies as the Director of 1  \nBureau of the Budget, after consultât:\nS J ï  ","path":"jobs/fr-originals/output/texts/EO_10799.txt","sha256":"1fedab9dc053b55fd83fc923c14f8102227d0fd1114b0316a30cd1f20f08d236","source":{"line":912,"path":"jobs/fr-originals/output/SOURCES.jsonl","record_sha256":"d07125c84b18951efe23b37c6b80113097d643ff566e6b72d035e1ea0e33ee21"}}]}
