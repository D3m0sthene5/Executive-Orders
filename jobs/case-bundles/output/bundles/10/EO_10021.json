ESIDUALS_NOT_CLOSED|LATER_SOURCE_SEARCH_NOT_RECORDED","claim_present":"no","claim_record_errors":"","decision_origin":"inherited_legacy_v2","exhausted_steps":"","instrument_id":"EO:10021","provisional_status":"no","ready_for_human_review":"no","ready_tier":"","step_clause_inventory":"open","step_counterevidence":"open","step_ending_or_current_basis":"open","step_opus_media":"n/a","step_original_text":"open","step_provisional_status":"done","step_savings_residuals":"open","step_shared_sources":"n/a","steps_applicable":"6","steps_done":"1"},"readiness_blockers":[{"step":"original_text","what":"no official original-text candidate from any job"},{"step":"ending_or_current_basis","what":"provisional NO, but no job found a whole-order-end candidate"}],"schema":"eo-case-bundle/v1","status":"no","text_pointers":[{"first_1500_characters":"Executive Order 10021—Further Exemption of Harry B. Mitchell From Compulsory Retirement for Age\n\n\n\n\n\n\n\n\n\n\nDecember 14, 1948\n \n\n\n\n\nWHEREAS, in my judgment, the public interest requires that Harry B. Mitchell, a member of the United States Civil Service Commission, who was exempted from compulsory retirement for age for a period of seven months ending December 31, 1948, by Executive Order No. 9956 of May 6, 1948, be further exempted from such compulsory retirement as provided below:\n\n\nNOW, THEREFORE, by virtue of and pursuant to the authority vested in me by section 204 of the act of June 30 1932 47 Stat. 404 (5 U.S.C. 715a), I hereby further exempt the said Harry B. Mitchell from compulsory retirement for are for an indefinite period of time.\n\n\nHARRY S. TRUMAN\n\nTHE WHITE HOUSE,\n\nDecember 14, 1948","path":"jobs/clause-drafts/output/texts/cd-opus_zip-10021-199a68817c.txt","sha256":"3e1b84ab7c13918547de7aedc74c8935dc1246d149e0209947d697d713aef6e1","source":{"line":330,"path":"jobs/clause-drafts/output/SOURCES.jsonl","record_sha256":"f6f192470dead697003a95f56d3a713df80e785de4bee58d3af2cf473960b824"}}]}
