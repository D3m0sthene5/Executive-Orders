12553; citation 51 FR 7237; field disposition_notes","sha256":"8ba9e1cce593bb06b6be625b585b15bb04a1555ed34ad8c5b6f8c9bd81f83f77","url":"https://www.federalregister.gov/api/v1/documents?conditions%5Bcorrection%5D=0&conditions%5Bpresidential_document_type%5D=executive_order&conditions%5Btype%5D%5B%5D=PRESDOCU&fields%5B%5D=citation&fields%5B%5D=disposition_notes&fields%5B%5D=document_number&fields%5B%5D=executive_order_number&fields%5B%5D=html_url&fields%5B%5D=pdf_url&fields%5B%5D=president&fields%5B%5D=publication_date&fields%5B%5D=raw_text_url&fields%5B%5D=signing_date&fields%5B%5D=title&format=json&include_pre_1994_docs=true&order=executive_order_number&page=6&per_page=1000&search_after_cursor=WzEyNDk3LjAsIjEyNDk3Il0"}]}],"notice":"Research startup packet; statuses remain provisional. Overflow records are explicit and require their source pointers.","overflow":{"fragments":{"reason":"30 KB startup budget; follow record pointers for complete evidence","sha256":"1edf04e711fdb412bac55e3f56afc9f6373106c5f5afb42d768ffab920e867d1"}},"readiness":{"blockers":"NO_CLAUSE_INVENTORY|FIRST_END_UNPROVED|SAVINGS_RESIDUALS_NOT_CLOSED","claim_present":"no","claim_record_errors":"","decision_origin":"inherited_legacy_v2","exhausted_steps":"","instrument_id":"EO:10965","provisional_status":"no","ready_for_human_review":"no","ready_tier":"","step_clause_inventory":"open","step_counterevidence":"done","step_ending_or_current_basis":"open","step_opus_media":"n/a","step_original_text":"done","step_provisional_status":"done","step_savings_residuals":"open","step_shared_sources":"n/a","steps_applicable":"6","steps_done":"3"},"readiness_blockers":[],"schema":"eo-case-bundle/v1","status":"no","text_pointers":[{"first_1500_characters":"Executive Order 10965\nCREATING AN EMERGENCY BOARD  \nTO INVESTIGATE A DISPUTE BE­\nTWEEN THE TRANS WORLD AIR­\nLINES, INC., AND CERTAIN OF ITS  \nEMPLOYEES\nWHEREAS a dispute exists between \nthe Trans World Airlines, Inc., a carrier, \nand certain of its employees represented \nby the Transport Workers Union of \nAmerica, AFL-CIO, a labor organization; \nand\nWHEREAS this dispute has not here­\ntofore been adjusted under the provisions \nof the Railway Labor Act, as amended; \nand\nWHEREAS this dispute, in the judg­\nment of the National Mediation Board, \nthreatens substantially' to interrupt \ninterstate commerce to a degree such as \nto deprive a section of the country of \nessential transportation service:\nNOW, THEREFORE, by virtue of the \nauthority vested in me by Section 10 of \nthe Railway Labor Act, as amended (45 \nU.S.C. 160), I hereby create a board of \nthree members, to be appointed by me, \nto investigate this dispute. No member \nof the board shall be pecuniarily or \notherwise interested in any organization \nof airline employees or any carrier.\n9451\n\n=== PDF page 4 of 80 ===\n9452 THE PRESIDENT\nThe board shall report its findings to \nthe President with respect to the dispute \nwithin thirty days from the date of this \norder.\nAs provided by section 10 of the Rail­\nway Labor Act, as amended, from this \ndate and for thirty days after the board \nhas made its report to the President, no \nchange, except by agreement, shall be \nmade by the Trans World Airlines, Inc. \nor by its employees, in th","path":"jobs/clause-drafts/output/texts/cd-job-fr-originals-10965-5bbfb0b25d.txt","sha256":"83ba0623175a4dea49770da9f41a0d47f2147c31a3f7e6bee3b2b1c6517fac00","source":{"line":2007,"path":"jobs/clause-drafts/output/SOURCES.jsonl","record_sha256":"3ed6164c30e86aea5a94122c32519d342ad5537b7c7feb94ead28f145e8e33f5"}},{"first_1500_characters":"Instrument: EO:10965\nSource: https://www.govinfo.gov/content/pkg/FR-1961-10-07/pdf/FR-1961-10-07.pdf\nSHA-256 of the downloaded file: 5bbfb0b25d0af3f13241fb5b67fc07242bcb87d66fb5cb48a338aa2b869adb58\nLocation: 26 FR 9451, PDF pages 3-4 (confidence high)\nMachine-extracted text layer of the official PDF (OCR for 1936-1994 scans). May contain recognition errors and parts of neighbouring documents on the same pages. Not an authenticated transcription: check the PDF pages.\n\n=== PDF page 3 of 80 ===\nPresidential Documents\nTitle 3— THE PRESIDENT\nProclamation 3436  \nNATIONAL DAY OF PRAYER, 1961  \nBy the President of the United States  \nof America  \nA Proclamation\nOur founding fathers came to these \nshores trusting in God, and in reliance \nupon His grace. They charted the \ncourse of free institutions under a gov­\nernment deriving its powers from the \nconsent of the people. In the General \nCongress assembled they appealed the \nrectitude of their intentions to the Su­\npreme Judge of the world, and “with \nfirm reliance on the protection of Di­\nvine Providence” they mutually pledged \ntheir lives, their fortunes, and their most \nsacred honor.\nDuring the deliberations in the Con­\nstitutional Convention they were called \nto daily prayers, with the reminder in \nsacred Scripture it is written that “ex­\ncept the Lord build the house, they la­\nbor in vain that build it,” and they were \nwarned that without the concurring aid \nof Providence they would succeed in \nthe political building “no better th","path":"jobs/fr-originals/output/texts/EO_10965.txt","sha256":"fc40cbe6c963f3809aa61500a0bb2041fd7b91102cd92348673b2a1a80cbce51","source":{"line":1000,"path":"jobs/fr-originals/output/SOURCES.jsonl","record_sha256":"e36b5e0776986b3bcb2287cabd7135e56a050af8f73d852dc131edde7a980e39"}}]}
