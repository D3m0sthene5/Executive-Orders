strument_id":"EO:12016","provisional_status":"no","ready_for_human_review":"no","ready_tier":"","step_clause_inventory":"open","step_counterevidence":"done","step_ending_or_current_basis":"open","step_opus_media":"n/a","step_original_text":"done","step_provisional_status":"done","step_savings_residuals":"open","step_shared_sources":"n/a","steps_applicable":"6","steps_done":"3"},"readiness_blockers":[{"step":"ending_or_current_basis","what":"provisional NO, but no job found a whole-order-end candidate"}],"schema":"eo-case-bundle/v1","status":"no","text_pointers":[{"first_1500_characters":"Executive Order 12016 October 31, 1977\nExemption of G. Joseph Minettj From Mandatory Retirement\nG. Joseph Minetti, Member, Civil Aeronautics Board, became subject to manda­\ntory retirement for age on July 31, 1977, under the provisions of Section 8335 of Title  \n5 of the United States Code unless exempted by Executive Order. Mr. Minetti was  \nexempted from mandatory retirement until September 30, 1977, by Executive Order  \nNo. 12006 of July 29, 1977, and until October 31, 1977, by Executive Order No. 12011  \nof September 30, 1977.\nIn my judgment, the public interest requires that G. Joseph Minetti continue to  \nbe exempted from such mandatory retirement.\nNOW, THEREFORE, by virtue of the authority vested in me by subsection\n(c) of Section 8335 of Title 5 of the United States Code, I hereby exempt G. Joseph  \nMinetti from mandatory retirement until January 31, 1978.\nT he  W hite H ouse ,\nOctober 31, 1977.\n[FR Doc.77-31956 Filed 11-1-77 ;12:15 pm]","path":"jobs/clause-drafts/output/texts/cd-job-fr-originals-12016-5455ea52f5.txt","sha256":"926faec1c9338f59ce7faef9f59041c650b7d14cc395988d5ad5e5109f211b43","source":{"line":2780,"path":"jobs/clause-drafts/output/SOURCES.jsonl","record_sha256":"99f60462ee817643fe6b6861213e843e96da1184e01d14d1ae6bacece0818096"}},{"first_1500_characters":"Instrument: EO:12016\nSource: https://www.govinfo.gov/content/pkg/FR-1977-11-02/pdf/FR-1977-11-02.pdf\nSHA-256 of the downloaded file: 5455ea52f5e64707f9392fa07c22ed6703461b44e9ebb6edd1d8efc09568ab82\nLocation: 42 FR 57297, PDF pages 11-11 (confidence high)\nMachine-extracted text layer of the official PDF (OCR for 1936-1994 scans). May contain recognition errors and parts of neighbouring documents on the same pages. Not an authenticated transcription: check the PDF pages.\n\n=== PDF page 11 of 128 ===\np resid en tial docum ents\n[ 3195-01  ]\nTitle 3—The President\nExecutive Order 12016 October 31, 1977\nExemption of G. Joseph Minettj From Mandatory Retirement\nG. Joseph Minetti, Member, Civil Aeronautics Board, became subject to manda­\ntory retirement for age on July 31, 1977, under the provisions of Section 8335 of Title  \n5 of the United States Code unless exempted by Executive Order. Mr. Minetti was  \nexempted from mandatory retirement until September 30, 1977, by Executive Order  \nNo. 12006 of July 29, 1977, and until October 31, 1977, by Executive Order No. 12011  \nof September 30, 1977.\nIn my judgment, the public interest requires that G. Joseph Minetti continue to  \nbe exempted from such mandatory retirement.\nNOW, THEREFORE, by virtue of the authority vested in me by subsection\n(c) of Section 8335 of Title 5 of the United States Code, I hereby exempt G. Joseph  \nMinetti from mandatory retirement until January 31, 1978.\nT he  W hite H ouse ,\nOctober 31, 1977.\n[FR Doc.77-31956 Fi","path":"jobs/fr-originals/output/texts/EO_12016.txt","sha256":"aeb5bc450f6158b24495897dc6546a7cebe9acf04adbe99ad981b388c5e67cba","source":{"line":1560,"path":"jobs/fr-originals/output/SOURCES.jsonl","record_sha256":"e5fa481dae57a098bb2c4445151cf808fbdf8130ebf6f951518d69682e829307"}}]}
