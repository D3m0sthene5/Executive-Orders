CU&fields%5B%5D=citation&fields%5B%5D=disposition_notes&fields%5B%5D=document_number&fields%5B%5D=executive_order_number&fields%5B%5D=html_url&fields%5B%5D=pdf_url&fields%5B%5D=president&fields%5B%5D=publication_date&fields%5B%5D=raw_text_url&fields%5B%5D=signing_date&fields%5B%5D=title&format=json&include_pre_1994_docs=true&order=executive_order_number&page=5&per_page=1000&search_after_cursor=WzExNDk3LjAsIjExNDk3Il0"}]}],"notice":"Research startup packet; statuses remain provisional. Overflow records are explicit and require their source pointers.","overflow":{"fragments":{"reason":"30 KB startup budget; follow record pointers for complete evidence","sha256":"d6101c09eeab3dcee72be13f34985cf9736003f74995c2ad2118c913b07ce828"}},"readiness":{"blockers":"NO_CLAUSE_INVENTORY|FIRST_END_UNPROVED|SAVINGS_RESIDUALS_NOT_CLOSED|LATER_SOURCE_SEARCH_NOT_RECORDED","claim_present":"no","claim_record_errors":"","decision_origin":"inherited_legacy_v2","exhausted_steps":"","instrument_id":"EO:12121","provisional_status":"no","ready_for_human_review":"no","ready_tier":"","step_clause_inventory":"open","step_counterevidence":"open","step_ending_or_current_basis":"open","step_opus_media":"n/a","step_original_text":"done","step_provisional_status":"done","step_savings_residuals":"open","step_shared_sources":"n/a","steps_applicable":"6","steps_done":"2"},"readiness_blockers":[],"schema":"eo-case-bundle/v1","status":"no","text_pointers":[{"first_1500_characters":"Executive Order 12121 of February 26, 1979\nEnergy Coordinating Committee\np\nBy the authority vested in me as President by the Constitution of the United  \nStates of America, and in order to enlarge the membership of the Energy  \nCoordinating Committee, Section 1-102 of Executive Order No. 12083 of  \nSeptember 27, 1978, is hereby amended by adding in alphabetical order the  \nfollowing:\n“(x) The Director of the Community Services Administration.\n. “(y) The Chairman of the Council on Wage and Price Stability.”.\nTHE WHITE HOUSE,  \nFebruary 26, 1979.","path":"jobs/clause-drafts/output/texts/cd-job-fr-originals-12121-d66ea9827e.txt","sha256":"d0ac39c183d6b2542f2004c50cb4c11e7dc564510de32dbc46d0f6060a7884a9","source":{"line":2836,"path":"jobs/clause-drafts/output/SOURCES.jsonl","record_sha256":"8ab084afde82dd1dd6b19a0487cda0d1fc0c33a1824f62891164d9b51e01fcac"}},{"first_1500_characters":"{\"member\": \"usc02.xml\", \"note_id\": \"iddcb8117d-3a6e-11f1-a0f3-db3efcbbb4ee\", \"citation\": \"2 U.S.C. 685 note\", \"heading\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\", \"subjects\": [\"11845\"], \"status_line\": \"Ex. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\", \"text\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\\nEx. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\\nBy virtue of the authority vested in me by the Impoundment Control Act of 1974 (Public Law 93–344; 88 Stat. 332, (2 U.S.C. 681 et seq.), hereinafter referred to as the Act) [subchapters I and II of this chapter], and section 301 of title 3 of the United States Code, the Director of the Office of Management and Budget is hereby designated and empowered to exercise, as of October 1, 1974 without ratification or other action of the President (1) the functions required by sections 1014(b) and 1014(d) of the Act [subsecs. (b) and (d) of this section] of transmitting to the Comptroller General of the United States and to the Office of the Federal Register copies of special messages transmitted pursuant to section 1012 or 1013 (2 U.S.C. 683 and 684) of the Act; and (2) the function conferred upon the President by section 1014(e) of the Act (2 U.S.C. 685","path":"jobs/current-law/output/USC_EO_NOTES.jsonl","sha256":"ac1e287b6b606b8adc5c1975f662aae2d31989c1d072e32c89dbc38f6efe8016","source":{"line":3,"path":"jobs/current-law/output/SOURCES.jsonl","record_sha256":"5b6e5de61be4ea9c9c4749827c02d0c9d484107505b7e9adae3172a42351c188"}},{"first_1500_characters":"Instrument: EO:12121\nSource: https://www.govinfo.gov/content/pkg/FR-1979-02-28/pdf/FR-1979-02-28.pdf\nSHA-256 of the downloaded file: d66ea9827ef213cd57daa46d856989d733dbb7bd7d559b824253f70bc84f3af1\nLocation: 44 FR 11195, PDF pages 19-19 (confidence high)\nMachine-extracted text layer of the official PDF (OCR for 1936-1994 scans). May contain recognition errors and parts of neighbouring documents on the same pages. Not an authenticated transcription: check the PDF pages.\n\n=== PDF page 19 of 288 ===\n11195\nTHE PRESIDENT\nExecutive Order 12121 of February 26, 1979\nEnergy Coordinating Committee\np\nBy the authority vested in me as President by the Constitution of the United  \nStates of America, and in order to enlarge the membership of the Energy  \nCoordinating Committee, Section 1-102 of Executive Order No. 12083 of  \nSeptember 27, 1978, is hereby amended by adding in alphabetical order the  \nfollowing:\n“(x) The Director of the Community Services Administration.\n. “(y) The Chairman of the Council on Wage and Price Stability.”.\nTHE WHITE HOUSE,  \nFebruary 26, 1979.\n{FR Doc. 79-6085 \nFiled 2-26-79; 5:07 pm]\nBilling code 3195-01-M\nFEDERAL REGISTER, V O L  44, NO. 41— WEDNESDAY, FEBRUARY 28, 1979\n","path":"jobs/fr-originals/output/texts/EO_12121.txt","sha256":"ce018b068c29887cd426013d1f05292f38c9aee699cd29b25401a897ed37832b","source":{"line":1626,"path":"jobs/fr-originals/output/SOURCES.jsonl","record_sha256":"18c863a069b16c264b098678e65084e766a6e4b17a44acb2eb1c3738c3073890"}}]}
