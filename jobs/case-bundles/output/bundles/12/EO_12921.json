B%5D=PRESDOCU&fields%5B%5D=citation&fields%5B%5D=disposition_notes&fields%5B%5D=document_number&fields%5B%5D=executive_order_number&fields%5B%5D=html_url&fields%5B%5D=pdf_url&fields%5B%5D=president&fields%5B%5D=publication_date&fields%5B%5D=raw_text_url&fields%5B%5D=signing_date&fields%5B%5D=title&format=json&include_pre_1994_docs=true&order=executive_order_number&page=6&per_page=1000&search_after_cursor=WzEyNDk3LjAsIjEyNDk3Il0"}]}],"notice":"Research startup packet; statuses remain provisional. Overflow records are explicit and require their source pointers.","readiness":{"blockers":"NO_CLAUSE_INVENTORY|FIRST_END_UNPROVED|SAVINGS_RESIDUALS_NOT_CLOSED","claim_present":"no","claim_record_errors":"","decision_origin":"inherited_legacy_v2","exhausted_steps":"","instrument_id":"EO:12921","provisional_status":"no","ready_for_human_review":"no","ready_tier":"","step_clause_inventory":"open","step_counterevidence":"done","step_ending_or_current_basis":"open","step_opus_media":"n/a","step_original_text":"done","step_provisional_status":"done","step_savings_residuals":"open","step_shared_sources":"n/a","steps_applicable":"6","steps_done":"3"},"readiness_blockers":[],"schema":"eo-case-bundle/v1","status":"no","text_pointers":[{"first_1500_characters":"Executive Order 12921 of June 13, 1994\nAmendment to Executive Order No. 12864\nBy the authority vested in me as President by the Constitution and the \nlaws of the United States of America, and in order to provide for the \nappointment of up to 37 members to the United States Advisory Council \non the National Information Infrastructure, it is hereby ordered that section \n1(a) of Executive Order No. 12864, as amended, is further amended by \ndeleting the number “ 30” and inserting the number “ 37” in lieu thereof.\nTHE WHITE HOUSE, \nJune 13, 1994.","path":"jobs/clause-drafts/output/texts/cd-job-fr-originals-12921-8be9acbeae.txt","sha256":"73a51140d7204c0da44c61a73de405204ae1a50feea16a2057b45b898a95a972","source":{"line":3246,"path":"jobs/clause-drafts/output/SOURCES.jsonl","record_sha256":"9542f0c3e409698527d1b8458168440058082815f2d504699507b0cc294540ea"}},{"first_1500_characters":"{\"member\": \"usc02.xml\", \"note_id\": \"iddcb8117d-3a6e-11f1-a0f3-db3efcbbb4ee\", \"citation\": \"2 U.S.C. 685 note\", \"heading\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\", \"subjects\": [\"11845\"], \"status_line\": \"Ex. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\", \"text\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\\nEx. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\\nBy virtue of the authority vested in me by the Impoundment Control Act of 1974 (Public Law 93–344; 88 Stat. 332, (2 U.S.C. 681 et seq.), hereinafter referred to as the Act) [subchapters I and II of this chapter], and section 301 of title 3 of the United States Code, the Director of the Office of Management and Budget is hereby designated and empowered to exercise, as of October 1, 1974 without ratification or other action of the President (1) the functions required by sections 1014(b) and 1014(d) of the Act [subsecs. (b) and (d) of this section] of transmitting to the Comptroller General of the United States and to the Office of the Federal Register copies of special messages transmitted pursuant to section 1012 or 1013 (2 U.S.C. 683 and 684) of the Act; and (2) the function conferred upon the President by section 1014(e) of the Act (2 U.S.C. 685","path":"jobs/current-law/output/USC_EO_NOTES.jsonl","sha256":"ac1e287b6b606b8adc5c1975f662aae2d31989c1d072e32c89dbc38f6efe8016","source":{"line":3,"path":"jobs/current-law/output/SOURCES.jsonl","record_sha256":"5b6e5de61be4ea9c9c4749827c02d0c9d484107505b7e9adae3172a42351c188"}},{"first_1500_characters":"Instrument: EO:12921\nSource: https://www.govinfo.gov/content/pkg/FR-1994-06-15/pdf/FR-1994-06-15.pdf\nSHA-256 of the downloaded file: 8be9acbeae97692d31d5096806b8a71567f2a71c04e00146a2642704ff46a822\nLocation: 59 FR 30667, PDF pages 14-14 (confidence high)\nMachine-extracted text layer of the official PDF (OCR for 1936-1994 scans). May contain recognition errors and parts of neighbouring documents on the same pages. Not an authenticated transcription: check the PDF pages.\n\n=== PDF page 14 of 219 ===\nFederal Register /  Vol. 59, No. 114 /  Wednesday, June 15, 1994 /  Presidential Documents 30667\nPresidential Documents\nExecutive Order 12921 of June 13, 1994\nAmendment to Executive Order No. 12864\nBy the authority vested in me as President by the Constitution and the \nlaws of the United States of America, and in order to provide for the \nappointment of up to 37 members to the United States Advisory Council \non the National Information Infrastructure, it is hereby ordered that section \n1(a) of Executive Order No. 12864, as amended, is further amended by \ndeleting the number “ 30” and inserting the number “ 37” in lieu thereof.\nTHE WHITE HOUSE, \nJune 13, 1994.\n(FR Doc 94-14728 \nFiled 6-13— 94; 4:09 pm} \nBilling code 3195-01-P\n","path":"jobs/fr-originals/output/texts/EO_12921.txt","sha256":"ab27c141404ae5ae3b58e44920a688979137ba8a065ac6246abfa193b6ff565b","source":{"line":1978,"path":"jobs/fr-originals/output/SOURCES.jsonl","record_sha256":"c7376b42a8dea251cd4a9c0679ad2bd43131f215aa232bf945cf9b509d9ed3f2"}}]}
