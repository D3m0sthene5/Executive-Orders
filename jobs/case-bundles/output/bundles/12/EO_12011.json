flow records are explicit and require their source pointers.","readiness":{"blockers":"NO_CLAUSE_INVENTORY|FIRST_END_UNPROVED|SAVINGS_RESIDUALS_NOT_CLOSED","claim_present":"no","claim_record_errors":"","decision_origin":"inherited_legacy_v2","exhausted_steps":"","instrument_id":"EO:12011","provisional_status":"no","ready_for_human_review":"no","ready_tier":"","step_clause_inventory":"open","step_counterevidence":"done","step_ending_or_current_basis":"open","step_opus_media":"n/a","step_original_text":"done","step_provisional_status":"done","step_savings_residuals":"open","step_shared_sources":"n/a","steps_applicable":"6","steps_done":"3"},"readiness_blockers":[{"step":"ending_or_current_basis","what":"provisional NO, but no job found a whole-order-end candidate"}],"schema":"eo-case-bundle/v1","status":"no","text_pointers":[{"first_1500_characters":"Executive Order 12011 September 30, 1977\nExemption of G. Joseph Minetti from Mandatory Retirement\nG. Joseph Minetti, Member, Civil Aeronautics Board, became subject to manda­\ntory retirement for age on July 31, 1977, under the provisions of Section 8335 of \nTitle 5 of the United States Code unless exempted by Executive Order. Mr. Minetti \nwas exempted from mandatory retirement until September 30, 1977, by Executive \nOrder No. 12006 of July 29, 1977/\nIn my judgment, the public interest requires that G. Joseph Minetti continue to \nbe exempted from such mandatory retirement.\nNOW , THEREFORE, by virtue of the authority vested in me by subsection (c) \nof Section 8335 of Title 5 of the United States Code, I hereby exempt G. Joseph \nMinetti from mandatory retirement until October 31, 1977.\nT h e W h ite H ou se,\nSeptember 30,1977.","path":"jobs/clause-drafts/output/texts/cd-job-fr-originals-12011-9d0fac48ea.txt","sha256":"bde10d07995710f9bad6e1b6c13e2e5004256eed0b241d1673dacdab01191af8","source":{"line":2778,"path":"jobs/clause-drafts/output/SOURCES.jsonl","record_sha256":"bbccda492a0665f3da7e1779af0f886ac2f4e9816ca0140f80e7007a52546e07"}},{"first_1500_characters":"Instrument: EO:12011\nSource: https://www.govinfo.gov/content/pkg/FR-1977-10-04/pdf/FR-1977-10-04.pdf\nSHA-256 of the downloaded file: 9d0fac48ea3fd6e9d928a865caf879da6e33bb3e6e2543585618fddacddee698\nLocation: 42 FR 53899, PDF pages 17-17 (confidence high)\nMachine-extracted text layer of the official PDF (OCR for 1936-1994 scans). May contain recognition errors and parts of neighbouring documents on the same pages. Not an authenticated transcription: check the PDF pages.\n\n=== PDF page 17 of 344 ===\nTHE PRESIDENT 53899\n[3195-01]\nExecutive Order 12011 September 30, 1977\nExemption of G. Joseph Minetti from Mandatory Retirement\nG. Joseph Minetti, Member, Civil Aeronautics Board, became subject to manda­\ntory retirement for age on July 31, 1977, under the provisions of Section 8335 of \nTitle 5 of the United States Code unless exempted by Executive Order. Mr. Minetti \nwas exempted from mandatory retirement until September 30, 1977, by Executive \nOrder No. 12006 of July 29, 1977/\nIn my judgment, the public interest requires that G. Joseph Minetti continue to \nbe exempted from such mandatory retirement.\nNOW , THEREFORE, by virtue of the authority vested in me by subsection (c) \nof Section 8335 of Title 5 of the United States Code, I hereby exempt G. Joseph \nMinetti from mandatory retirement until October 31, 1977.\nT h e W h ite H ou se,\nSeptember 30,1977.\n{FR Doc.77-29279 Filed 9-30-77 ;5 :09 pm]\nFEDERAL REGISTER, VOL. 42, N O . 192— TUESDAY, OCTOBER 4, 1977\n","path":"jobs/fr-originals/output/texts/EO_12011.txt","sha256":"b6a6b6ad2b54ababaf78623d8e14157c373ed72b1b87e9296500011cbeab6403","source":{"line":1558,"path":"jobs/fr-originals/output/SOURCES.jsonl","record_sha256":"86dec40d21d243c632fa3e5da02f3434ac3a22de6026a7de1fac80854168eaeb"}}]}
