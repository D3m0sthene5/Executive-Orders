5D=disposition_notes&fields%5B%5D=document_number&fields%5B%5D=executive_order_number&fields%5B%5D=html_url&fields%5B%5D=pdf_url&fields%5B%5D=president&fields%5B%5D=publication_date&fields%5B%5D=raw_text_url&fields%5B%5D=signing_date&fields%5B%5D=title&format=json&include_pre_1994_docs=true&order=executive_order_number&page=6&per_page=1000&search_after_cursor=WzEyNDk3LjAsIjEyNDk3Il0"},{"page_or_item":"OFR API record executive_order_number=12402; citation 48 FR 2311; field disposition_notes","sha256":"79e100de57f8d997baaa1875f1937e8ee54569852f043ec283a3242cbcf3893e","url":"https://www.federalregister.gov/api/v1/documents?conditions%5Bcorrection%5D=0&conditions%5Bpresidential_document_type%5D=executive_order&conditions%5Btype%5D%5B%5D=PRESDOCU&fields%5B%5D=citation&fields%5B%5D=disposition_notes&fields%5B%5D=document_number&fields%5B%5D=executive_order_number&fields%5B%5D=html_url&fields%5B%5D=pdf_url&fields%5B%5D=president&fields%5B%5D=publication_date&fields%5B%5D=raw_text_url&fields%5B%5D=signing_date&fields%5B%5D=title&format=json&include_pre_1994_docs=true&order=executive_order_number&page=5&per_page=1000&search_after_cursor=WzExNDk3LjAsIjExNDk3Il0"}]}],"notice":"Research startup packet; statuses remain provisional. Overflow records are explicit and require their source pointers.","readiness":{"blockers":"ORIGINAL_FOUND_NEEDS_PAGE_CHECK|NO_CLAUSE_INVENTORY|FIRST_END_UNPROVED|SAVINGS_RESIDUALS_NOT_CLOSED|LATER_SOURCE_SEARCH_NOT_RECORDED","claim_present":"no","claim_record_errors":"","decision_origin":"inherited_legacy_v2","exhausted_steps":"","instrument_id":"EO:12402","provisional_status":"no","ready_for_human_review":"no","ready_tier":"","step_clause_inventory":"open","step_counterevidence":"open","step_ending_or_current_basis":"open","step_opus_media":"n/a","step_original_text":"open","step_provisional_status":"done","step_savings_residuals":"open","step_shared_sources":"n/a","steps_applicable":"6","steps_done":"1"},"readiness_blockers":[{"step":"clause_inventory","what":"no clause inventory drafted; clause-drafts could not segment the available text(s): official_fr_scan_ocr_text:body_only_refused_text_has_heading_for_other_order_12432"}],"schema":"eo-case-bundle/v1","status":"no","text_pointers":[{"first_1500_characters":"{\"member\": \"usc02.xml\", \"note_id\": \"iddcb8117d-3a6e-11f1-a0f3-db3efcbbb4ee\", \"citation\": \"2 U.S.C. 685 note\", \"heading\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\", \"subjects\": [\"11845\"], \"status_line\": \"Ex. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\", \"text\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\\nEx. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\\nBy virtue of the authority vested in me by the Impoundment Control Act of 1974 (Public Law 93–344; 88 Stat. 332, (2 U.S.C. 681 et seq.), hereinafter referred to as the Act) [subchapters I and II of this chapter], and section 301 of title 3 of the United States Code, the Director of the Office of Management and Budget is hereby designated and empowered to exercise, as of October 1, 1974 without ratification or other action of the President (1) the functions required by sections 1014(b) and 1014(d) of the Act [subsecs. (b) and (d) of this section] of transmitting to the Comptroller General of the United States and to the Office of the Federal Register copies of special messages transmitted pursuant to section 1012 or 1013 (2 U.S.C. 683 and 684) of the Act; and (2) the function conferred upon the President by section 1014(e) of the Act (2 U.S.C. 685","path":"jobs/current-law/output/USC_EO_NOTES.jsonl","sha256":"ac1e287b6b606b8adc5c1975f662aae2d31989c1d072e32c89dbc38f6efe8016","source":{"line":3,"path":"jobs/current-law/output/SOURCES.jsonl","record_sha256":"5b6e5de61be4ea9c9c4749827c02d0c9d484107505b7e9adae3172a42351c188"}},{"first_1500_characters":"Instrument: EO:12402\nSource: https://www.govinfo.gov/content/pkg/FR-1983-01-18/pdf/FR-1983-01-18.pdf\nSHA-256 of the downloaded file: 17a00614d1f4f84556e115128f869f71acea393d168c9e273142b0e6d57e7a50\nLocation: 48 FR 2311, PDF pages 203-203 (confidence low)\nMachine-extracted text layer of the official PDF (OCR for 1936-1994 scans). May contain recognition errors and parts of neighbouring documents on the same pages. Not an authenticated transcription: check the PDF pages.\n\n=== PDF page 203 of 208 ===\nFederal Register /  Vol. 48, No. 12 /  Tuesday, January 18,1 9 8 3  /  Presidential Documents 2311\nPresidential Documents\nExecutive Order 12432 of January 15, 1983\nNational Commission on Social Security Reform\nBy the authority vested in me as President by the Constitution and law s of the  \nUnited States of Am erica, and specifically the Federal Advisory Committee  \nA ct, as amended (5 U.S.C. App. I), it is hereby ordered that Section 2(b) of  \nExecutive Order No. 12335, as amended, establishing the National Commis­\nsion on Social Security Reform, is hereby further amended to provide* as  \nfollows:\n“The Commission shall m ake its report to the President by January 2 0 ,1 9 8 3 .”.\nTHE W H ITE HOUSE,  \nJ a n u a r y  15, 1983.\n[FR Doc. 83-1527 \nFiled 1-17-83; 11:42 am] \nBilling code 3195-01-M\n","path":"jobs/fr-originals/output/texts/EO_12402.txt","sha256":"e59a7a9d5c548fe09bcc0c523ab298f5e6c9672d7e35524f3f11f17541538884","source":{"line":1777,"path":"jobs/fr-originals/output/SOURCES.jsonl","record_sha256":"7e08e58899814996bb4e04cc6e5d71c070ebedf8e8c05d4d251163b6f424a900"}}]}
