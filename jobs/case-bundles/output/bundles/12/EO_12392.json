ath":"jobs/clause-drafts/output/texts/cd-job-fr-originals-12392-785b8b4511.txt","sha256":"9953b29eb37572dd3b0602c26d934634fa2d018590bbb8c01c9bf000a745c453","source":{"line":2976,"path":"jobs/clause-drafts/output/SOURCES.jsonl","record_sha256":"b8522dd45823551fe3e961549b328a283669dac81f54bd83b342d699d3183b12"}},{"first_1500_characters":"Instrument: EO:12392\nSource: https://www.govinfo.gov/content/pkg/FR-1982-11-17/pdf/FR-1982-11-17.pdf\nSHA-256 of the downloaded file: 785b8b45115866c0d2dc2dccf66d1673c1239d4774ad02458ef0f91d8dab4871\nLocation: 47 FR 51715, PDF pages 11-11 (confidence high)\nMachine-extracted text layer of the official PDF (OCR for 1936-1994 scans). May contain recognition errors and parts of neighbouring documents on the same pages. Not an authenticated transcription: check the PDF pages.\n\n=== PDF page 11 of 152 ===\nFederal Register / Vol. 47, No. 222 / Wednesday, November 17,1982 / Presidential Documents 51715\nPresidential Documents\nExecutive Order 12392 of November 15, 1982\nInternational Financial Institutions\nBy the authority vested in me as President by the Constitution and statutes of  \nthe United States of America, including Section 301 of Title 3 of the United  \nStates Code, and in order to assign to the Secretary of the Treasury the  \nauthority to make payments to certain international financial institutions, it is  \nhereby ordered that the functions vested in the President by Section 129 of  \nPublic Law 97-276 (October 2, 1982) are delegated to the Secretary of the  \nTreasury.\nTHE WHITE HOUSE,  \nN ovem ber 15, 1982.\n[FR Doc. 82-31705 \nFiled 11-18-82; 10:06 am]  \nBilling code 3Ï95-01-M\n","path":"jobs/fr-originals/output/texts/EO_12392.txt","sha256":"a3173d4771d6bc93c21b22cc3ab2e65642a19de839a027dac75f4c6fed9ee8f3","source":{"line":1768,"path":"jobs/fr-originals/output/SOURCES.jsonl","record_sha256":"87183003ea85096d9ae9a141acc7763ca3813c6da8ee3ab705116a1013ab8fed"}}]}
