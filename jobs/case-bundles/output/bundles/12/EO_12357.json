_review":"no","ready_tier":"","step_clause_inventory":"open","step_counterevidence":"open","step_ending_or_current_basis":"open","step_opus_media":"n/a","step_original_text":"done","step_provisional_status":"done","step_savings_residuals":"open","step_shared_sources":"n/a","steps_applicable":"6","steps_done":"2"},"readiness_blockers":[{"step":"clause_inventory","what":"no clause inventory drafted; clause-drafts could not segment the available text(s): official_fr_scan_ocr_text:segmented:unusable(no_operative_unit_found)"}],"schema":"eo-case-bundle/v1","status":"no","text_pointers":[{"first_1500_characters":"{\"member\": \"usc02.xml\", \"note_id\": \"iddcb8117d-3a6e-11f1-a0f3-db3efcbbb4ee\", \"citation\": \"2 U.S.C. 685 note\", \"heading\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\", \"subjects\": [\"11845\"], \"status_line\": \"Ex. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\", \"text\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\\nEx. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\\nBy virtue of the authority vested in me by the Impoundment Control Act of 1974 (Public Law 93–344; 88 Stat. 332, (2 U.S.C. 681 et seq.), hereinafter referred to as the Act) [subchapters I and II of this chapter], and section 301 of title 3 of the United States Code, the Director of the Office of Management and Budget is hereby designated and empowered to exercise, as of October 1, 1974 without ratification or other action of the President (1) the functions required by sections 1014(b) and 1014(d) of the Act [subsecs. (b) and (d) of this section] of transmitting to the Comptroller General of the United States and to the Office of the Federal Register copies of special messages transmitted pursuant to section 1012 or 1013 (2 U.S.C. 683 and 684) of the Act; and (2) the function conferred upon the President by section 1014(e) of the Act (2 U.S.C. 685","path":"jobs/current-law/output/USC_EO_NOTES.jsonl","sha256":"ac1e287b6b606b8adc5c1975f662aae2d31989c1d072e32c89dbc38f6efe8016","source":{"line":3,"path":"jobs/current-law/output/SOURCES.jsonl","record_sha256":"5b6e5de61be4ea9c9c4749827c02d0c9d484107505b7e9adae3172a42351c188"}},{"first_1500_characters":"Instrument: EO:12357\nSource: https://www.govinfo.gov/content/pkg/FR-1982-04-08/pdf/FR-1982-04-08.pdf\nSHA-256 of the downloaded file: 2487eda3974fc272074961f272fda9546fd96ca8bfdf6254b13f40853a8355c6\nLocation: 47 FR 15093, PDF pages 11-11 (confidence high)\nMachine-extracted text layer of the official PDF (OCR for 1936-1994 scans). May contain recognition errors and parts of neighbouring documents on the same pages. Not an authenticated transcription: check the PDF pages.\n\n=== PDF page 11 of 232 ===\nFederal Register /  Vol. 47, No. 68 /  Thursday, April 8,1982 /  Presidential Documents 15093\nPresidential Documents\nExecutive Order 12357 of April 6, 1982\nSinai Support Mission\nBy the authority vested in me as President by the Constitution and statutes of \nthe United States of America, including Chapter 6 of Part II of the Foreign \n^Assistance Act of 1961, as amended (22 U.S.C. 2348, 2348a-2348c), and Section \n6 of the Special International Security A ssistance Act of 1979 (22 U.S.C. 3404), \nSection 2 of Executive Order No. 11896, as amended, is further amended by \nadding thereto the following:\n“(f) The functions vested in the President by Section 6 of the Special Interna­\ntional Security A ssistance Act of 1979 (22 U.S.C. 3404) are delegated to the \nDirector.\n“(g) The Director shall, as soon as possible after the Multinational Force and \nObservers becomes operational on April 25, 1982, phase-out the activities of \nthe Mission in the Sinai and terminate all functions of the Mission ","path":"jobs/fr-originals/output/texts/EO_12357.txt","sha256":"4c7d20467ecd9d8f555f433fa7e59d92bd4e2f9c7f2e0870993d4e9be756fe50","source":{"line":1749,"path":"jobs/fr-originals/output/SOURCES.jsonl","record_sha256":"6b69de52b9f4b2078a943c78eb57c4b0b1b6441d429f1d7d0d61e356bbbf562c"}}]}
