 record executive_order_number=8827; field disposition_notes","sha256":"95361ad83413ec8072599698e736ced47ecdf3830b181329ca993b8bfa8c0113","url":"https://www.federalregister.gov/api/v1/documents?conditions%5Bcorrection%5D=0&conditions%5Bpresidential_document_type%5D=executive_order&conditions%5Btype%5D%5B%5D=PRESDOCU&fields%5B%5D=citation&fields%5B%5D=disposition_notes&fields%5B%5D=document_number&fields%5B%5D=executive_order_number&fields%5B%5D=html_url&fields%5B%5D=pdf_url&fields%5B%5D=president&fields%5B%5D=publication_date&fields%5B%5D=raw_text_url&fields%5B%5D=signing_date&fields%5B%5D=title&format=json&include_pre_1994_docs=true&order=executive_order_number&page=2&per_page=1000&search_after_cursor=Wzg1MjMuMCwiODUyMyJd"}]}],"notice":"Research startup packet; statuses remain provisional. Overflow records are explicit and require their source pointers.","readiness":{"blockers":"NO_OFFICIAL_SOURCE_LOCATED|ONLY_COMPILED_TRANSCRIPTION_FOUND|NO_CLAUSE_INVENTORY|FIRST_END_UNPROVED|SAVINGS_RESIDUALS_NOT_CLOSED","claim_present":"no","claim_record_errors":"","decision_origin":"inherited_legacy_v2","exhausted_steps":"","instrument_id":"EO:8827","provisional_status":"no","ready_for_human_review":"no","ready_tier":"","step_clause_inventory":"open","step_counterevidence":"done","step_ending_or_current_basis":"open","step_opus_media":"n/a","step_original_text":"open","step_provisional_status":"done","step_savings_residuals":"open","step_shared_sources":"n/a","steps_applicable":"6","steps_done":"2"},"readiness_blockers":[{"step":"original_text","what":"no official original-text candidate from any job; fr-originals: ofr_index_not_received_for_publication (The OFR index marks this order 'not received for publication', so it was probably never printed in the Federal Register (OFR catalog statement, not verified here). Other routes: NARA, presidential lib); 1 compiled-transcription lead(s) (for example Richardson) point to the text but are not the original by themselves"},{"step":"ending_or_current_basis","what":"provisional NO, but no job found a whole-order-end candidate"}],"schema":"eo-case-bundle/v1","status":"no","text_pointers":[{"first_1500_characters":"Whereas, in my judgment, the public interest requires that Harry T. Edwards, senior technologist, Bureau of Plant Industry, Department of Agriculture, who was exempted from compulsory retirement for age for periods totaling two years by Executive Orders No. 8259 of September 21, 1939, and No. 8525 of August 26, 1940, be further exempted from such compulsory retirement for a period of one year:\n\nNow, Therefore, by virtue of and pursuant to the authority vested in me by section 204 of the act of June 30, 1932, 47 Stat. 382, 404 (U.S.C., title 5, sec. 715a), I hereby further exempt the said Harry T. Edwards from compulsory retirement for age for a period of one year ending October 31, 1941.\n\nFRANKLIN D ROOSEVELT\n\nThe White House,\n\nJuly 24, 1941.\n","path":"jobs/app-executive-orders/output/texts/executive-order-8827-exemption-harry-t-edwards-from-compulsory-retirement-for-age.txt","sha256":"399c16d3166410b3ccda68ca5e51361301ac4cca81b0d65aee94eff23e796596","source":{"line":8715,"path":"jobs/app-transcriptions/output/SOURCES.jsonl","record_sha256":"03d55ba9f27b01214652662da942e1a43042f683488d6c4f228b3c56533aa6df"}},{"first_1500_characters":"Executive Order 8827—Exemption of Harry T. Edwards From Compulsory Retirement for Age\n\nWhereas, in my judgment, the public interest requires that Harry T. Edwards, senior technologist, Bureau of Plant Industry, Department of Agriculture, who was exempted from compulsory retirement for age for periods totaling two years by Executive Orders No. 8259 of September 21, 1939, and No. 8525 of August 26, 1940, be further exempted from such compulsory retirement for a period of one year:\n\nNow, Therefore, by virtue of and pursuant to the authority vested in me by section 204 of the act of June 30, 1932, 47 Stat. 382, 404 (U.S.C., title 5, sec. 715a), I hereby further exempt the said Harry T. Edwards from compulsory retirement for age for a period of one year ending October 31, 1941.\n\nFRANKLIN D ROOSEVELT\n\nThe White House,\n\nJuly 24, 1941.","path":"jobs/clause-drafts/output/texts/cd-job-app-executive-orders-8827-d4fb7f4e88.txt","sha256":"f2749baa8f55372aaf171248ce2f4980288db2c5d2797821e22ee2824c45f223","source":{"line":4241,"path":"jobs/clause-drafts/output/SOURCES.jsonl","record_sha256":"4f23b0cadf07288c38a87d91d712a0a40004e5b2053d09eac501ffa5a5c9cd4b"}}]}
