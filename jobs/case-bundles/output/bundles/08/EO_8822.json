rrors":"","decision_origin":"inherited_legacy_v2","exhausted_steps":"","instrument_id":"EO:8822","original_text_basis":"official","provisional_status":"no","ready_for_human_review":"no","ready_tier":"","step_clause_inventory":"open","step_counterevidence":"done","step_ending_or_current_basis":"open","step_opus_media":"n/a","step_original_text":"done","step_provisional_status":"done","step_savings_residuals":"open","step_shared_sources":"n/a","steps_applicable":"6","steps_done":"3"},"readiness_blockers":[{"step":"ending_or_current_basis","what":"provisional NO, but no job found a whole-order-end candidate"}],"schema":"eo-case-bundle/v1","status":"no","text_pointers":[{"first_1500_characters":"By virtue of the authority vested in me by the Constitution and statutes of the United States, Executive Order No. 8757 of May 20, 1941, establishing the Office of Civilian Defense in the Office for Emergency Management of the Executive Office of the President, is hereby amended to include the American Red Cross among the organizations invited to designate a representative to serve as a member of the Board for Civilian Protection in the Office of Civilian Defense.\n\nFRANKLIN D ROOSEVELT\n\nThe White House,\n\nJuly 16, 1941.\n","path":"jobs/app-executive-orders/output/texts/executive-order-8822-amendment-executive-order-no-8757-may-20-1941-establishing-the-office.txt","sha256":"8d049798e4824e1649133f843ae9a0660829c05e9509018c751b24b5012828e2","source":{"line":8710,"path":"jobs/app-transcriptions/output/SOURCES.jsonl","record_sha256":"1a599174b90ffe7054515a75e77987bce89dc55cfc07bb65f480c9e0d8a30bb1"}},{"first_1500_characters":"Executive Order 8822—Amendment of Executive Order No. 8757 of May 20, 1941, Establishing the Office of Civilian Defense\n\nBy virtue of the authority vested in me by the Constitution and statutes of the United States, Executive Order No. 8757 of May 20, 1941, establishing the Office of Civilian Defense in the Office for Emergency Management of the Executive Office of the President, is hereby amended to include the American Red Cross among the organizations invited to designate a representative to serve as a member of the Board for Civilian Protection in the Office of Civilian Defense.\n\nFRANKLIN D ROOSEVELT\n\nThe White House,\n\nJuly 16, 1941.","path":"jobs/clause-drafts/output/texts/cd-job-app-executive-orders-8822-357ffde85d.txt","sha256":"affa60b347e1b7b5b4ab39a77e13dd35ae0c38ed65da0918910f47be06e3df6b","source":{"line":4236,"path":"jobs/clause-drafts/output/SOURCES.jsonl","record_sha256":"8da3a6c53ab44a89678100cc5c479787c9f62c3598ce15b4379ecbe60c28ac0e"}},{"first_1500_characters":"Instrument: EO:8822\nSource: https://www.govinfo.gov/content/pkg/FR-1941-07-18/pdf/FR-1941-07-18.pdf\nSHA-256 of the downloaded file: 91902cbf964af743b8bed5bc3ebabec2b821c7ae19b2933f41312a4d452437c0\nLocation: 6 FR 3529, PDF pages 1-1 (confidence high)\nMachine-extracted text layer of the official PDF (OCR for 1936-1994 scans). May contain recognition errors and parts of neighbouring documents on the same pages. Not an authenticated transcription: check the PDF pages.\n\n=== PDF page 1 of 26 ===\n»  M I iT T rO A  \\ V i\nDERALREGISTER\nVOLUM E 6 » * ♦  e j v  \n*  ^ A / I T E O  ^\nNUM BER 139\nWashington, Friday, July 18, 1941\nThe President e x e c u t i v e o r d e r\nA m e n d m e n t of E xecutive  O rder N o.\nCONTENTS  \nTHE PR ESIDENT\nEXECUTIVE ORDER\nReserving  P ublic  L and  for  U se  of  the  \nDepartment  of the  N a v y for  N aval  \nAviation  P urposes\nNEVADA\nBy virtue of the authority vested in me  \nas President of the United States, it is  \nhereby ordered as follows:\n1, The following-described tract of  \nland in the Southwest quarter (SW V i)  \nof section 8, T. 23 S., R. 64 E., M. D. M.,  \nNevada, containing twenty (20) acres,  \nmore or less, at the Boulder City Airport  \nsite, within the Boulder Dam National  \nRecreational Area, is hereby set apart  \nand reserved for use for naval aviation  \npurposes under the jurisdiction of the  \nSecretary of the Navy:\nBeginning at a point in NE%SW% sec. 8  \nfrom which the corner of secs. 5, 6, 7, and 8  \nbears N. 87°23'53\" W., 3943.29 fee","path":"jobs/fr-originals/output/texts/EO_8822.txt","sha256":"45f8fed8f0ec5fde70789b958c20c1e45f52754005ead41b8e90b24b70a3b35f","source":{"line":162,"path":"jobs/fr-originals/output/SOURCES.jsonl","record_sha256":"8b6c1dfc7f78250cb86d872aa4db2ed00ebf34f8b0607873742a1c369318bc7e"}}]}
