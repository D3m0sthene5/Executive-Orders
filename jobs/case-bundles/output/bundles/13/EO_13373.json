isposition_notes","sha256":"8ba9e1cce593bb06b6be625b585b15bb04a1555ed34ad8c5b6f8c9bd81f83f77","url":{"characters":590,"preview":"https://www.federalregister.gov/api/v1/documents?conditions%5Bcorrection%5D=0&conditions%5Bpresidential_document_type%5D=executive_order&conditions%5B","sha256_utf8":"d136bbd46dbf384a5a7f7e191405abcdeb476b9adbc9e10d1abc6539fa76c008","truncated":true}}],"summary":"See complete record at pointer"}],"notice":"Research startup packet; statuses remain provisional. Overflow records are explicit and require their source pointers.","overflow":{"claim_draft":{"reason":"30 KB startup budget; follow record pointers for complete evidence","sha256":"092af4903ed1253e68172312d9e6138b370815be052abb5717efcbc41a422f4c"},"conflicts":{"reason":"30 KB startup budget; follow record pointers for complete evidence","sha256":"4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945"},"current_law_hits":{"reason":"30 KB startup budget; follow record pointers for complete evidence","sha256":"2dce0eff69c3c723dabb9074545a5f7a3d6de22bc2ce06e88dd72013a7facdfa"},"fragments":{"reason":"30 KB startup budget; follow record pointers for complete evidence","sha256":"31af1f48108a76af7fb8459ed40013ac94a5ca54ea8e62040da95800cb911ee4"},"later_events":{"reason":"30 KB startup budget; follow record pointers for complete evidence","sha256":"255dd1465b3787a177c1100eac772a96b7839ad9c860b68934b80b0afb66f017"}},"readiness":{"blockers":"CLAIM_INCOMPLETE:clause_inventory|CLAIM_INCOMPLETE:ending_or_current_basis|CLAIM_INCOMPLETE:savings_residuals","claim_present":"yes","claim_record_errors":"unresolved_material_gaps","decision_origin":"inherited_legacy_v2","exhausted_steps":"","instrument_id":"EO:13373","provisional_status":"yes","ready_for_human_review":"no","ready_tier":"","step_clause_inventory":"open","step_counterevidence":"done","step_ending_or_current_basis":"open","step_opus_media":"n/a","step_original_text":"done","step_provisional_status":"done","step_savings_residuals":"open","step_shared_sources":"n/a","steps_applicable":"6","steps_done":"3"},"readiness_blockers":[{"step":"ending_or_current_basis","what":"no current-law lead is checked through 2026-10-14 (U.S. Code entries are current only through 2026-10-09); confirm the last days by hand"}],"schema":"eo-case-bundle/v1","status":"yes","text_pointers":[{"first_1500_characters":"Executive Order 13373 of March 10, 2005\nAmendments to Executive Order 11926 Relating to the Vice\nPresidential Service Badge\nBy the authority vested in me as President by the Constitution and the\nlaws of the United States of America, it is hereby ordered as follows:\nSection 1. Amendments to Executive Order 11926. Executive Order 11926\nof July 19, 1976, as amended by Executive Order 13286 of February 28,\n2003, is further amended as follows:\n(a) in section 1, by striking ‘‘and Coast Guard’’ and inserting in lieu\nthereof ‘‘Coast Guard, commissioned corps of the National Oceanic and\nAtmospheric Administration, and commissioned corps of the Public Health\nService’’;\n(b) in section 1, by inserting ‘‘, or who have been assigned to perform\nduties predominantly for the Vice President for a period of at least one\nyear subsequent to January 20, 2001, in the implementation of Public Law\n93–346, as amended, or in military units and support facilities to which\nsection 1 of Executive Order 12793 of March 20, 1992, as amended, refers’’\nimmediately preceding the period;\n(c) in section 2, by striking ‘‘Military Assistant to the Vice President’’\nand inserting in lieu thereof ‘‘Vice President’s designee (with the concurrence\nof the Director of the White House Military Office in the case of personnel\nin military units or support facilities to which section 1 of Executive Order\n12793, as amended, refers)’’;\n(d) in section 2, by inserting ‘‘and, in the case of members of the commis-\nsioned corps of t","path":"jobs/clause-drafts/output/texts/cd-stage21-13373-4a783e7a5b.txt","sha256":"aa80ac087135016c837e0b9ef11791f91f60c1e316533272cdb74044a0a45c97","source":{"line":3705,"path":"jobs/clause-drafts/output/SOURCES.jsonl","record_sha256":"424b85025eccd4cd9e37b512afee2ae8e4f142cee489bfb314783b8e4241975f"}},{"first_1500_characters":"{\"member\": \"usc02.xml\", \"note_id\": \"iddcb8117d-3a6e-11f1-a0f3-db3efcbbb4ee\", \"citation\": \"2 U.S.C. 685 note\", \"heading\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\", \"subjects\": [\"11845\"], \"status_line\": \"Ex. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\", \"text\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\\nEx. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\\nBy virtue of the authority vested in me by the Impoundment Control Act of 1974 (Public Law 93–344; 88 Stat. 332, (2 U.S.C. 681 et seq.), hereinafter referred to as the Act) [subchapters I and II of this chapter], and section 301 of title 3 of the United States Code, the Director of the Office of Management and Budget is hereby designated and empowered to exercise, as of October 1, 1974 without ratification or other action of the President (1) the functions required by sections 1014(b) and 1014(d) of the Act [subsecs. (b) and (d) of this section] of transmitting to the Comptroller General of the United States and to the Office of the Federal Register copies of special messages transmitted pursuant to section 1012 or 1013 (2 U.S.C. 683 and 684) of the Act; and (2) the function conferred upon the President by section 1014(e) of the Act (2 U.S.C. 685","path":"jobs/current-law/output/USC_EO_NOTES.jsonl","sha256":"ac1e287b6b606b8adc5c1975f662aae2d31989c1d072e32c89dbc38f6efe8016","source":{"line":3,"path":"jobs/current-law/output/SOURCES.jsonl","record_sha256":"5b6e5de61be4ea9c9c4749827c02d0c9d484107505b7e9adae3172a42351c188"}},{"first_1500_characters":"Instrument: EO:13373\nSource: https://www.govinfo.gov/content/pkg/FR-2005-03-14/pdf/05-5097.pdf\nSHA-256 of the downloaded file: 4a783e7a5b00b9fd4ee8db2b8c13b5627b0df63f71ff06a8a52d610085491c4f\nLocation: 70 FR 12579, PDF pages 1-2 (confidence high)\nMachine-extracted text layer of the official PDF (OCR for 1936-1994 scans). May contain recognition errors and parts of neighbouring documents on the same pages. Not an authenticated transcription: check the PDF pages.\n\n=== PDF page 1 of 2 ===\nPresidential Documents\n12579\nFederal Register \nVol. 70, No. 48\nMonday, March 14, 2005\nTitle 3— \nThe President \nExecutive Order 13373 of March 10, 2005\nAmendments to Executive Order 11926 Relating to the Vice \nPresidential Service Badge \nBy the authority vested in me as President by the Constitution and the \nlaws of the United States of America, it is hereby ordered as follows: \nSection 1. Amendments to Executive Order 11926. Executive Order 11926 \nof July 19, 1976, as amended by Executive Order 13286 of February 28, \n2003, is further amended as follows: \n(a) in section 1, by striking ‘‘and Coast Guard’’ and inserting in lieu \nthereof ‘‘Coast Guard, commissioned corps of the National Oceanic and \nAtmospheric Administration, and commissioned corps of the Public Health \nService’’; \n(b) in section 1, by inserting ‘‘, or who have been assigned to perform \nduties predominantly for the Vice President for a period of at least one \nyear subsequent to January 20, 2001, in the implementation of Public Law","path":"jobs/fr-originals/output/texts/EO_13373.txt","sha256":"b93d23e0bb50c539234a7ebb7febee5bd63e9a584274c71fd2d7a498bc163fe8","source":{"line":2101,"path":"jobs/fr-originals/output/SOURCES.jsonl","record_sha256":"9ef5179eda673d5f1967c288945dabec36d79fbf2578459be3bb11631fb5dba3"}},{"first_1500_characters":"Wanted: queue:EO:13373:10USC subtitleA partII chapter57;EO11926,13373,14131\nCited by: EO:13373\nSour