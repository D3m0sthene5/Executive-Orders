c11c96f23","url":"https://www.govinfo.gov/content/pkg/FR-2003-06-03/pdf/03-14116.pdf"}],"summary":"See complete record at pointer"},{"record":{"line":415,"path":"jobs/current-law/output/FRAGMENTS.jsonl","record_sha256":"8d149cd827683e20681d62c23193f1ae2ad3211c900e8a227700c8b5221f69b6"},"sources":[{"page_or_item":{"characters":283,"preview":"10 U.S.C. subtitle A, pt. II, ch. 57 note; note 'Ex. Ord. No. 13306. Establishing the Bob Hope American Patriot Award' [USLM note id ida8989a5d-3a6f-1","sha256_utf8":"bcdf133cfba97bf8f524d7ae905f2217ce689bfbc781cbc83efb722577b18b9b","truncated":true},"sha256":"c6122974e951003437ece5a998aa7c0b2cdc0f5703dfc78d6135e1fc9e729142","url":"https://uscode.house.gov/download/releasepoints/us/pl/119/121/xml_uscAll@119-121.zip"}],"summary":"See complete record at pointer"},{"record":{"line":2081,"path":"jobs/fr-originals/output/FRAGMENTS.jsonl","record_sha256":"eb1da0d301cbad1d69d7bab2d1ecf78dba1ad20949f0f6213f0965213c5ce9ff"},"sources":[{"page_or_item":"68 FR 33337, PDF pages 1-1","sha256":"dc629f67a47ffe031666f4d009da8b2e91c89af7de4b92b5ea78982c11c96f23","url":"https://www.govinfo.gov/content/pkg/FR-2003-06-03/pdf/03-14116.pdf"}],"summary":"See complete record at pointer"},{"record":{"line":3330,"path":"jobs/status-history/output/FRAGMENTS.jsonl","record_sha256":"0d0b3d64e0fa0a8e8254c0ac55b6e8798076aafb517fc6702cf1653332d3ed99"},"sources":[],"summary":"See complete record at pointer"}],"gate_errors":["clause_0_state","clause_1_state","clause_2_state","clause_3_state","clause_4_state","yes_without_continuing_clause","savings_residuals_evidence","bounded_later_search","unresolved_material_gaps","research_rationale"],"instrument_id":"EO:13306","later_events":[],"notice":"Research startup packet; statuses remain provisional. Overflow records are explicit and require their source pointers.","overflow":{"claim_draft":{"reason":"30 KB startup budget; follow record pointers for complete evidence","sha256":"4d2306102b1e2eef935e25ad436600e7569db01b2acd1c4756b119cef95ba7d2"},"conflicts":{"reason":"30 KB startup budget; follow record pointers for complete evidence","sha256":"4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945"},"current_law_hits":{"reason":"30 KB startup budget; follow record pointers for complete evidence","sha256":"0d928a9a5b8250a63bd8cf66eeec44a2151f68b7e2ed9f61192d40bbe4573a7e"},"fragments":{"reason":"30 KB startup budget; follow record pointers for complete evidence","sha256":"b90abaea1d22835520bade53789ac5acddddaff63be49ed85458bad5eb685fcc"},"later_events":{"reason":"30 KB startup budget; follow record pointers for complete evidence","sha256":"4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945"}},"readiness":{"blockers":"","claim_present":"yes","claim_record_errors":"","decision_origin":"inherited_legacy_v2","exhausted_steps":"","instrument_id":"EO:13306","provisional_status":"yes","ready_for_human_review":"yes","ready_tier":"complete_claim","step_clause_inventory":"done","step_counterevidence":"done","step_ending_or_current_basis":"done","step_opus_media":"n/a","step_original_text":"done","step_provisional_status":"done","step_savings_residuals":"done","step_shared_sources":"n/a","steps_applicable":"6","steps_done":"6"},"readiness_blockers":[{"step":"ending_or_current_basis","what":"no current-law lead is checked through 2026-10-14 (U.S. Code entries are current only through 2026-10-09); confirm the last days by hand"}],"schema":"eo-case-bundle/v1","status":"yes","text_pointers":[{"first_1500_characters":"By the authority vested in me as President and as Commander in Chief by the Constitution and the laws of the United States of America, it is ordered as follows:\n\nSection 1. Establishment of the Award. In order to encourage love of country, service to the people of the United States, and support for our Armed Forces, and in order to recognize the unique and lifelong service of Bob Hope to the United States Armed Forces and to the Nation through his unwavering patriotism and dedication to maintaining the morale of the troops he entertained for nearly six decades, and on the occasion of his 100th birthday, there is hereby established the Bob Hope American Patriot Award (Award).\n\nSec. 2. Granting and Presentation of the Award.\n\n(a)\nThe Award may be granted by the President, in his sole discretion, to any civilian individual who has demonstrated extraordinary love of country and devotion to the personnel of the United States Armed Forces, in the form of true patriotism. The Award may also be granted by the President to an organization that meets the same criteria.\n(b)\nOther than in exceptional circumstances, no more than one Award may be granted in any given year.\n(c)\nThe presentation of the Award may take place at any time during the year.\n(d)\nSubject to the provisions of this order, the Award may be conferred posthumously.\n\nGEORGE W. BUSH\n\nThe White House,\n\nMay 28, 2003.\n\n[Filed with the Office of the Federal Register, 9:30 a.m., June 2, 2003]\n","path":"jobs/app-executive-orders/output/texts/executive-order-13306-establishing-the-bob-hope-american-patriot-award.txt","sha256":"981f8036ba5498b835c22e7ff306d147e27c57be369c5ed2ffaef7d2b01f98cf","source":{"line":3346,"path":"jobs/app-transcriptions/output/SOURCES.jsonl","record_sha256":"302fce61e596928fe090bf7152b4e48113ef782dfbab820d5ef004d4f5e6ae8e"}},{"first_1500_characters":"Executive Order 13306 of May 28, 2003\nEstablishing the Bob Hope American Patriot Award \nBy the authority vested in me as President and as Commander in Chief \nby the Constitution and the laws of the United States of America, it is \nordered as follows: \nSection 1. Establishment of the Award. In order to encourage love of country, \nservice to the people of the United States, and support for our Armed \nForces, and in order to recognize the unique and lifelong service of Bob \nHope to the United States Armed Forces and to the Nation through his \nunwavering patriotism and dedication to maintaining the morale of the \ntroops he entertained for nearly six decades, and on the occasion of his \n100th birthday, there is hereby established the Bob Hope American Patriot \nAward (Award). \nSec. 2. Granting and Presentation of the Award.\n(a) The Award may be granted by the President, in his sole discretion, \nto any civilian individual who has demonstrated extraordinary love of coun-\ntry and devotion to the personnel of the United States Armed Forces, in \nthe form of true patriotism. The Award may also be granted by the President \nto an organization that meets the same criteria. \n(b) Other than in exceptional circumstances, no more than one Award \nmay be granted in any given year. \n(c) The presentation of the Award may take place at any time during \nthe year. \n(d) Subject to the provisions of this order, the Award may be conferred \nposthumously.\nW\nTHE WHITE HOUSE, \nMay 28, 2003. \n[FR Doc. 03–1411","path":"jobs/clause-drafts/output/texts/cd-job-fr-originals-13306-dc629f67a4.txt","sha256":"426164aa97739df51d9920f5cbf00039c4368a5a4b171dcacb61adeaa593eedb","source":{"line":8633,"path":"jobs/clause-drafts/output/SOURCES.jsonl","record_sha256":"e10ce1a4ef3a79cee33105e610acdd3f2fd8673772456a91b1ed6b93944c629c"}},{"first_1500_characters":"{\"member\": \"usc02.xml\", \"note_id\": \"iddcb8117d-3a6e-11f1-a0f3-db3efcbbb4ee\", \"citation\": \"2 U.S.C. 685 note\", \"heading\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\", \"subjects\": [\"11845\"], \"status_line\": \"Ex. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\", \"text\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\\nEx. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\\nBy virtue of the authority vested in me by the Impoundment Control Act of 1974 (Public Law 93–344; 88 Stat. 332, (2 U.S.C. 681 et seq.), hereinafter referred to as the Act) [subchapters I and II of this chapter], and section 301 of title 3 of the United States Code, the Director of the Office of Management and Budget is hereby designated and empowered to exercise, as of October 1, 1974 without ratification or other action of the President (1) the functions required by sections 1014(b) and 1014(d) of the Act [subsecs. (b) and (d) of this section] of transmitting to the Comptroller General of the United States and to the Office of the Federal Register copies of special messages transmitted pursuant to section 1012 or 1013 (2 U.S.C. 683 and 684) of the Act; and (2) the function conferred upon the President by section 1014(e) of the Act (2 U.S.C. 685","path":"jobs/current-law/output/USC_EO_NOTES.jsonl","sha256":"ac1e287b6b606b8adc5c1975f662aae2d31989c1d072e32c89dbc38f6efe8016","source":{"line":3,"path":"jobs/current-law/output/SOURCES.jsonl","record_sha256":"5b6e5de61be4ea9c9c4749827c02d0c9d484107505b7e9adae3172a42351c188"}},{"first_1500_characters":"Instrument: EO:13306\nSource: https://www.govinfo.gov/content/pkg/FR-2003-06-03/pdf/03-14116.pdf\nSHA-256 of the downloaded file: dc629f67a47ffe031666f4d009da8b2e91c89af7de4b92b5ea78982c11c96f23\nLocation: 68 FR 33337, PDF pages 1-1 (confidence high)\nMachine-extracted text layer of the official PDF (OCR for 1936-1994 scans). May contain recognition errors and parts of neighbouring documents on the same pages. Not an authenticated transcription: check the PDF pages.\n\n=== PDF page 1 of 1 ===\nPresidential Documents\n33337\nFederal Register \nVol. 68, No. 106\nTuesday, June 3, 2003\nTitle 3— \nThe President \nExecutive Order 13306 of May 28, 2003\nEstablishing the Bob Hope American Patriot Award \nBy the authority vested in me as President and as Commander in Chief \nby the Constitution and the laws of the United States of America, it is \nordered as follows: \nSection 1.