ha256":"5523a353aca96f9b69e2d61bcf3528f15e9249d1a65ee2759a54fd7fe7d6d271","url":{"characters":590,"preview":"https://www.federalregister.gov/api/v1/documents?conditions%5Bcorrection%5D=0&conditions%5Bpresidential_document_type%5D=executive_order&conditions%5B","sha256_utf8":"105552d819656831410983cee908e7447caf1d2c9a8a89b2b6235e8c1658d26c","truncated":true}}],"summary":"See complete record at pointer"}],"notice":"Research startup packet; statuses remain provisional. Overflow records are explicit and require their source pointers.","overflow":{"claim_draft":{"reason":"30 KB startup budget; follow record pointers for complete evidence","sha256":"969926d64385e8c1529ad85c4d4f42fb9f88486f3d45e8f8db1ce53c8f7cc36a"},"conflicts":{"reason":"30 KB startup budget; follow record pointers for complete evidence","sha256":"4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945"},"current_law_hits":{"reason":"30 KB startup budget; follow record pointers for complete evidence","sha256":"d967511f36ebe48a5a9a8318344f35f5594ccd51a50d1469f78143a2db03c085"},"fragments":{"reason":"30 KB startup budget; follow record pointers for complete evidence","sha256":"a921671b14ca3fa17b87f4ba5dd2e66743466f463d244387d4fedf60edd4df63"},"later_events":{"reason":"30 KB startup budget; follow record pointers for complete evidence","sha256":"982ce94dcdaa875f2323391094e1bf35eb890b106fcaadd53d77c678362296ee"}},"readiness":{"blockers":"CLAIM_INCOMPLETE:clause_inventory|CLAIM_INCOMPLETE:ending_or_current_basis|CLAIM_INCOMPLETE:savings_residuals","claim_present":"yes","claim_record_errors":"unresolved_material_gaps","decision_origin":"inherited_legacy_v2","exhausted_steps":"","instrument_id":"EO:13540","provisional_status":"yes","ready_for_human_review":"no","ready_tier":"","step_clause_inventory":"open","step_counterevidence":"done","step_ending_or_current_basis":"open","step_opus_media":"n/a","step_original_text":"done","step_provisional_status":"done","step_savings_residuals":"open","step_shared_sources":"n/a","steps_applicable":"6","steps_done":"3"},"readiness_blockers":[{"step":"ending_or_current_basis","what":"no current-law lead is checked through 2026-10-14 (U.S. Code entries are current only through 2026-10-09); confirm the last days by hand"}],"schema":"eo-case-bundle/v1","status":"yes","text_pointers":[{"first_1500_characters":"By the authority vested in me as President by the Constitution and the laws of the United States of America, including section 102 of title I of the Military Reservist and Veteran Small Business Reauthorization and Opportunity Act of 2008 (Public Law 110-186) (the \"Act\"), and in order to establish an interagency task force to coordinate the efforts of Federal agencies to improve capital, business development opportunities, and pre-established Federal contracting goals for small business concerns owned and controlled by veterans and service-disabled veterans, it is hereby ordered as follows:\n\nSection 1. Establishment. The Administrator of the Small Business Administration (Administrator) shall establish within the Small Business Administration an Interagency Task Force on Veterans Small Business Development (Task Force).\n\nSec. 2. Membership. The Administrator shall serve as Chair of the Task Force and shall direct its work. Other members shall consist of:\n\n(a) a senior level representative, designated by the head of the respective department or agency, from each of the following:\n\n     (i) the Department of the Treasury;\n\n     (ii) the Department of Defense;\n\n     (iii) the Department of Labor;\n\n     (iv) the Department of Veterans Affairs;\n\n     (v) the Office of Management and Budget;\n\n     (vi) the Small Business Administration (in addition to the Administrator); and\n\n     (vii) the General Services Administration; and\n\n(b) four representatives from a veterans' service or m","path":"jobs/app-executive-orders/output/texts/executive-order-13540-interagency-task-force-veterans-small-business-development.txt","sha256":"981f4358a742287b90226c26ae1e1aabc610fe3ffd9082a0638e30e6b6eebe0f","source":{"line":3581,"path":"jobs/app-transcriptions/output/SOURCES.jsonl","record_sha256":"f60c0eeaa0dc8cc6fb24f9340b54338bbb240188e1b8f296dda4ac635dcf6adb"}},{"first_1500_characters":"Executive Order 13540 of April 26, 2010 \nInteragency Task Force on Veterans Small Business Develop-\nment \nBy the authority vested in me as President by the Constitution and the \nlaws of the United States of America, including section 102 of title I of \nthe Military Reservist and Veteran Small Business Reauthorization and Op-\nportunity Act of 2008 (Public Law 110–186) (the ‘‘Act’’), and in order to \nestablish an interagency task force to coordinate the efforts of Federal agencies \nto improve capital, business development opportunities, and pre-established \nFederal contracting goals for small business concerns owned and controlled \nby veterans and service-disabled veterans, it is hereby ordered as follows: \nSection 1. Establishment. The Administrator of the Small Business Adminis-\ntration (Administrator) shall establish within the Small Business Administra-\ntion an Interagency Task Force on Veterans Small Business Development \n(Task Force). \nSec. 2. Membership. The Administrator shall serve as Chair of the Task \nForce and shall direct its work. Other members shall consist of: \n(a) a senior level representative, designated by the head of the respective \ndepartment or agency, from each of the following: \n(i) the Department of the Treasury; \n(ii) the Department of Defense; \n(iii) the Department of Labor; \n(iv) the Department of Veterans Affairs; \n(v) the Office of Management and Budget; \n(vi) the Small Business Administration (in addition to the Administrator); \nand \n(vii) the Gen","path":"jobs/clause-drafts/output/texts/cd-job-fr-originals-13540-b6bd4a4d0c.txt","sha256":"fa9cc217d203851033899139ce026aac6cc0e82579bac3b3be653e9361c93596","source":{"line":8866,"path":"jobs/clause-drafts/output/SOURCES.jsonl","record_sha256":"49f776427093d34b575da4af3fca4415ee2eee61a2bb228dfa07456b5d0825e7"}},{"first_1500_characters":"{\"member\": \"usc02.xml\", \"note_id\": \"iddcb8117d-3a6e-11f1-a0f3-db3efcbbb4ee\", \"citation\": \"2 U.S.C. 685 note\", \"heading\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\", \"subjects\": [\"11845\"], \"status_line\": \"Ex. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\", \"text\": \"Ex. Ord. No. 11845. Delegation of Certain Reporting Functions to Director of Office of Management and Budget\\nEx. Ord. No. 11845, Mar. 24, 1975, 40 F.R. 13299, as amended by Ex. Ord. No. 12608, Sept. 9, 1987, 52 F.R. 34617, provided:\\nBy virtue of the authority vested in me by the Impoundment Control Act of 1974 (Public Law 93–344; 88 Stat. 332, (2 U.S.C. 681 et seq.), hereinafter referred to as the Act) [subchapters I and II of this chapter], and section 301 of title 3 of the United States Code, the Director of the Office of Management and Budget is hereby designated and empowered to exercise, as of October 1, 1974 without ratification or other action of the President (1) the functions required by sections 1014(b) and 1014(d) of the Act [subsecs. (b) and (d) of this section] of transmitting to the Comptroller General of the United States and to the Office of the Federal Register copies of special messages transmitted pursuant to section 1012 or 1013 (2 U.S.C. 683 and 684) of the Act; and (2) the function conferred upon the President by section 1014(e) of the Act (2 U.S.C. 685","path":"jobs/current-law/output/USC_EO_NOTES.jsonl","sha256":"ac1e287b6b606b8adc5c1975f662aae2d31989c1d072e32c89dbc38f6efe8016","source":{"line":3,"path":"jobs/current-law/output/SOURCES.jsonl","record_sha256":"5b6e5de61be4ea9c9c4749827c02d0c9d484107505b7e9adae3172a42351c188"}},{"first_1500_characters":"Instrument: EO:13540\nSource: https://www.govinfo.gov/content/pkg/FR-2010-04-29/pdf/2010-10172.pdf\nSHA-256 of the downloaded file: b6bd4a4d0c2eae831a6e473534e1b97bcc7b8672165221c2ac6202f1ee9029ec\nLocation: 75 FR 22497, PDF pages 1-2 (confidence high)\nMachine-extracted text layer of the official PDF (OCR for 1936-1994 scans). May contain recognition errors and parts of neighbouring documents on the same pages. Not an authenticated transcription: check the PDF pages.\n\n=== PDF page 1 of 2 ===\nPresidential Documents\n22497 \nFederal Register \nVol. 75, No. 82 \nThursday, April 29, 2010 \nTitle 3— \nThe President \nExecutive Order 13540 of April 26, 2010 \nInteragency Task Force on Veterans Small Business Develop-\nment \nBy the authority vested in me as President by the Constitution and the \nlaws of the United States of America, including section 102 of title I of \nthe Military Reservist and Veteran Small Business Reauthorization and Op-\nportunity Act of 2008 (Public Law 110–186) (the ‘‘Act’’), and in order to \nestablish an interagency task force to coordinate the efforts of Federal agencies \nto improve capital, business development opportunities, and pre-established \nFederal contracting goals for small business concerns owned and controlled \nby veterans and service-disabled veterans, it is hereby ordered as follows: \nSection 1. Establishment. The Administrator of the Small Business Adminis-\ntration (Administrator) shall establish within the Small Business Administra-\ntion an Interagency Ta","path":"jobs/fr-originals/output/texts/EO_13540.txt","sha256":"21c7eda05428b34dad8d45bd3b1994d574e30d022d8ef320058de1fb17b123c6","source":{"line":2131,"path":"jobs/fr-originals/output/SOURCES.jsonl","record_sha256":"1abb32c280e93919d79a1889a2ee95bec39545d78b2d7665267556117c086275"}},{"first_1500_characters":"Wanted: queue:EO:13540:15USC657b;PublicLaw110-186section102;EO13540;FACAcontinuation\nCited by: EO:13540\nSource: https://web.archive.org/web/20260711014000id_/https://www.congress.gov/publ