EO:180,0,,presidency_project,number_phrase,Accessibility,https://www.presidency.ucsb.edu/accessibility,,,,,,2026-11-12T03:28:01Z,
EO:180,40,,brave_api,number_phrase,"EXECUTIVE ORDER NO. 180 - PROVIDING GUIDELINES FOR THE EXERCISE OF THE RIGHT TO ORGANIZE OF GOVERNMENT EMPLOYEES, CREATING A PUBLIC SECTOR LABOR-MANAGEMENT COUNCIL, AND FOR OTHER PURPOSES - Supreme Court E-Library",https://elibrary.judiciary.gov.ph/thebookshelf/showdocs/5/6157,,number_named,,,,2026-11-12T03:28:01Z,"SECTION 3. High-level employees whose functions are normally considered as policy-making or managerial or whose duties are of a highly confidential nature shall not be eligible to join the organization of rank-and-file government employees. SECTION 4. The Executive Order shall not apply to the members of the Armed Forces of the Philippines, including police officers, policemen, firemen and jail guards."
EO:180,40,,brave_api,number_phrase,Executive Order No. 180,https://lawphil.net/executive/execord/eo1987/eo_180_1987.html,,number_named,,,,2026-11-12T03:28:01Z,"EXECUTIVE ORDER NO. 180 June 1, 1987 · PROVIDING GUIDELINES FOR THE EXERCISE OF THE RIGHT TO ORGANIZE OF GOVERNMENT EMPLOYEES, CREATING A PUBLIC SECTOR LABOR-MANAGEMENT COUNCIL, AND FOR OTHER PURPOSES"
EO:180,40,,brave_api,number_phrase,Executive Order No. 180,https://lawphil.net/executive/execord/eo1948/eo_180_1948.html,,number_named,,,,2026-11-12T03:28:01Z,Executive Order - ESTABLISHING THE CLASSIFICATION OF ROADS
EO:180,40,,brave_api,number_phrase,EXECUTIVE ORDER NO. 180,https://jur.ph/law/facts/guidelines-for-government-employees-right-to-organize,,number_named,,,,2026-11-12T03:28:01Z,"Corazon C. Aquino's Executive Order No. 180 establishes guidelines for government employees' right to organize , creates a Public Sector Labor-Management Council, and ensures protection against discrimination for their participation in employee organizations."
EO:180,40,,brave_api,number_phrase,"NATLEX - Philippines - Executive Order No. 180 providing guidelines for the exercise of the right to organize of government employees, creating a public sector labor-management council, and for other purposes.",https://natlex.ilo.org/dyn/natlex2/r/natlex/fe/details?p3_isn=3709,,number_named,,,,2026-11-12T03:28:01Z,Skip to Main Content
