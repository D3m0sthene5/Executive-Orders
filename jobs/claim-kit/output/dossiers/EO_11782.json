      "pdf_page": 7,
      "scope_id": "EO:11782#sec2",
      "source": {
        "filing_date": null,
        "location_confidence": "high",
        "location_verified": false,
        "page_or_item": "39 FR 15991, PDF pages 7-7",
        "requires_page_check": false,
        "sha256": "df3cb25b7934209d89b65516ccda54917bdfe7271c58afc206d12ac49078d876",
        "signing_date": "1974-05-06",
        "text_path": "jobs/fr-originals/data/full_run/texts/EO_11782.txt",
        "text_sha256": "c81be0c5f109398a5064a8a5106e5a99023c295e8140cac9dc2adeaef15b03eb",
        "url": "https://www.govinfo.gov/content/pkg/FR-1974-05-07/pdf/FR-1974-05-07.pdf"
      },
      "text": "Sec. 2. The Council shall provide advice and assistance to the Board  \nof Directors of the Federal Financing Bank established by the Federal  \nFinancing Bank Act of 1973 (Public Law 93-224 ; 87 Stat. 937) con­\ncerning the administration of that act. It shall also serve as a coordinat­\ning forum to insure a broader understanding of, and support for, the  \nBank.\nSec . 3. The Department of the Treasury shall, to the extent permitted  \nby law, provide administrative support for the Council."
    },
