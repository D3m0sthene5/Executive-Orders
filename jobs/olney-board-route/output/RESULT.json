  "cover_rule": "D-20261125-board-cover-date",
  "exception_needs": {
    "congressional_action": "Congress legislated on the dispute (NMB inventory); a producer must decide whether the statute ended or displaced the board or the no-change period. Owner rule does not cover it.",
    "dossier_inventory_not_single_clause": "The kit dossier splits the order into several clauses (often FR layout or added commands); a producer must reconcile the inventory before the scripted split applies.",
    "filed_claim_changed_since_lind": "A claim file newer than the one Lind read names the order (EO 11343 was filed by standing auto-adoption after the v2 review); Olney does not replace it.",
    "follow_on_order": "A producer claim: the order amends or extends another board order, so its end follows the parent board and the instrument that names it (not covered by the board rule as written).",
    "letter_and_cover_dates_conflict": "The letter date line reads cleanly as a date other than the cover date (an OCR misreading or a real difference); needs a page-image reading of both lines. D-20261125-board-cover-date covers only an unreadable line.",
    "letter_reading_doubt": "Olney's reading of the held letter (its date line or its address to the President) disagrees with Lind's, or a 'no date line' statement would not hold of the quoted span; needs a page-image reading of the letter.",
    "multi_clause_claim": "The filed claim has more than two clauses (extra commands); each needs its own end beyond the board rule.",
    "original_bytes_not_held": "The order's own Federal Register bytes are only a custody record; needs the original PDF kept (dispatch refuses the packet).",
    "reconvened_or_supplemental_report": "The board reconvened or filed a supplemental report; which report completed the task needs a producer judgment and a second span.",
    "report_date_not_corroborated": "Lind's report date is not corroborated (image check needed or held readings conflict); needs a page-image check of the cover and letter (Lind UNREAD_IMAGE_CHECK_NEEDED/CONFLICT_IMAGE_CHECK_NEEDED).",
    "report_extension_not_scriptable": "The report records a report-time extension Olney cannot carry as a later event: outside the held pages (needs a held text of the later pages), several extensions, an unparsed or ambiguous approval date or deadline, or (run v3) no printed approval date or new deadline. Needs a producer to record each extension, or a held text of the pages.",
    "report_procedural_event": "The report records a stipulation about the proceedings, a reconstituted board or changed member, a reconvening or a report period restarted from a later date (o2 review, EO 10760). The board rule does not say which act completed the task or when the no-change period ran; needs a producer claim that records the event.",
    "report_shared_with_follow_on_order": "One report answers two orders (a board order and its follow-on); a producer must assign the report to each order and decide whether the follow-on reset the deadline. Needs a two-order claim, reviewed together.",
    "submission_sentence_not_found": "The letter is held but no submission sentence was found; needs a manual span or a page check."
  },
