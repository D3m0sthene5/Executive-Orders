 SOURCE_KEYS = {'url', 'sha256', 'text_path', 'text_sha256', 'page_or_item', 'local_path'}
 
 
+def pergamon_record(repo, sha):
+    """The Pergamon store record for raw bytes ``sha`` declared in jobs/*/output/SOURCES.jsonl, or None.
+
+    A source whose bytes are kept only in the Pergamon store (owner decision D-20261110-papinian-board-bytes)
+    declares ``local_path: null``; the claim checker's pergamon_store adapter fetches and re-hashes the bytes."""
+    for path in sorted(Path(repo).glob('jobs/*/output/SOURCES.jsonl')):
+        with path.open(encoding='utf-8') as fh:
+            for line in fh:
+                if sha not in line or '"pergamon"' not in line:
+                    continue
+                try:
+                    row = json.loads(line)
+                except ValueError:
+                    continue
+                pg = row.get('pergamon') if isinstance(row, dict) else None
+                if row.get('sha256') == sha and isinstance(pg, dict) and pg.get('sha256') == sha and pg.get('locator'):
+                    return pg
+    return None
+
+
+def held_bytes(repo, source):
+    """Check the declared raw bytes: a repository file that hashes to sha256, or (local_path null) a Pergamon record
+    for sha256 whose fetched bytes hash to it. Fetching needs the network once per run; refused bytes raise."""
+    if source['local_path'] is not None:
+        return B.file_sha(B.safe(repo, source['local_path'])) == source['sha256']
+    record = pergamon_record(repo, source['sha256'])
+    if record is None:
+        return False
+    import sys
+    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / '_lib'))
+    import pergamon_store
+    return hashlib.sha256(pergamon_store.Store.from_env().get_verified(record)).hexdigest() == source['sha256']
+
+
 def official_declarations(repo):
     """{(text_path, raw sha256): [declarations]} for held official printings declared in jobs/*/output/SOURCES.jsonl.
     The official grades and roles are the compiler's (build.OFFICIAL_GRADE_PREFIXES, build.OFFICIAL_ROLES)."""
